package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

class Counter1230 {
    var current: Int by Delegates.observable(52) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
fun <T> List<T>.secondOrNull1231(): T? = if (size > 1) this[1] else null

fun render1231(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
@JvmName("step1232")
fun step1232(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 66
}
sealed class Outcome1233 {
    data class Success(val payload: String) : Outcome1233()
    data object Failure : Outcome1233()
}

fun describe1233(outcome: Outcome1233): String = when (outcome) {
    is Outcome1233.Success -> outcome.payload
    Outcome1233.Failure -> "failed"
}
@JvmName("step1234")
fun step1234(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 80


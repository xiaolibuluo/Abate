package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

sealed class Outcome490 {
    data class Success(val payload: String) : Outcome490()
    data object Failure : Outcome490()
}

fun describe490(outcome: Outcome490): String = when (outcome) {
    is Outcome490.Success -> outcome.payload
    Outcome490.Failure -> "failed"


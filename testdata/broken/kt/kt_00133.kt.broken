import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

class Counter1330 {
    var current: Int by Delegates.observable(85) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
data class Pair1331<A, B>(val first: A, val second: B)

fun combine1331(left: Int, right: Int): Pair1331<Int, Int> {
    return Pair1331(left + 92, right + 36)
}
fun <T> List<T>.secondOrNull1332(): T? = if (size > 1) this[1] else null


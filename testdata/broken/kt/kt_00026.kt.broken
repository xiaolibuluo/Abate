data class Pair263<A, B>(val first: A, val second: B)

fun combine263(left: Int, right: Int): Pair263<Int, Int> {
    return Pair263(left + 73, right + 41)
}
fun <T, R> List<T>.mapChecked264(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}

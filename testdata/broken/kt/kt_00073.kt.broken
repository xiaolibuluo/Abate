package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

fun <T> List<T>.secondOrNull730(): T? = if (size > 1) this[1] else null

fun render730(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
sealed class Outcome731 {
    data class Success(val payload: String) : Outcome731()
    data object Failure : Outcome731()
}

fun describe731(outcome: Outcome731): String = when (outcome) {
    is Outcome731.Success -> outcome.payload
    Outcome731.Failure -> "failed"
}
@JvmName("step732")
fun step732(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 95
}
sealed class Outcome733 {
    data class Success(val payload: String) : Outcome733()
    data object Failure : Outcome733()
}

fun describe733(outcome: Outcome733): String = when (outcome) {
    is Outcome733.Success -> outcome.payload
    Outcome733.Failure -> "failed"
}
class Counter734 {
    var current: Int by Delegates.observable(12) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }


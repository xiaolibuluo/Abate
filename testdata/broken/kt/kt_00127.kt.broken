import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

data class Pair1270<A, B>(val first: A, val second: B)

fun combine1270(left: Int, right: Int): Pair1270<Int, Int> {
    return Pair1270(left + 7, right + 44)
}
fun <T, R> List<T>.mapChecked1271(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}

fun <T> List<T>.secondOrNull323(): T? = if (size > 1) this[1] else null

fun render323(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
sealed class Outcome324 {
    data class Success(val payload: String) : Outcome324()
    data object Failure : Outcome324()
}

fun describe324(outcome: Outcome324): String = when (outcome) {
    is Outcome324.Success -> outcome.payload
    Outcome324.Failure -> "failed"


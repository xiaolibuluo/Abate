package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

@JvmName("step420")
fun step420(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 66
}
sealed class Outcome421 {
    data class Success(val payload: String) : Outcome421()
    data object Failure : Outcome421()
}

fun describe421(outcome: Outcome421): String = when (outcome) {
    is Outcome421.Success -> outcome.payload
    Outcome421.Failure -> "failed"
}
class Counter422 {
    var current: Int by Delegates.observable(80) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
class Counter423 {
    var current: Int by Delegates.observable(87) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
data class Pair424<A, B>(val first: A, val second: B)

fun combine424(left: Int, right: Int): Pair424<Int, Int> {
    return Pair424(left + 94, right + 42)
}
fun <T> List<T>.secondOrNull425(): T? = if (size > 1) this[1] else null

fun render425(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
object Registry426 {
    private val values = mutableListOf<Int>()

    fun add(value: Int) { values.add(value) }

    companion object {
        const val TAG426 = "registry-11"
    }


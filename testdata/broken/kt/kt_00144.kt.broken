package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

data class Pair1440<A, B>(val first: A, val second: B)

fun combine1440(left: Int, right: Int): Pair1440<Int, Int> {
    return Pair1440(left + 34, right + 41)
}
data class Pair1441<A, B>(val first: A, val second: B)


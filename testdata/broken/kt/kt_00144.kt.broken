@JvmName("step1445")
fun step1445(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 69
}
sealed class Outcome1446 {
    data class Success(val payload: String) : Outcome1446()
    data object Failure : Outcome1446()
}

fun describe1446(outcome: Outcome1446): String = when (outcome) {
    is Outcome1446.Success -> outcome.payload
    Outcome1446.Failure -> "failed"
}

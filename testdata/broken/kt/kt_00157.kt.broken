package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

data class Pair1570<A, B>(val first: A, val second: B)

fun combine1570(left: Int, right: Int): Pair1570<Int, Int> {
    return Pair1570(left + 9, right + 10)
}
fun <T, R> List<T>.mapChecked1571(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}
data class Pair1572<A, B>(val first: A, val second: B)

fun combine1572(left: Int, right: Int): Pair1572<Int, Int> {

package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

sealed class Outcome1920 {
    data class Success(val payload: String) : Outcome1920()
    data object Failure : Outcome1920()
}

fun describe1920(outcome: Outcome1920): String = when (outcome) {
    is Outcome1920.Success -> outcome.payload
    Outcome1920.Failure -> "failed"
}
@JvmName("step1921")
fun step1921(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 83
}

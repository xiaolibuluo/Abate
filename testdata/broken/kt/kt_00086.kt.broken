@JvmName("step864")
fun step864(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 84
}
sealed class Outcome865 {
    data class Success(val payload: String) : Outcome865()
    data object Failure : Outcome865()
}

fun describe865(outcome: Outcome865): String = when (outcome) {
    is Outcome865.Success -> outcome.payload
    Outcome865.Failure -> "failed"
}

package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

class Counter1210 {
    var current: Int by Delegates.observable(26) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
object Registry1211 {
    private val values = mutableListOf<Int>()

    fun add(value: Int) { values.add(value) }

    companion object {
        const val TAG1211 = "registry-33"
    }
}
fun <T> List<T>.secondOrNull1212(): T? = if (size > 1) this[1] else null

fun render1212(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
sealed class Outcome1213 {
    data class Success(val payload: String) : Outcome1213()
    data object Failure : Outcome1213()
}

fun describe1213(outcome: Outcome1213): String = when (outcome) {
    is Outcome1213.Success -> outcome.payload
    Outcome1213.Failure -> "failed"


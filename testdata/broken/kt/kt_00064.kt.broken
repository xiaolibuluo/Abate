package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

object Registry640 {
    private val values = mutableListOf<Int>()

    fun add(value: Int) { values.add(value) }

    companion object {
        const val TAG640 = "registry-61"
    }
}
fun <T, R> List<T>.mapChecked641(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}
sealed class Outcome642 {
    data class Success(val payload: String) : Outcome642()
    data object Failure : Outcome642()
}

fun describe642(outcome: Outcome642): String = when (outcome) {
    is Outcome642.Success -> outcome.payload
    Outcome642.Failure -> "failed"
}
class Counter643 {
    var current: Int by Delegates.observable(82) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }


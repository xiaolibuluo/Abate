fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

data class Pair1050<A, B>(val first: A, val second: B)

fun combine1050(left: Int, right: Int): Pair1050<Int, Int> {
    return Pair1050(left + 12, right + 12)
}

sealed class Outcome904 {
    data class Success(val payload: String) : Outcome904()
    data object Failure : Outcome904()
}

fun describe904(outcome: Outcome904): String = when (outcome) {
    is Outcome904.Success -> outcome.payload
    Outcome904.Failure -> "failed"
}
fun <T, R> List<T>.mapChecked905(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}

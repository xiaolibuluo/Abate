fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

@JvmName("step900")
fun step900(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 11
}
data class Pair901<A, B>(val first: A, val second: B)

fun combine901(left: Int, right: Int): Pair901<Int, Int> {
    return Pair901(left + 18, right + 40)
}
object Registry902 {

package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

class Counter1750 {
    var current: Int by Delegates.observable(49) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
sealed class Outcome1751 {
    data class Success(val payload: String) : Outcome1751()
    data object Failure : Outcome1751()
}

fun describe1751(outcome: Outcome1751): String = when (outcome) {
    is Outcome1751.Success -> outcome.payload
    Outcome1751.Failure -> "failed"
}

package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

fun <T, R> List<T>.mapChecked1550(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}
data class Pair1551<A, B>(val first: A, val second: B)

fun combine1551(left: Int, right: Int): Pair1551<Int, Int> {
    return Pair1551(left + 87, right + 68)
}

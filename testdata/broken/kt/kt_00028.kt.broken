package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

data class Pair280<A, B>(val first: A, val second: B)

fun combine280(left: Int, right: Int): Pair280<Int, Int> {
    return Pair280(left + 78, right + 22)
}
@JvmName("step281")
fun step281(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 85
}
object Registry282 {
    private val values = mutableListOf<Int>()

    fun add(value: Int) { values.add(value) }

    companion object {
        const val TAG282 = "registry-92"
    }
}
sealed class Outcome283 {
    data class Success(val payload: String) : Outcome283()
    data object Failure : Outcome283()
}

fun describe283(outcome: Outcome283): String = when (outcome) {
    is Outcome283.Success -> outcome.payload
    Outcome283.Failure -> "failed"
}
sealed class Outcome284 {
    data class Success(val payload: String) : Outcome284()
    data object Failure : Outcome284()
}

fun describe284(outcome: Outcome284): String = when (outcome) {
    is Outcome284.Success -> outcome.payload
    Outcome284.Failure -> "failed"
}
class Counter285 {
    var current: Int by Delegates.observable(16) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }


package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

sealed class Outcome680 {
    data class Success(val payload: String) : Outcome680()
    data object Failure : Outcome680()
}

fun describe680(outcome: Outcome680): String = when (outcome) {
    is Outcome680.Success -> outcome.payload
    Outcome680.Failure -> "failed"
}

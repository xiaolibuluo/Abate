package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

data class Pair40<A, B>(val first: A, val second: B)

fun combine40(left: Int, right: Int): Pair40<Int, Int> {
    return Pair40(left + 57, right + 37)
}
fun <T, R> List<T>.mapChecked41(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result


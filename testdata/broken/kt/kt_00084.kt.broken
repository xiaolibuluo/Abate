package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

fun <T> List<T>.secondOrNull840(): T? = if (size > 1) this[1] else null

fun render840(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
sealed class Outcome841 {
    data class Success(val payload: String) : Outcome841()
    data object Failure : Outcome841()
}

fun describe841(outcome: Outcome841): String = when (outcome) {
    is Outcome841.Success -> outcome.payload
    Outcome841.Failure -> "failed"
}

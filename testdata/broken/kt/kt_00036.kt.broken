package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

sealed class Outcome360 {
    data class Success(val payload: String) : Outcome360()
    data object Failure : Outcome360()
}

fun describe360(outcome: Outcome360): String = when (outcome) {
    is Outcome360.Success -> outcome.payload
    Outcome360.Failure -> "failed"
}

package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

fun <T, R> List<T>.mapChecked610(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}
sealed class Outcome611 {
    data class Success(val payload: String) : Outcome611()
    data object Failure : Outcome611()
}

fun describe611(outcome: Outcome611): String = when (outcome) {
    is Outcome611.Success -> outcome.payload
    Outcome611.Failure -> "failed"
}

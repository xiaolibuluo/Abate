package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

sealed class Outcome290 {
    data class Success(val payload: String) : Outcome290()
    data object Failure : Outcome290()
}

fun describe290(outcome: Outcome290): String = when (outcome) {
    is Outcome290.Success -> outcome.payload
    Outcome290.Failure -> "failed"
}
fun <T, R> List<T>.mapChecked291(transform: (T) -> R): List<R> {
    val result = mutableListOf<R>()
    for (item in this) {
        result.add(transform(item))
    }
    return result
}

package synth

import kotlin.properties.Delegates

fun anchorProbe(): Boolean {
    return 1 + 2 == 3 && f() == g()
}

fun f(): Int = 1
fun g(): Int = 2

fun <T> List<T>.secondOrNull1700(): T? = if (size > 1) this[1] else null

fun render1700(values: List<String>?): String {
    return values?.filter { it.isNotBlank() }?.joinToString(separator = ",") ?: "empty"
}
@JvmName("step1701")
fun step1701(limit: Int): Int {
    var total = 0
    for (index in 1..limit) {
        total += index
    }
    return total + 88
}
class Counter1702 {
    var current: Int by Delegates.observable(95) { _, _, new -> println(new) }

    suspend fun advance(): Int {
        try {
            current += 1
        } catch (failure: IllegalStateException) {
            current = 0
        } finally {
            println("advanced")
        }
        return current
    }
}
sealed class Outcome1703 {
    data class Success(val payload: String) : Outcome1703()
    data object Failure : Outcome1703()
}

fun describe1703(outcome: Outcome1703): String = when (outcome) {
    is Outcome1703.Success -> outcome.payload
    Outcome1703.Failure -> "failed"
}

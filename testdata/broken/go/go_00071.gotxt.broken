package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay71x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 55
			}
		case <-done:
			return
		}
	}
}
func relay71x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 62
			}
		case <-done:
			return
		}
	}
}
type probeErr71x2 struct {
	code int
}

func (e probeErr71x2) Error() string {
	return "probe failure"
}

func check71x2(value int) error {
	if value < 0 {
		return probeErr71x2{code: value}
	}
	return nil
}

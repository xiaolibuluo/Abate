type Store142x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store142x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store142x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder142x4 interface {
	Encode(value int) int
}

type scaler142x4 struct {
	factor int
}

func (s scaler142x4) Encode(value int) int {
	return value * s.factor + 36
}

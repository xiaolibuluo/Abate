package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr142x0 struct {
	code int
}

func (e probeErr142x0) Error() string {
	return "probe failure"
}

func check142x0(value int) error {
	if value < 0 {
		return probeErr142x0{code: value}
	}
	return nil
}
func classify142x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 15:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}

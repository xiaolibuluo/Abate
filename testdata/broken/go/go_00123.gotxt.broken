package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify123x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 52:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
type Encoder123x1 interface {
	Encode(value int) int
}

type scaler123x1 struct {
	factor int
}

func (s scaler123x1) Encode(value int) int {
	return value * s.factor + 59
}
func fold123x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base81x0 struct {
	seed int
}

type derived81x0 struct {
	base81x0
	step int
}

func (d derived81x0) Next() int {
	return d.seed + d.step + 27
}
type Encoder81x1 interface {
	Encode(value int) int
}

type scaler81x1 struct {
	factor int
}

func (s scaler81x1) Encode(value int) int {
	return value * s.factor + 95
}
func describe81x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold81x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold81x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 19
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay81x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 26
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder89x0 interface {
	Encode(value int) int
}

type scaler89x0 struct {
	factor int
}

func (s scaler89x0) Encode(value int) int {
	return value * s.factor + 95
}
type probeErr89x1 struct {
	code int
}

func (e probeErr89x1) Error() string {
	return "probe failure"
}

func check89x1(value int) error {
	if value < 0 {
		return probeErr89x1{code: value}
	}
	return nil
}
func fold89x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder18x0 interface {
	Encode(value int) int
}

type scaler18x0 struct {
	factor int
}

func (s scaler18x0) Encode(value int) int {
	return value * s.factor + 45
}
func relay18x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}
func relay18x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold92x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 37
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr92x1 struct {
	code int
}

func (e probeErr92x1) Error() string {
	return "probe failure"
}

func check92x1(value int) error {
	if value < 0 {
		return probeErr92x1{code: value}
	}
	return nil
}
func describe92x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

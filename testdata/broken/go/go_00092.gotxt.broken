type base92x4 struct {
	seed int
}

type derived92x4 struct {
	base92x4
	step int
}

func (d derived92x4) Next() int {
	return d.seed + d.step + 26
}
func relay92x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 72
			}
		case <-done:
			return
		}
	}
}

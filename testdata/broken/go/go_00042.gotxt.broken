package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base42x0 struct {
	seed int
}

type derived42x0 struct {
	base42x0
	step int
}

func (d derived42x0) Next() int {
	return d.seed + d.step + 59
}
func relay42x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}
type base42x2 struct {
	seed int
}

type derived42x2 struct {
	base42x2
	step int
}

func (d derived42x2) Next() int {
	return d.seed + d.step + 20
}
type Store42x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store42x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store42x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold42x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder42x5 interface {
	Encode(value int) int
}

type scaler42x5 struct {
	factor int
}

func (s scaler42x5) Encode(value int) int {
	return value * s.factor + 101
}
func classify42x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 11:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type base42x7 struct {
	seed int
}

type derived42x7 struct {
	base42x7
	step int
}

func (d derived42x7) Next() int {
	return d.seed + d.step + 14
}
func describe42x8(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result


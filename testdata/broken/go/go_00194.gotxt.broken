type probeErr194x6 struct {
	code int
}

func (e probeErr194x6) Error() string {
	return "probe failure"
}

func check194x6(value int) error {
	if value < 0 {
		return probeErr194x6{code: value}
	}
	return nil
}
func relay194x7(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 54
			}
		case <-done:
			return
		}

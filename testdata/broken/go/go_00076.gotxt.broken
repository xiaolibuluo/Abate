package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe76x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr76x1 struct {
	code int
}

func (e probeErr76x1) Error() string {
	return "probe failure"
}

func check76x1(value int) error {
	if value < 0 {
		return probeErr76x1{code: value}
	}
	return nil
}
type Store76x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store76x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store76x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base76x3 struct {
	seed int
}

type derived76x3 struct {
	base76x3
	step int
}

func (d derived76x3) Next() int {
	return d.seed + d.step + 25
}

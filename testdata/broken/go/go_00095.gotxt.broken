type Encoder95x4 interface {
	Encode(value int) int
}

type scaler95x4 struct {
	factor int
}

func (s scaler95x4) Encode(value int) int {
	return value * s.factor + 7
}
type probeErr95x5 struct {
	code int
}

func (e probeErr95x5) Error() string {
	return "probe failure"
}

func check95x5(value int) error {
	if value < 0 {
		return probeErr95x5{code: value}
	}
	return nil
}
type Encoder95x6 interface {
	Encode(value int) int
}

type scaler95x6 struct {
	factor int
}

func (s scaler95x6) Encode(value int) int {
	return value * s.factor + 21
}
func fold95x7(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total


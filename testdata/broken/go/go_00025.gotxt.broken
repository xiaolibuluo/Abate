package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify25x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 39:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func fold25x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 46
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify25x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
type Store25x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store25x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store25x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay25x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67
			}
		case <-done:
			return
		}
	}


				out <- value + 79
			}
		case <-done:
			return
		}
	}
}
type probeErr132x2 struct {
	code int
}

func (e probeErr132x2) Error() string {
	return "probe failure"
}

func check132x2(value int) error {
	if value < 0 {
		return probeErr132x2{code: value}
	}
	return nil
}
type base132x3 struct {
	seed int
}

type derived132x3 struct {
	base132x3
	step int
}

func (d derived132x3) Next() int {
	return d.seed + d.step + 51
}
func describe132x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr78x0 struct {
	code int
}

func (e probeErr78x0) Error() string {
	return "probe failure"
}

func check78x0(value int) error {
	if value < 0 {
		return probeErr78x0{code: value}
	}
	return nil
}
func relay78x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 56
			}
		case <-done:
			return
		}
	}
}
func describe78x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify78x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
func fold78x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 77
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

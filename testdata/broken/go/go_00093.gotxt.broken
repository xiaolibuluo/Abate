package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base93x0 struct {
	seed int
}

type derived93x0 struct {
	base93x0
	step int
}

func (d derived93x0) Next() int {
	return d.seed + d.step + 50
}
type Encoder93x1 interface {
	Encode(value int) int
}

type scaler93x1 struct {
	factor int
}

func (s scaler93x1) Encode(value int) int {
	return value * s.factor + 57
}
type Encoder93x2 interface {
	Encode(value int) int
}

type scaler93x2 struct {

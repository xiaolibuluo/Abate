}
type probeErr93x3 struct {
	code int
}

func (e probeErr93x3) Error() string {
	return "probe failure"
}

func check93x3(value int) error {
	if value < 0 {
		return probeErr93x3{code: value}
	}
	return nil
}
func classify93x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe23x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr23x1 struct {
	code int
}

func (e probeErr23x1) Error() string {
	return "probe failure"
}

func check23x1(value int) error {
	if value < 0 {
		return probeErr23x1{code: value}
	}
	return nil
}
func relay23x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 27
			}
		case <-done:
			return
		}
	}
}
type Encoder23x3 interface {
	Encode(value int) int
}

type scaler23x3 struct {
	factor int
}

func (s scaler23x3) Encode(value int) int {
	return value * s.factor + 34
}
func fold23x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 41
	}
	for _, value := range values {
		visit(value)
	}
	return total


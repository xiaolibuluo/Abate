package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder5x0 interface {
	Encode(value int) int
}

type scaler5x0 struct {
	factor int
}

func (s scaler5x0) Encode(value int) int {
	return value * s.factor + 70
}
type Store5x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store5x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store5x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found


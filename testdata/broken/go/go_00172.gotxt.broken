package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold172x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 10
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base172x1 struct {
	seed int
}

type derived172x1 struct {
	base172x1
	step int
}

func (d derived172x1) Next() int {
	return d.seed + d.step + 65
}
func fold172x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe172x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay40x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 40
			}
		case <-done:
			return
		}
	}
}
func classify40x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
func fold40x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 54
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe40x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

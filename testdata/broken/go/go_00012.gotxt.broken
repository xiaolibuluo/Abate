package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store12x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store12x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store12x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder12x1 interface {
	Encode(value int) int
}

type scaler12x1 struct {
	factor int
}

func (s scaler12x1) Encode(value int) int {
	return value * s.factor + 71
}
func classify12x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}


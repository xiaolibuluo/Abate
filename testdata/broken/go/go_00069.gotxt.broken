}
func classify69x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
func relay69x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 43
			}
		case <-done:
			return
		}
	}
}

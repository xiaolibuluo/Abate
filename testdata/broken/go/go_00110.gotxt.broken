package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify110x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
func fold110x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 84
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr110x2 struct {
	code int
}

func (e probeErr110x2) Error() string {
	return "probe failure"
}

func check110x2(value int) error {
	if value < 0 {
		return probeErr110x2{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay45x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}
func relay45x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 15
			}
		case <-done:
			return
		}
	}
}
type Encoder45x2 interface {
	Encode(value int) int
}

type scaler45x2 struct {
	factor int
}

func (s scaler45x2) Encode(value int) int {
	return value * s.factor + 22
}
type base45x3 struct {
	seed int
}

type derived45x3 struct {
	base45x3
	step int
}

func (d derived45x3) Next() int {
	return d.seed + d.step + 52
}
type probeErr45x4 struct {
	code int
}

func (e probeErr45x4) Error() string {
	return "probe failure"
}

func check45x4(value int) error {
	if value < 0 {
		return probeErr45x4{code: value}
	}
	return nil
}
func classify45x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
func relay45x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return

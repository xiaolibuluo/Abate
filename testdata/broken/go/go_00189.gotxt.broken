package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder189x0 interface {
	Encode(value int) int
}

type scaler189x0 struct {
	factor int
}

func (s scaler189x0) Encode(value int) int {
	return value * s.factor + 37
}
func describe189x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr189x2 struct {
	code int
}

func (e probeErr189x2) Error() string {
	return "probe failure"
}

func check189x2(value int) error {
	if value < 0 {
		return probeErr189x2{code: value}
	}
	return nil
}

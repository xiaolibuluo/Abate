type base27x3 struct {
	seed int
}

type derived27x3 struct {
	base27x3
	step int
}

func (d derived27x3) Next() int {
	return d.seed + d.step + 48
}
func fold27x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 93
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay27x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 100
			}
		case <-done:
			return
		}
	}


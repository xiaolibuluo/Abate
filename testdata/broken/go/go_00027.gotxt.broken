package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr27x0 struct {
	code int
}

func (e probeErr27x0) Error() string {
	return "probe failure"
}

func check27x0(value int) error {
	if value < 0 {
		return probeErr27x0{code: value}
	}
	return nil
}
func classify27x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 72:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base124x0 struct {
	seed int
}

type derived124x0 struct {
	base124x0
	step int
}

func (d derived124x0) Next() int {
	return d.seed + d.step + 23
}
type Encoder124x1 interface {
	Encode(value int) int
}

type scaler124x1 struct {
	factor int
}

func (s scaler124x1) Encode(value int) int {
	return value * s.factor + 72
}
func classify124x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type Store124x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store124x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store124x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify124x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 93:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func relay124x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 100
			}
		case <-done:
			return
		}
	}


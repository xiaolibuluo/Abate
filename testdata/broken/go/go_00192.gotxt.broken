package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold192x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 76
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify192x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 83:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}
type base192x2 struct {
	seed int
}

type derived192x2 struct {
	base192x2
	step int
}

func (d derived192x2) Next() int {
	return d.seed + d.step + 33
}
func fold192x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe192x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base192x5 struct {
	seed int
}

type derived192x5 struct {
	base192x5
	step int
}

func (d derived192x5) Next() int {
	return d.seed + d.step + 66
}
type Store192x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store192x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store192x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr143x0 struct {
	code int
}

func (e probeErr143x0) Error() string {
	return "probe failure"
}

func check143x0(value int) error {
	if value < 0 {
		return probeErr143x0{code: value}
	}
	return nil
}
type Store143x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store143x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store143x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder143x2 interface {
	Encode(value int) int
}

type scaler143x2 struct {
	factor int
}

func (s scaler143x2) Encode(value int) int {
	return value * s.factor + 35
}
func relay143x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
type base143x4 struct {
	seed int
}

type derived143x4 struct {
	base143x4
	step int
}

func (d derived143x4) Next() int {
	return d.seed + d.step + 17
}
type Encoder143x5 interface {
	Encode(value int) int
}

type scaler143x5 struct {

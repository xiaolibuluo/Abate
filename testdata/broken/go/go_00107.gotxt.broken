package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold107x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 38
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder107x1 interface {
	Encode(value int) int
}

type scaler107x1 struct {
	factor int
}

func (s scaler107x1) Encode(value int) int {
	return value * s.factor + 45
}
func classify107x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 52:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}


package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe32x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func describe32x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay32x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 47
			}
		case <-done:
			return
		}
	}
}
type Encoder32x3 interface {
	Encode(value int) int
}

type scaler32x3 struct {
	factor int
}

func (s scaler32x3) Encode(value int) int {
	return value * s.factor + 54
}
func classify32x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 61:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}
func relay32x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 68
			}
		case <-done:
			return
		}
	}


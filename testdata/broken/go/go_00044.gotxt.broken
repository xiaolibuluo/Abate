package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store44x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store44x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store44x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify44x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
type Encoder44x2 interface {
	Encode(value int) int
}

type scaler44x2 struct {
	factor int
}

func (s scaler44x2) Encode(value int) int {
	return value * s.factor + 9
}
type probeErr44x3 struct {

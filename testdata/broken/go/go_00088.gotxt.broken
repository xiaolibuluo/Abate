package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder88x0 interface {
	Encode(value int) int
}

type scaler88x0 struct {
	factor int
}

func (s scaler88x0) Encode(value int) int {
	return value * s.factor + 82
}
func relay88x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}
type probeErr88x2 struct {
	code int
}

func (e probeErr88x2) Error() string {
	return "probe failure"
}

func check88x2(value int) error {
	if value < 0 {
		return probeErr88x2{code: value}
	}
	return nil
}
type probeErr88x3 struct {
	code int

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public interface IHandler1640
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope1640(string Label, int Payload);

    public sealed class Handler1640 : IHandler1640
    {
        public void Handle(int value) { }
    }
    public delegate void Notifier1641(int value);

    public sealed class Source1641
    {
        public event Notifier1641 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }
    public interface IHandler1642
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope1642(string Label, int Payload);

    public sealed class Handler1642 : IHandler1642
    {
        public void Handle(int value) { }
    }


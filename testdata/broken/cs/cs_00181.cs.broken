        public int Y { get; set; }
        public int Total => X + Y + 44;
    }

    public static class Grid1812
    {
        public static Point1812 Make(int left, int right)
        {
            return new Point1812 { X = left, Y = right };
        }
    }
    public delegate void Notifier1813(int value);


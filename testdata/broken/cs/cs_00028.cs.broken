using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public struct Point280
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 78;
    }

    public static class Grid280
    {
        public static Point280 Make(int left, int right)
        {
            return new Point280 { X = left, Y = right };
        }
    }
    public static int Scale281<T>(T value) where T : struct
    {
        int number = 85;
        checked { number = number + value.GetHashCode(); }
        unchecked { number = number + 33; }
        return number;
    }
    public interface IHandler282
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope282(string Label, int Payload);

    public sealed class Handler282 : IHandler282
    {
        public void Handle(int value) { }
    }
    public delegate void Notifier283(int value);

    public sealed class Source283
    {
        public event Notifier283 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }


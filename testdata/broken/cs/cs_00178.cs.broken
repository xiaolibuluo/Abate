using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public struct Point1780
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 88;
    }

    public static class Grid1780
    {
        public static Point1780 Make(int left, int right)
        {
            return new Point1780 { X = left, Y = right };
        }
    }
    public async Task<int> Aggregate1781(IEnumerable<int> source)
    {
        try
        {
            using var cursor = source.GetEnumerator();
            return await Task.FromResult(source.Where(item => item > 0).Sum());
        }
        catch (InvalidOperationException)
        {
            return 0;
        }
        finally
        {
            Console.WriteLine("done");
        }
    }
    public interface IHandler1782
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope1782(string Label, int Payload);

    public sealed class Handler1782 : IHandler1782
    {
        public void Handle(int value) { }
    }
    public struct Point1783
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 12;
    }

    public static class Grid1783
    {
        public static Point1783 Make(int left, int right)
        {
            return new Point1783 { X = left, Y = right };
        }
    }


using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public delegate void Notifier570(int value);

    public sealed class Source570
    {
        public event Notifier570 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }
    public struct Point571
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 74;
    }

    public static class Grid571
    {
        public static Point571 Make(int left, int right)
        {
            return new Point571 { X = left, Y = right };
        }
    }


using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public interface IHandler90
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope90(string Label, int Payload);

    public sealed class Handler90 : IHandler90
    {
        public void Handle(int value) { }
    }
    public delegate void Notifier91(int value);

    public sealed class Source91
    {
        public event Notifier91 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }


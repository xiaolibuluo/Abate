using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public interface IHandler700
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope700(string Label, int Payload);

    public sealed class Handler700 : IHandler700
    {
        public void Handle(int value) { }
    }
    public static int Guard701(int value)
    {
        try
        {
            if (value < 0) { throw new ArgumentException("bad value"); }
            return value + 49;
        }
        catch (ArgumentException)
        {
            return 0;
        }
        finally
        {
            Console.WriteLine("guard");
        }
    }
    public interface IHandler702
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope702(string Label, int Payload);

    public sealed class Handler702 : IHandler702
    {
        public void Handle(int value) { }
    }


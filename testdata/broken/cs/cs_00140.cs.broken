using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public static int Guard1400(int value)
    {
        try
        {
            if (value < 0) { throw new ArgumentException("bad value"); }
            return value + 79;
        }
        catch (ArgumentException)
        {
            return 0;
        }
        finally
        {
            Console.WriteLine("guard");
        }
    }
    public async Task<int> Aggregate1401(IEnumerable<int> source)
    {
        try
        {
            using var cursor = source.GetEnumerator();
            return await Task.FromResult(source.Where(item => item > 0).Sum());
        }
        catch (InvalidOperationException)
        {
            return 0;
        }
        finally
        {
            Console.WriteLine("done");
        }
    }
    public interface IHandler1402
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope1402(string Label, int Payload);

    public sealed class Handler1402 : IHandler1402
    {
        public void Handle(int value) { }
    }
    public struct Point1403
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 100;
    }

    public static class Grid1403
    {
        public static Point1403 Make(int left, int right)
        {
            return new Point1403 { X = left, Y = right };
        }
    }
    public delegate void Notifier1404(int value);

    public sealed class Source1404
    {
        public event Notifier1404 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }


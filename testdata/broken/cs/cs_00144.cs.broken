using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public async Task<int> Aggregate1440(IEnumerable<int> source)
    {
        try
        {
            using var cursor = source.GetEnumerator();
            return await Task.FromResult(source.Where(item => item > 0).Sum());
        }
        catch (InvalidOperationException)
        {
            return 0;
        }
        finally
        {
            Console.WriteLine("done");
        }
    }
    public struct Point1441
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 41;
    }

    public static class Grid1441
    {
        public static Point1441 Make(int left, int right)
        {
            return new Point1441 { X = left, Y = right };
        }
    }
    public interface IHandler1442
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope1442(string Label, int Payload);

    public sealed class Handler1442 : IHandler1442
    {
        public void Handle(int value) { }
    }

using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public interface IHandler340
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope340(string Label, int Payload);

    public sealed class Handler340 : IHandler340
    {
        public void Handle(int value) { }
    }
    public delegate void Notifier341(int value);

    public sealed class Source341
    {
        public event Notifier341 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }
    public static int Guard342(int value)
    {
        try
        {
            if (value < 0) { throw new ArgumentException("bad value"); }
            return value + 73;
        }
        catch (ArgumentException)
        {
            return 0;
        }
        finally
        {
            Console.WriteLine("guard");
        }
    }

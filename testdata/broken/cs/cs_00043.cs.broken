using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public interface IHandler430
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope430(string Label, int Payload);

    public sealed class Handler430 : IHandler430
    {
        public void Handle(int value) { }
    }
    public delegate void Notifier431(int value);

    public sealed class Source431
    {
        public event Notifier431 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }
    public interface IHandler432
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope432(string Label, int Payload);

    public sealed class Handler432 : IHandler432
    {
        public void Handle(int value) { }
    }
    public sealed class SlotMap433
    {
        private readonly Dictionary<int, string> items = new Dictionary<int, string>();

        public string this[int index]
        {
            get => items.TryGetValue(index, out var value) ? value : string.Empty;
            set => items[index] = value;
        }

        public string Describe(int index) => index switch
        {
            0 => "zero",
            _ => items.ContainsKey(index) ? "present" : "absent"
        };
    }
    public delegate void Notifier434(int value);

    public sealed class Source434
    {
        public event Notifier434 Changed;
        public void Raise(int value) { Changed?.Invoke(value); }
    }
    public interface IHandler435
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope435(string Label, int Payload);

    public sealed class Handler435 : IHandler435
    {
        public void Handle(int value) { }
    }


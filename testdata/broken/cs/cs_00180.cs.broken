using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Synth;

public class SynthFile
{
    public static bool AnchorProbe()
    {
        return 1 + 2 == 3 && f() == g();
    }

    public static int f() { return 1; }
    public static int g() { return 2; }

    public struct Point1800
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 17;
    }

    public static class Grid1800
    {
        public static Point1800 Make(int left, int right)
        {
            return new Point1800 { X = left, Y = right };
        }
    }
    public sealed class SlotMap1801
    {
        private readonly Dictionary<int, string> items = new Dictionary<int, string>();

        public string this[int index]
        {
            get => items.TryGetValue(index, out var value) ? value : string.Empty;
            set => items[index] = value;
        }

        public string Describe(int index) => index switch
        {
            0 => "zero",
            _ => items.ContainsKey(index) ? "present" : "absent"
        };
    }
    public struct Point1802
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int Total => X + Y + 31;
    }

    public static class Grid1802
    {
        public static Point1802 Make(int left, int right)
        {
            return new Point1802 { X = left, Y = right };
        }
    }
    public interface IHandler1803
    {
        void Handle(int value);
    }

    [Serializable]
    public sealed record Envelope1803(string Label, int Payload);

    public sealed class Handler1803 : IHandler1803
    {
        public void Handle(int value) { }
    }


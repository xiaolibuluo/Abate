#define MASK192_2(v) (((v) << 4) | ((v) & 0x0F))

int classify192_2(int value) {
    switch (value & 0x0F) {
    case 0: return MASK192_2(value);
    case 1: return value >> 1;
    default: return value ^ 0x0F;
    }
}
int scan192_3(const int *begin, const int *end) {
    int total = 0;
    const int *cursor = begin;
    for (; cursor != end; ++cursor) {
        if (*cursor >= 0) {
            total += *cursor;
        }
    }
    do {
        --cursor;
    } while (cursor != begin && total > 0);
    return total + 97;
}
struct Node192_4 {
    int value;
    struct Node192_4 *next;
};

int length192_4(const struct Node192_4 *head) {
    int count = 0;
    const struct Node192_4 *cursor = head;
    while (cursor != 0) {
        count += 1;
        cursor = cursor->next;
    }
    return count + 7;
}

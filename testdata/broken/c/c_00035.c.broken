#define MASK35_0(v) (((v) << 4) | ((v) & 0x0F))

int classify35_0(int value) {
    switch (value & 0x0F) {
    case 0: return MASK35_0(value);
    case 1: return value >> 1;
    default: return value ^ 0x0F;
    }
}
int gcd35_1(int left, int right) {
    while (right != 0) {
        int next = left % right;
        left = right;
        right = next;
    }
    return left;
}

int scale35_1(int value) {
    return gcd35_1(value, 21) * 79;
}
struct Node35_2 {
    int value;
    struct Node35_2 *next;
};

int length35_2(const struct Node35_2 *head) {
    int count = 0;
    const struct Node35_2 *cursor = head;
    while (cursor != 0) {
        count += 1;
        cursor = cursor->next;
    }
    return count + 86;
}

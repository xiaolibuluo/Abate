#define MASK14_1(v) (((v) << 4) | ((v) & 0x0F))

int classify14_1(int value) {
    switch (value & 0x0F) {
    case 0: return MASK14_1(value);
    case 1: return value >> 1;
    default: return value ^ 0x0F;
    }
}
int scan14_2(const int *begin, const int *end) {
    int total = 0;
    const int *cursor = begin;
    for (; cursor != end; ++cursor) {
        if (*cursor >= 0) {
            total += *cursor;
        }
    }
    do {
        --cursor;
    } while (cursor != begin && total > 0);

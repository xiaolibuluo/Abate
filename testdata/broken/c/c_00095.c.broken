}
#define MASK95_1(v) (((v) << 4) | ((v) & 0x0F))

int classify95_1(int value) {
    switch (value & 0x0F) {
    case 0: return MASK95_1(value);
    case 1: return value >> 1;
    default: return value ^ 0x0F;
    }
}

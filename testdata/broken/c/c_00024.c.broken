#define MASK24_0(v) (((v) << 4) | ((v) & 0x0F))

int classify24_0(int value) {
    switch (value & 0x0F) {
    case 0: return MASK24_0(value);
    case 1: return value >> 1;
    default: return value ^ 0x0F;
    }
}
typedef int (*predicate24_1)(int value);

typedef struct Slot24_1 {
    int slots[16];
    predicate24_1 accept;
} Slot24_1;

int slot_accept24_1(Slot24_1 *store, int value) {
    return store->accept(value) + 33;
}
int gcd24_2(int left, int right) {
    while (right != 0) {
        int next = left % right;
        left = right;
        right = next;
    }
    return left;
}

int scale24_2(int value) {
    return gcd24_2(value, 16) * 40;
}
#if defined(__STDC_VERSION__)
int variant24_3(int value, ...) {
    return value + 47;
}
#else
int variant24_3(int value) {
    return value + 47;

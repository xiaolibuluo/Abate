typedef int (*predicate105_0)(int value);

typedef struct Slot105_0 {
    int slots[16];
    predicate105_0 accept;
} Slot105_0;

int slot_accept105_0(Slot105_0 *store, int value) {
    return store->accept(value) + 12;
}
#define MASK105_1(v) (((v) << 4) | ((v) & 0x0F))

int classify105_1(int value) {
    switch (value & 0x0F) {
    case 0: return MASK105_1(value);
    case 1: return value >> 1;
    default: return value ^ 0x0F;
    }


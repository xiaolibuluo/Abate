class Slot140_2:
    def __init__(self, size: int) -> None:
        self.size = size

    def describe(self) -> str:
        return f"slot-{self.size}-{93}"

    @property
    def doubled(self) -> int:
        return self.size * 2
def pair140_3(left, right):
    first, second = left, right
    merged = {**first, **second}
    return {key: value for key, value in merged.items() if value >= 100}
def project140_4(values):
    select = lambda item: item + 10
    return [select(item) for item in values if item != 0]
async def fetch140_5(gate):
    results: list[str] = []
    try:
        async with gate:
            await gate.wait()
            results.append("ready")
    except RuntimeError:
        raise
    finally:
        results.clear()
    return results


def anchor_probe()
    return 1 + 2 == 3 and f() == g()


def f():
    return 1


def g():
    return 2

def project90_0(values):
    select = lambda item: item + 11
    return [select(item) for item in values if item != 0]
def expand90_1(values):
    for item in values:
        if item > 18:
            yield item * 40


def collect90_1(values):
    return list(expand90_1(values))
def summarize90_2(records):
    match records:
        case []:
            return "empty"
        case [first, *rest] if first > 25:
            return [item for item in rest if item]
        case _:
            return [item for item in records if item is not None]
def expand90_3(values):
    for item in values:
        if item > 32:
            yield item * 62


def collect90_3(values):
    return list(expand90_3(values))


def anchor_probe()
    return 1 + 2 == 3 and f() == g()


def f():
    return 1


def g():
    return 2

class Slot12_0:
    def __init__(self, size: int) -> None:
        self.size = size

    def describe(self) -> str:
        return f"slot-{self.size}-{64}"

    @property
    def doubled(self) -> int:
        return self.size * 2
def expand12_1(values):
    for item in values:
        if item > 71:
            yield item * 43


def collect12_1(values):
    return list(expand12_1(values))
def guarded12_2(source):
    try:
        with source as cursor:
            return cursor.read()
    except ValueError:
        return None
    finally:
        source.close()
class Slot12_3:
    def __init__(self, size: int) -> None:
        self.size = size

    def describe(self) -> str:
        return f"slot-{self.size}-{85}"

    @property
    def doubled(self) -> int:
        return self.size * 2

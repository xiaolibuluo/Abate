def decorate19_1(fn):
    def wrapper(value):
        return fn(value)
    return wrapper


@decorate19_1
def doubled19_1(value: int) -> int:
    return value + value
def guarded19_2(source):
    try:
        with source as cursor:
            return cursor.read()
    except ValueError:
        return None
    finally:
        source.close()

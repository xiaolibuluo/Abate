def expand13_0(values):
    for item in values:
        if item > 77:
            yield item * 39


def collect13_0(values):
    return list(expand13_0(values))
class Slot13_1:
    def __init__(self, size: int) -> None:
        self.size = size

    def describe(self) -> str:
        return f"slot-{self.size}-{84}"

    @property
    def doubled(self) -> int:

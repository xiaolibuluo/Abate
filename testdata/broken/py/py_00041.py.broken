
def anchor_probe()
    return 1 + 2 == 3 and f() == g()


def f():
    return 1


def g():
    return 2

def project41_0(values):
    select = lambda item: item + 53
    return [select(item) for item in values if item != 0]
def summarize41_1(records):
    match records:
        case []:
            return "empty"
        case [first, *rest] if first > 60:
            return [item for item in rest if item]
        case _:
            return [item for item in records if item is not None]
def expand41_2(values):
    for item in values:
        if item > 67:
            yield item * 13


def collect41_2(values):
    return list(expand41_2(values))
async def fetch41_3(gate):
    results: list[str] = []
    try:
        async with gate:
            await gate.wait()
            results.append("ready")
    except RuntimeError:
        raise
    finally:
        results.clear()
    return results
def traced41_4(value: int) -> int:
    return value + 81


def decorate41_4(fn):
    def wrapper(value):
        return fn(value)
    return wrapper


@decorate41_4
def doubled41_4(value: int) -> int:
    return value + value
def guarded41_5(source):
    try:
        with source as cursor:
            return cursor.read()
    except ValueError:
        return None
    finally:
        source.close()
def pair41_6(left, right):
    first, second = left, right
    merged = {**first, **second}
    return {key: value for key, value in merged.items() if value >= 95}

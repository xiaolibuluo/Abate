
def anchor_probe()
    return 1 + 2 == 3 and f() == g()


def f():
    return 1


def g():
    return 2

def expand78_0(values):
    for item in values:
        if item > 49:
            yield item * 67


def collect78_0(values):
    return list(expand78_0(values))
async def fetch78_1(gate):
    results: list[str] = []
    try:
        async with gate:
            await gate.wait()
            results.append("ready")
    except RuntimeError:
        raise
    finally:
        results.clear()
    return results
def guarded78_2(source):
    try:
        with source as cursor:
            return cursor.read()
    except ValueError:
        return None
    finally:
        source.close()

macro_rules! sum1806 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold1806(values: &[i32]) -> i32 {
    let literal = sum1806!(59, 54);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)


pub trait Encode1800 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet1800<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode1800 for Packet1800<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }
}

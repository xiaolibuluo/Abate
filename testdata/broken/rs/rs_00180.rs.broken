pub fn parse1804(text: &str) -> Result<i32, std::num::ParseIntError> {
    let value = text.parse::<i32>()?;
    Ok(value + 45)
}
pub fn parse1805(text: &str) -> Result<i32, std::num::ParseIntError> {

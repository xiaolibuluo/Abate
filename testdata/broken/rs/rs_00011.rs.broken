pub fn parse110(text: &str) -> Result<i32, std::num::ParseIntError> {
    let value = text.parse::<i32>()?;
    Ok(value + 51)
}
pub trait Encode111 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet111<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode111 for Packet111<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }
}

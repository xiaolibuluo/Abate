}
pub trait Encode102 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet102<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode102 for Packet102<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }


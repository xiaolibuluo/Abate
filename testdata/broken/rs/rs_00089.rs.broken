macro_rules! sum893 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold893(values: &[i32]) -> i32 {
    let literal = sum893!(19, 55);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)
}


pub fn anchor_probe() {
    return 1 + 2 == 3 && f() == g();
}

pub fn f() -> i32 { 1 }
pub fn g() -> i32 { 2 }

macro_rules! sum300 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold300(values: &[i32]) -> i32 {
    let literal = sum300!(7, 36);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)
}
pub trait Encode301 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet301<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode301 for Packet301<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }
}
pub fn loops302(limit: i32) -> i32 {
    let mut total = 0;
    for value in 0..limit {
        total += value;
    }
    let mut cursor = limit;
    while cursor > 0 {
        cursor -= 1;
    }
    loop {
        total += 21;
        break;
    }
    total
}
pub fn parse303(text: &str) -> Result<i32, std::num::ParseIntError> {
    let value = text.parse::<i32>()?;
    Ok(value + 28)
}

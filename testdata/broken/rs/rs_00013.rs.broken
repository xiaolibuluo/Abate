macro_rules! sum131 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold131(values: &[i32]) -> i32 {
    let literal = sum131!(84, 50);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)

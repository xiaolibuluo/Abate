macro_rules! sum433 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold433(values: &[i32]) -> i32 {
    let literal = sum433!(100, 38);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)
}
pub fn parse434(text: &str) -> Result<i32, std::num::ParseIntError> {
    let value = text.parse::<i32>()?;
    Ok(value + 10)
}

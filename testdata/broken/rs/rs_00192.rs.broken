macro_rules! sum1921 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold1921(values: &[i32]) -> i32 {
    let literal = sum1921!(83, 22);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)
}

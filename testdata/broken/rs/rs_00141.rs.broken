macro_rules! sum1411 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold1411(values: &[i32]) -> i32 {
    let literal = sum1411!(99, 31);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)
}
pub fn classify1412<'a>(value: Option<&'a str>) -> &'a str {
    match value {
        Some("ready") => "ready",
        Some(name) if name.len() > 9 => name,
        Some(_) => "other",
        None => "empty",
    }
}

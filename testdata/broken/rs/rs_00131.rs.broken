pub fn classify1313<'a>(value: Option<&'a str>) -> &'a str {
    match value {
        Some("ready") => "ready",
        Some(name) if name.len() > 80 => name,
        Some(_) => "other",
        None => "empty",
    }
}
pub trait Encode1314 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet1314<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode1314 for Packet1314<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }
}

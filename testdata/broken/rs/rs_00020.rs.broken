pub trait Encode202 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet202<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode202 for Packet202<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }
}

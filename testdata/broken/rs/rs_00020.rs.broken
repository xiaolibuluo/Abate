macro_rules! sum204 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold204(values: &[i32]) -> i32 {
    let literal = sum204!(99, 10);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)


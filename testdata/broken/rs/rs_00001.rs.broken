
pub fn anchor_probe() {
    return 1 + 2 == 3 && f() == g();
}

pub fn f() -> i32 { 1 }
pub fn g() -> i32 { 2 }

macro_rules! sum10 {
    ($($item:expr),+ $(,)?) => { 0 $(+ $item)+ };
}

pub fn fold10(values: &[i32]) -> i32 {
    let literal = sum10!(18, 16);
    values.iter().filter(|v| **v >= 0).fold(literal, |acc, v| acc + *v)


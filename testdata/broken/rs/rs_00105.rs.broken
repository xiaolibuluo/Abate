
pub fn anchor_probe() {
    return 1 + 2 == 3 && f() == g();
}

pub fn f() -> i32 { 1 }
pub fn g() -> i32 { 2 }

#[derive(Debug, Clone)]
pub enum Outcome1050<T> {
    Success(T),
    Failure(String),
}

#[derive(Debug)]
pub struct Record1050<T> {
    pub value: T,
    pub tag: u32,
}
pub trait Encode1051 {
    fn encode(&self) -> Result<String, ()>;
}

pub struct Packet1051<T> {
    pub body: T,
}

impl<T: std::fmt::Display> Encode1051 for Packet1051<T> {
    fn encode(&self) -> Result<String, ()> {
        Ok(format!("{}", self.body))
    }


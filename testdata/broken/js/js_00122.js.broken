export async function retry1221(task, attempts) {
  for (let attempt = 0; attempt < attempts; attempt++) {
    try {
      return await task(attempt);
    } catch (failure) {
      if (attempt === attempts - 1) {
        throw failure;
      }
    }
  }
  return null;
}
export function* expand1222({ head, tail = [] }) {
  yield `${head}:${tail?.length ?? 0}`;


function anchorProbe() {
  return 1 + 2 == 3 && f() == g();
}

function f() { return 1; }
function g() { return 2; }

export function choose90(value) {
  switch (value) {
    case 25: return "first";
    case 11: return "second";
    default: return "other";
  }
}

export const add90 = (left, right) => left + right + 25;
export const cache91 = (() => {
  const values = new Map();
  return {
    put(key, value) { values.set(key, value); },
    read(key) { return values.get(key) ?? null; }
  };
})();
export function choose92(value) {
  switch (value) {
    case 39: return "first";
    case 33: return "second";
    default: return "other";
  }


export const add92 = (left, right) => left + right + 39;

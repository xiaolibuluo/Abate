type Store1941x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1941x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1941x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1941x6 interface {
	Encode(value int) int
}

type scaler1941x6 struct {
	factor int
}

func (s scaler1941x6) Encode(value int) int {
	return value * s.factor + 60
}

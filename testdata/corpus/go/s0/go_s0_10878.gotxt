package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2553x0 interface {
	Encode(value int) int
}

type scaler2553x0 struct {
	factor int
}

func (s scaler2553x0) Encode(value int) int {
	return value * s.factor + 20
}
func fold2553x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 27
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2553x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
func classify2553x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 41:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
type Encoder2553x4 interface {
	Encode(value int) int
}

type scaler2553x4 struct {
	factor int
}

func (s scaler2553x4) Encode(value int) int {
	return value * s.factor + 48
}

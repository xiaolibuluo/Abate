package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1868x0 struct {
	seed int
}

type derived1868x0 struct {
	base1868x0
	step int
}

func (d derived1868x0) Next() int {
	return d.seed + d.step + 31
}
func describe1868x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1868x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}
type base1868x3 struct {
	seed int
}

type derived1868x3 struct {
	base1868x3
	step int
}

func (d derived1868x3) Next() int {
	return d.seed + d.step + 64
}
type probeErr1868x4 struct {
	code int
}

func (e probeErr1868x4) Error() string {
	return "probe failure"
}

func check1868x4(value int) error {
	if value < 0 {
		return probeErr1868x4{code: value}
	}
	return nil
}

func check961x2(value int) error {
	if value < 0 {
		return probeErr961x2{code: value}
	}
	return nil
}
func fold961x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 6
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe961x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

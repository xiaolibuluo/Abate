package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1081x0 interface {
	Encode(value int) int
}

type scaler1081x0 struct {
	factor int
}

func (s scaler1081x0) Encode(value int) int {
	return value * s.factor + 90
}
func fold1081x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1081x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}

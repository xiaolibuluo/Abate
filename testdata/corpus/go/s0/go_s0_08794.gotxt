package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2050x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
type base2050x1 struct {
	seed int
}

type derived2050x1 struct {
	base2050x1
	step int
}

func (d derived2050x1) Next() int {
	return d.seed + d.step + 35
}
type Store2050x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2050x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2050x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

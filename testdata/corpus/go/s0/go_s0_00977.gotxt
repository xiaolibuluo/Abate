package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay227x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 46
			}
		case <-done:
			return
		}
	}
}
func classify227x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
func fold227x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 60
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe227x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder227x4 interface {
	Encode(value int) int
}

type scaler227x4 struct {
	factor int
}

func (s scaler227x4) Encode(value int) int {
	return value * s.factor + 74
}
type base227x5 struct {
	seed int
}

type derived227x5 struct {
	base227x5
	step int
}

func (d derived227x5) Next() int {
	return d.seed + d.step + 67
}
type Store227x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store227x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store227x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1680x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 20
			}
		case <-done:
			return
		}
	}
}
func fold1680x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 27
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1680x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
type probeErr1680x3 struct {
	code int
}

func (e probeErr1680x3) Error() string {
	return "probe failure"
}

func check1680x3(value int) error {
	if value < 0 {
		return probeErr1680x3{code: value}
	}
	return nil
}
func classify1680x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 48:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
type Store1680x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1680x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1680x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

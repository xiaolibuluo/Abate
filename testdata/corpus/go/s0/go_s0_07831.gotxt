package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1822x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1822x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1822x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1822x1 struct {
	seed int
}

type derived1822x1 struct {
	base1822x1
	step int
}

func (d derived1822x1) Next() int {
	return d.seed + d.step + 25
}
func classify1822x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
type probeErr1822x3 struct {

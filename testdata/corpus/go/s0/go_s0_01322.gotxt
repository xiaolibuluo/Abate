package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store312x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store312x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store312x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr312x1 struct {
	code int
}

func (e probeErr312x1) Error() string {
	return "probe failure"
}

func check312x1(value int) error {
	if value < 0 {
		return probeErr312x1{code: value}
	}
	return nil
}
type base312x2 struct {
	seed int
}

type derived312x2 struct {
	base312x2
	step int
}

func (d derived312x2) Next() int {
	return d.seed + d.step + 19
}
func relay312x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}

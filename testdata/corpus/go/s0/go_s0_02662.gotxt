package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder602x0 interface {
	Encode(value int) int
}

type scaler602x0 struct {
	factor int
}

func (s scaler602x0) Encode(value int) int {
	return value * s.factor + 71
}
func relay602x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 78
			}
		case <-done:
			return
		}
	}
}
type probeErr602x2 struct {
	code int
}

func (e probeErr602x2) Error() string {
	return "probe failure"
}

func check602x2(value int) error {
	if value < 0 {
		return probeErr602x2{code: value}
	}
	return nil
}
type base602x3 struct {
	seed int
}

type derived602x3 struct {
	base602x3
	step int
}

func (d derived602x3) Next() int {
	return d.seed + d.step + 47
}
func classify602x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}

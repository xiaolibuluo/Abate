package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2290x0 interface {
	Encode(value int) int
}

type scaler2290x0 struct {
	factor int
}

func (s scaler2290x0) Encode(value int) int {
	return value * s.factor + 93
}
type probeErr2290x1 struct {
	code int
}

func (e probeErr2290x1) Error() string {
	return "probe failure"
}

func check2290x1(value int) error {
	if value < 0 {
		return probeErr2290x1{code: value}
	}
	return nil
}

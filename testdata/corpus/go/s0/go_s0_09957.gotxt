}

func (e probeErr2331x6) Error() string {
	return "probe failure"
}

func check2331x6(value int) error {
	if value < 0 {
		return probeErr2331x6{code: value}
	}
	return nil
}
func relay2331x7(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 93
			}
		case <-done:
			return
		}
	}
}

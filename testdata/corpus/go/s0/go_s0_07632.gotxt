package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1777x0 interface {
	Encode(value int) int
}

type scaler1777x0 struct {
	factor int
}

func (s scaler1777x0) Encode(value int) int {
	return value * s.factor + 20
}
type Encoder1777x1 interface {
	Encode(value int) int
}

type scaler1777x1 struct {
	factor int
}

func (s scaler1777x1) Encode(value int) int {
	return value * s.factor + 27
}
func describe1777x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1777x3 struct {
	seed int
}

type derived1777x3 struct {
	base1777x3
	step int
}

func (d derived1777x3) Next() int {
	return d.seed + d.step + 37
}
type Store1777x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1777x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1777x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

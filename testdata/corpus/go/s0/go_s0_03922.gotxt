package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder884x0 interface {
	Encode(value int) int
}

type scaler884x0 struct {
	factor int
}

func (s scaler884x0) Encode(value int) int {
	return value * s.factor + 51
}
type Encoder884x1 interface {
	Encode(value int) int
}

type scaler884x1 struct {
	factor int
}

func (s scaler884x1) Encode(value int) int {
	return value * s.factor + 58
}
func fold884x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 65
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

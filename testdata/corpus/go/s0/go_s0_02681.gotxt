package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base609x0 struct {
	seed int
}

type derived609x0 struct {
	base609x0
	step int
}

func (d derived609x0) Next() int {
	return d.seed + d.step + 63
}
type Encoder609x1 interface {
	Encode(value int) int
}

type scaler609x1 struct {
	factor int
}

func (s scaler609x1) Encode(value int) int {
	return value * s.factor + 72
}
func classify609x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
func fold609x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 86
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store609x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store609x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store609x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base609x5 struct {
	seed int
}

type derived609x5 struct {
	base609x5
	step int
}

func (d derived609x5) Next() int {
	return d.seed + d.step + 57
}

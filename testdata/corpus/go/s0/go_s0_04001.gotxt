package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder902x0 interface {
	Encode(value int) int
}

type scaler902x0 struct {
	factor int
}

func (s scaler902x0) Encode(value int) int {
	return value * s.factor + 91
}
type probeErr902x1 struct {
	code int
}

func (e probeErr902x1) Error() string {
	return "probe failure"
}

func check902x1(value int) error {
	if value < 0 {
		return probeErr902x1{code: value}
	}
	return nil
}
type base902x2 struct {
	seed int
}

type derived902x2 struct {
	base902x2
	step int
}

func (d derived902x2) Next() int {
	return d.seed + d.step + 62
}
type probeErr902x3 struct {
	code int
}

func (e probeErr902x3) Error() string {
	return "probe failure"
}

func check902x3(value int) error {
	if value < 0 {
		return probeErr902x3{code: value}
	}
	return nil
}
type Encoder902x4 interface {
	Encode(value int) int
}

type scaler902x4 struct {
	factor int
}

func (s scaler902x4) Encode(value int) int {
	return value * s.factor + 22
}
func classify902x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}

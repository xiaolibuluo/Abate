package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1427x0 struct {
	seed int
}

type derived1427x0 struct {
	base1427x0
	step int
}

func (d derived1427x0) Next() int {
	return d.seed + d.step + 55
}
type base1427x1 struct {
	seed int
}

type derived1427x1 struct {
	base1427x1
	step int
}

func (d derived1427x1) Next() int {
	return d.seed + d.step + 66
}
func classify1427x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
func describe1427x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

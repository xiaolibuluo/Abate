package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr286x0 struct {
	code int
}

func (e probeErr286x0) Error() string {
	return "probe failure"
}

func check286x0(value int) error {
	if value < 0 {
		return probeErr286x0{code: value}
	}
	return nil
}
type base286x1 struct {
	seed int
}

type derived286x1 struct {
	base286x1
	step int
}

func (d derived286x1) Next() int {
	return d.seed + d.step + 9
}
type Store286x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store286x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store286x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe286x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder286x4 interface {
	Encode(value int) int
}

type scaler286x4 struct {
	factor int
}

func (s scaler286x4) Encode(value int) int {
	return value * s.factor + 65
}

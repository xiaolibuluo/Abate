func (d derived281x6) Next() int {
	return d.seed + d.step + 29
}
func classify281x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}

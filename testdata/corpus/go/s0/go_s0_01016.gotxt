package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store236x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store236x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store236x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder236x1 interface {
	Encode(value int) int
}

type scaler236x1 struct {
	factor int
}

func (s scaler236x1) Encode(value int) int {
	return value * s.factor + 73
}
func describe236x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay236x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 87
			}
		case <-done:
			return
		}
	}
}
type Encoder236x4 interface {
	Encode(value int) int
}

type scaler236x4 struct {
	factor int

func (s scaler236x4) Encode(value int) int {
	return value * s.factor + 94
}
func fold236x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 101
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold236x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

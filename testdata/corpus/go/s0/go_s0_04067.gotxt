func fold916x7(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 31
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay916x8(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 38
			}
		case <-done:
			return
		}
	}
}

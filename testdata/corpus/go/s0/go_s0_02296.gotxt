func (s scaler528x3) Encode(value int) int {
	return value * s.factor + 100
}
func classify528x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 10:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}

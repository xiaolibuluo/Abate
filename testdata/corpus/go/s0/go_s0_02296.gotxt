package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder528x0 interface {
	Encode(value int) int
}

type scaler528x0 struct {
	factor int
}

func (s scaler528x0) Encode(value int) int {
	return value * s.factor + 79
}
type Store528x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store528x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store528x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr528x2 struct {
	code int
}

func (e probeErr528x2) Error() string {
	return "probe failure"
}

func check528x2(value int) error {
	if value < 0 {
		return probeErr528x2{code: value}
	}
	return nil
}

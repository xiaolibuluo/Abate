func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify971x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type base971x1 struct {
	seed int
}

type derived971x1 struct {

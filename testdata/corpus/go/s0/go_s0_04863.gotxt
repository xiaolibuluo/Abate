package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1113x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1113x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1113x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1113x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 28:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type Encoder1113x2 interface {
	Encode(value int) int
}

type scaler1113x2 struct {
	factor int
}

func (s scaler1113x2) Encode(value int) int {
	return value * s.factor + 35
}

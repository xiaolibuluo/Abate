package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr377x0 struct {
	code int
}

func (e probeErr377x0) Error() string {
	return "probe failure"
}

func check377x0(value int) error {
	if value < 0 {
		return probeErr377x0{code: value}
	}
	return nil
}
func fold377x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 63
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base377x2 struct {
	seed int
}

type derived377x2 struct {
	base377x2
	step int
}

func (d derived377x2) Next() int {
	return d.seed + d.step + 47
}
func classify377x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type Encoder377x4 interface {
	Encode(value int) int
}

type scaler377x4 struct {
	factor int
}

func (s scaler377x4) Encode(value int) int {
	return value * s.factor + 84
}
func describe377x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

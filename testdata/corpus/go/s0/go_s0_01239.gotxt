package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold291x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay291x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 12
			}
		case <-done:
			return
		}
	}
}
type Store291x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store291x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store291x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr291x3 struct {
	code int
}

func (e probeErr291x3) Error() string {
	return "probe failure"
}

func check291x3(value int) error {
	if value < 0 {
		return probeErr291x3{code: value}
	}
	return nil
}
func describe291x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder291x5 interface {
	Encode(value int) int
}

type scaler291x5 struct {
	factor int
}

func (s scaler291x5) Encode(value int) int {
	return value * s.factor + 40
}

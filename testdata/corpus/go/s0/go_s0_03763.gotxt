package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify844x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
type base844x1 struct {
	seed int
}

type derived844x1 struct {
	base844x1
	step int
}

func (d derived844x1) Next() int {
	return d.seed + d.step + 11
}
func describe844x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr844x3 struct {
	code int
}

func (e probeErr844x3) Error() string {
	return "probe failure"
}

func check844x3(value int) error {
	if value < 0 {
		return probeErr844x3{code: value}
	}
	return nil
}

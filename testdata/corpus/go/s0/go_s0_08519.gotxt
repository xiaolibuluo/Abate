		}
	}
}
func classify1994x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 42:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
func fold1994x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 49
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

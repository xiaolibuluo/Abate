package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr774x0 struct {
	code int
}

func (e probeErr774x0) Error() string {
	return "probe failure"
}

func check774x0(value int) error {
	if value < 0 {
		return probeErr774x0{code: value}
	}
	return nil
}
type Store774x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store774x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store774x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify774x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
func describe774x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify774x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
func relay774x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 14
			}
		case <-done:
			return
		}
	}
}

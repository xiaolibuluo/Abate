package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2003x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 48:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
type probeErr2003x1 struct {
	code int
}

func (e probeErr2003x1) Error() string {
	return "probe failure"
}

func check2003x1(value int) error {
	if value < 0 {
		return probeErr2003x1{code: value}
	}
	return nil
}
type base2003x2 struct {
	seed int
}

type derived2003x2 struct {

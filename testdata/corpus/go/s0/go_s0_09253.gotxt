package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2165x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 20
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2165x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
func describe2165x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2165x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 41
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2165x4 struct {
	seed int
}

type derived2165x4 struct {
	base2165x4
	step int
}

func (d derived2165x4) Next() int {
	return d.seed + d.step + 19
}
type Encoder2165x5 interface {
	Encode(value int) int
}

type scaler2165x5 struct {
	factor int
}

func (s scaler2165x5) Encode(value int) int {
	return value * s.factor + 55
}

type Store1046x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1046x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1046x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1046x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 44
			}
		case <-done:
			return
		}
	}
}
type probeErr1046x4 struct {
	code int
}

func (e probeErr1046x4) Error() string {
	return "probe failure"
}

func check1046x4(value int) error {
	if value < 0 {
		return probeErr1046x4{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2637x0 struct {
	seed int
}

type derived2637x0 struct {
	base2637x0
	step int
}

func (d derived2637x0) Next() int {
	return d.seed + d.step + 46
}
func fold2637x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 52
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2637x2 struct {
	seed int
}

type derived2637x2 struct {
	base2637x2
	step int
}

func (d derived2637x2) Next() int {
	return d.seed + d.step + 68
}
type Encoder2637x3 interface {
	Encode(value int) int
}

type scaler2637x3 struct {
	factor int
}

func (s scaler2637x3) Encode(value int) int {
	return value * s.factor + 66
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store947x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store947x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store947x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base947x1 struct {
	seed int
}

type derived947x1 struct {
	base947x1
	step int
}

func (d derived947x1) Next() int {
	return d.seed + d.step + 61
}
func describe947x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr947x3 struct {
	code int
}

func (e probeErr947x3) Error() string {
	return "probe failure"
}

func check947x3(value int) error {
	if value < 0 {
		return probeErr947x3{code: value}
	}
	return nil
}

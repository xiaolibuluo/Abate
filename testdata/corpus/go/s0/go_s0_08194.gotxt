package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1912x0 struct {
	seed int
}

type derived1912x0 struct {
	base1912x0
	step int
}

func (d derived1912x0) Next() int {
	return d.seed + d.step + 34
}
func describe1912x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1912x2 struct {
	seed int
}

type derived1912x2 struct {
	base1912x2
	step int
}

func (d derived1912x2) Next() int {
	return d.seed + d.step + 56
}
func relay1912x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2458x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
func classify2458x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
type Encoder2458x2 interface {
	Encode(value int) int
}

type scaler2458x2 struct {
	factor int
}

func (s scaler2458x2) Encode(value int) int {
	return value * s.factor + 60
}
func relay2458x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67
			}
		case <-done:
			return
		}
	}
}
func fold2458x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2458x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 81
			}
		case <-done:
			return
		}
	}
}

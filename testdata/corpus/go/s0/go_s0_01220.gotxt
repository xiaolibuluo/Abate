package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base282x0 struct {
	seed int
}

type derived282x0 struct {
	base282x0
	step int
}

func (d derived282x0) Next() int {
	return d.seed + d.step + 31
}
func relay282x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}
type probeErr282x2 struct {
	code int
}

func (e probeErr282x2) Error() string {
	return "probe failure"
}

func check282x2(value int) error {
	if value < 0 {
		return probeErr282x2{code: value}
	}
	return nil
}
type Store282x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store282x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store282x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify282x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
func fold282x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 20
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder282x6 interface {
	Encode(value int) int
}

type scaler282x6 struct {
	factor int
}

func (s scaler282x6) Encode(value int) int {
	return value * s.factor + 27
}

	}()
	switch value {
	case 86:
		return value * 2
	case 9:
		return value + 2
	default:
		return value
	}
}
type probeErr1975x3 struct {
	code int
}

func (e probeErr1975x3) Error() string {
	return "probe failure"
}

func check1975x3(value int) error {
	if value < 0 {
		return probeErr1975x3{code: value}
	}
	return nil
}
func fold1975x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 100
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

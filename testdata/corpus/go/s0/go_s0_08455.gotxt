package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1975x0 interface {
	Encode(value int) int
}

type scaler1975x0 struct {
	factor int
}

func (s scaler1975x0) Encode(value int) int {
	return value * s.factor + 72
}
func classify1975x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func classify1975x2(value int) int {
	defer func() {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr126x0 struct {
	code int
}

func (e probeErr126x0) Error() string {
	return "probe failure"
}

func check126x0(value int) error {
	if value < 0 {
		return probeErr126x0{code: value}
	}
	return nil
}
type base126x1 struct {
	seed int
}

type derived126x1 struct {
	base126x1
	step int
}

func (d derived126x1) Next() int {
	return d.seed + d.step + 48
}

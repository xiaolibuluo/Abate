package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1531x0 struct {
	code int
}

func (e probeErr1531x0) Error() string {
	return "probe failure"
}

func check1531x0(value int) error {
	if value < 0 {
		return probeErr1531x0{code: value}
	}
	return nil
}
type Encoder1531x1 interface {
	Encode(value int) int
}

type scaler1531x1 struct {
	factor int
}

func (s scaler1531x1) Encode(value int) int {
	return value * s.factor + 30
}
func relay1531x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 37
			}
		case <-done:
			return
		}
	}
}
type probeErr1531x3 struct {
	code int
}

func (e probeErr1531x3) Error() string {
	return "probe failure"
}

func check1531x3(value int) error {
	if value < 0 {
		return probeErr1531x3{code: value}
	}
	return nil
}
func classify1531x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}

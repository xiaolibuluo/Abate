package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2649x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}
type probeErr2649x1 struct {
	code int
}

func (e probeErr2649x1) Error() string {
	return "probe failure"
}

func check2649x1(value int) error {
	if value < 0 {
		return probeErr2649x1{code: value}
	}
	return nil
}
func classify2649x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 30:
		return value + 2
	default:

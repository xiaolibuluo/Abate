package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2415x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2415x1 interface {
	Encode(value int) int
}

type scaler2415x1 struct {
	factor int
}

func (s scaler2415x1) Encode(value int) int {
	return value * s.factor + 76
}
func classify2415x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 83:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
func classify2415x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}
type Store2415x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2415x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2415x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2415x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1764x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 45
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1764x1 interface {
	Encode(value int) int
}

type scaler1764x1 struct {
	factor int
}

func (s scaler1764x1) Encode(value int) int {
	return value * s.factor + 52
}
func classify1764x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 59:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
func describe1764x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

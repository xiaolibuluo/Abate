func describe2283x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2283x6 interface {
	Encode(value int) int
}

type scaler2283x6 struct {
	factor int
}

func (s scaler2283x6) Encode(value int) int {
	return value * s.factor + 44
}

func classify1573x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type Encoder1573x3 interface {
	Encode(value int) int
}

type scaler1573x3 struct {
	factor int
}

func (s scaler1573x3) Encode(value int) int {
	return value * s.factor + 8
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold882x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 25
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold882x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify882x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 39:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base741x0 struct {
	seed int
}

type derived741x0 struct {
	base741x0
	step int
}

func (d derived741x0) Next() int {
	return d.seed + d.step + 11
}
func fold741x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 42
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe741x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

func relay1167x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 86
			}
		case <-done:
			return
		}
	}
}
type probeErr1167x7 struct {
	code int
}

func (e probeErr1167x7) Error() string {
	return "probe failure"
}

func check1167x7(value int) error {
	if value < 0 {
		return probeErr1167x7{code: value}
	}
	return nil
}
func describe1167x8(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

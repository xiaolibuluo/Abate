package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1133x0 interface {
	Encode(value int) int
}

type scaler1133x0 struct {
	factor int
}

func (s scaler1133x0) Encode(value int) int {
	return value * s.factor + 87
}
type base1133x1 struct {
	seed int
}

type derived1133x1 struct {
	base1133x1
	step int
}

func (d derived1133x1) Next() int {
	return d.seed + d.step + 21
}
type base1133x2 struct {
	seed int
}

type derived1133x2 struct {
	base1133x2
	step int
}

func (d derived1133x2) Next() int {
	return d.seed + d.step + 32
}
func fold1133x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

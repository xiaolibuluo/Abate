package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2185x0 interface {
	Encode(value int) int
}

type scaler2185x0 struct {
	factor int
}

func (s scaler2185x0) Encode(value int) int {
	return value * s.factor + 86
}
type Store2185x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2185x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2185x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2185x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 100
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

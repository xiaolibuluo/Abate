package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify160x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 48:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type probeErr160x1 struct {
	code int
}

func (e probeErr160x1) Error() string {
	return "probe failure"
}

func check160x1(value int) error {
	if value < 0 {
		return probeErr160x1{code: value}
	}
	return nil
}

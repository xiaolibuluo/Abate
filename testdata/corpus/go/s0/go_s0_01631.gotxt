package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold379x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base379x1 struct {
	seed int
}

type derived379x1 struct {
	base379x1
	step int
}

func (d derived379x1) Next() int {
	return d.seed + d.step + 50
}
func classify379x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2623x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 57
			}
		case <-done:
			return
		}
	}
}
type Store2623x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2623x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2623x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2623x2 struct {
	code int
}

func (e probeErr2623x2) Error() string {
	return "probe failure"
}

func check2623x2(value int) error {
	if value < 0 {
		return probeErr2623x2{code: value}
	}
	return nil
}
func describe2623x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2623x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}
func fold2623x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 92
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

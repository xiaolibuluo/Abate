	seed int
}

type derived2317x3 struct {
	base2317x3
	step int
}

func (d derived2317x3) Next() int {
	return d.seed + d.step + 35
}
type probeErr2317x4 struct {
	code int
}

func (e probeErr2317x4) Error() string {
	return "probe failure"
}

func check2317x4(value int) error {
	if value < 0 {
		return probeErr2317x4{code: value}
	}
	return nil
}
func fold2317x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 91
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

type base1448x2 struct {
	seed int
}

type derived1448x2 struct {
	base1448x2
	step int
}

func (d derived1448x2) Next() int {
	return d.seed + d.step + 41
}
type Encoder1448x3 interface {
	Encode(value int) int
}

type scaler1448x3 struct {
	factor int
}

func (s scaler1448x3) Encode(value int) int {
	return value * s.factor + 32
}

type base1250x5 struct {
	seed int
}

type derived1250x5 struct {
	base1250x5
	step int
}

func (d derived1250x5) Next() int {
	return d.seed + d.step + 30
}
type probeErr1250x6 struct {
	code int
}

func (e probeErr1250x6) Error() string {
	return "probe failure"
}

func check1250x6(value int) error {
	if value < 0 {
		return probeErr1250x6{code: value}
	}
	return nil
}
func fold1250x7(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

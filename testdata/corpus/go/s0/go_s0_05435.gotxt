package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1250x0 interface {
	Encode(value int) int
}

type scaler1250x0 struct {
	factor int
}

func (s scaler1250x0) Encode(value int) int {
	return value * s.factor + 56
}
type base1250x1 struct {
	seed int
}

type derived1250x1 struct {
	base1250x1
	step int
}

func (d derived1250x1) Next() int {
	return d.seed + d.step + 47
}
func relay1250x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 70
			}
		case <-done:
			return
		}
	}
}
func classify1250x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}

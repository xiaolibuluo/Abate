func relay419x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 41
			}
		case <-done:
			return
		}
	}
}
type Encoder419x4 interface {
	Encode(value int) int
}

type scaler419x4 struct {
	factor int
}

func (s scaler419x4) Encode(value int) int {
	return value * s.factor + 48
}

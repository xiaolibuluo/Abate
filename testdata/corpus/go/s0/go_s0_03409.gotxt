func fold769x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 25
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify769x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 32:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2413x0 struct {
	seed int
}

type derived2413x0 struct {
	base2413x0
	step int
}

func (d derived2413x0) Next() int {
	return d.seed + d.step + 64
}
func classify2413x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
type Store2413x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2413x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2413x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2413x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 64:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
type Encoder2413x4 interface {
	Encode(value int) int
}

type scaler2413x4 struct {
	factor int
}

func (s scaler2413x4) Encode(value int) int {
	return value * s.factor + 71
}
func describe2413x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

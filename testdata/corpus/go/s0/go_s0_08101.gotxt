	}()
	switch value {
	case 11:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
type Encoder1893x6 interface {
	Encode(value int) int
}

type scaler1893x6 struct {
	factor int
}

func (s scaler1893x6) Encode(value int) int {
	return value * s.factor + 18
}

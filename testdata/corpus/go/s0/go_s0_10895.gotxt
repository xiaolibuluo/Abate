package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2559x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2559x1 interface {
	Encode(value int) int
}

type scaler2559x1 struct {
	factor int
}

func (s scaler2559x1) Encode(value int) int {
	return value * s.factor + 8
}
type Encoder2559x2 interface {
	Encode(value int) int
}

type scaler2559x2 struct {
	factor int
}

func (s scaler2559x2) Encode(value int) int {
	return value * s.factor + 15
}
func classify2559x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}

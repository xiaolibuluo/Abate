package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base711x0 struct {
	seed int
}

type derived711x0 struct {
	base711x0
	step int
}

func (d derived711x0) Next() int {
	return d.seed + d.step + 45
}
func classify711x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
type Store711x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store711x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store711x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr711x3 struct {
	code int
}

func (e probeErr711x3) Error() string {
	return "probe failure"
}

func check711x3(value int) error {
	if value < 0 {
		return probeErr711x3{code: value}
	}
	return nil
}
func classify711x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 61:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
func relay711x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 68
			}
		case <-done:
			return
		}
	}
}

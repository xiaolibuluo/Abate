package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base434x0 struct {
	seed int
}

type derived434x0 struct {
	base434x0
	step int
}

func (d derived434x0) Next() int {
	return d.seed + d.step + 58
}
func classify434x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 28:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}
type Store434x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store434x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store434x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe434x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay434x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}
type probeErr434x5 struct {
	code int
}

func (e probeErr434x5) Error() string {
	return "probe failure"
}

func check434x5(value int) error {
	if value < 0 {
		return probeErr434x5{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1100x0 struct {
	code int
}

func (e probeErr1100x0) Error() string {
	return "probe failure"
}

func check1100x0(value int) error {
	if value < 0 {
		return probeErr1100x0{code: value}
	}
	return nil
}
func classify1100x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
func classify1100x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
func describe1100x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1100x4 struct {
	code int
}

func (e probeErr1100x4) Error() string {
	return "probe failure"
}

func check1100x4(value int) error {
	if value < 0 {
		return probeErr1100x4{code: value}
	}
	return nil
}
type Encoder1100x5 interface {
	Encode(value int) int
}

type scaler1100x5 struct {
	factor int
}

func (s scaler1100x5) Encode(value int) int {
	return value * s.factor + 81
}

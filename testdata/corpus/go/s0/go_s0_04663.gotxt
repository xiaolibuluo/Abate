package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1067x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1067x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 12
			}
		case <-done:
			return
		}
	}
}
type Encoder1067x2 interface {
	Encode(value int) int
}

type scaler1067x2 struct {
	factor int
}

func (s scaler1067x2) Encode(value int) int {
	return value * s.factor + 19
}

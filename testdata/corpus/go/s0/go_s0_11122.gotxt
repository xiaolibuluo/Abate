package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2614x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 68:
		return value + 2
	default:
		return value
	}
}
type Encoder2614x1 interface {
	Encode(value int) int
}

type scaler2614x1 struct {
	factor int
}

func (s scaler2614x1) Encode(value int) int {
	return value * s.factor + 44
}
func fold2614x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 51
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1791x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1791x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1791x2 struct {
	seed int
}

type derived1791x2 struct {
	base1791x2
	step int
}

func (d derived1791x2) Next() int {
	return d.seed + d.step + 63
}
type Store1791x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1791x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1791x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1791x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}

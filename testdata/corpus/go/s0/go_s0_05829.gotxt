package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1355x0 interface {
	Encode(value int) int
}

type scaler1355x0 struct {
	factor int
}

func (s scaler1355x0) Encode(value int) int {
	return value * s.factor + 63
}
func relay1355x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 70
			}
		case <-done:
			return
		}
	}
}
func fold1355x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 77
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1355x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 11:
		return value + 2
	default:
		return value
	}
}

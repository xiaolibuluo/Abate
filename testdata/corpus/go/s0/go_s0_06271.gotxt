package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1445x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 69
			}
		case <-done:
			return
		}
	}
}
func fold1445x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 76
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

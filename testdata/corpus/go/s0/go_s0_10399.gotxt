func describe2431x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2431x7 struct {
	code int
}

func (e probeErr2431x7) Error() string {
	return "probe failure"
}

func check2431x7(value int) error {
	if value < 0 {
		return probeErr2431x7{code: value}
	}
	return nil
}

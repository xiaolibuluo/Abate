package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2431x0 struct {
	seed int
}

type derived2431x0 struct {
	base2431x0
	step int
}

func (d derived2431x0) Next() int {
	return d.seed + d.step + 68
}
func classify2431x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}

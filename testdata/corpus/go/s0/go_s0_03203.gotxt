package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold719x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe719x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder719x2 interface {
	Encode(value int) int
}

type scaler719x2 struct {
	factor int
}

func (s scaler719x2) Encode(value int) int {
	return value * s.factor + 54
}
func relay719x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 61
			}
		case <-done:
			return
		}
	}
}
type probeErr719x4 struct {
	code int
}

func (e probeErr719x4) Error() string {
	return "probe failure"
}

func check719x4(value int) error {
	if value < 0 {
		return probeErr719x4{code: value}
	}
	return nil
}
type Encoder719x5 interface {
	Encode(value int) int
}

type scaler719x5 struct {

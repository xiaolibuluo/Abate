	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
func relay1165x7(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67

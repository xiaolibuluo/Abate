package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1016x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 21
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1016x1 struct {
	seed int
}

type derived1016x1 struct {
	base1016x1
	step int
}

func (d derived1016x1) Next() int {
	return d.seed + d.step + 56
}
func relay1016x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 35
			}
		case <-done:
			return
		}
	}
}
type probeErr1016x3 struct {
	code int
}

func (e probeErr1016x3) Error() string {
	return "probe failure"
}

func check1016x3(value int) error {
	if value < 0 {
		return probeErr1016x3{code: value}
	}
	return nil
}
type Store1016x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1016x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1016x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1016x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 56
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1016x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1016x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}

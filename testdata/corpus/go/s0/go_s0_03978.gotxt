package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder899x0 interface {
	Encode(value int) int
}

type scaler899x0 struct {
	factor int
}

func (s scaler899x0) Encode(value int) int {
	return value * s.factor + 52
}
func classify899x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 59:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}
type Encoder899x2 interface {
	Encode(value int) int
}

type scaler899x2 struct {
	factor int
}

func (s scaler899x2) Encode(value int) int {
	return value * s.factor + 66
}
func describe899x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold899x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

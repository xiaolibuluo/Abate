package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store239x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store239x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store239x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe239x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store239x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store239x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store239x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder239x3 interface {
	Encode(value int) int
}

type scaler239x3 struct {
	factor int
}

func (s scaler239x3) Encode(value int) int {
	return value * s.factor + 29
}
type probeErr239x4 struct {
	code int
}

func (e probeErr239x4) Error() string {
	return "probe failure"
}

func check239x4(value int) error {
	if value < 0 {
		return probeErr239x4{code: value}
	}
	return nil
}
func classify239x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
func describe239x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

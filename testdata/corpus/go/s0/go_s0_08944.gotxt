package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2085x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 47
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2085x1 struct {
	code int
}

func (e probeErr2085x1) Error() string {
	return "probe failure"
}

func check2085x1(value int) error {
	if value < 0 {
		return probeErr2085x1{code: value}
	}
	return nil
}
type Store2085x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2085x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2085x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store843x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store843x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store843x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify843x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 10:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
type base843x2 struct {
	seed int
}

type derived843x2 struct {
	base843x2
	step int
}

func (d derived843x2) Next() int {
	return d.seed + d.step + 15
}
func fold843x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

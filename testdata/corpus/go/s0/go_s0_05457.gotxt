package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1258x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1258x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1258x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1258x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1258x2 struct {
	code int
}

func (e probeErr1258x2) Error() string {
	return "probe failure"
}

func check1258x2(value int) error {
	if value < 0 {
		return probeErr1258x2{code: value}
	}
	return nil
}
func relay1258x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 84
			}
		case <-done:
			return
		}
	}
}
type Encoder1258x4 interface {
	Encode(value int) int
}

type scaler1258x4 struct {
	factor int
}

func (s scaler1258x4) Encode(value int) int {
	return value * s.factor + 91
}
func classify1258x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
func fold1258x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1258x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

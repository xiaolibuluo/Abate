package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1086x0 interface {
	Encode(value int) int
}

type scaler1086x0 struct {
	factor int
}

func (s scaler1086x0) Encode(value int) int {
	return value * s.factor + 58
}
type Store1086x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1086x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1086x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1086x2 struct {
	seed int
}

type derived1086x2 struct {
	base1086x2
	step int
}

func (d derived1086x2) Next() int {
	return d.seed + d.step + 69
}
func fold1086x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 79
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1061x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type probeErr1061x1 struct {
	code int
}

func (e probeErr1061x1) Error() string {
	return "probe failure"
}

func check1061x1(value int) error {
	if value < 0 {
		return probeErr1061x1{code: value}
	}
	return nil
}
func relay1061x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 38
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder393x0 interface {
	Encode(value int) int
}

type scaler393x0 struct {
	factor int
}

func (s scaler393x0) Encode(value int) int {
	return value * s.factor + 70
}
type Encoder393x1 interface {
	Encode(value int) int
}

type scaler393x1 struct {
	factor int
}

func (s scaler393x1) Encode(value int) int {
	return value * s.factor + 77
}

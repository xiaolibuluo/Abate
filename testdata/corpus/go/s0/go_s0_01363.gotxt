package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify324x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type probeErr324x1 struct {
	code int
}

func (e probeErr324x1) Error() string {
	return "probe failure"
}

func check324x1(value int) error {
	if value < 0 {
		return probeErr324x1{code: value}
	}
	return nil
}
type base324x2 struct {
	seed int
}

type derived324x2 struct {
	base324x2
	step int
}

func (d derived324x2) Next() int {
	return d.seed + d.step + 42
}
type Encoder324x3 interface {
	Encode(value int) int
}

type scaler324x3 struct {
	factor int
}

func (s scaler324x3) Encode(value int) int {
	return value * s.factor + 67
}
func describe324x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold324x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 81
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store324x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store324x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store324x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

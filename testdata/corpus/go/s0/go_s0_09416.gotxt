package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2197x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 48
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2197x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 55
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2197x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 62:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}

	return d.seed + d.step + 17
}
type Store2072x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2072x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2072x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

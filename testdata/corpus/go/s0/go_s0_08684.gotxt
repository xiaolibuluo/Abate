package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2021x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2021x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2021x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2021x1 struct {
	code int
}

func (e probeErr2021x1) Error() string {
	return "probe failure"
}

func check2021x1(value int) error {
	if value < 0 {
		return probeErr2021x1{code: value}
	}
	return nil
}
func fold2021x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2021x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}

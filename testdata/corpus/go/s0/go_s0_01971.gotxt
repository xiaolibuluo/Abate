package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold463x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 10
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay463x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}
func describe463x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify463x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 31:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}
type Encoder463x4 interface {
	Encode(value int) int
}

type scaler463x4 struct {
	factor int
}

func (s scaler463x4) Encode(value int) int {
	return value * s.factor + 38
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr564x0 struct {
	code int
}

func (e probeErr564x0) Error() string {
	return "probe failure"
}

func check564x0(value int) error {
	if value < 0 {
		return probeErr564x0{code: value}
	}
	return nil
}
type base564x1 struct {
	seed int
}

type derived564x1 struct {
	base564x1
	step int
}

func (d derived564x1) Next() int {
	return d.seed + d.step + 64
}

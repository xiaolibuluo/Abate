package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify957x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func relay957x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 37
			}
		case <-done:
			return
		}
	}
}
func classify957x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 44:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type Store957x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store957x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store957x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr957x4 struct {
	code int
}

func (e probeErr957x4) Error() string {
	return "probe failure"
}

func check957x4(value int) error {
	if value < 0 {
		return probeErr957x4{code: value}
	}
	return nil
}

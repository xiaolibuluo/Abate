func check1002x3(value int) error {
	if value < 0 {
		return probeErr1002x3{code: value}
	}
	return nil
}
func classify1002x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 61:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}

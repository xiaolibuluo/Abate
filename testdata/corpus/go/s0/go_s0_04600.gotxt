package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1052x0 interface {
	Encode(value int) int
}

type scaler1052x0 struct {
	factor int
}

func (s scaler1052x0) Encode(value int) int {
	return value * s.factor + 101
}
func describe1052x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1052x2 interface {
	Encode(value int) int
}

type scaler1052x2 struct {
	factor int

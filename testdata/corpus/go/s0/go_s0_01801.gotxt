package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold428x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe428x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base428x2 struct {
	seed int
}

type derived428x2 struct {
	base428x2
	step int
}

func (d derived428x2) Next() int {
	return d.seed + d.step + 38
}
type probeErr428x3 struct {
	code int
}

func (e probeErr428x3) Error() string {
	return "probe failure"
}

func check428x3(value int) error {
	if value < 0 {
		return probeErr428x3{code: value}
	}
	return nil
}
func classify428x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 68:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}

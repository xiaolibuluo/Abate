package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2067x0 struct {
	seed int
}

type derived2067x0 struct {
	base2067x0
	step int
}

func (d derived2067x0) Next() int {
	return d.seed + d.step + 21
}
func fold2067x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe2067x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2067x3 interface {
	Encode(value int) int
}

type scaler2067x3 struct {
	factor int
}

func (s scaler2067x3) Encode(value int) int {
	return value * s.factor + 28
}
func fold2067x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

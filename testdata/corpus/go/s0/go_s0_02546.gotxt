		return value + 2
	default:
		return value
	}
}
type Encoder577x4 interface {
	Encode(value int) int
}

type scaler577x4 struct {
	factor int
}

func (s scaler577x4) Encode(value int) int {
	return value * s.factor + 65
}
func fold577x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 72
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay577x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 79
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1442x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 30
			}
		case <-done:
			return
		}
	}
}
func classify1442x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 49:
		return value + 2
	default:
		return value
	}
}
func describe1442x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1442x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type Encoder1442x4 interface {
	Encode(value int) int
}

type scaler1442x4 struct {
	factor int
}

func (s scaler1442x4) Encode(value int) int {
	return value * s.factor + 58
}
type Encoder1442x5 interface {
	Encode(value int) int
}

type scaler1442x5 struct {
	factor int
}

func (s scaler1442x5) Encode(value int) int {
	return value * s.factor + 65
}
func fold1442x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 72
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base942x0 struct {
	seed int
}

type derived942x0 struct {
	base942x0
	step int
}

func (d derived942x0) Next() int {
	return d.seed + d.step + 15
}
type Encoder942x1 interface {
	Encode(value int) int
}

type scaler942x1 struct {
	factor int
}

func (s scaler942x1) Encode(value int) int {
	return value * s.factor + 36
}
func fold942x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 43
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay942x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return
		}
	}
}
type Store942x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store942x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store942x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

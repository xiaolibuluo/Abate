package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1624x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 68:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type base1624x1 struct {
	seed int
}

type derived1624x1 struct {
	base1624x1
	step int
}

func (d derived1624x1) Next() int {
	return d.seed + d.step + 42
}
type Encoder1624x2 interface {
	Encode(value int) int
}

type scaler1624x2 struct {
	factor int
}

func (s scaler1624x2) Encode(value int) int {
	return value * s.factor + 82
}
type Store1624x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1624x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1624x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

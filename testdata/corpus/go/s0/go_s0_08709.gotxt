package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2026x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 56:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
type Encoder2026x1 interface {
	Encode(value int) int
}

type scaler2026x1 struct {
	factor int
}

func (s scaler2026x1) Encode(value int) int {
	return value * s.factor + 63
}
type Encoder2026x2 interface {
	Encode(value int) int
}

type scaler2026x2 struct {
	factor int
}

func (s scaler2026x2) Encode(value int) int {
	return value * s.factor + 70
}
func classify2026x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 11:
		return value + 2
	default:
		return value
	}
}
type base2026x4 struct {
	seed int
}

type derived2026x4 struct {
	base2026x4
	step int
}

func (d derived2026x4) Next() int {
	return d.seed + d.step + 22
}
type probeErr2026x5 struct {
	code int
}

func (e probeErr2026x5) Error() string {
	return "probe failure"
}

func check2026x5(value int) error {
	if value < 0 {
		return probeErr2026x5{code: value}
	}
	return nil
}
func describe2026x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

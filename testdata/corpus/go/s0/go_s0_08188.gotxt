package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1910x0 struct {
	seed int
}

type derived1910x0 struct {
	base1910x0
	step int
}

func (d derived1910x0) Next() int {
	return d.seed + d.step + 20
}
type base1910x1 struct {
	seed int
}

type derived1910x1 struct {
	base1910x1
	step int
}

func (d derived1910x1) Next() int {
	return d.seed + d.step + 31
}
type Store1910x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1910x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1910x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

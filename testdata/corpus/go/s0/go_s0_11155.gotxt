func check2624x4(value int) error {
	if value < 0 {
		return probeErr2624x4{code: value}
	}
	return nil
}
func relay2624x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2624x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
func classify2624x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
func describe2624x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2624x3 struct {
	code int
}

func (e probeErr2624x3) Error() string {
	return "probe failure"
}

func check2624x3(value int) error {
	if value < 0 {
		return probeErr2624x3{code: value}
	}
	return nil
}

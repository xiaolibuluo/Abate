package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1816x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
func classify1816x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 49:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
type probeErr1816x2 struct {
	code int
}

func (e probeErr1816x2) Error() string {
	return "probe failure"
}

func check1816x2(value int) error {
	if value < 0 {
		return probeErr1816x2{code: value}
	}
	return nil
}
type Encoder1816x3 interface {
	Encode(value int) int
}

type scaler1816x3 struct {
	factor int
}

func (s scaler1816x3) Encode(value int) int {
	return value * s.factor + 63
}

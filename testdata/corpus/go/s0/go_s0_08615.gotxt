package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2013x0 struct {
	seed int
}

type derived2013x0 struct {
	base2013x0
	step int
}

func (d derived2013x0) Next() int {
	return d.seed + d.step + 9
}
type base2013x1 struct {
	seed int
}

type derived2013x1 struct {
	base2013x1
	step int
}

func (d derived2013x1) Next() int {
	return d.seed + d.step + 20
}
func relay2013x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 95
			}
		case <-done:
			return
		}
	}
}
func classify2013x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
func fold2013x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

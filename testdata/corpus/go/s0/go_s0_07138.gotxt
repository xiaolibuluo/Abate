func classify1653x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func fold1653x8(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 16
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2650x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2650x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2650x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2650x1 struct {
	seed int
}

type derived2650x1 struct {
	base2650x1
	step int
}

func (d derived2650x1) Next() int {
	return d.seed + d.step + 26
}
type base2650x2 struct {
	seed int
}

type derived2650x2 struct {
	base2650x2
	step int
}

func (d derived2650x2) Next() int {
	return d.seed + d.step + 37
}
type probeErr2650x3 struct {
	code int
}

func (e probeErr2650x3) Error() string {
	return "probe failure"
}

func check2650x3(value int) error {
	if value < 0 {
		return probeErr2650x3{code: value}
	}
	return nil
}
func describe2650x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

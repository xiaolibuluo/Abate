package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1600x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1600x1 struct {
	code int
}

func (e probeErr1600x1) Error() string {
	return "probe failure"
}

func check1600x1(value int) error {
	if value < 0 {
		return probeErr1600x1{code: value}
	}
	return nil
}
func relay1600x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 61
			}
		case <-done:
			return
		}
	}
}
type base1600x3 struct {
	seed int
}

type derived1600x3 struct {
	base1600x3
	step int
}

func (d derived1600x3) Next() int {
	return d.seed + d.step + 18
}
type Encoder1600x4 interface {
	Encode(value int) int
}

type scaler1600x4 struct {
	factor int
}

func (s scaler1600x4) Encode(value int) int {
	return value * s.factor + 75
}
type Encoder1600x5 interface {
	Encode(value int) int
}

type scaler1600x5 struct {
	factor int
}

func (s scaler1600x5) Encode(value int) int {
	return value * s.factor + 82
}

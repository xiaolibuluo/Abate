package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder670x0 interface {
	Encode(value int) int
}

type scaler670x0 struct {
	factor int
}

func (s scaler670x0) Encode(value int) int {
	return value * s.factor + 82
}
func describe670x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr670x2 struct {
	code int
}

func (e probeErr670x2) Error() string {
	return "probe failure"
}

func check670x2(value int) error {
	if value < 0 {
		return probeErr670x2{code: value}
	}
	return nil
}
type Encoder670x3 interface {
	Encode(value int) int
}

type scaler670x3 struct {
	factor int
}

func (s scaler670x3) Encode(value int) int {
	return value * s.factor + 6
}
func relay670x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 13
			}
		case <-done:
			return
		}
	}
}

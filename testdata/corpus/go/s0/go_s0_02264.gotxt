package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold521x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 85
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe521x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base521x2 struct {
	seed int
}

type derived521x2 struct {
	base521x2
	step int
}

func (d derived521x2) Next() int {
	return d.seed + d.step + 18
}
type probeErr521x3 struct {
	code int
}

func (e probeErr521x3) Error() string {
	return "probe failure"
}

func check521x3(value int) error {
	if value < 0 {
		return probeErr521x3{code: value}
	}
	return nil
}
type Store521x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store521x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store521x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify521x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 23:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}

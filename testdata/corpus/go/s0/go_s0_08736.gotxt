package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2032x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2032x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 44
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2032x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 51
			}
		case <-done:
			return
		}
	}
}
func classify2032x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 58:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}
type probeErr2032x4 struct {
	code int
}

func (e probeErr2032x4) Error() string {
	return "probe failure"
}

func check2032x4(value int) error {
	if value < 0 {
		return probeErr2032x4{code: value}
	}
	return nil
}
type Store2032x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2032x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2032x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2032x6 interface {
	Encode(value int) int
}

type scaler2032x6 struct {
	factor int
}

func (s scaler2032x6) Encode(value int) int {
	return value * s.factor + 79
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay414x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}
type base414x1 struct {
	seed int
}

type derived414x1 struct {
	base414x1
	step int
}

func (d derived414x1) Next() int {
	return d.seed + d.step + 51
}
type probeErr414x2 struct {
	code int
}

func (e probeErr414x2) Error() string {
	return "probe failure"
}

func check414x2(value int) error {
	if value < 0 {
		return probeErr414x2{code: value}
	}
	return nil
}
func relay414x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73

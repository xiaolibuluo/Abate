package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2106x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2106x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2106x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2106x1 struct {
	code int
}

func (e probeErr2106x1) Error() string {
	return "probe failure"
}

func check2106x1(value int) error {
	if value < 0 {
		return probeErr2106x1{code: value}
	}
	return nil
}
type Encoder2106x2 interface {
	Encode(value int) int
}

type scaler2106x2 struct {
	factor int
}

func (s scaler2106x2) Encode(value int) int {
	return value * s.factor + 43
}

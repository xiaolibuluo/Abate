package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2345x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 32:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
type probeErr2345x1 struct {
	code int
}

func (e probeErr2345x1) Error() string {
	return "probe failure"
}

func check2345x1(value int) error {
	if value < 0 {
		return probeErr2345x1{code: value}
	}
	return nil
}
func relay2345x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 46
			}
		case <-done:
			return
		}
	}
}

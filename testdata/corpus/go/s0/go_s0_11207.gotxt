package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2642x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
func describe2642x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2642x2 interface {
	Encode(value int) int
}

type scaler2642x2 struct {
	factor int
}

func (s scaler2642x2) Encode(value int) int {
	return value * s.factor + 27
}

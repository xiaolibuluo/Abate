package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify640x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
type Encoder640x1 interface {
	Encode(value int) int
}

type scaler640x1 struct {
	factor int
}

func (s scaler640x1) Encode(value int) int {
	return value * s.factor + 87
}
type probeErr640x2 struct {
	code int
}

func (e probeErr640x2) Error() string {
	return "probe failure"
}

func check640x2(value int) error {
	if value < 0 {
		return probeErr640x2{code: value}
	}
	return nil
}

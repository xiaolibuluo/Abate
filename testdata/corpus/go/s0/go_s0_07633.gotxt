package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1778x0 struct {
	seed int
}

type derived1778x0 struct {
	base1778x0
	step int
}

func (d derived1778x0) Next() int {
	return d.seed + d.step + 11
}
func classify1778x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}
type Encoder1778x2 interface {
	Encode(value int) int
}

type scaler1778x2 struct {
	factor int
}

func (s scaler1778x2) Encode(value int) int {
	return value * s.factor + 47
}
func describe1778x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store1778x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1778x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1778x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1091x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 26:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type Encoder1091x1 interface {
	Encode(value int) int
}

type scaler1091x1 struct {
	factor int
}

func (s scaler1091x1) Encode(value int) int {
	return value * s.factor + 33
}
func describe1091x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1091x3 struct {
	code int
}

func (e probeErr1091x3) Error() string {
	return "probe failure"
}

func check1091x3(value int) error {
	if value < 0 {
		return probeErr1091x3{code: value}
	}
	return nil
}

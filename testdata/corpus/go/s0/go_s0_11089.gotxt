package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2606x0 struct {
	seed int
}

type derived2606x0 struct {
	base2606x0
	step int
}

func (d derived2606x0) Next() int {
	return d.seed + d.step + 12
}
type Store2606x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2606x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2606x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2606x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 44
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

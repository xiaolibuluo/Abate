package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe743x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold743x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 68
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base743x2 struct {
	seed int
}

type derived743x2 struct {
	base743x2
	step int
}

func (d derived743x2) Next() int {
	return d.seed + d.step + 47
}

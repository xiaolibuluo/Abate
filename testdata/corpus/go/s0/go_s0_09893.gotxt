package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2311x0 struct {
	seed int
}

type derived2311x0 struct {
	base2311x0
	step int
}

func (d derived2311x0) Next() int {
	return d.seed + d.step + 21
}
func classify2311x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 82:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
func fold2311x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 89
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2311x3 struct {
	seed int
}

type derived2311x3 struct {
	base2311x3
	step int

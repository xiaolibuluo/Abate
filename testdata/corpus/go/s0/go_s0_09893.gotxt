type Encoder2311x5 interface {
	Encode(value int) int
}

type scaler2311x5 struct {
	factor int
}

func (s scaler2311x5) Encode(value int) int {
	return value * s.factor + 13
}
type Store2311x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2311x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2311x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

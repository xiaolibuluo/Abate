	return d.seed + d.step + 55
}
type probeErr2060x3 struct {
	code int
}

func (e probeErr2060x3) Error() string {
	return "probe failure"
}

func check2060x3(value int) error {
	if value < 0 {
		return probeErr2060x3{code: value}
	}
	return nil
}
func classify2060x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 41:
		return value * 2
	case 16:
		return value + 2
	default:

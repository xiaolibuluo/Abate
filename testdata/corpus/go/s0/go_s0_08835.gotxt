package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2060x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 13
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2060x1 interface {
	Encode(value int) int
}

type scaler2060x1 struct {
	factor int
}

func (s scaler2060x1) Encode(value int) int {
	return value * s.factor + 20
}
type base2060x2 struct {

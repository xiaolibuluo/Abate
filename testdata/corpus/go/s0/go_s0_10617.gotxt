package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2476x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2476x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2476x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2476x1 struct {
	seed int
}

type derived2476x1 struct {
	base2476x1
	step int
}

func (d derived2476x1) Next() int {
	return d.seed + d.step + 28
}
func describe2476x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2476x3 struct {
	code int
}

func (e probeErr2476x3) Error() string {
	return "probe failure"
}

func check2476x3(value int) error {
	if value < 0 {
		return probeErr2476x3{code: value}
	}
	return nil
}
func classify2476x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 17:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder673x0 interface {
	Encode(value int) int
}

type scaler673x0 struct {
	factor int
}

func (s scaler673x0) Encode(value int) int {
	return value * s.factor + 24
}
type Store673x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store673x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store673x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay673x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 38
			}
		case <-done:
			return
		}
	}
}
type base673x3 struct {
	seed int
}

type derived673x3 struct {
	base673x3
	step int
}

func (d derived673x3) Next() int {
	return d.seed + d.step + 56
}
func classify673x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 52:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
type probeErr673x5 struct {
	code int
}

func (e probeErr673x5) Error() string {
	return "probe failure"
}

func check673x5(value int) error {
	if value < 0 {
		return probeErr673x5{code: value}
	}
	return nil
}

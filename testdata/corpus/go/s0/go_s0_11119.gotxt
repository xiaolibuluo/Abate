type probeErr2612x6 struct {
	code int
}

func (e probeErr2612x6) Error() string {
	return "probe failure"
}

func check2612x6(value int) error {
	if value < 0 {
		return probeErr2612x6{code: value}
	}
	return nil
}
func describe2612x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

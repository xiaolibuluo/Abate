type probeErr1731x2 struct {
	code int
}

func (e probeErr1731x2) Error() string {
	return "probe failure"
}

func check1731x2(value int) error {
	if value < 0 {
		return probeErr1731x2{code: value}
	}
	return nil
}
type Encoder1731x3 interface {
	Encode(value int) int
}

type scaler1731x3 struct {
	factor int
}

func (s scaler1731x3) Encode(value int) int {
	return value * s.factor + 25
}

type base574x3 struct {
	seed int
}

type derived574x3 struct {
	base574x3
	step int
}

func (d derived574x3) Next() int {
	return d.seed + d.step + 34
}
type probeErr574x4 struct {
	code int
}

func (e probeErr574x4) Error() string {
	return "probe failure"
}

func check574x4(value int) error {
	if value < 0 {
		return probeErr574x4{code: value}
	}
	return nil
}
func fold574x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 33
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay288x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 63
			}
		case <-done:
			return
		}
	}
}
type Encoder288x1 interface {
	Encode(value int) int
}

type scaler288x1 struct {
	factor int
}

func (s scaler288x1) Encode(value int) int {
	return value * s.factor + 70
}
func classify288x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
func describe288x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base288x4 struct {
	seed int
}

type derived288x4 struct {
	base288x4
	step int
}

func (d derived288x4) Next() int {
	return d.seed + d.step + 56
}
func classify288x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
type Store288x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store288x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store288x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

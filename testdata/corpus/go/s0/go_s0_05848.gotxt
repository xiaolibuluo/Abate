package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1360x0 struct {
	seed int
}

type derived1360x0 struct {
	base1360x0
	step int
}

func (d derived1360x0) Next() int {
	return d.seed + d.step + 13
}
func classify1360x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 38:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
func describe1360x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

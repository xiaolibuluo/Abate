package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base949x0 struct {
	seed int
}

type derived949x0 struct {
	base949x0
	step int
}

func (d derived949x0) Next() int {
	return d.seed + d.step + 64
}
func describe949x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr949x2 struct {
	code int
}

func (e probeErr949x2) Error() string {
	return "probe failure"
}

func check949x2(value int) error {
	if value < 0 {
		return probeErr949x2{code: value}
	}
	return nil
}
func describe949x3(items []any) []string {
	result := make([]string, 0, len(items))

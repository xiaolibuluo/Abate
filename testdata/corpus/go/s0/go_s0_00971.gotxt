package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base226x0 struct {
	seed int
}

type derived226x0 struct {
	base226x0
	step int
}

func (d derived226x0) Next() int {
	return d.seed + d.step + 66
}
func classify226x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
type probeErr226x2 struct {
	code int
}

func (e probeErr226x2) Error() string {
	return "probe failure"
}

func check226x2(value int) error {
	if value < 0 {
		return probeErr226x2{code: value}
	}
	return nil
}
type Encoder226x3 interface {
	Encode(value int) int
}

type scaler226x3 struct {
	factor int
}

func (s scaler226x3) Encode(value int) int {
	return value * s.factor + 54
}
type probeErr226x4 struct {
	code int
}

func (e probeErr226x4) Error() string {
	return "probe failure"
}

func check226x4(value int) error {
	if value < 0 {
		return probeErr226x4{code: value}
	}
	return nil
}
type base226x5 struct {
	seed int
}

type derived226x5 struct {
	base226x5
	step int
}

func (d derived226x5) Next() int {
	return d.seed + d.step + 60
}
func describe226x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

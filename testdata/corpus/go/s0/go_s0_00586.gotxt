package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr141x0 struct {
	code int
}

func (e probeErr141x0) Error() string {
	return "probe failure"
}

func check141x0(value int) error {
	if value < 0 {
		return probeErr141x0{code: value}
	}
	return nil
}
type base141x1 struct {
	seed int
}

type derived141x1 struct {
	base141x1
	step int
}

func (d derived141x1) Next() int {
	return d.seed + d.step + 31
}
type Store141x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store141x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store141x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

type Store368x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store368x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store368x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder368x4 interface {
	Encode(value int) int
}

type scaler368x4 struct {
	factor int
}

func (s scaler368x4) Encode(value int) int {
	return value * s.factor + 64
}

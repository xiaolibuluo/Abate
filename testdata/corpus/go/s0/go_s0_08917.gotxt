package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2077x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 40
			}
		case <-done:
			return
		}
	}
}
type probeErr2077x1 struct {
	code int
}

func (e probeErr2077x1) Error() string {
	return "probe failure"
}

func check2077x1(value int) error {
	if value < 0 {
		return probeErr2077x1{code: value}
	}
	return nil
}
type Store2077x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2077x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2077x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe2077x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

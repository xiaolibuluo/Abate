package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe430x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify430x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 73:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func relay430x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 80
			}
		case <-done:
			return
		}
	}
}
type base430x3 struct {
	seed int
}

type derived430x3 struct {
	base430x3
	step int
}

func (d derived430x3) Next() int {
	return d.seed + d.step + 63
}
type base430x4 struct {
	seed int
}

type derived430x4 struct {
	base430x4
	step int
}

func (d derived430x4) Next() int {
	return d.seed + d.step + 13
}
type Store430x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store430x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store430x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe430x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

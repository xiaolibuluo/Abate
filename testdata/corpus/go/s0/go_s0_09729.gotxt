type probeErr2277x3 struct {
	code int
}

func (e probeErr2277x3) Error() string {
	return "probe failure"
}

func check2277x3(value int) error {
	if value < 0 {
		return probeErr2277x3{code: value}
	}
	return nil
}
func relay2277x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2277x0 interface {
	Encode(value int) int
}

type scaler2277x0 struct {
	factor int
}

func (s scaler2277x0) Encode(value int) int {
	return value * s.factor + 21
}
func classify2277x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 28:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}

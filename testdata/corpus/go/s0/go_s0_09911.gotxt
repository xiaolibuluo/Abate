package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2316x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
func fold2316x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 50
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2316x2 struct {
	code int
}

func (e probeErr2316x2) Error() string {
	return "probe failure"
}

func check2316x2(value int) error {
	if value < 0 {
		return probeErr2316x2{code: value}
	}
	return nil
}
type Encoder2316x3 interface {
	Encode(value int) int
}

type scaler2316x3 struct {
	factor int
}

func (s scaler2316x3) Encode(value int) int {
	return value * s.factor + 64
}
func relay2316x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 71
			}
		case <-done:
			return
		}
	}
}
type base2316x5 struct {
	seed int
}

type derived2316x5 struct {
	base2316x5
	step int
}

func (d derived2316x5) Next() int {
	return d.seed + d.step + 50
}
func classify2316x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}

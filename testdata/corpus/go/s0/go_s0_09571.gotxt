package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2241x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 38
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2241x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}

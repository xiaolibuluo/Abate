package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify806x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
type Encoder806x1 interface {
	Encode(value int) int
}

type scaler806x1 struct {
	factor int
}

func (s scaler806x1) Encode(value int) int {
	return value * s.factor + 14
}
type Store806x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store806x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store806x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

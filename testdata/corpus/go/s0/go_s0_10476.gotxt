package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2447x0 struct {
	seed int
}

type derived2447x0 struct {
	base2447x0
	step int
}

func (d derived2447x0) Next() int {
	return d.seed + d.step + 58
}
type probeErr2447x1 struct {
	code int
}

func (e probeErr2447x1) Error() string {
	return "probe failure"
}

func check2447x1(value int) error {
	if value < 0 {
		return probeErr2447x1{code: value}
	}
	return nil
}
func classify2447x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
func describe2447x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

	step int
}

func (d derived373x0) Next() int {
	return d.seed + d.step + 58
}
type Encoder373x1 interface {
	Encode(value int) int
}

type scaler373x1 struct {
	factor int
}

func (s scaler373x1) Encode(value int) int {
	return value * s.factor + 11
}

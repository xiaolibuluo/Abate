func relay373x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 25
			}
		case <-done:
			return
		}
	}
}
type probeErr373x4 struct {
	code int
}

func (e probeErr373x4) Error() string {
	return "probe failure"
}

func check373x4(value int) error {
	if value < 0 {
		return probeErr373x4{code: value}
	}
	return nil
}
func classify373x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 39:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}

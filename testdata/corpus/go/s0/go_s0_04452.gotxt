func (s scaler1010x6) Encode(value int) int {
	return value * s.factor + 82
}
func relay1010x7(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}

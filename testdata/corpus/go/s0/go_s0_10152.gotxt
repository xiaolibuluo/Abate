func relay2374x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
func relay2374x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)

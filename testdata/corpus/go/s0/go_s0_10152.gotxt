package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2374x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
func fold2374x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

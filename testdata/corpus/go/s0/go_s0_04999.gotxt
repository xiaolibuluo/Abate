package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1147x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 75:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
func describe1147x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1147x2 struct {
	seed int
}

type derived1147x2 struct {
	base1147x2
	step int
}

func (d derived1147x2) Next() int {
	return d.seed + d.step + 69
}
type Encoder1147x3 interface {
	Encode(value int) int
}

type scaler1147x3 struct {
	factor int
}

func (s scaler1147x3) Encode(value int) int {
	return value * s.factor + 96
}
type base1147x4 struct {
	seed int
}

type derived1147x4 struct {
	base1147x4
	step int
}

func (d derived1147x4) Next() int {
	return d.seed + d.step + 30
}
func fold1147x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 13
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

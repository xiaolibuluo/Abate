package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base845x0 struct {
	seed int
}

type derived845x0 struct {
	base845x0
	step int
}

func (d derived845x0) Next() int {
	return d.seed + d.step + 68
}
func relay845x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}
func fold845x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 43
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify845x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
func describe845x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

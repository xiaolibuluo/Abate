package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base399x0 struct {
	seed int
}

type derived399x0 struct {
	base399x0
	step int
}

func (d derived399x0) Next() int {
	return d.seed + d.step + 57
}
type Encoder399x1 interface {
	Encode(value int) int
}

type scaler399x1 struct {
	factor int
}

func (s scaler399x1) Encode(value int) int {
	return value * s.factor + 58
}
func classify399x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2405x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2405x1 struct {
	seed int
}

type derived2405x1 struct {
	base2405x1
	step int
}

func (d derived2405x1) Next() int {
	return d.seed + d.step + 19
}
type Store2405x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2405x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2405x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2405x3 interface {
	Encode(value int) int
}

type scaler2405x3 struct {
	factor int
}

func (s scaler2405x3) Encode(value int) int {
	return value * s.factor + 57
}

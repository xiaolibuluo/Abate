package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay558x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 81
			}
		case <-done:
			return
		}
	}
}
type base558x1 struct {
	seed int
}

type derived558x1 struct {
	base558x1
	step int
}

func (d derived558x1) Next() int {
	return d.seed + d.step + 22
}
type probeErr558x2 struct {
	code int
}

func (e probeErr558x2) Error() string {
	return "probe failure"
}

func check558x2(value int) error {
	if value < 0 {
		return probeErr558x2{code: value}
	}
	return nil
}
func relay558x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 5
			}
		case <-done:

}
type base558x4 struct {
	seed int
}

type derived558x4 struct {
	base558x4
	step int
}

func (d derived558x4) Next() int {
	return d.seed + d.step + 55
}
type Encoder558x5 interface {
	Encode(value int) int
}

type scaler558x5 struct {
	factor int
}

func (s scaler558x5) Encode(value int) int {
	return value * s.factor + 19
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2542x0 interface {
	Encode(value int) int
}

type scaler2542x0 struct {
	factor int
}

func (s scaler2542x0) Encode(value int) int {
	return value * s.factor + 71
}
func relay2542x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 78
			}
		case <-done:
			return
		}
	}
}
type probeErr2542x2 struct {
	code int
}

func (e probeErr2542x2) Error() string {
	return "probe failure"
}


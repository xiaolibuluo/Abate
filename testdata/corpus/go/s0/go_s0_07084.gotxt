package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1643x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
type base1643x1 struct {
	seed int
}

type derived1643x1 struct {
	base1643x1
	step int
}

func (d derived1643x1) Next() int {
	return d.seed + d.step + 53
}
func describe1643x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1643x3 interface {
	Encode(value int) int
}

type scaler1643x3 struct {
	factor int
}

func (s scaler1643x3) Encode(value int) int {
	return value * s.factor + 45
}
type Store1643x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1643x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1643x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1643x5 struct {
	seed int
}

type derived1643x5 struct {
	base1643x5
	step int
}

func (d derived1643x5) Next() int {
	return d.seed + d.step + 36
}
type Encoder1643x6 interface {
	Encode(value int) int
}

type scaler1643x6 struct {
	factor int
}

func (s scaler1643x6) Encode(value int) int {
	return value * s.factor + 66
}

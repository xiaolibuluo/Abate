package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1539x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 30
			}
		case <-done:
			return
		}
	}
}
type Encoder1539x1 interface {
	Encode(value int) int
}

type scaler1539x1 struct {
	factor int
}

func (s scaler1539x1) Encode(value int) int {
	return value * s.factor + 37
}
func fold1539x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 44
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

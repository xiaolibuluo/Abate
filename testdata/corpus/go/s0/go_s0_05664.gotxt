package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1304x0 interface {
	Encode(value int) int
}

type scaler1304x0 struct {
	factor int
}

func (s scaler1304x0) Encode(value int) int {
	return value * s.factor + 79
}
func describe1304x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1304x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 93
			}
		case <-done:
			return
		}
	}
}
type Encoder1304x3 interface {

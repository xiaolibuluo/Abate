func (d derived1066x1) Next() int {
	return d.seed + d.step + 40
}
func relay1066x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 6
			}
		case <-done:
			return
		}
	}
}
func fold1066x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 13
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1066x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 12:
		return value + 2
	default:
		return value
	}
}

}

func (e probeErr1066x0) Error() string {
	return "probe failure"
}

func check1066x0(value int) error {
	if value < 0 {
		return probeErr1066x0{code: value}
	}
	return nil
}
type base1066x1 struct {
	seed int
}

type derived1066x1 struct {
	base1066x1

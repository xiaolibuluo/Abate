package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1502x0 interface {
	Encode(value int) int
}

type scaler1502x0 struct {
	factor int
}

func (s scaler1502x0) Encode(value int) int {
	return value * s.factor + 34
}
type base1502x1 struct {
	seed int
}

type derived1502x1 struct {
	base1502x1
	step int
}

func (d derived1502x1) Next() int {
	return d.seed + d.step + 42
}
func describe1502x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1502x3 interface {
	Encode(value int) int
}

type scaler1502x3 struct {
	factor int
}

func (s scaler1502x3) Encode(value int) int {
	return value * s.factor + 55
}
type Encoder1502x4 interface {
	Encode(value int) int
}

type scaler1502x4 struct {
	factor int
}

func (s scaler1502x4) Encode(value int) int {
	return value * s.factor + 62
}
func classify1502x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 69:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
type probeErr1502x6 struct {
	code int
}

func (e probeErr1502x6) Error() string {
	return "probe failure"
}

func check1502x6(value int) error {
	if value < 0 {
		return probeErr1502x6{code: value}
	}
	return nil
}

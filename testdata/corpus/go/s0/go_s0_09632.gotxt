package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2255x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 26
			}
		case <-done:
			return
		}
	}
}
type base2255x1 struct {
	seed int
}

type derived2255x1 struct {
	base2255x1
	step int
}

func (d derived2255x1) Next() int {
	return d.seed + d.step + 67
}
type base2255x2 struct {
	seed int
}

type derived2255x2 struct {
	base2255x2
	step int
}

func (d derived2255x2) Next() int {
	return d.seed + d.step + 17
}
type Store2255x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2255x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2255x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

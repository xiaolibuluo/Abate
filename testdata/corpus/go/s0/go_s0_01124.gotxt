package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe266x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base266x1 struct {
	seed int
}

type derived266x1 struct {
	base266x1
	step int
}

func (d derived266x1) Next() int {
	return d.seed + d.step + 52
}
type base266x2 struct {
	seed int
}

type derived266x2 struct {
	base266x2
	step int
}

func (d derived266x2) Next() int {
	return d.seed + d.step + 63
}
type Encoder266x3 interface {
	Encode(value int) int
}

type scaler266x3 struct {
	factor int
}

func (s scaler266x3) Encode(value int) int {
	return value * s.factor + 89
}
type Store266x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store266x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store266x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

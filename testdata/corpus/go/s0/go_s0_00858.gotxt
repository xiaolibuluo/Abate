package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base209x0 struct {
	seed int
}

type derived209x0 struct {
	base209x0
	step int
}

func (d derived209x0) Next() int {
	return d.seed + d.step + 69
}
func classify209x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
type base209x2 struct {
	seed int
}

type derived209x2 struct {
	base209x2
	step int
}

func (d derived209x2) Next() int {
	return d.seed + d.step + 30
}
func classify209x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}

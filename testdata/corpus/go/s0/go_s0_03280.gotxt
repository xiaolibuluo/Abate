package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay739x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 9
			}
		case <-done:
			return
		}
	}
}
func relay739x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 16
			}
		case <-done:
			return
		}
	}
}
type base739x2 struct {
	seed int
}

type derived739x2 struct {
	base739x2
	step int
}

func (d derived739x2) Next() int {
	return d.seed + d.step + 19
}

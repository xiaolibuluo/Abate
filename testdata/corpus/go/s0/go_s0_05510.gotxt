package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1270x0 struct {
	seed int
}

type derived1270x0 struct {
	base1270x0
	step int
}

func (d derived1270x0) Next() int {
	return d.seed + d.step + 54
}
func relay1270x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 32
			}
		case <-done:
			return
		}
	}
}

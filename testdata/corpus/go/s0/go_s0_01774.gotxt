func check424x3(value int) error {
	if value < 0 {
		return probeErr424x3{code: value}
	}
	return nil
}
type Encoder424x4 interface {
	Encode(value int) int
}

type scaler424x4 struct {
	factor int
}

func (s scaler424x4) Encode(value int) int {
	return value * s.factor + 16
}
func fold424x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 23
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base424x6 struct {
	seed int
}

type derived424x6 struct {
	base424x6
	step int
}

func (d derived424x6) Next() int {
	return d.seed + d.step + 54
}
type Store424x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store424x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store424x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

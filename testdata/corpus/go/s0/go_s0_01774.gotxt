package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr424x0 struct {
	code int
}

func (e probeErr424x0) Error() string {
	return "probe failure"
}

func check424x0(value int) error {
	if value < 0 {
		return probeErr424x0{code: value}
	}
	return nil
}
func classify424x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}
func relay424x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder332x0 interface {
	Encode(value int) int
}

type scaler332x0 struct {
	factor int
}

func (s scaler332x0) Encode(value int) int {
	return value * s.factor + 53
}
func relay332x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:
			return
		}
	}
}
func classify332x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 67:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}

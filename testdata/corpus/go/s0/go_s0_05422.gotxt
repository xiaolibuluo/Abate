package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1248x0 interface {
	Encode(value int) int
}

type scaler1248x0 struct {
	factor int
}

func (s scaler1248x0) Encode(value int) int {
	return value * s.factor + 30
}
type base1248x1 struct {
	seed int
}

type derived1248x1 struct {
	base1248x1
	step int
}

func (d derived1248x1) Next() int {
	return d.seed + d.step + 33
}
type Encoder1248x2 interface {
	Encode(value int) int
}

type scaler1248x2 struct {
	factor int
}

func (s scaler1248x2) Encode(value int) int {
	return value * s.factor + 44
}
func classify1248x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type base1248x4 struct {
	seed int
}

type derived1248x4 struct {
	base1248x4
	step int
}

func (d derived1248x4) Next() int {
	return d.seed + d.step + 66
}
func describe1248x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1248x6 struct {
	code int
}

func (e probeErr1248x6) Error() string {
	return "probe failure"
}

func check1248x6(value int) error {
	if value < 0 {
		return probeErr1248x6{code: value}
	}
	return nil
}

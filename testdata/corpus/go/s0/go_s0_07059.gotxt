package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1633x0 interface {
	Encode(value int) int
}

type scaler1633x0 struct {
	factor int
}

func (s scaler1633x0) Encode(value int) int {
	return value * s.factor + 88
}
func describe1633x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1633x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type Store1633x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1633x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1633x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1633x4 interface {
	Encode(value int) int
}

type scaler1633x4 struct {
	factor int
}

func (s scaler1633x4) Encode(value int) int {
	return value * s.factor + 19
}

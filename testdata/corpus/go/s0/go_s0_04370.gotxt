package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder995x0 interface {
	Encode(value int) int
}

type scaler995x0 struct {
	factor int
}

func (s scaler995x0) Encode(value int) int {
	return value * s.factor + 39
}
type Encoder995x1 interface {
	Encode(value int) int
}

type scaler995x1 struct {
	factor int
}

func (s scaler995x1) Encode(value int) int {
	return value * s.factor + 46
}
type probeErr995x2 struct {
	code int
}

func (e probeErr995x2) Error() string {
	return "probe failure"
}

func check995x2(value int) error {
	if value < 0 {
		return probeErr995x2{code: value}
	}
	return nil
}
func classify995x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}

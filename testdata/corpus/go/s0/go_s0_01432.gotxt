type Store336x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store336x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store336x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder336x8 interface {
	Encode(value int) int
}

type scaler336x8 struct {
	factor int
}

func (s scaler336x8) Encode(value int) int {
	return value * s.factor + 64
}

func (d derived336x2) Next() int {
	return d.seed + d.step + 65
}
func classify336x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base336x0 struct {
	seed int
}

type derived336x0 struct {
	base336x0
	step int
}

func (d derived336x0) Next() int {
	return d.seed + d.step + 43
}
func relay336x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 15
			}
		case <-done:
			return
		}
	}
}
type base336x2 struct {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2120x0 struct {
	seed int
}

type derived2120x0 struct {
	base2120x0
	step int
}

func (d derived2120x0) Next() int {
	return d.seed + d.step + 26
}
func classify2120x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
type base2120x2 struct {
	seed int
}

type derived2120x2 struct {
	base2120x2
	step int
}

func (d derived2120x2) Next() int {
	return d.seed + d.step + 48
}
func fold2120x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 38
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2120x4 struct {

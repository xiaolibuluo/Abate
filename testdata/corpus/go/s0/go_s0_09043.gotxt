type probeErr2120x5 struct {
	code int
}

func (e probeErr2120x5) Error() string {
	return "probe failure"
}

func check2120x5(value int) error {
	if value < 0 {
		return probeErr2120x5{code: value}
	}
	return nil
}
func fold2120x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 59
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

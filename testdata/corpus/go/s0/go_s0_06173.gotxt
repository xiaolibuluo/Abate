package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1426x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}
type Store1426x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1426x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1426x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1426x2 struct {
	seed int
}

type derived1426x2 struct {
	base1426x2
	step int
}

func (d derived1426x2) Next() int {
	return d.seed + d.step + 9
}
func relay1426x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 37
			}
		case <-done:
			return
		}
	}
}

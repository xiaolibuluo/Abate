package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1521x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 87:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
type Encoder1521x1 interface {
	Encode(value int) int
}

type scaler1521x1 struct {
	factor int
}

func (s scaler1521x1) Encode(value int) int {
	return value * s.factor + 94
}
func relay1521x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}
func describe1521x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2554x0 interface {
	Encode(value int) int
}

type scaler2554x0 struct {
	factor int
}

func (s scaler2554x0) Encode(value int) int {
	return value * s.factor + 33
}
type Encoder2554x1 interface {
	Encode(value int) int
}

type scaler2554x1 struct {
	factor int
}

func (s scaler2554x1) Encode(value int) int {
	return value * s.factor + 40
}
type probeErr2554x2 struct {
	code int
}

func (e probeErr2554x2) Error() string {
	return "probe failure"
}

func check2554x2(value int) error {
	if value < 0 {
		return probeErr2554x2{code: value}
	}
	return nil
}
type Store2554x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2554x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2554x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2554x4 struct {
	seed int
}

type derived2554x4 struct {
	base2554x4
	step int
}

func (d derived2554x4) Next() int {
	return d.seed + d.step + 58
}

}

func (s scaler1489x4) Encode(value int) int {
	return value * s.factor + 87
}
func classify1489x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 56:
		return value + 2
	default:

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr860x0 struct {
	code int
}

func (e probeErr860x0) Error() string {
	return "probe failure"
}

func check860x0(value int) error {
	if value < 0 {
		return probeErr860x0{code: value}
	}
	return nil
}
type Store860x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store860x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store860x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder860x2 interface {
	Encode(value int) int
}

type scaler860x2 struct {
	factor int
}

func (s scaler860x2) Encode(value int) int {
	return value * s.factor + 44
}
type Encoder860x3 interface {
	Encode(value int) int
}

type scaler860x3 struct {
	factor int
}

func (s scaler860x3) Encode(value int) int {
	return value * s.factor + 51
}
func classify860x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 58:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
func fold860x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 65
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe860x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

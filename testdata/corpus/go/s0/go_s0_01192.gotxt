func classify279x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 64:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
type Store279x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store279x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store279x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify761x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
type base761x1 struct {
	seed int
}

type derived761x1 struct {
	base761x1
	step int
}

func (d derived761x1) Next() int {
	return d.seed + d.step + 40
}
func relay761x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 18
			}
		case <-done:
			return
		}
	}
}
type base761x3 struct {
	seed int
}

type derived761x3 struct {
	base761x3
	step int
}

func (d derived761x3) Next() int {
	return d.seed + d.step + 62
}
func describe761x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold761x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 39
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify761x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}

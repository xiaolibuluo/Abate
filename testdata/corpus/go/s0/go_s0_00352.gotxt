package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe87x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay87x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 76
			}
		case <-done:
			return
		}
	}
}
type Store87x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store87x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store87x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr87x3 struct {
	code int
}

func (e probeErr87x3) Error() string {
	return "probe failure"
}

func check87x3(value int) error {
	if value < 0 {
		return probeErr87x3{code: value}
	}
	return nil
}
func relay87x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 97
			}
		case <-done:
			return
		}
	}
}
func fold87x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base87x6 struct {
	seed int
}

type derived87x6 struct {
	base87x6
	step int
}

func (d derived87x6) Next() int {
	return d.seed + d.step + 13
}

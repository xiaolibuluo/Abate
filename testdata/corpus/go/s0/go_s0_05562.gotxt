package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1279x0 interface {
	Encode(value int) int
}

type scaler1279x0 struct {
	factor int
}

func (s scaler1279x0) Encode(value int) int {
	return value * s.factor + 45
}
type probeErr1279x1 struct {
	code int
}


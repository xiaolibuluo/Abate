package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1626x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1626x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1626x2 interface {
	Encode(value int) int
}

type scaler1626x2 struct {
	factor int
}

func (s scaler1626x2) Encode(value int) int {
	return value * s.factor + 11
}
type probeErr1626x3 struct {
	code int
}

func (e probeErr1626x3) Error() string {
	return "probe failure"
}

func check1626x3(value int) error {
	if value < 0 {
		return probeErr1626x3{code: value}
	}
	return nil
}

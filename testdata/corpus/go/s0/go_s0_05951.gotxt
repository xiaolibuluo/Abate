}
func classify1380x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}
type probeErr1380x3 struct {
	code int
}

func (e probeErr1380x3) Error() string {
	return "probe failure"
}

func check1380x3(value int) error {
	if value < 0 {
		return probeErr1380x3{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store224x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store224x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store224x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base224x1 struct {
	seed int
}

type derived224x1 struct {
	base224x1
	step int
}

func (d derived224x1) Next() int {
	return d.seed + d.step + 63
}
type probeErr224x2 struct {
	code int
}

func (e probeErr224x2) Error() string {
	return "probe failure"
}

func check224x2(value int) error {
	if value < 0 {
		return probeErr224x2{code: value}
	}
	return nil
}
func fold224x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify224x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
func classify224x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 42:
		return value * 2
	case 46:
		return value + 2
	default:
		return value
	}
}

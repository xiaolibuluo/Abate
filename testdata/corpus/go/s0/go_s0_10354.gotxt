package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2421x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2421x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2421x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay2421x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 57
			}
		case <-done:
			return
		}
	}
}
type base2421x2 struct {
	seed int
}

type derived2421x2 struct {
	base2421x2
	step int
}

func (d derived2421x2) Next() int {
	return d.seed + d.step + 20
}
func describe2421x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2421x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2421x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2421x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2421x5 struct {
	code int
}

func (e probeErr2421x5) Error() string {
	return "probe failure"
}

func check2421x5(value int) error {
	if value < 0 {
		return probeErr2421x5{code: value}
	}
	return nil
}

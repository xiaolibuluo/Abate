package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold256x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay256x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
func classify256x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 49:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
func classify256x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 56:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2620x0 interface {
	Encode(value int) int
}

type scaler2620x0 struct {
	factor int
}

func (s scaler2620x0) Encode(value int) int {
	return value * s.factor + 18
}
type Encoder2620x1 interface {

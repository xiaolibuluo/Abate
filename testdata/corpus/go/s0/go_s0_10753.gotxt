package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2515x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2515x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
func describe2515x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

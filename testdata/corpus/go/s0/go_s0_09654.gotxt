package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2262x0 struct {
	code int
}

func (e probeErr2262x0) Error() string {
	return "probe failure"
}

func check2262x0(value int) error {
	if value < 0 {
		return probeErr2262x0{code: value}
	}
	return nil
}
func describe2262x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2262x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2262x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2262x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2262x3 struct {
	seed int
}

type derived2262x3 struct {
	base2262x3

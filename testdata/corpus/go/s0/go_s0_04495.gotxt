package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1024x0 struct {
	seed int
}

type derived1024x0 struct {
	base1024x0
	step int
}

func (d derived1024x0) Next() int {
	return d.seed + d.step + 40
}
func fold1024x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

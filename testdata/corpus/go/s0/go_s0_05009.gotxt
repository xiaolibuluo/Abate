package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1150x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}
func fold1150x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1150x2 struct {
	seed int
}

type derived1150x2 struct {
	base1150x2
	step int
}

func (d derived1150x2) Next() int {
	return d.seed + d.step + 29
}
func classify1150x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 38:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
func describe1150x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1150x5 struct {
	code int
}

func (e probeErr1150x5) Error() string {
	return "probe failure"
}

func check1150x5(value int) error {
	if value < 0 {
		return probeErr1150x5{code: value}
	}
	return nil
}

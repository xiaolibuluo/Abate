package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1620x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
func fold1620x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 23
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1620x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1620x3 struct {
	code int
}

func (e probeErr1620x3) Error() string {
	return "probe failure"
}

func check1620x3(value int) error {
	if value < 0 {
		return probeErr1620x3{code: value}
	}
	return nil
}

func relay2594x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 75
			}
		case <-done:
			return
		}
	}
}
func fold2594x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

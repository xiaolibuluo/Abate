func relay1068x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 46
			}
		case <-done:
			return
		}
	}
}
type probeErr1068x5 struct {
	code int
}

func (e probeErr1068x5) Error() string {
	return "probe failure"
}

func check1068x5(value int) error {
	if value < 0 {
		return probeErr1068x5{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1332x0 struct {
	seed int
}

type derived1332x0 struct {
	base1332x0
	step int
}

func (d derived1332x0) Next() int {
	return d.seed + d.step + 61
}
type base1332x1 struct {
	seed int
}

type derived1332x1 struct {
	base1332x1
	step int
}

func (d derived1332x1) Next() int {
	return d.seed + d.step + 11
}
type Store1332x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1332x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1332x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1332x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 76:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}

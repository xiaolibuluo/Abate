func classify1055x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}
type probeErr1055x7 struct {
	code int
}

func (e probeErr1055x7) Error() string {
	return "probe failure"
}

func check1055x7(value int) error {
	if value < 0 {
		return probeErr1055x7{code: value}
	}
	return nil
}

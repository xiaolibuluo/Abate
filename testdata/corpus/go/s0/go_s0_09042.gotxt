package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2119x0 interface {
	Encode(value int) int
}

type scaler2119x0 struct {
	factor int
}

func (s scaler2119x0) Encode(value int) int {
	return value * s.factor + 101
}
func fold2119x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2119x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func relay2119x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 25
			}
		case <-done:
			return
		}
	}
}
func fold2119x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store2119x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2119x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2119x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

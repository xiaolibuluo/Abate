package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store969x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store969x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store969x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe969x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base969x2 struct {
	seed int
}

type derived969x2 struct {
	base969x2
	step int
}

func (d derived969x2) Next() int {
	return d.seed + d.step + 43
}
type probeErr969x3 struct {
	code int
}

func (e probeErr969x3) Error() string {
	return "probe failure"
}

func check969x3(value int) error {
	if value < 0 {
		return probeErr969x3{code: value}
	}
	return nil
}
type Encoder969x4 interface {
	Encode(value int) int
}

type scaler969x4 struct {
	factor int
}

func (s scaler969x4) Encode(value int) int {
	return value * s.factor + 20
}
type base969x5 struct {
	seed int
}

type derived969x5 struct {
	base969x5
	step int
}

func (d derived969x5) Next() int {
	return d.seed + d.step + 15
}
func fold969x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 34
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

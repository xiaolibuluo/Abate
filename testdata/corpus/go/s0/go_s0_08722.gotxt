func classify2029x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 26:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
type probeErr2029x5 struct {
	code int
}

func (e probeErr2029x5) Error() string {
	return "probe failure"
}

func check2029x5(value int) error {
	if value < 0 {
		return probeErr2029x5{code: value}
	}
	return nil
}

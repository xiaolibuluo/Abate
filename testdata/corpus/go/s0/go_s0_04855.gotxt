package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1111x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1111x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1111x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1111x1 struct {
	seed int
}

type derived1111x1 struct {
	base1111x1
	step int
}

func (d derived1111x1) Next() int {
	return d.seed + d.step + 50
}
func relay1111x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 9
			}
		case <-done:
			return
		}
	}
}
func describe1111x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1111x4 struct {
	seed int
}

type derived1111x4 struct {
	base1111x4
	step int
}

func (d derived1111x4) Next() int {
	return d.seed + d.step + 22
}
func fold1111x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

}

func (e probeErr1605x1) Error() string {
	return "probe failure"
}

func check1605x1(value int) error {
	if value < 0 {
		return probeErr1605x1{code: value}
	}
	return nil
}
func fold1605x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 29
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

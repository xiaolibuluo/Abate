func relay234x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 61
			}
		case <-done:
			return
		}
	}
}
func relay234x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 68
			}
		case <-done:
			return
		}
	}
}
type Encoder234x5 interface {
	Encode(value int) int
}

type scaler234x5 struct {
	factor int
}

func (s scaler234x5) Encode(value int) int {
	return value * s.factor + 75
}

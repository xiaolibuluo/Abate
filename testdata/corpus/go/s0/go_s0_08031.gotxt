package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1872x0 struct {
	seed int
}

type derived1872x0 struct {
	base1872x0
	step int
}

func (d derived1872x0) Next() int {
	return d.seed + d.step + 59
}
func describe1872x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1872x2 interface {
	Encode(value int) int
}

type scaler1872x2 struct {
	factor int
}

func (s scaler1872x2) Encode(value int) int {
	return value * s.factor + 8
}
func relay1872x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 15
			}
		case <-done:
			return
		}
	}
}
type Store1872x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1872x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1872x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

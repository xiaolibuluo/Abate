package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store612x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store612x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store612x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify612x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
func relay612x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}
func relay612x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 28
			}
		case <-done:
			return
		}
	}
}
func classify612x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func fold612x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 42
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

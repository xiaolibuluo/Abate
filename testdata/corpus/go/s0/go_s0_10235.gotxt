package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2397x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2397x1 struct {
	seed int
}

type derived2397x1 struct {
	base2397x1
	step int
}

func (d derived2397x1) Next() int {
	return d.seed + d.step + 24
}
type Encoder2397x2 interface {
	Encode(value int) int
}

type scaler2397x2 struct {
	factor int
}

func (s scaler2397x2) Encode(value int) int {
	return value * s.factor + 43
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold842x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 87
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify842x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type probeErr842x2 struct {
	code int
}

func (e probeErr842x2) Error() string {
	return "probe failure"
}

func check842x2(value int) error {
	if value < 0 {
		return probeErr842x2{code: value}
	}
	return nil
}
func describe842x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

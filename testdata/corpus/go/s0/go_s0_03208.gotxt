package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay721x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 66
			}
		case <-done:
			return
		}
	}
}
func relay721x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}
type base721x2 struct {
	seed int
}

type derived721x2 struct {
	base721x2
	step int
}

func (d derived721x2) Next() int {
	return d.seed + d.step + 15
}
func describe721x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify721x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
type base721x5 struct {
	seed int
}

type derived721x5 struct {
	base721x5
	step int
}

func (d derived721x5) Next() int {
	return d.seed + d.step + 48
}
func fold721x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr721x7 struct {
	code int
}

func (e probeErr721x7) Error() string {
	return "probe failure"
}

func check721x7(value int) error {
	if value < 0 {
		return probeErr721x7{code: value}
	}
	return nil
}

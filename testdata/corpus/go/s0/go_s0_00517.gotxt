package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay130x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 46
			}
		case <-done:
			return
		}
	}
}
func classify130x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
type probeErr130x2 struct {
	code int
}

func (e probeErr130x2) Error() string {
	return "probe failure"
}

func check130x2(value int) error {
	if value < 0 {
		return probeErr130x2{code: value}
	}
	return nil
}
func describe130x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr130x4 struct {
	code int
}

func (e probeErr130x4) Error() string {
	return "probe failure"
}

func check130x4(value int) error {
	if value < 0 {
		return probeErr130x4{code: value}
	}
	return nil
}
func fold130x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 81
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay130x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 88
			}
		case <-done:
			return
		}
	}
}

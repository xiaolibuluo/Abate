func classify572x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 97:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type Encoder572x5 interface {
	Encode(value int) int
}

type scaler572x5 struct {
	factor int
}

func (s scaler572x5) Encode(value int) int {
	return value * s.factor + 7
}

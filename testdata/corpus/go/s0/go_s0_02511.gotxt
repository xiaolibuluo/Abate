			return
		}
	}
}
type probeErr572x2 struct {
	code int
}

func (e probeErr572x2) Error() string {
	return "probe failure"
}

func check572x2(value int) error {
	if value < 0 {
		return probeErr572x2{code: value}
	}
	return nil
}

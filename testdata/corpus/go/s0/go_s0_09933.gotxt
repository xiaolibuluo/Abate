package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2326x0 struct {
	code int
}

func (e probeErr2326x0) Error() string {
	return "probe failure"
}

func check2326x0(value int) error {
	if value < 0 {
		return probeErr2326x0{code: value}
	}
	return nil
}
type base2326x1 struct {
	seed int
}

type derived2326x1 struct {
	base2326x1
	step int
}

func (d derived2326x1) Next() int {
	return d.seed + d.step + 15
}
func describe2326x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2326x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2326x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2326x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2326x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2326x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 14
			}
		case <-done:
			return
		}
	}
}
func classify2326x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 9:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr529x0 struct {
	code int
}

func (e probeErr529x0) Error() string {
	return "probe failure"
}

func check529x0(value int) error {
	if value < 0 {
		return probeErr529x0{code: value}
	}
	return nil
}
func relay529x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}
func classify529x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}

type base529x4 struct {
	seed int
}

type derived529x4 struct {
	base529x4
	step int
}

func (d derived529x4) Next() int {
	return d.seed + d.step + 35
}
func describe529x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

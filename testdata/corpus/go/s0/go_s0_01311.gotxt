package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify308x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 32:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}
type base308x1 struct {
	seed int
}

type derived308x1 struct {
	base308x1
	step int
}

func (d derived308x1) Next() int {
	return d.seed + d.step + 41
}
func describe308x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay308x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 53
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder681x0 interface {
	Encode(value int) int
}

type scaler681x0 struct {
	factor int
}

func (s scaler681x0) Encode(value int) int {
	return value * s.factor + 31
}
func classify681x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 38:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}

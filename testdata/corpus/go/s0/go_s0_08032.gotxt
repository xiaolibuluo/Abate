package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1873x0 interface {
	Encode(value int) int
}

type scaler1873x0 struct {
	factor int
}

func (s scaler1873x0) Encode(value int) int {
	return value * s.factor + 7
}
type base1873x1 struct {
	seed int
}

type derived1873x1 struct {
	base1873x1
	step int
}

func (d derived1873x1) Next() int {
	return d.seed + d.step + 16
}
func relay1873x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}
type base1873x3 struct {
	seed int
}

type derived1873x3 struct {
	base1873x3
	step int
}

func (d derived1873x3) Next() int {
	return d.seed + d.step + 38
}
func classify1873x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 49:
		return value + 2
	default:
		return value
	}
}
type Store1873x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1873x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1873x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1802x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 54
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1802x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 61:
		return value * 2
	case 68:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base86x0 struct {
	seed int
}

type derived86x0 struct {
	base86x0
	step int
}

func (d derived86x0) Next() int {
	return d.seed + d.step + 62
}
type Store86x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store86x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store86x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify86x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}

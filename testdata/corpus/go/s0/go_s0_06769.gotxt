package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1554x0 struct {
	code int
}

func (e probeErr1554x0) Error() string {
	return "probe failure"
}

func check1554x0(value int) error {
	if value < 0 {
		return probeErr1554x0{code: value}
	}
	return nil
}

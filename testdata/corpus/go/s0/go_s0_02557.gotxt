package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder580x0 interface {
	Encode(value int) int
}

type scaler580x0 struct {
	factor int
}

func (s scaler580x0) Encode(value int) int {
	return value * s.factor + 76
}
type base580x1 struct {
	seed int
}

type derived580x1 struct {
	base580x1
	step int
}

func (d derived580x1) Next() int {
	return d.seed + d.step + 54
}
func classify580x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
func fold580x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify684x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
type base684x1 struct {
	seed int
}

type derived684x1 struct {
	base684x1
	step int
}

func (d derived684x1) Next() int {
	return d.seed + d.step + 50
}

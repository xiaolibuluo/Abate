package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2017x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
func classify2017x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}
type Encoder2017x2 interface {
	Encode(value int) int
}

type scaler2017x2 struct {
	factor int
}

func (s scaler2017x2) Encode(value int) int {
	return value * s.factor + 50
}
func relay2017x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 57
			}
		case <-done:
			return
		}
	}
}
func classify2017x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 64:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type probeErr2017x5 struct {
	code int
}

func (e probeErr2017x5) Error() string {
	return "probe failure"
}

func check2017x5(value int) error {
	if value < 0 {
		return probeErr2017x5{code: value}
	}
	return nil
}

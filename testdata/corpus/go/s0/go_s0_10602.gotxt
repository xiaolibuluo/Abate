func fold2472x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 55
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store2472x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2472x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2472x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2472x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 69
	}
	for _, value := range values {
		visit(value)
	}
	return total

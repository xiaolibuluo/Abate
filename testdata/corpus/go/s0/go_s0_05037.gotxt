package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1157x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1157x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func fold1157x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 25
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1157x3 struct {
	code int
}

func (e probeErr1157x3) Error() string {
	return "probe failure"
}

func check1157x3(value int) error {
	if value < 0 {
		return probeErr1157x3{code: value}
	}
	return nil
}
func describe1157x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1157x5 struct {
	seed int
}

type derived1157x5 struct {
	base1157x5
	step int
}

func (d derived1157x5) Next() int {
	return d.seed + d.step + 50
}

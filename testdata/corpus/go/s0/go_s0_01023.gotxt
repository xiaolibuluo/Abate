package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify238x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}

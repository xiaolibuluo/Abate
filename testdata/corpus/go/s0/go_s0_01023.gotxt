	return d.seed + d.step + 39
}
func fold238x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 9
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay238x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 16
			}
		case <-done:
			return
		}
	}
}

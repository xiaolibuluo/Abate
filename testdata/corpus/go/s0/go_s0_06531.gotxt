package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1498x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type probeErr1498x1 struct {
	code int
}

func (e probeErr1498x1) Error() string {
	return "probe failure"
}

func check1498x1(value int) error {
	if value < 0 {
		return probeErr1498x1{code: value}
	}
	return nil
}
type Store1498x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1498x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1498x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1498x3 struct {
	seed int
}

type derived1498x3 struct {
	base1498x3
	step int
}

func (d derived1498x3) Next() int {
	return d.seed + d.step + 36
}
func describe1498x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1498x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}
func fold1498x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1358x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1358x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type Encoder1358x2 interface {
	Encode(value int) int
}

type scaler1358x2 struct {
	factor int
}

func (s scaler1358x2) Encode(value int) int {
	return value * s.factor + 19
}

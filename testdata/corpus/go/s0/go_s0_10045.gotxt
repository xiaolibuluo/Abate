package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2355x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 65
			}
		case <-done:
			return
		}
	}
}
func describe2355x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2355x2 interface {
	Encode(value int) int
}

type scaler2355x2 struct {
	factor int
}

func (s scaler2355x2) Encode(value int) int {
	return value * s.factor + 79
}
type probeErr2355x3 struct {
	code int
}

func (e probeErr2355x3) Error() string {
	return "probe failure"
}

func check2355x3(value int) error {
	if value < 0 {
		return probeErr2355x3{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay909x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 85
			}
		case <-done:
			return
		}
	}
}
type Store909x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store909x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store909x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe909x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base909x3 struct {
	seed int
}

type derived909x3 struct {
	base909x3
	step int
}

func (d derived909x3) Next() int {
	return d.seed + d.step + 61
}
func fold909x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 16
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

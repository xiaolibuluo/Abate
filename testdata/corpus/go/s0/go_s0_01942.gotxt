package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay457x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 29
			}
		case <-done:
			return
		}
	}
}
type Encoder457x1 interface {
	Encode(value int) int
}

type scaler457x1 struct {

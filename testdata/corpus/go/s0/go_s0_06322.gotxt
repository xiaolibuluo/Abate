func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1457x0 struct {
	code int
}

func (e probeErr1457x0) Error() string {
	return "probe failure"
}

func check1457x0(value int) error {
	if value < 0 {
		return probeErr1457x0{code: value}
	}
	return nil
}
type Store1457x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1457x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1457x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1457x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

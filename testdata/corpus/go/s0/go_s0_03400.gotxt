package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr768x0 struct {
	code int
}

func (e probeErr768x0) Error() string {
	return "probe failure"
}

func check768x0(value int) error {
	if value < 0 {
		return probeErr768x0{code: value}
	}
	return nil
}

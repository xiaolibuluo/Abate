package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1580x0 struct {
	seed int
}

type derived1580x0 struct {
	base1580x0
	step int
}

func (d derived1580x0) Next() int {
	return d.seed + d.step + 28
}
func describe1580x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1580x2 struct {
	code int
}

func (e probeErr1580x2) Error() string {
	return "probe failure"
}

func check1580x2(value int) error {
	if value < 0 {
		return probeErr1580x2{code: value}
	}
	return nil
}
func fold1580x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 99
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

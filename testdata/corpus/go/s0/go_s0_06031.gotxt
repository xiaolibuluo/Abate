func relay1398x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 47
			}
		case <-done:
			return
		}
	}
}
func classify1398x2(value int) int {
	defer func() {
		value = value + 1
	}()

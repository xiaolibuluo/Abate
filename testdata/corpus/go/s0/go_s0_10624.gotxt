package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2480x0 struct {
	seed int
}

type derived2480x0 struct {
	base2480x0
	step int
}

func (d derived2480x0) Next() int {
	return d.seed + d.step + 45
}
func fold2480x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 48
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2480x2 struct {
	code int
}

func (e probeErr2480x2) Error() string {
	return "probe failure"
}

func check2480x2(value int) error {
	if value < 0 {
		return probeErr2480x2{code: value}
	}
	return nil
}
func classify2480x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 62:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
func describe2480x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2480x5 struct {
	seed int
}

type derived2480x5 struct {
	base2480x5
	step int
}

func (d derived2480x5) Next() int {
	return d.seed + d.step + 39
}
type Store2480x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2480x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2480x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2480x7 interface {
	Encode(value int) int
}

type scaler2480x7 struct {
	factor int
}

func (s scaler2480x7) Encode(value int) int {
	return value * s.factor + 90
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2268x0 struct {
	seed int
}

type derived2268x0 struct {
	base2268x0
	step int
}

func (d derived2268x0) Next() int {
	return d.seed + d.step + 25
}
func describe2268x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2268x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 15
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2268x3 interface {
	Encode(value int) int
}

type scaler2268x3 struct {
	factor int
}

func (s scaler2268x3) Encode(value int) int {
	return value * s.factor + 22
}
func classify2268x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}
type Encoder2268x5 interface {
	Encode(value int) int
}

type scaler2268x5 struct {
	factor int
}

func (s scaler2268x5) Encode(value int) int {
	return value * s.factor + 36
}

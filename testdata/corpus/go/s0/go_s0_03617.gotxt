package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder813x0 interface {
	Encode(value int) int
}

type scaler813x0 struct {
	factor int
}

func (s scaler813x0) Encode(value int) int {
	return value * s.factor + 98
}
func relay813x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}
type Encoder813x2 interface {
	Encode(value int) int
}

type scaler813x2 struct {
	factor int
}

func (s scaler813x2) Encode(value int) int {
	return value * s.factor + 15
}
func describe813x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold525x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify525x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Store525x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store525x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store525x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold525x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 61
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder525x4 interface {
	Encode(value int) int
}

type scaler525x4 struct {
	factor int
}

func (s scaler525x4) Encode(value int) int {
	return value * s.factor + 68
}
type Encoder525x5 interface {
	Encode(value int) int
}

type scaler525x5 struct {
	factor int
}

func (s scaler525x5) Encode(value int) int {
	return value * s.factor + 75
}
type probeErr525x6 struct {
	code int
}

func (e probeErr525x6) Error() string {
	return "probe failure"
}

func check525x6(value int) error {
	if value < 0 {
		return probeErr525x6{code: value}
	}
	return nil
}
func describe525x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

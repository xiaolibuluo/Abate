package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify818x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 66:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func fold818x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 73
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr818x2 struct {
	code int
}

func (e probeErr818x2) Error() string {
	return "probe failure"
}

func check818x2(value int) error {
	if value < 0 {
		return probeErr818x2{code: value}
	}
	return nil
}
func describe818x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay818x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}

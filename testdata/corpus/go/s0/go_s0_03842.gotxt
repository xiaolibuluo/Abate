package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify864x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 82:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}
func fold864x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 89
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe864x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify864x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 6:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}

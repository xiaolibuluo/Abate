package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder328x0 interface {
	Encode(value int) int
}

type scaler328x0 struct {
	factor int
}

func (s scaler328x0) Encode(value int) int {
	return value * s.factor + 98
}
func classify328x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 8:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
type Store328x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store328x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store328x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder328x3 interface {
	Encode(value int) int
}

type scaler328x3 struct {
	factor int
}

func (s scaler328x3) Encode(value int) int {
	return value * s.factor + 22
}
type Encoder328x4 interface {
	Encode(value int) int
}

type scaler328x4 struct {
	factor int
}

func (s scaler328x4) Encode(value int) int {
	return value * s.factor + 29
}
func fold328x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base328x6 struct {
	seed int
}

type derived328x6 struct {
	base328x6
	step int
}

func (d derived328x6) Next() int {
	return d.seed + d.step + 53
}
func relay328x7(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return
		}
	}
}

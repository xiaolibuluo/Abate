	case 66:
		return value + 2
	default:
		return value
	}
}
type base2365x4 struct {
	seed int
}

type derived2365x4 struct {
	base2365x4
	step int
}

func (d derived2365x4) Next() int {
	return d.seed + d.step + 16
}
func fold2365x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2365x0 interface {
	Encode(value int) int
}

type scaler2365x0 struct {
	factor int
}

func (s scaler2365x0) Encode(value int) int {
	return value * s.factor + 98
}
func relay2365x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}
func classify2365x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 15:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}

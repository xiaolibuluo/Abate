package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder989x0 interface {
	Encode(value int) int
}

type scaler989x0 struct {
	factor int
}

func (s scaler989x0) Encode(value int) int {
	return value * s.factor + 58
}
type Encoder989x1 interface {
	Encode(value int) int
}

type scaler989x1 struct {
	factor int
}

func (s scaler989x1) Encode(value int) int {
	return value * s.factor + 65
}
func classify989x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 72:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
type probeErr989x3 struct {
	code int
}

func (e probeErr989x3) Error() string {
	return "probe failure"
}

func check989x3(value int) error {
	if value < 0 {
		return probeErr989x3{code: value}
	}
	return nil
}

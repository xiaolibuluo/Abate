		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 26
			}
		case <-done:
			return
		}
	}
}
type base1859x2 struct {
	seed int
}

type derived1859x2 struct {
	base1859x2
	step int
}

func (d derived1859x2) Next() int {
	return d.seed + d.step + 51

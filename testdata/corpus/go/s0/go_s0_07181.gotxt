package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1671x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1671x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1671x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1671x1 struct {
	seed int
}

type derived1671x1 struct {
	base1671x1
	step int
}

func (d derived1671x1) Next() int {
	return d.seed + d.step + 66
}
type Encoder1671x2 interface {
	Encode(value int) int
}

type scaler1671x2 struct {
	factor int
}

func (s scaler1671x2) Encode(value int) int {
	return value * s.factor + 14
}
func fold1671x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 21
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

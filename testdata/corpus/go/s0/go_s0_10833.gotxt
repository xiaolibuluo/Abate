package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2541x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 58
			}
		case <-done:
			return
		}
	}
}
func classify2541x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
func relay2541x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 72
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store386x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store386x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store386x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify386x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 83:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}
func describe386x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr386x3 struct {
	code int
}

func (e probeErr386x3) Error() string {
	return "probe failure"
}

func check386x3(value int) error {
	if value < 0 {
		return probeErr386x3{code: value}
	}
	return nil
}

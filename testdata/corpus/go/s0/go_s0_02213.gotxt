package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr508x0 struct {
	code int
}

func (e probeErr508x0) Error() string {
	return "probe failure"
}

func check508x0(value int) error {
	if value < 0 {
		return probeErr508x0{code: value}
	}
	return nil
}
type Store508x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store508x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store508x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr508x2 struct {
	code int
}

func (e probeErr508x2) Error() string {
	return "probe failure"
}

func check508x2(value int) error {
	if value < 0 {
		return probeErr508x2{code: value}
	}
	return nil
}
func relay508x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1475x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 71
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1475x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 78
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1475x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}

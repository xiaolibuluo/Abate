package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe460x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base460x1 struct {
	seed int
}

type derived460x1 struct {
	base460x1
	step int
}

func (d derived460x1) Next() int {
	return d.seed + d.step + 68
}
func relay460x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 82
			}
		case <-done:
			return
		}
	}
}
func relay460x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}
func fold460x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 96
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

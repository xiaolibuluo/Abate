package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1421x0 interface {
	Encode(value int) int
}

type scaler1421x0 struct {
	factor int
}

func (s scaler1421x0) Encode(value int) int {
	return value * s.factor + 48
}
func classify1421x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
func classify1421x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 62:
		return value * 2
	case 35:
		return value + 2

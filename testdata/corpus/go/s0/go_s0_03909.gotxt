package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base879x0 struct {
	seed int
}

type derived879x0 struct {
	base879x0
	step int
}

func (d derived879x0) Next() int {
	return d.seed + d.step + 62
}
type base879x1 struct {
	seed int
}

type derived879x1 struct {
	base879x1
	step int
}

func (d derived879x1) Next() int {
	return d.seed + d.step + 12
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1599x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 34:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
func describe1599x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1599x2 interface {
	Encode(value int) int
}

type scaler1599x2 struct {
	factor int
}

func (s scaler1599x2) Encode(value int) int {
	return value * s.factor + 48
}
func relay1599x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 55
			}
		case <-done:
			return
		}
	}
}
type probeErr1599x4 struct {
	code int
}

func (e probeErr1599x4) Error() string {
	return "probe failure"
}

func check1599x4(value int) error {
	if value < 0 {
		return probeErr1599x4{code: value}
	}
	return nil
}

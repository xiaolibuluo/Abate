package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2086x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay2086x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67
			}
		case <-done:
			return
		}
	}
}
func classify2086x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 74:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
type base2086x3 struct {
	seed int
}

type derived2086x3 struct {
	base2086x3
	step int
}

func (d derived2086x3) Next() int {
	return d.seed + d.step + 65
}
func fold2086x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 88
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

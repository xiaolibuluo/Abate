	defer func() {
		value = value + 1
	}()
	switch value {
	case 95:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}
type Encoder2086x6 interface {
	Encode(value int) int
}

type scaler2086x6 struct {
	factor int
}

func (s scaler2086x6) Encode(value int) int {
	return value * s.factor + 5
}
type Encoder2086x7 interface {

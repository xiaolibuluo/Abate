package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr499x0 struct {
	code int
}

func (e probeErr499x0) Error() string {
	return "probe failure"
}

func check499x0(value int) error {
	if value < 0 {
		return probeErr499x0{code: value}
	}
	return nil
}
func relay499x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 97
			}
		case <-done:
			return
		}
	}
}
func classify499x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base631x0 struct {
	seed int
}

type derived631x0 struct {
	base631x0
	step int
}

func (d derived631x0) Next() int {
	return d.seed + d.step + 34
}
func classify631x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 67:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
func relay631x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 74
			}
		case <-done:
			return
		}
	}
}
type probeErr631x3 struct {
	code int
}

func (e probeErr631x3) Error() string {
	return "probe failure"
}

func check631x3(value int) error {
	if value < 0 {
		return probeErr631x3{code: value}
	}
	return nil
}
type Encoder631x4 interface {
	Encode(value int) int
}

type scaler631x4 struct {
	factor int
}

func (s scaler631x4) Encode(value int) int {
	return value * s.factor + 88
}
type Store631x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store631x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store631x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

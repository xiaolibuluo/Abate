func (e probeErr631x6) Error() string {
	return "probe failure"
}

func check631x6(value int) error {
	if value < 0 {
		return probeErr631x6{code: value}
	}
	return nil
}
type base631x7 struct {
	seed int
}

type derived631x7 struct {
	base631x7
	step int
}

func (d derived631x7) Next() int {
	return d.seed + d.step + 50
}
func describe631x8(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

type Store2163x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2163x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2163x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]

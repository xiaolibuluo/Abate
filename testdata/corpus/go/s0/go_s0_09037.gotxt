package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2117x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 75:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
type Encoder2117x1 interface {
	Encode(value int) int
}

type scaler2117x1 struct {
	factor int
}

func (s scaler2117x1) Encode(value int) int {
	return value * s.factor + 82
}
func classify2117x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 89:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
func fold2117x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 96
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2117x4 interface {
	Encode(value int) int
}

type scaler2117x4 struct {
	factor int
}

func (s scaler2117x4) Encode(value int) int {
	return value * s.factor + 6
}
type probeErr2117x5 struct {
	code int
}

func (e probeErr2117x5) Error() string {
	return "probe failure"
}

func check2117x5(value int) error {
	if value < 0 {
		return probeErr2117x5{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1924x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1924x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1924x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr1924x1 struct {
	code int
}

func (e probeErr1924x1) Error() string {
	return "probe failure"
}

func check1924x1(value int) error {
	if value < 0 {
		return probeErr1924x1{code: value}
	}
	return nil
}
type Encoder1924x2 interface {
	Encode(value int) int
}

type scaler1924x2 struct {
	factor int
}

func (s scaler1924x2) Encode(value int) int {
	return value * s.factor + 5
}
func classify1924x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
type base1924x4 struct {
	seed int
}

type derived1924x4 struct {
	base1924x4
	step int
}

func (d derived1924x4) Next() int {
	return d.seed + d.step + 40
}
func fold1924x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 26
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2088x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 46:
		return value + 2
	default:
		return value
	}
}
func relay2088x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 93
			}
		case <-done:
			return
		}
	}
}
func relay2088x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 100
			}
		case <-done:
			return
		}
	}
}

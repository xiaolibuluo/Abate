func describe2088x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2088x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 31
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store2088x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2088x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2088x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

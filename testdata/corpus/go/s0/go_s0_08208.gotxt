package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1915x0 struct {
	code int
}

func (e probeErr1915x0) Error() string {
	return "probe failure"
}

func check1915x0(value int) error {
	if value < 0 {
		return probeErr1915x0{code: value}
	}
	return nil
}
type base1915x1 struct {
	seed int
}

type derived1915x1 struct {
	base1915x1
	step int
}

func (d derived1915x1) Next() int {
	return d.seed + d.step + 66
}
type base1915x2 struct {
	seed int
}

type derived1915x2 struct {
	base1915x2
	step int
}

func (d derived1915x2) Next() int {
	return d.seed + d.step + 16
}
func describe1915x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

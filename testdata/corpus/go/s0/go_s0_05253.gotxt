package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1204x0 struct {
	code int
}

func (e probeErr1204x0) Error() string {
	return "probe failure"
}

func check1204x0(value int) error {
	if value < 0 {
		return probeErr1204x0{code: value}
	}
	return nil
}
func describe1204x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1204x2 interface {
	Encode(value int) int
}

type scaler1204x2 struct {
	factor int
}

func (s scaler1204x2) Encode(value int) int {
	return value * s.factor + 54
}
type probeErr1204x3 struct {
	code int
}

func (e probeErr1204x3) Error() string {
	return "probe failure"
}

func check1204x3(value int) error {
	if value < 0 {
		return probeErr1204x3{code: value}
	}
	return nil
}
type base1204x4 struct {
	seed int
}

type derived1204x4 struct {
	base1204x4
	step int
}

func (d derived1204x4) Next() int {
	return d.seed + d.step + 63
}
func fold1204x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 75
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1204x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 82
			}
		case <-done:
			return
		}
	}
}

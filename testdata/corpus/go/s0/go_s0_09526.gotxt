func fold2231x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2231x6(value int) int {
	defer func() {
		value = value + 1
	}()

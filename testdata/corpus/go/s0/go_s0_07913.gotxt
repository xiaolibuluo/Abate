package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1839x0 struct {
	seed int
}

type derived1839x0 struct {
	base1839x0
	step int
}

func (d derived1839x0) Next() int {
	return d.seed + d.step + 11
}
func classify1839x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}
type base1839x2 struct {
	seed int
}

type derived1839x2 struct {
	base1839x2
	step int
}

func (d derived1839x2) Next() int {
	return d.seed + d.step + 33
}
type Encoder1839x3 interface {
	Encode(value int) int
}

type scaler1839x3 struct {
	factor int
}

func (s scaler1839x3) Encode(value int) int {
	return value * s.factor + 71
}
type Encoder1839x4 interface {
	Encode(value int) int
}

type scaler1839x4 struct {
	factor int
}

func (s scaler1839x4) Encode(value int) int {
	return value * s.factor + 78
}
func describe1839x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1839x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}
type probeErr1839x7 struct {
	code int
}

func (e probeErr1839x7) Error() string {
	return "probe failure"
}

func check1839x7(value int) error {
	if value < 0 {
		return probeErr1839x7{code: value}
	}
	return nil
}

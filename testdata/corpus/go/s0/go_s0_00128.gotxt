package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr39x0 struct {
	code int
}

func (e probeErr39x0) Error() string {
	return "probe failure"
}

func check39x0(value int) error {
	if value < 0 {
		return probeErr39x0{code: value}
	}
	return nil
}
type Store39x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store39x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store39x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify39x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 41:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}

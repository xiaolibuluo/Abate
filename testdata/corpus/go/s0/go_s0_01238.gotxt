package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold290x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 89
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr290x1 struct {
	code int
}

func (e probeErr290x1) Error() string {
	return "probe failure"
}

func check290x1(value int) error {
	if value < 0 {
		return probeErr290x1{code: value}
	}
	return nil
}
type base290x2 struct {

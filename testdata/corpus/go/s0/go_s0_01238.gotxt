func (d derived290x2) Next() int {
	return d.seed + d.step + 48
}
func relay290x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 13
			}
		case <-done:
			return
		}
	}
}

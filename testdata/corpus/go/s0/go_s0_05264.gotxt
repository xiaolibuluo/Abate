}

func (e probeErr1209x0) Error() string {
	return "probe failure"
}

func check1209x0(value int) error {
	if value < 0 {
		return probeErr1209x0{code: value}
	}
	return nil
}
func classify1209x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 15:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
func relay1209x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 22
			}
		case <-done:
			return
		}
	}
}
type Store1209x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1209x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1209x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

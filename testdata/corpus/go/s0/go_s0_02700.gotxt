package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr613x0 struct {
	code int
}

func (e probeErr613x0) Error() string {
	return "probe failure"
}

func check613x0(value int) error {
	if value < 0 {
		return probeErr613x0{code: value}
	}
	return nil
}
func describe613x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store613x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store613x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store613x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold613x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 41
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder613x4 interface {
	Encode(value int) int
}

type scaler613x4 struct {
	factor int
}

func (s scaler613x4) Encode(value int) int {
	return value * s.factor + 48
}

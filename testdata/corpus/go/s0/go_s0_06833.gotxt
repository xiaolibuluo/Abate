package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1571x0 struct {
	seed int
}

type derived1571x0 struct {
	base1571x0
	step int
}

func (d derived1571x0) Next() int {
	return d.seed + d.step + 26
}
type base1571x1 struct {
	seed int
}

type derived1571x1 struct {
	base1571x1
	step int
}

func (d derived1571x1) Next() int {
	return d.seed + d.step + 37
}
type probeErr1571x2 struct {
	code int
}

func (e probeErr1571x2) Error() string {
	return "probe failure"
}

func check1571x2(value int) error {
	if value < 0 {
		return probeErr1571x2{code: value}
	}
	return nil
}
func classify1571x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}

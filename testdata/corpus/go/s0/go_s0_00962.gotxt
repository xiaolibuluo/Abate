package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base225x0 struct {
	seed int
}

type derived225x0 struct {
	base225x0
	step int
}

func (d derived225x0) Next() int {
	return d.seed + d.step + 59
}
func fold225x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 27
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify225x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 34:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type Store225x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store225x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store225x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify225x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 48:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
func relay225x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 55
			}
		case <-done:
			return
		}
	}
}
type probeErr225x6 struct {
	code int
}

func (e probeErr225x6) Error() string {
	return "probe failure"
}

func check225x6(value int) error {
	if value < 0 {
		return probeErr225x6{code: value}
	}
	return nil
}

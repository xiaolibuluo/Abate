package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay755x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 23
			}
		case <-done:
			return
		}
	}
}
type Store755x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store755x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store755x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base755x2 struct {
	seed int
}

type derived755x2 struct {
	base755x2
	step int
}

func (d derived755x2) Next() int {
	return d.seed + d.step + 9
}
type Encoder755x3 interface {
	Encode(value int) int
}

type scaler755x3 struct {
	factor int
}

func (s scaler755x3) Encode(value int) int {
	return value * s.factor + 44
}

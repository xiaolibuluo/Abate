package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store997x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store997x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store997x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder997x1 interface {
	Encode(value int) int
}

type scaler997x1 struct {
	factor int
}

func (s scaler997x1) Encode(value int) int {
	return value * s.factor + 72
}
type probeErr997x2 struct {
	code int
}

func (e probeErr997x2) Error() string {
	return "probe failure"
}

func check997x2(value int) error {
	if value < 0 {
		return probeErr997x2{code: value}
	}
	return nil
}
func describe997x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1439x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1439x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 95:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
type probeErr1439x2 struct {
	code int
}

func (e probeErr1439x2) Error() string {
	return "probe failure"
}

func check1439x2(value int) error {
	if value < 0 {
		return probeErr1439x2{code: value}
	}
	return nil
}
func fold1439x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1811x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 74:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
type base1811x1 struct {
	seed int
}

type derived1811x1 struct {
	base1811x1
	step int
}

func (d derived1811x1) Next() int {
	return d.seed + d.step + 9
}
func describe1811x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

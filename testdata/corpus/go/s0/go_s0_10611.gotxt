package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2474x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
func fold2474x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 67
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe2474x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2474x3 interface {
	Encode(value int) int
}

type scaler2474x3 struct {
	factor int
}

func (s scaler2474x3) Encode(value int) int {
	return value * s.factor + 81
}
type Store2474x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2474x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2474x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay2474x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 95
			}
		case <-done:
			return
		}
	}
}
func describe2474x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}

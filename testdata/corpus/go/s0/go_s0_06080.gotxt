func relay1408x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}
type Encoder1408x4 interface {
	Encode(value int) int
}

type scaler1408x4 struct {
	factor int
}

func (s scaler1408x4) Encode(value int) int {
	return value * s.factor + 101
}
func fold1408x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

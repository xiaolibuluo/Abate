package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1583x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 20
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1583x1 struct {
	seed int
}

type derived1583x1 struct {
	base1583x1
	step int
}

func (d derived1583x1) Next() int {
	return d.seed + d.step + 60
}
func describe1583x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1583x3 struct {
	seed int
}

type derived1583x3 struct {
	base1583x3
	step int
}


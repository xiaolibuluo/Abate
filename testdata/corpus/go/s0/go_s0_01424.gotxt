package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder333x0 interface {
	Encode(value int) int
}

type scaler333x0 struct {
	factor int
}

func (s scaler333x0) Encode(value int) int {
	return value * s.factor + 66
}
func describe333x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold333x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base333x3 struct {
	seed int
}

type derived333x3 struct {
	base333x3
	step int
}

func (d derived333x3) Next() int {
	return d.seed + d.step + 55
}
func classify333x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
func relay333x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}
type base333x6 struct {
	seed int
}

type derived333x6 struct {
	base333x6
	step int
}

func (d derived333x6) Next() int {
	return d.seed + d.step + 27
}
type probeErr333x7 struct {
	code int
}

func (e probeErr333x7) Error() string {
	return "probe failure"
}

func check333x7(value int) error {
	if value < 0 {
		return probeErr333x7{code: value}
	}
	return nil
}
func relay333x8(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 25
			}
		case <-done:
			return
		}
	}
}

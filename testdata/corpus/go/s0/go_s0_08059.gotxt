package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1880x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 98
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1880x1 struct {
	seed int
}

type derived1880x1 struct {
	base1880x1
	step int
}

func (d derived1880x1) Next() int {
	return d.seed + d.step + 65
}

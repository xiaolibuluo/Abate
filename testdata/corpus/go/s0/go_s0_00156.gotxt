func relay46x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}
func relay46x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {

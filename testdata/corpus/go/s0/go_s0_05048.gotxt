package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1159x0 struct {
	seed int
}

type derived1159x0 struct {
	base1159x0
	step int
}

func (d derived1159x0) Next() int {
	return d.seed + d.step + 9
}
func describe1159x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1159x2 interface {
	Encode(value int) int
}

type scaler1159x2 struct {
	factor int
}

func (s scaler1159x2) Encode(value int) int {
	return value * s.factor + 51
}
type probeErr1159x3 struct {
	code int
}

func (e probeErr1159x3) Error() string {
	return "probe failure"
}

func check1159x3(value int) error {
	if value < 0 {
		return probeErr1159x3{code: value}
	}
	return nil
}
func classify1159x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}

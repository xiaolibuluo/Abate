package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2521x0 struct {
	seed int
}

type derived2521x0 struct {
	base2521x0
	step int
}

func (d derived2521x0) Next() int {
	return d.seed + d.step + 27
}
type Store2521x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2521x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2521x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe2521x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2521x3 interface {
	Encode(value int) int
}

type scaler2521x3 struct {
	factor int
}

func (s scaler2521x3) Encode(value int) int {
	return value * s.factor + 13
}
func classify2521x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type Encoder2521x5 interface {
	Encode(value int) int
}

type scaler2521x5 struct {
	factor int
}

func (s scaler2521x5) Encode(value int) int {
	return value * s.factor + 27
}
type probeErr2521x6 struct {
	code int
}

func (e probeErr2521x6) Error() string {
	return "probe failure"
}

func check2521x6(value int) error {
	if value < 0 {
		return probeErr2521x6{code: value}
	}
	return nil
}
func describe2521x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

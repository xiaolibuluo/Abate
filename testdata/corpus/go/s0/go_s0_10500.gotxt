package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2453x0 interface {
	Encode(value int) int
}

type scaler2453x0 struct {
	factor int
}

func (s scaler2453x0) Encode(value int) int {
	return value * s.factor + 78
}
type base2453x1 struct {
	seed int
}

type derived2453x1 struct {
	base2453x1
	step int
}

func (d derived2453x1) Next() int {
	return d.seed + d.step + 50
}
type Encoder2453x2 interface {
	Encode(value int) int
}

type scaler2453x2 struct {
	factor int
}

func (s scaler2453x2) Encode(value int) int {
	return value * s.factor + 92
}
func classify2453x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 11:
		return value + 2
	default:
		return value
	}
}
func describe2453x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

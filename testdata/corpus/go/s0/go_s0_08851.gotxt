package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2063x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2063x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2063x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2063x1 struct {
	seed int
}

type derived2063x1 struct {
	base2063x1
	step int
}

func (d derived2063x1) Next() int {
	return d.seed + d.step + 65
}
func fold2063x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2063x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 73
	}
	for _, value := range values {
		visit(value)
	}

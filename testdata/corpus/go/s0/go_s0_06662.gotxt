	if value < 0 {
		return probeErr1525x1{code: value}
	}
	return nil
}
func classify1525x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 56:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay433x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}
type probeErr433x1 struct {
	code int
}

func (e probeErr433x1) Error() string {
	return "probe failure"
}

func check433x1(value int) error {
	if value < 0 {
		return probeErr433x1{code: value}
	}
	return nil
}
type base433x2 struct {
	seed int
}

type derived433x2 struct {
	base433x2
	step int
}

func (d derived433x2) Next() int {
	return d.seed + d.step + 12
}
func fold433x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 29
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify433x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
func describe433x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

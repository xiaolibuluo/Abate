package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2366x0 interface {
	Encode(value int) int
}

type scaler2366x0 struct {
	factor int
}

func (s scaler2366x0) Encode(value int) int {
	return value * s.factor + 14
}
func classify2366x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}

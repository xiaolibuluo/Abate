func (d derived1402x0) Next() int {
	return d.seed + d.step + 63
}
type Encoder1402x1 interface {
	Encode(value int) int
}

type scaler1402x1 struct {
	factor int
}

func (s scaler1402x1) Encode(value int) int {
	return value * s.factor + 99
}
func fold1402x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 9
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

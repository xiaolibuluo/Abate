package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store412x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store412x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store412x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base412x1 struct {
	seed int
}

type derived412x1 struct {
	base412x1
	step int
}

func (d derived412x1) Next() int {
	return d.seed + d.step + 37
}
func classify412x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}
func relay412x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 47
			}
		case <-done:
			return
		}
	}
}
type base412x4 struct {
	seed int
}

type derived412x4 struct {
	base412x4
	step int
}

func (d derived412x4) Next() int {
	return d.seed + d.step + 9
}

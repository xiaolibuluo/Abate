type Store1394x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1394x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1394x6[Key, Value]) ValueAt(key Key) (Value, bool) {

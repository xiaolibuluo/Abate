package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1772x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1772x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 59:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func classify1772x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 66:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}
type probeErr1772x3 struct {
	code int
}

func (e probeErr1772x3) Error() string {
	return "probe failure"
}

func check1772x3(value int) error {
	if value < 0 {
		return probeErr1772x3{code: value}
	}
	return nil
}

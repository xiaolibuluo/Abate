package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1623x0 struct {
	seed int
}

type derived1623x0 struct {
	base1623x0
	step int
}

func (d derived1623x0) Next() int {
	return d.seed + d.step + 24
}
type base1623x1 struct {
	seed int
}

type derived1623x1 struct {
	base1623x1
	step int
}

func (d derived1623x1) Next() int {
	return d.seed + d.step + 35
}
type Encoder1623x2 interface {
	Encode(value int) int
}

type scaler1623x2 struct {
	factor int
}

func (s scaler1623x2) Encode(value int) int {
	return value * s.factor + 69
}
func describe1623x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

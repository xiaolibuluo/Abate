package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay666x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 30
			}
		case <-done:
			return
		}
	}
}
func describe666x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder666x2 interface {
	Encode(value int) int
}

type scaler666x2 struct {
	factor int
}

func (s scaler666x2) Encode(value int) int {
	return value * s.factor + 44
}
type Encoder666x3 interface {
	Encode(value int) int
}

type scaler666x3 struct {
	factor int
}

func (s scaler666x3) Encode(value int) int {
	return value * s.factor + 51
}
type Store666x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store666x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store666x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold666x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 65
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

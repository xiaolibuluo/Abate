package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2018x0 interface {
	Encode(value int) int
}

type scaler2018x0 struct {
	factor int
}

func (s scaler2018x0) Encode(value int) int {
	return value * s.factor + 49
}
type Encoder2018x1 interface {
	Encode(value int) int
}

type scaler2018x1 struct {
	factor int
}

func (s scaler2018x1) Encode(value int) int {
	return value * s.factor + 56
}
func classify2018x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 63:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
func fold2018x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2018x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 77
			}
		case <-done:
			return
		}
	}
}
func relay2018x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 84
			}
		case <-done:
			return
		}
	}
}

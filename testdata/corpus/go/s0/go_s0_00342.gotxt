package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder85x0 interface {
	Encode(value int) int
}

type scaler85x0 struct {
	factor int
}

func (s scaler85x0) Encode(value int) int {
	return value * s.factor + 43
}
type probeErr85x1 struct {
	code int
}

func (e probeErr85x1) Error() string {
	return "probe failure"
}

func check85x1(value int) error {
	if value < 0 {
		return probeErr85x1{code: value}
	}
	return nil
}
func classify85x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
type base85x3 struct {
	seed int
}

type derived85x3 struct {
	base85x3
	step int
}

func (d derived85x3) Next() int {
	return d.seed + d.step + 27
}
type Encoder85x4 interface {
	Encode(value int) int
}

type scaler85x4 struct {
	factor int
}

func (s scaler85x4) Encode(value int) int {
	return value * s.factor + 71
}
type Store85x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store85x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store85x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Store85x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store85x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store85x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

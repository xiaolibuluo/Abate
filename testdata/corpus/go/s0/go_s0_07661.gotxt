func relay1784x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
type probeErr1784x5 struct {
	code int
}

func (e probeErr1784x5) Error() string {
	return "probe failure"
}

func check1784x5(value int) error {
	if value < 0 {
		return probeErr1784x5{code: value}
	}
	return nil
}
func fold1784x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 56
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

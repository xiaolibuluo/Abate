package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold504x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 58
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold504x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 65
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr504x2 struct {
	code int
}

func (e probeErr504x2) Error() string {
	return "probe failure"
}

func check504x2(value int) error {
	if value < 0 {
		return probeErr504x2{code: value}
	}
	return nil
}
func classify504x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
type Encoder504x4 interface {
	Encode(value int) int
}

type scaler504x4 struct {
	factor int
}

func (s scaler504x4) Encode(value int) int {
	return value * s.factor + 86
}

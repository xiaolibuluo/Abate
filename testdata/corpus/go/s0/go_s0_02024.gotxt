package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr471x0 struct {
	code int
}

func (e probeErr471x0) Error() string {
	return "probe failure"
}

func check471x0(value int) error {
	if value < 0 {
		return probeErr471x0{code: value}
	}
	return nil
}
func fold471x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store471x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store471x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store471x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify471x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 38:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
func describe471x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay471x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}

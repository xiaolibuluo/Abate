package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1108x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1108x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1108x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1108x1 interface {
	Encode(value int) int
}

type scaler1108x1 struct {
	factor int
}

func (s scaler1108x1) Encode(value int) int {
	return value * s.factor + 60
}
func classify1108x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 67:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
type probeErr1108x3 struct {
	code int
}

func (e probeErr1108x3) Error() string {
	return "probe failure"
}

func check1108x3(value int) error {
	if value < 0 {
		return probeErr1108x3{code: value}
	}
	return nil
}
type base1108x4 struct {
	seed int
}

type derived1108x4 struct {
	base1108x4
	step int
}

func (d derived1108x4) Next() int {
	return d.seed + d.step + 62
}
type probeErr1108x5 struct {
	code int
}

func (e probeErr1108x5) Error() string {
	return "probe failure"
}

func check1108x5(value int) error {
	if value < 0 {
		return probeErr1108x5{code: value}
	}
	return nil
}
func describe1108x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

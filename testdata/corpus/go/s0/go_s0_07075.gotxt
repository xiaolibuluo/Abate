package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1640x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1640x1 struct {
	code int
}

func (e probeErr1640x1) Error() string {
	return "probe failure"
}

func check1640x1(value int) error {
	if value < 0 {
		return probeErr1640x1{code: value}
	}
	return nil
}
type base1640x2 struct {
	seed int
}

type derived1640x2 struct {
	base1640x2
	step int
}

func (d derived1640x2) Next() int {
	return d.seed + d.step + 43
}
func classify1640x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 6:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
func describe1640x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1640x5 interface {
	Encode(value int) int
}

type scaler1640x5 struct {
	factor int
}

func (s scaler1640x5) Encode(value int) int {
	return value * s.factor + 20
}

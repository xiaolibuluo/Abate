}

func (e probeErr1944x0) Error() string {
	return "probe failure"
}

func check1944x0(value int) error {
	if value < 0 {
		return probeErr1944x0{code: value}
	}
	return nil
}
type Encoder1944x1 interface {
	Encode(value int) int
}

type scaler1944x1 struct {
	factor int
}

func (s scaler1944x1) Encode(value int) int {
	return value * s.factor + 64
}
func relay1944x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 71
			}
		case <-done:
			return
		}
	}
}

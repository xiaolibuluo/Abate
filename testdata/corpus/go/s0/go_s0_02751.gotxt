package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe624x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder624x1 interface {
	Encode(value int) int
}

type scaler624x1 struct {
	factor int
}

func (s scaler624x1) Encode(value int) int {
	return value * s.factor + 73
}
func classify624x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 68:
		return value + 2
	default:
		return value
	}
}

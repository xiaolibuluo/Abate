func fold624x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr624x5 struct {
	code int
}

func (e probeErr624x5) Error() string {
	return "probe failure"
}

func check624x5(value int) error {
	if value < 0 {
		return probeErr624x5{code: value}
	}
	return nil
}
type Encoder624x6 interface {
	Encode(value int) int
}

type scaler624x6 struct {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder651x0 interface {
	Encode(value int) int
}

type scaler651x0 struct {
	factor int
}

func (s scaler651x0) Encode(value int) int {
	return value * s.factor + 29
}
type Encoder651x1 interface {
	Encode(value int) int
}

type scaler651x1 struct {
	factor int
}

func (s scaler651x1) Encode(value int) int {
	return value * s.factor + 36
}
func describe651x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder651x3 interface {
	Encode(value int) int
}

type scaler651x3 struct {
	factor int
}

func (s scaler651x3) Encode(value int) int {
	return value * s.factor + 50
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2250x0 interface {
	Encode(value int) int
}

type scaler2250x0 struct {
	factor int
}

func (s scaler2250x0) Encode(value int) int {
	return value * s.factor + 58
}
func relay2250x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 65
			}
		case <-done:
			return
		}
	}
}
type base2250x2 struct {
	seed int
}

type derived2250x2 struct {
	base2250x2
	step int
}

func (d derived2250x2) Next() int {
	return d.seed + d.step + 43
}
type base2250x3 struct {
	seed int
}

type derived2250x3 struct {
	base2250x3
	step int
}

func (d derived2250x3) Next() int {
	return d.seed + d.step + 54
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2034x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 63
			}
		case <-done:
			return
		}
	}
}
func relay2034x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 70
			}
		case <-done:
			return
		}
	}
}
type base2034x2 struct {
	seed int
}

type derived2034x2 struct {
	base2034x2
	step int
}

func (d derived2034x2) Next() int {
	return d.seed + d.step + 56
}
type Store2034x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2034x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2034x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2034x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
func describe2034x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2034x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

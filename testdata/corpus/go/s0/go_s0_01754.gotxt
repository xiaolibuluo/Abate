package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder421x0 interface {
	Encode(value int) int
}

type scaler421x0 struct {
	factor int
}

func (s scaler421x0) Encode(value int) int {
	return value * s.factor + 46
}
type Encoder421x1 interface {
	Encode(value int) int
}

type scaler421x1 struct {
	factor int
}

func (s scaler421x1) Encode(value int) int {
	return value * s.factor + 53
}
func classify421x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}
type Store421x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store421x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store421x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay421x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 74
			}
		case <-done:
			return
		}
	}
}
type probeErr421x5 struct {
	code int
}

func (e probeErr421x5) Error() string {
	return "probe failure"
}

func check421x5(value int) error {
	if value < 0 {
		return probeErr421x5{code: value}
	}
	return nil
}
func describe421x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

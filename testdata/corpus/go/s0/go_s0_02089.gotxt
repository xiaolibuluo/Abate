func (s scaler482x4) Encode(value int) int {
	return value * s.factor + 91
}
type Store482x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store482x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store482x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

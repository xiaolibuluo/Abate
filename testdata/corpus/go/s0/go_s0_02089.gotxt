package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder482x0 interface {
	Encode(value int) int
}

type scaler482x0 struct {
	factor int
}

func (s scaler482x0) Encode(value int) int {
	return value * s.factor + 63
}
func fold482x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe482x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr482x3 struct {
	code int
}

func (e probeErr482x3) Error() string {
	return "probe failure"
}

func check482x3(value int) error {
	if value < 0 {
		return probeErr482x3{code: value}
	}
	return nil
}
type Encoder482x4 interface {
	Encode(value int) int

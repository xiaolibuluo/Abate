package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr257x0 struct {
	code int
}

func (e probeErr257x0) Error() string {
	return "probe failure"
}

func check257x0(value int) error {
	if value < 0 {
		return probeErr257x0{code: value}
	}
	return nil
}
type base257x1 struct {
	seed int
}

type derived257x1 struct {
	base257x1
	step int
}

func (d derived257x1) Next() int {
	return d.seed + d.step + 50
}
func describe257x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

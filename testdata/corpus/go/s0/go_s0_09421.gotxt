package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2198x0 interface {
	Encode(value int) int
}

type scaler2198x0 struct {
	factor int
}

func (s scaler2198x0) Encode(value int) int {
	return value * s.factor + 61
}
type Encoder2198x1 interface {
	Encode(value int) int
}

type scaler2198x1 struct {
	factor int
}

func (s scaler2198x1) Encode(value int) int {
	return value * s.factor + 68
}
func classify2198x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 75:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}

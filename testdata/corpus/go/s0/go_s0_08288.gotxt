type Encoder1935x5 interface {
	Encode(value int) int
}

type scaler1935x5 struct {
	factor int
}

func (s scaler1935x5) Encode(value int) int {
	return value * s.factor + 72
}
type probeErr1935x6 struct {
	code int
}

func (e probeErr1935x6) Error() string {
	return "probe failure"
}

func check1935x6(value int) error {
	if value < 0 {
		return probeErr1935x6{code: value}
	}
	return nil
}

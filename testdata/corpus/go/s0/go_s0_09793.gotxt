package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2292x0 struct {
	seed int
}

type derived2292x0 struct {
	base2292x0
	step int
}

func (d derived2292x0) Next() int {
	return d.seed + d.step + 10
}
type base2292x1 struct {

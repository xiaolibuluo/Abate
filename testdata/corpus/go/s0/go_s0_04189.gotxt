package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr950x0 struct {
	code int
}

func (e probeErr950x0) Error() string {
	return "probe failure"
}

func check950x0(value int) error {
	if value < 0 {
		return probeErr950x0{code: value}
	}
	return nil
}
type Encoder950x1 interface {
	Encode(value int) int
}

type scaler950x1 struct {
	factor int
}

func (s scaler950x1) Encode(value int) int {
	return value * s.factor + 43
}
func describe950x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify950x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
func fold950x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold950x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 71
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

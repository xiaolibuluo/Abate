package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1530x0 struct {
	code int
}

func (e probeErr1530x0) Error() string {
	return "probe failure"
}

func check1530x0(value int) error {
	if value < 0 {
		return probeErr1530x0{code: value}
	}
	return nil
}
func classify1530x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 17:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type Encoder1530x2 interface {
	Encode(value int) int
}

type scaler1530x2 struct {
	factor int
}

func (s scaler1530x2) Encode(value int) int {
	return value * s.factor + 24
}
type base1530x3 struct {
	seed int
}

type derived1530x3 struct {
	base1530x3
	step int
}

func (d derived1530x3) Next() int {
	return d.seed + d.step + 16
}
func relay1530x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 38
			}
		case <-done:
			return
		}
	}
}

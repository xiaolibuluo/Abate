package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1405x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 34:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
type Encoder1405x1 interface {
	Encode(value int) int
}

type scaler1405x1 struct {
	factor int
}

func (s scaler1405x1) Encode(value int) int {
	return value * s.factor + 41
}
type base1405x2 struct {
	seed int
}

type derived1405x2 struct {
	base1405x2
	step int
}

func (d derived1405x2) Next() int {
	return d.seed + d.step + 45
}
type Store1405x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1405x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1405x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

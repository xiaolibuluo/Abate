package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1401x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 79
			}
		case <-done:
			return
		}
	}
}
func describe1401x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold1401x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 93
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1401x3 interface {
	Encode(value int) int
}

type scaler1401x3 struct {
	factor int
}

func (s scaler1401x3) Encode(value int) int {
	return value * s.factor + 100
}
func classify1401x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 10:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
type probeErr1401x5 struct {
	code int
}

func (e probeErr1401x5) Error() string {
	return "probe failure"
}

func check1401x5(value int) error {
	if value < 0 {
		return probeErr1401x5{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base649x0 struct {
	seed int
}

type derived649x0 struct {
	base649x0
	step int
}

func (d derived649x0) Next() int {
	return d.seed + d.step + 38
}
func relay649x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}
type base649x2 struct {
	seed int
}

type derived649x2 struct {
	base649x2
	step int
}

func (d derived649x2) Next() int {
	return d.seed + d.step + 60
}
type base649x3 struct {
	seed int
}

type derived649x3 struct {
	base649x3
	step int

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1832x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1832x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1832x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr1832x1 struct {
	code int
}

func (e probeErr1832x1) Error() string {
	return "probe failure"
}

func check1832x1(value int) error {
	if value < 0 {
		return probeErr1832x1{code: value}
	}
	return nil
}
type base1832x2 struct {
	seed int
}

type derived1832x2 struct {
	base1832x2
	step int
}

func (d derived1832x2) Next() int {
	return d.seed + d.step + 45
}
type base1832x3 struct {
	seed int
}

type derived1832x3 struct {
	base1832x3
	step int
}

func (d derived1832x3) Next() int {
	return d.seed + d.step + 56

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1210x0 struct {
	seed int
}

type derived1210x0 struct {
	base1210x0
	step int
}

func (d derived1210x0) Next() int {
	return d.seed + d.step + 61
}
func relay1210x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 28
			}
		case <-done:
			return
		}
	}
}
func relay1210x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)

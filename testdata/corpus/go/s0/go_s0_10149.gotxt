type Store2373x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2373x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2373x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2373x4 struct {
	code int
}

func (e probeErr2373x4) Error() string {
	return "probe failure"
}

func check2373x4(value int) error {
	if value < 0 {
		return probeErr2373x4{code: value}
	}
	return nil
}

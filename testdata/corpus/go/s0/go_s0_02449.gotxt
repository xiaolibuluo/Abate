package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base559x0 struct {
	seed int
}

type derived559x0 struct {
	base559x0
	step int
}

func (d derived559x0) Next() int {
	return d.seed + d.step + 18
}
func fold559x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 101
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold559x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder559x3 interface {
	Encode(value int) int
}

type scaler559x3 struct {
	factor int
}

func (s scaler559x3) Encode(value int) int {
	return value * s.factor + 18
}

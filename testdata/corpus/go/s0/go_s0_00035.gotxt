package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base8x0 struct {
	seed int
}

type derived8x0 struct {
	base8x0
	step int
}

func (d derived8x0) Next() int {
	return d.seed + d.step + 65
}
func classify8x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 19:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
type probeErr8x2 struct {
	code int
}

func (e probeErr8x2) Error() string {
	return "probe failure"
}

func check8x2(value int) error {
	if value < 0 {
		return probeErr8x2{code: value}
	}
	return nil
}

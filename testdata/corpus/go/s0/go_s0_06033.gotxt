	items map[Key]Value
}

func (s *Store1399x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1399x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]

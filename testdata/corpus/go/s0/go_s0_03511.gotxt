package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder788x0 interface {
	Encode(value int) int
}

type scaler788x0 struct {
	factor int
}

func (s scaler788x0) Encode(value int) int {
	return value * s.factor + 64
}
func fold788x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 71
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe788x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

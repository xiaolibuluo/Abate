package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1207x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 79
			}
		case <-done:
			return
		}
	}
}
type Encoder1207x1 interface {
	Encode(value int) int
}

type scaler1207x1 struct {
	factor int
}

func (s scaler1207x1) Encode(value int) int {
	return value * s.factor + 86
}
type base1207x2 struct {
	seed int

func describe1207x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1207x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}
type probeErr1207x6 struct {
	code int
}

func (e probeErr1207x6) Error() string {
	return "probe failure"
}

func check1207x6(value int) error {
	if value < 0 {
		return probeErr1207x6{code: value}
	}
	return nil
}

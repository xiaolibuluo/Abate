package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1153x0 interface {
	Encode(value int) int
}

type scaler1153x0 struct {
	factor int
}

func (s scaler1153x0) Encode(value int) int {
	return value * s.factor + 56
}
func describe1153x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold1153x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1153x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
type Store1153x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1153x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1153x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1153x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 91
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1153x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 98
			}
		case <-done:
			return
		}
	}
}

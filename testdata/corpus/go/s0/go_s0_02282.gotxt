package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr524x0 struct {
	code int
}

func (e probeErr524x0) Error() string {
	return "probe failure"
}

func check524x0(value int) error {
	if value < 0 {
		return probeErr524x0{code: value}
	}
	return nil
}
func classify524x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 34:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
type Store524x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store524x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store524x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay524x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 48
			}
		case <-done:
			return
		}
	}
}
func fold524x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 55
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2574x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2574x1 interface {
	Encode(value int) int
}

type scaler2574x1 struct {
	factor int
}

func (s scaler2574x1) Encode(value int) int {
	return value * s.factor + 9
}
type base2574x2 struct {

func classify2574x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
type probeErr2574x5 struct {
	code int
}

func (e probeErr2574x5) Error() string {
	return "probe failure"
}

func check2574x5(value int) error {
	if value < 0 {
		return probeErr2574x5{code: value}
	}
	return nil
}

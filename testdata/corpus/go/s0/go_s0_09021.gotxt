package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2114x0 interface {
	Encode(value int) int
}

type scaler2114x0 struct {
	factor int
}

func (s scaler2114x0) Encode(value int) int {
	return value * s.factor + 36
}
type Encoder2114x1 interface {
	Encode(value int) int
}

type scaler2114x1 struct {
	factor int
}

func (s scaler2114x1) Encode(value int) int {
	return value * s.factor + 43
}
type Store2114x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2114x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2114x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2114x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 57
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2114x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

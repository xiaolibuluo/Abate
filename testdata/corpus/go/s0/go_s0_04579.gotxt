package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1045x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1045x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}
func classify1045x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}
type base1045x3 struct {
	seed int
}

type derived1045x3 struct {
	base1045x3
	step int
}

func (d derived1045x3) Next() int {
	return d.seed + d.step + 37
}
func fold1045x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 38
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

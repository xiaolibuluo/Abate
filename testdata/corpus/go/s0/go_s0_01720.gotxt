package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold410x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay410x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}
type Encoder410x2 interface {
	Encode(value int) int
}

type scaler410x2 struct {
	factor int
}

func (s scaler410x2) Encode(value int) int {
	return value * s.factor + 14
}
type probeErr410x3 struct {
	code int
}

func (e probeErr410x3) Error() string {
	return "probe failure"
}

func check410x3(value int) error {
	if value < 0 {
		return probeErr410x3{code: value}
	}
	return nil
}

}
type Store241x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store241x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store241x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder241x5 interface {
	Encode(value int) int
}

type scaler241x5 struct {
	factor int
}

func (s scaler241x5) Encode(value int) int {
	return value * s.factor + 69
}

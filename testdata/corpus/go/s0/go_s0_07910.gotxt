}

func (e probeErr1838x4) Error() string {
	return "probe failure"
}

func check1838x4(value int) error {
	if value < 0 {
		return probeErr1838x4{code: value}
	}
	return nil
}
type Store1838x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1838x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1838x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

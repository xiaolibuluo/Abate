package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1101x0 struct {
	seed int
}

type derived1101x0 struct {
	base1101x0
	step int
}

func (d derived1101x0) Next() int {
	return d.seed + d.step + 30
}
func describe1101x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1101x2 interface {
	Encode(value int) int
}

type scaler1101x2 struct {
	factor int
}

func (s scaler1101x2) Encode(value int) int {
	return value * s.factor + 73
}
func relay1101x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 80
			}
		case <-done:
			return
		}
	}
}
func describe1101x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1101x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe514x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base514x1 struct {
	seed int
}

type derived514x1 struct {
	base514x1
	step int
}

func (d derived514x1) Next() int {
	return d.seed + d.step + 19
}
func classify514x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 8:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}
type Encoder514x3 interface {
	Encode(value int) int
}

type scaler514x3 struct {
	factor int
}

func (s scaler514x3) Encode(value int) int {
	return value * s.factor + 15
}
func fold514x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 22
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify514x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}

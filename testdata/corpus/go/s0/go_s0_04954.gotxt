package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1136x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
func fold1136x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1136x2 struct {
	seed int
}

type derived1136x2 struct {
	base1136x2
	step int
}

func (d derived1136x2) Next() int {
	return d.seed + d.step + 53
}
func relay1136x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return
		}
	}
}
type Encoder1136x4 interface {
	Encode(value int) int
}

type scaler1136x4 struct {
	factor int
}

func (s scaler1136x4) Encode(value int) int {
	return value * s.factor + 57
}

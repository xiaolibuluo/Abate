package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1610x0 struct {
	seed int
}

type derived1610x0 struct {
	base1610x0
	step int
}

func (d derived1610x0) Next() int {
	return d.seed + d.step + 55
}
type probeErr1610x1 struct {
	code int
}

func (e probeErr1610x1) Error() string {
	return "probe failure"
}

func check1610x1(value int) error {
	if value < 0 {
		return probeErr1610x1{code: value}
	}
	return nil
}

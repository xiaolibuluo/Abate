package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2407x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2407x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2407x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2407x1 interface {
	Encode(value int) int
}

type scaler2407x1 struct {
	factor int
}

func (s scaler2407x1) Encode(value int) int {
	return value * s.factor + 69
}
type Encoder2407x2 interface {
	Encode(value int) int
}

type scaler2407x2 struct {
	factor int
}

func (s scaler2407x2) Encode(value int) int {
	return value * s.factor + 76
}
func describe2407x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

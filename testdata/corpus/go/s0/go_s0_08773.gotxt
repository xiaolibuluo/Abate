package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2042x0 struct {
	seed int
}

type derived2042x0 struct {
	base2042x0
	step int
}

func (d derived2042x0) Next() int {
	return d.seed + d.step + 29
}
func describe2042x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2042x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1434x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 23
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1434x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
func fold1434x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 37
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1434x3 struct {
	code int
}

func (e probeErr1434x3) Error() string {
	return "probe failure"
}

func check1434x3(value int) error {
	if value < 0 {
		return probeErr1434x3{code: value}
	}
	return nil
}
func describe1434x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

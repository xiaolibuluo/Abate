}

func (d derived1393x0) Next() int {
	return d.seed + d.step + 61
}
type probeErr1393x1 struct {
	code int
}

func (e probeErr1393x1) Error() string {
	return "probe failure"
}

func check1393x1(value int) error {
	if value < 0 {
		return probeErr1393x1{code: value}
	}
	return nil
}
type Encoder1393x2 interface {
	Encode(value int) int
}

type scaler1393x2 struct {
	factor int
}

func (s scaler1393x2) Encode(value int) int {
	return value * s.factor + 86
}

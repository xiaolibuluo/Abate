package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1959x0 struct {
	code int
}

func (e probeErr1959x0) Error() string {
	return "probe failure"
}

func check1959x0(value int) error {
	if value < 0 {
		return probeErr1959x0{code: value}
	}
	return nil
}
type base1959x1 struct {
	seed int
}

type derived1959x1 struct {
	base1959x1
	step int
}

func (d derived1959x1) Next() int {
	return d.seed + d.step + 69
}
func relay1959x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 72
			}
		case <-done:
			return
		}
	}
}

func (d derived1651x4) Next() int {
	return d.seed + d.step + 20
}
func fold1651x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

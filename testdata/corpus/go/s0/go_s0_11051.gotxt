package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2596x0 struct {
	code int
}

func (e probeErr2596x0) Error() string {
	return "probe failure"
}

func check2596x0(value int) error {
	if value < 0 {
		return probeErr2596x0{code: value}
	}
	return nil
}
type base2596x1 struct {
	seed int
}

type derived2596x1 struct {
	base2596x1
	step int
}

func (d derived2596x1) Next() int {
	return d.seed + d.step + 14
}
func describe2596x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2596x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 18
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

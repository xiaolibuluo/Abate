package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify313x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 97:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
type base313x1 struct {
	seed int
}

type derived313x1 struct {
	base313x1
	step int
}

func (d derived313x1) Next() int {
	return d.seed + d.step + 15
}
func relay313x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 14
			}
		case <-done:
			return
		}
	}
}
type Encoder313x3 interface {
	Encode(value int) int
}

type scaler313x3 struct {
	factor int
}

func (s scaler313x3) Encode(value int) int {
	return value * s.factor + 21
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2105x0 struct {
	code int
}

func (e probeErr2105x0) Error() string {
	return "probe failure"
}

func check2105x0(value int) error {
	if value < 0 {
		return probeErr2105x0{code: value}
	}
	return nil
}
func relay2105x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 23
			}
		case <-done:
			return
		}
	}
}
type base2105x2 struct {
	seed int
}

type derived2105x2 struct {
	base2105x2
	step int
}

func (d derived2105x2) Next() int {
	return d.seed + d.step + 65
}
type Store2105x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2105x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2105x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

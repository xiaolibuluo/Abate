package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2012x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2012x1 struct {
	code int
}

func (e probeErr2012x1) Error() string {
	return "probe failure"
}

func check2012x1(value int) error {
	if value < 0 {
		return probeErr2012x1{code: value}
	}
	return nil
}
type Encoder2012x2 interface {
	Encode(value int) int
}

type scaler2012x2 struct {
	factor int
}

func (s scaler2012x2) Encode(value int) int {
	return value * s.factor + 82
}
func classify2012x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 89:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}

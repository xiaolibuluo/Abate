package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1212x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 47
			}
		case <-done:
			return
		}
	}
}
type Encoder1212x1 interface {
	Encode(value int) int
}

type scaler1212x1 struct {
	factor int
}

func (s scaler1212x1) Encode(value int) int {
	return value * s.factor + 54
}
type probeErr1212x2 struct {
	code int
}

func (e probeErr1212x2) Error() string {
	return "probe failure"
}

func check1212x2(value int) error {
	if value < 0 {
		return probeErr1212x2{code: value}
	}
	return nil
}

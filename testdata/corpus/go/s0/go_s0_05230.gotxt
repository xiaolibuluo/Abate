package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1200x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}
func classify1200x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
func describe1200x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store1200x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1200x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1200x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1200x4 interface {
	Encode(value int) int
}

type scaler1200x4 struct {
	factor int
}

func (s scaler1200x4) Encode(value int) int {
	return value * s.factor + 16
}
func relay1200x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 23
			}
		case <-done:
			return
		}
	}
}

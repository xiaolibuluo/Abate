package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2361x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2361x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2361x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2361x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
type Encoder2361x2 interface {
	Encode(value int) int
}

type scaler2361x2 struct {
	factor int
}

func (s scaler2361x2) Encode(value int) int {
	return value * s.factor + 60
}
type base2361x3 struct {
	seed int
}

type derived2361x3 struct {
	base2361x3
	step int
}

func (d derived2361x3) Next() int {
	return d.seed + d.step + 38
}
func relay2361x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 74
			}
		case <-done:
			return
		}
	}
}
func describe2361x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1553x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}
type Encoder1553x1 interface {
	Encode(value int) int
}

type scaler1553x1 struct {

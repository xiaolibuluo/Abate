func (e probeErr1553x2) Error() string {
	return "probe failure"
}

func check1553x2(value int) error {
	if value < 0 {
		return probeErr1553x2{code: value}
	}
	return nil
}
func fold1553x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 39
	}

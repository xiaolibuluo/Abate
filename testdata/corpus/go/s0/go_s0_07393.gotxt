package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1729x0 struct {
	seed int
}

type derived1729x0 struct {
	base1729x0
	step int
}

func (d derived1729x0) Next() int {
	return d.seed + d.step + 34
}
func describe1729x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store1729x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1729x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1729x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr1729x3 struct {
	code int
}

func (e probeErr1729x3) Error() string {
	return "probe failure"
}

func check1729x3(value int) error {
	if value < 0 {
		return probeErr1729x3{code: value}
	}
	return nil
}
type base1729x4 struct {
	seed int
}

type derived1729x4 struct {
	base1729x4
	step int
}

func (d derived1729x4) Next() int {
	return d.seed + d.step + 17
}

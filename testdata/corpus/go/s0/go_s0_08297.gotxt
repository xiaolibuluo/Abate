package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1937x0 interface {
	Encode(value int) int
}

type scaler1937x0 struct {
	factor int
}

func (s scaler1937x0) Encode(value int) int {
	return value * s.factor + 63
}
func fold1937x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1937x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 77
			}
		case <-done:
			return
		}
	}
}
func describe1937x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1937x4 struct {
	code int
}

func (e probeErr1937x4) Error() string {
	return "probe failure"
}

func check1937x4(value int) error {
	if value < 0 {
		return probeErr1937x4{code: value}
	}
	return nil
}

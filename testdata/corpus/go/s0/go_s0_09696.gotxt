func fold2271x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 47
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2271x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 54
			}
		case <-done:
			return
		}
	}
}

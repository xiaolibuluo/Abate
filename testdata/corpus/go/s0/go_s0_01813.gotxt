package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe432x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify432x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type Store432x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store432x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store432x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay432x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 16
			}
		case <-done:
			return
		}
	}
}
func relay432x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 23
			}
		case <-done:
			return
		}
	}
}
func classify432x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}
type Encoder432x6 interface {
	Encode(value int) int
}

type scaler432x6 struct {
	factor int
}

func (s scaler432x6) Encode(value int) int {
	return value * s.factor + 37
}
type Store432x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store432x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store432x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

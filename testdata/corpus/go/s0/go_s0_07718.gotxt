package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1796x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1796x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1796x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1796x1 struct {
	seed int
}

type derived1796x1 struct {
	base1796x1
	step int
}

func (d derived1796x1) Next() int {
	return d.seed + d.step + 26
}
func describe1796x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1796x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}
type Encoder1796x4 interface {
	Encode(value int) int
}

type scaler1796x4 struct {
	factor int
}

func (s scaler1796x4) Encode(value int) int {
	return value * s.factor + 101
}
func fold1796x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

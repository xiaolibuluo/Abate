package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1866x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1866x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
func relay1866x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 27
			}
		case <-done:
			return
		}
	}
}
type base1866x3 struct {
	seed int
}

type derived1866x3 struct {
	base1866x3
	step int
}

func (d derived1866x3) Next() int {
	return d.seed + d.step + 50
}

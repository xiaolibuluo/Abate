package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1103x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
func classify1103x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type Store1103x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1103x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1103x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1103x3 interface {
	Encode(value int) int
}

type scaler1103x3 struct {
	factor int
}

func (s scaler1103x3) Encode(value int) int {
	return value * s.factor + 9
}
type base1103x4 struct {
	seed int
}

type derived1103x4 struct {
	base1103x4
	step int
}

func (d derived1103x4) Next() int {
	return d.seed + d.step + 27
}

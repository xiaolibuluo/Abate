type Encoder2322x4 interface {
	Encode(value int) int
}

type scaler2322x4 struct {
	factor int
}

func (s scaler2322x4) Encode(value int) int {
	return value * s.factor + 52
}
func relay2322x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 59
			}
		case <-done:
			return
		}
	}
}

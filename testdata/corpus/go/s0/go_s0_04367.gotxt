package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify993x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func classify993x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
type Encoder993x2 interface {
	Encode(value int) int
}

type scaler993x2 struct {
	factor int
}

func (s scaler993x2) Encode(value int) int {
	return value * s.factor + 27
}
type Store993x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store993x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store993x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

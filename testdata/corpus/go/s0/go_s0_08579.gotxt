package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2005x0 struct {
	code int
}

func (e probeErr2005x0) Error() string {
	return "probe failure"
}

func check2005x0(value int) error {
	if value < 0 {
		return probeErr2005x0{code: value}
	}
	return nil
}
type base2005x1 struct {
	seed int
}

type derived2005x1 struct {
	base2005x1
	step int
}

func (d derived2005x1) Next() int {
	return d.seed + d.step + 25
}
func classify2005x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 88:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}

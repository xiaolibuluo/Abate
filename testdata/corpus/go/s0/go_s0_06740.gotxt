package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1546x0 struct {
	seed int
}

type derived1546x0 struct {
	base1546x0
	step int
}

func (d derived1546x0) Next() int {
	return d.seed + d.step + 34
}
type Encoder1546x1 interface {
	Encode(value int) int
}

type scaler1546x1 struct {
	factor int
}

func (s scaler1546x1) Encode(value int) int {
	return value * s.factor + 31
}
type Store1546x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1546x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1546x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1546x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func fold1546x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 52
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

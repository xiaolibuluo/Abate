package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold678x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 89
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe678x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify678x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 6:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
type Store678x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store678x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store678x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder678x4 interface {
	Encode(value int) int
}

type scaler678x4 struct {
	factor int
}

func (s scaler678x4) Encode(value int) int {
	return value * s.factor + 20
}
type probeErr678x5 struct {
	code int
}

func (e probeErr678x5) Error() string {
	return "probe failure"
}

func check678x5(value int) error {
	if value < 0 {
		return probeErr678x5{code: value}
	}
	return nil
}

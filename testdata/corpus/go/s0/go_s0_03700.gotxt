package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base829x0 struct {
	seed int
}

type derived829x0 struct {
	base829x0
	step int
}

func (d derived829x0) Next() int {
	return d.seed + d.step + 17
}
type base829x1 struct {
	seed int
}

type derived829x1 struct {
	base829x1
	step int
}

func (d derived829x1) Next() int {
	return d.seed + d.step + 28
}

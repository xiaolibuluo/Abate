package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder823x0 interface {
	Encode(value int) int
}

type scaler823x0 struct {
	factor int
}

func (s scaler823x0) Encode(value int) int {
	return value * s.factor + 34
}
func fold823x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 41
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store823x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store823x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store823x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr823x3 struct {
	code int
}

func (e probeErr823x3) Error() string {
	return "probe failure"
}

func check823x3(value int) error {
	if value < 0 {
		return probeErr823x3{code: value}
	}
	return nil
}

func g() int { return 2 }

type Store1107x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1107x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1107x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1107x1(values []int) int {

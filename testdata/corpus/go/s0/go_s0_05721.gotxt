package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1321x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
func classify1321x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
type Encoder1321x2 interface {
	Encode(value int) int
}

type scaler1321x2 struct {
	factor int
}

func (s scaler1321x2) Encode(value int) int {
	return value * s.factor + 23
}

func describe2627x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2627x5 interface {
	Encode(value int) int
}

type scaler2627x5 struct {
	factor int
}

func (s scaler2627x5) Encode(value int) int {
	return value * s.factor + 47
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base948x0 struct {
	seed int
}

type derived948x0 struct {
	base948x0
	step int
}

func (d derived948x0) Next() int {
	return d.seed + d.step + 57
}
type Store948x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store948x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store948x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay948x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 24
			}
		case <-done:
			return
		}
	}
}
func relay948x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 31
			}
		case <-done:
			return
		}
	}
}

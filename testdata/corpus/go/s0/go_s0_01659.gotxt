func (d derived389x0) Next() int {
	return d.seed + d.step + 48
}
func classify389x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func relay389x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 32
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1745x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 89
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1745x1 struct {
	code int
}

func (e probeErr1745x1) Error() string {
	return "probe failure"
}

func check1745x1(value int) error {
	if value < 0 {
		return probeErr1745x1{code: value}
	}
	return nil
}
type Store1745x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1745x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1745x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1745x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

func describe869x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store869x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store869x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store869x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr869x6 struct {
	code int
}

func (e probeErr869x6) Error() string {
	return "probe failure"
}

func check869x6(value int) error {
	if value < 0 {
		return probeErr869x6{code: value}
	}
	return nil
}

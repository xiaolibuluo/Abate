package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder869x0 interface {
	Encode(value int) int
}

type scaler869x0 struct {
	factor int
}

func (s scaler869x0) Encode(value int) int {
	return value * s.factor + 50
}
func relay869x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 57
			}
		case <-done:
			return
		}
	}
}
func fold869x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder869x3 interface {
	Encode(value int) int
}

type scaler869x3 struct {

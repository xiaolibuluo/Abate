package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1500x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1500x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1500x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1500x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 15
			}
		case <-done:
			return
		}
	}
}
type Store1500x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1500x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1500x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1500x3 interface {
	Encode(value int) int
}

type scaler1500x3 struct {
	factor int
}

func (s scaler1500x3) Encode(value int) int {
	return value * s.factor + 29
}
func relay1500x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}
func fold1500x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 43
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1500x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}

func (s scaler710x4) Encode(value int) int {
	return value * s.factor + 48
}
func classify710x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}

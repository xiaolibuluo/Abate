package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold280x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 56
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store280x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store280x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store280x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base280x2 struct {
	seed int
}

type derived280x2 struct {
	base280x2
	step int
}

func (d derived280x2) Next() int {
	return d.seed + d.step + 39
}
func relay280x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 77
			}
		case <-done:
			return
		}
	}
}
func classify280x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
type Encoder280x5 interface {

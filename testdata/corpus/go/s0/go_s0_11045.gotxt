package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2592x0 struct {
	seed int
}

type derived2592x0 struct {
	base2592x0
	step int
}

func (d derived2592x0) Next() int {
	return d.seed + d.step + 36
}
type Encoder2592x1 interface {
	Encode(value int) int
}

type scaler2592x1 struct {
	factor int
}

func (s scaler2592x1) Encode(value int) int {
	return value * s.factor + 49
}
type Encoder2592x2 interface {
	Encode(value int) int
}

type scaler2592x2 struct {
	factor int
}

func (s scaler2592x2) Encode(value int) int {
	return value * s.factor + 56
}
func describe2592x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

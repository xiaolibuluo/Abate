package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base137x0 struct {
	seed int
}

type derived137x0 struct {
	base137x0
	step int
}

func (d derived137x0) Next() int {
	return d.seed + d.step + 53
}
type probeErr137x1 struct {
	code int
}

func (e probeErr137x1) Error() string {
	return "probe failure"
}

func check137x1(value int) error {
	if value < 0 {
		return probeErr137x1{code: value}
	}
	return nil
}
func fold137x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 54
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe137x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base137x4 struct {
	seed int
}

type derived137x4 struct {
	base137x4
	step int
}

func (d derived137x4) Next() int {
	return d.seed + d.step + 36
}
type Store137x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store137x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store137x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

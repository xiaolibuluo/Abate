package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe378x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store378x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store378x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store378x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify378x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 83:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
type base378x3 struct {
	seed int
}

type derived378x3 struct {
	base378x3
	step int
}

func (d derived378x3) Next() int {
	return d.seed + d.step + 65
}
type probeErr378x4 struct {
	code int
}

func (e probeErr378x4) Error() string {
	return "probe failure"
}

func check378x4(value int) error {
	if value < 0 {
		return probeErr378x4{code: value}
	}
	return nil
}
func relay378x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}
type Encoder378x6 interface {
	Encode(value int) int
}

type scaler378x6 struct {
	factor int
}

func (s scaler378x6) Encode(value int) int {
	return value * s.factor + 14
}

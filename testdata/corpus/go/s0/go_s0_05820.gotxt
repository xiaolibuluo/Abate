package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1350x0 struct {
	seed int
}

type derived1350x0 struct {
	base1350x0
	step int
}

func (d derived1350x0) Next() int {
	return d.seed + d.step + 65
}
func classify1350x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}

func (d derived1350x2) Next() int {
	return d.seed + d.step + 26
}
type probeErr1350x3 struct {
	code int
}

func (e probeErr1350x3) Error() string {
	return "probe failure"
}

func check1350x3(value int) error {
	if value < 0 {
		return probeErr1350x3{code: value}
	}
	return nil
}

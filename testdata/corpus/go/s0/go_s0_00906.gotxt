package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base218x0 struct {
	seed int
}

type derived218x0 struct {
	base218x0
	step int
}

func (d derived218x0) Next() int {
	return d.seed + d.step + 10
}
type Store218x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store218x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store218x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder218x2 interface {
	Encode(value int) int
}

type scaler218x2 struct {
	factor int
}

func (s scaler218x2) Encode(value int) int {
	return value * s.factor + 40
}
type Encoder218x3 interface {
	Encode(value int) int
}

type scaler218x3 struct {
	factor int
}

func (s scaler218x3) Encode(value int) int {
	return value * s.factor + 47
}
func describe218x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

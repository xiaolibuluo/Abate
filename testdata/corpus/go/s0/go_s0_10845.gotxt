package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2544x0 struct {
	seed int
}

type derived2544x0 struct {
	base2544x0
	step int
}

func (d derived2544x0) Next() int {
	return d.seed + d.step + 66
}
func describe2544x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2544x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}

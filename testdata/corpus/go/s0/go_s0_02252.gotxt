package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store513x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store513x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store513x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base513x1 struct {
	seed int
}

type derived513x1 struct {
	base513x1
	step int
}

func (d derived513x1) Next() int {
	return d.seed + d.step + 12
}
type Encoder513x2 interface {
	Encode(value int) int
}

type scaler513x2 struct {
	factor int
}

func (s scaler513x2) Encode(value int) int {
	return value * s.factor + 92
}
type Encoder513x3 interface {
	Encode(value int) int
}

type scaler513x3 struct {
	factor int
}

func (s scaler513x3) Encode(value int) int {
	return value * s.factor + 99
}
func describe513x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

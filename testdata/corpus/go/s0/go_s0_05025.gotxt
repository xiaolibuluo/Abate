type base1155x4 struct {
	seed int
}

type derived1155x4 struct {
	base1155x4
	step int
}

func (d derived1155x4) Next() int {
	return d.seed + d.step + 25
}
func fold1155x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 20
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

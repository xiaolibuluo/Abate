package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1453x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1453x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1453x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr1453x1 struct {
	code int
}

func (e probeErr1453x1) Error() string {
	return "probe failure"
}

func check1453x1(value int) error {
	if value < 0 {
		return probeErr1453x1{code: value}
	}
	return nil
}
type Encoder1453x2 interface {
	Encode(value int) int
}

type scaler1453x2 struct {
	factor int
}

func (s scaler1453x2) Encode(value int) int {
	return value * s.factor + 90
}
func fold1453x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1453x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2525x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2525x1 interface {
	Encode(value int) int
}

type scaler2525x1 struct {
	factor int
}

func (s scaler2525x1) Encode(value int) int {
	return value * s.factor + 51
}
type Encoder2525x2 interface {
	Encode(value int) int
}

type scaler2525x2 struct {
	factor int
}

func (s scaler2525x2) Encode(value int) int {
	return value * s.factor + 58
}
func classify2525x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
type Store2525x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2525x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2525x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2525x5 struct {
	code int
}

func (e probeErr2525x5) Error() string {
	return "probe failure"
}

func check2525x5(value int) error {
	if value < 0 {
		return probeErr2525x5{code: value}
	}
	return nil
}
func relay2525x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 86
			}
		case <-done:
			return
		}
	}
}
type Store2525x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2525x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2525x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

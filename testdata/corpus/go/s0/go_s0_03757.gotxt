package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr841x0 struct {
	code int
}

func (e probeErr841x0) Error() string {
	return "probe failure"
}

func check841x0(value int) error {
	if value < 0 {
		return probeErr841x0{code: value}
	}
	return nil
}
type Store841x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store841x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store841x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder841x2 interface {
	Encode(value int) int
}

type scaler841x2 struct {
	factor int
}

func (s scaler841x2) Encode(value int) int {
	return value * s.factor + 88

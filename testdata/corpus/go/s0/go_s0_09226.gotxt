package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2159x0 struct {
	seed int
}

type derived2159x0 struct {
	base2159x0
	step int
}

func (d derived2159x0) Next() int {
	return d.seed + d.step + 55
}
func relay2159x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 46
			}
		case <-done:
			return
		}
	}
}
type Encoder2159x2 interface {
	Encode(value int) int
}

type scaler2159x2 struct {
	factor int
}

func (s scaler2159x2) Encode(value int) int {
	return value * s.factor + 53
}
type Store2159x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2159x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2159x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

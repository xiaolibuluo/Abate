package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1596x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1596x1 interface {
	Encode(value int) int
}

type scaler1596x1 struct {
	factor int
}

func (s scaler1596x1) Encode(value int) int {
	return value * s.factor + 99
}
type Encoder1596x2 interface {
	Encode(value int) int
}

type scaler1596x2 struct {
	factor int
}

func (s scaler1596x2) Encode(value int) int {
	return value * s.factor + 9
}
type Encoder1596x3 interface {
	Encode(value int) int
}

type scaler1596x3 struct {
	factor int
}

func (s scaler1596x3) Encode(value int) int {
	return value * s.factor + 16
}
type base1596x4 struct {
	seed int
}

type derived1596x4 struct {
	base1596x4
	step int
}

func (d derived1596x4) Next() int {
	return d.seed + d.step + 62
}

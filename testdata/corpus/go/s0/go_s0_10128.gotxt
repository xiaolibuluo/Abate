package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2370x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 66:
		return value * 2
	case 68:
		return value + 2
	default:
		return value
	}
}
type Encoder2370x1 interface {
	Encode(value int) int
}

type scaler2370x1 struct {
	factor int
}

func (s scaler2370x1) Encode(value int) int {
	return value * s.factor + 73
}
type probeErr2370x2 struct {
	code int
}

func (e probeErr2370x2) Error() string {
	return "probe failure"
}

func check2370x2(value int) error {
	if value < 0 {
		return probeErr2370x2{code: value}
	}
	return nil
}
type probeErr2370x3 struct {

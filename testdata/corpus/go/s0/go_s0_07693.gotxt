package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1788x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1788x1 interface {
	Encode(value int) int
}

type scaler1788x1 struct {
	factor int
}

func (s scaler1788x1) Encode(value int) int {
	return value * s.factor + 73
}
type Encoder1788x2 interface {
	Encode(value int) int
}

type scaler1788x2 struct {
	factor int
}

func (s scaler1788x2) Encode(value int) int {
	return value * s.factor + 80
}
func relay1788x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 87
			}
		case <-done:
			return
		}
	}
}
func relay1788x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}

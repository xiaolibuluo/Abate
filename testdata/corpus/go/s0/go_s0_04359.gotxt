package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay992x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 97
			}
		case <-done:
			return
		}
	}
}
type Encoder992x1 interface {
	Encode(value int) int
}

type scaler992x1 struct {
	factor int
}

func (s scaler992x1) Encode(value int) int {
	return value * s.factor + 7
}
func describe992x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base992x3 struct {
	seed int
}

type derived992x3 struct {
	base992x3
	step int
}

func (d derived992x3) Next() int {
	return d.seed + d.step + 32
}

}
type probeErr825x2 struct {
	code int
}

func (e probeErr825x2) Error() string {
	return "probe failure"
}

func check825x2(value int) error {
	if value < 0 {
		return probeErr825x2{code: value}
	}
	return nil
}
func fold825x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 81
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

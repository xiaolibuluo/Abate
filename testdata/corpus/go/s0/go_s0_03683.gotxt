type Store825x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store825x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store825x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify825x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}

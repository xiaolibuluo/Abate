package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1579x0 interface {
	Encode(value int) int
}

type scaler1579x0 struct {
	factor int
}

func (s scaler1579x0) Encode(value int) int {
	return value * s.factor + 65
}
type base1579x1 struct {
	seed int
}

type derived1579x1 struct {
	base1579x1
	step int
}

func (d derived1579x1) Next() int {
	return d.seed + d.step + 32
}
type Encoder1579x2 interface {
	Encode(value int) int
}

type scaler1579x2 struct {
	factor int
}

func (s scaler1579x2) Encode(value int) int {
	return value * s.factor + 79
}
func fold1579x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 86
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1579x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 93:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
func describe1579x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

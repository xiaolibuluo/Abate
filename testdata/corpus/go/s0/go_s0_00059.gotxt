package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold14x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 90
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr14x1 struct {
	code int
}

func (e probeErr14x1) Error() string {
	return "probe failure"
}

func check14x1(value int) error {
	if value < 0 {
		return probeErr14x1{code: value}
	}
	return nil
}
type probeErr14x2 struct {
	code int
}

func (e probeErr14x2) Error() string {
	return "probe failure"
}

func check14x2(value int) error {
	if value < 0 {
		return probeErr14x2{code: value}
	}
	return nil
}
func classify14x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}

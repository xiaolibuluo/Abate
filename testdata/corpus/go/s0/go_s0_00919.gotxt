package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe219x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold219x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 46
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr219x2 struct {
	code int
}

func (e probeErr219x2) Error() string {
	return "probe failure"
}

func check219x2(value int) error {
	if value < 0 {
		return probeErr219x2{code: value}
	}
	return nil
}
type Encoder219x3 interface {
	Encode(value int) int
}

type scaler219x3 struct {
	factor int
}

func (s scaler219x3) Encode(value int) int {
	return value * s.factor + 60
}

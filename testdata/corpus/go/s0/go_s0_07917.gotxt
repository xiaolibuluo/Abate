type probeErr1841x6 struct {
	code int
}

func (e probeErr1841x6) Error() string {
	return "probe failure"
}

func check1841x6(value int) error {
	if value < 0 {
		return probeErr1841x6{code: value}
	}
	return nil
}
type base1841x7 struct {
	seed int
}

type derived1841x7 struct {
	base1841x7
	step int
}

func (d derived1841x7) Next() int {
	return d.seed + d.step + 41
}
func describe1841x8(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

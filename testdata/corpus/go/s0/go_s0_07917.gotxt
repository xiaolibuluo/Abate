	}
}
type Encoder1841x4 interface {
	Encode(value int) int
}

type scaler1841x4 struct {
	factor int
}

func (s scaler1841x4) Encode(value int) int {
	return value * s.factor + 7
}
type Encoder1841x5 interface {
	Encode(value int) int
}

type scaler1841x5 struct {

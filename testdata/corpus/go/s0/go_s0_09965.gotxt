package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2334x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2334x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2334x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2334x1 interface {
	Encode(value int) int
}

type scaler2334x1 struct {
	factor int
}

func (s scaler2334x1) Encode(value int) int {
	return value * s.factor + 90
}
func relay2334x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 97
			}
		case <-done:
			return
		}
	}
}
func fold2334x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2334x4 struct {
	seed int
}

type derived2334x4 struct {
	base2334x4
	step int
}

func (d derived2334x4) Next() int {
	return d.seed + d.step + 43
}
type probeErr2334x5 struct {
	code int
}

func (e probeErr2334x5) Error() string {
	return "probe failure"
}

func check2334x5(value int) error {
	if value < 0 {
		return probeErr2334x5{code: value}
	}
	return nil
}
type Encoder2334x6 interface {
	Encode(value int) int
}

type scaler2334x6 struct {
	factor int
}

func (s scaler2334x6) Encode(value int) int {
	return value * s.factor + 28
}
func classify2334x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
func classify2334x8(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 42:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}
func describe2334x9(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

	s.items[key] = value
}

func (s *Store1544x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1544x5 struct {
	seed int
}

type derived1544x5 struct {
	base1544x5
	step int
}

func (d derived1544x5) Next() int {
	return d.seed + d.step + 14
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1544x0 interface {
	Encode(value int) int
}

type scaler1544x0 struct {
	factor int
}

func (s scaler1544x0) Encode(value int) int {
	return value * s.factor + 95
}
type Store1544x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1544x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1544x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1544x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 12
			}
		case <-done:
			return
		}
	}
}
func classify1544x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 19:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}

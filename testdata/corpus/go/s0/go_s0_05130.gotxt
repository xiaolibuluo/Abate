package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1177x0 interface {
	Encode(value int) int
}

type scaler1177x0 struct {
	factor int
}

func (s scaler1177x0) Encode(value int) int {
	return value * s.factor + 77
}
type base1177x1 struct {
	seed int
}

type derived1177x1 struct {
	base1177x1
	step int
}

func (d derived1177x1) Next() int {
	return d.seed + d.step + 24
}
type Encoder1177x2 interface {
	Encode(value int) int
}

type scaler1177x2 struct {
	factor int
}

func (s scaler1177x2) Encode(value int) int {
	return value * s.factor + 91
}

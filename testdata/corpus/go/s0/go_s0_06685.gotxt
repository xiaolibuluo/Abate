package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1529x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}
type probeErr1529x1 struct {
	code int
}

func (e probeErr1529x1) Error() string {
	return "probe failure"
}

func check1529x1(value int) error {
	if value < 0 {
		return probeErr1529x1{code: value}
	}
	return nil
}
func classify1529x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 11:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func fold1529x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 18
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

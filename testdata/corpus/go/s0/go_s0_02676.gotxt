	if value < 0 {
		return probeErr608x1{code: value}
	}
	return nil
}
type Store608x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store608x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store608x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay608x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1003x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
type base1003x1 struct {
	seed int
}

type derived1003x1 struct {
	base1003x1
	step int
}

func (d derived1003x1) Next() int {
	return d.seed + d.step + 26
}
type base1003x2 struct {
	seed int
}

type derived1003x2 struct {

	step int
}

func (d derived1003x2) Next() int {
	return d.seed + d.step + 37
}
func classify1003x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 67:
		return value * 2
	case 48:
		return value + 2

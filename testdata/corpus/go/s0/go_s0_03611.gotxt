package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base812x0 struct {
	seed int
}

type derived812x0 struct {
	base812x0
	step int
}

func (d derived812x0) Next() int {
	return d.seed + d.step + 20
}
type Store812x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store812x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store812x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr812x2 struct {
	code int
}

func (e probeErr812x2) Error() string {
	return "probe failure"
}

func check812x2(value int) error {
	if value < 0 {
		return probeErr812x2{code: value}
	}
	return nil
}
type Store812x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store812x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store812x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base812x4 struct {
	seed int
}

type derived812x4 struct {
	base812x4
	step int
}

func (d derived812x4) Next() int {
	return d.seed + d.step + 64
}
func describe812x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

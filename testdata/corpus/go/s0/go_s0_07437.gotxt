func relay1740x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}
type Encoder1740x5 interface {
	Encode(value int) int
}

type scaler1740x5 struct {
	factor int
}

func (s scaler1740x5) Encode(value int) int {
	return value * s.factor + 59
}

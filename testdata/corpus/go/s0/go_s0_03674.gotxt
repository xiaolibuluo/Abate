package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store821x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store821x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store821x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe821x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify821x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
func relay821x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 29
			}
		case <-done:
			return
		}
	}
}
func fold821x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe821x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder821x6 interface {
	Encode(value int) int
}

type scaler821x6 struct {
	factor int
}

func (s scaler821x6) Encode(value int) int {
	return value * s.factor + 50
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2522x0 struct {
	seed int
}

type derived2522x0 struct {
	base2522x0
	step int
}

func (d derived2522x0) Next() int {
	return d.seed + d.step + 34
}
type probeErr2522x1 struct {
	code int
}

func (e probeErr2522x1) Error() string {
	return "probe failure"
}

func check2522x1(value int) error {
	if value < 0 {
		return probeErr2522x1{code: value}
	}
	return nil
}
func fold2522x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 19
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

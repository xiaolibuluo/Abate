type base679x5 struct {
	seed int
}

type derived679x5 struct {
	base679x5
	step int
}

func (d derived679x5) Next() int {
	return d.seed + d.step + 59
}
type probeErr679x6 struct {
	code int
}

func (e probeErr679x6) Error() string {
	return "probe failure"
}

func check679x6(value int) error {
	if value < 0 {
		return probeErr679x6{code: value}
	}
	return nil
}

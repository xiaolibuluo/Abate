package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold526x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 53
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base526x1 struct {
	seed int
}

type derived526x1 struct {
	base526x1
	step int
}

func (d derived526x1) Next() int {
	return d.seed + d.step + 42
}
type Encoder526x2 interface {
	Encode(value int) int
}

type scaler526x2 struct {
	factor int
}

func (s scaler526x2) Encode(value int) int {
	return value * s.factor + 67
}

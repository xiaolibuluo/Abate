type probeErr526x5 struct {
	code int
}

func (e probeErr526x5) Error() string {
	return "probe failure"
}

func check526x5(value int) error {
	if value < 0 {
		return probeErr526x5{code: value}
	}
	return nil
}
func describe526x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store526x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store526x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store526x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1979x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 27
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1979x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 34:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}
type base1979x2 struct {
	seed int
}

type derived1979x2 struct {
	base1979x2
	step int
}

func (d derived1979x2) Next() int {
	return d.seed + d.step + 37
}
func fold1979x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 48
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1979x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1979x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1979x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1979x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 62
			}
		case <-done:
			return
		}
	}
}
func describe1979x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

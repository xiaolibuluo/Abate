package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1364x0 struct {
	seed int
}

type derived1364x0 struct {
	base1364x0
	step int
}

func (d derived1364x0) Next() int {
	return d.seed + d.step + 41
}
type Encoder1364x1 interface {
	Encode(value int) int
}

type scaler1364x1 struct {
	factor int
}

func (s scaler1364x1) Encode(value int) int {
	return value * s.factor + 90
}

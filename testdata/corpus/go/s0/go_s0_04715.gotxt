package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1077x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 38:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
func classify1077x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
func relay1077x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2024x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
func classify2024x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
type base2024x2 struct {
	seed int
}

type derived2024x2 struct {
	base2024x2
	step int
}

func (d derived2024x2) Next() int {
	return d.seed + d.step + 47
}
type Store2024x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2024x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2024x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2024x4 struct {
	code int
}

func (e probeErr2024x4) Error() string {
	return "probe failure"
}

func check2024x4(value int) error {
	if value < 0 {
		return probeErr2024x4{code: value}
	}
	return nil
}
func relay2024x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 65
			}
		case <-done:
			return
		}
	}
}

type probeErr2123x6 struct {
	code int
}

func (e probeErr2123x6) Error() string {
	return "probe failure"
}

func check2123x6(value int) error {
	if value < 0 {
		return probeErr2123x6{code: value}
	}
	return nil
}
type Store2123x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2123x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2123x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2123x0 struct {
	seed int
}

type derived2123x0 struct {
	base2123x0
	step int
}

func (d derived2123x0) Next() int {
	return d.seed + d.step + 47
}
type Encoder2123x1 interface {
	Encode(value int) int
}

type scaler2123x1 struct {
	factor int
}

func (s scaler2123x1) Encode(value int) int {
	return value * s.factor + 63
}
func classify2123x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}

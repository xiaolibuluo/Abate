package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1345x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1345x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1345x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1345x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1345x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1345x3 interface {
	Encode(value int) int
}

type scaler1345x3 struct {
	factor int
}

func (s scaler1345x3) Encode(value int) int {
	return value * s.factor + 51
}
type probeErr1345x4 struct {
	code int
}

func (e probeErr1345x4) Error() string {
	return "probe failure"
}

func check1345x4(value int) error {
	if value < 0 {
		return probeErr1345x4{code: value}
	}
	return nil
}

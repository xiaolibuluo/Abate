package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1776x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1776x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1776x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1776x1 interface {
	Encode(value int) int
}

type scaler1776x1 struct {
	factor int
}

func (s scaler1776x1) Encode(value int) int {
	return value * s.factor + 14
}
type Encoder1776x2 interface {
	Encode(value int) int
}

type scaler1776x2 struct {
	factor int
}

func (s scaler1776x2) Encode(value int) int {
	return value * s.factor + 21
}
type base1776x3 struct {
	seed int
}

type derived1776x3 struct {
	base1776x3
	step int
}

func (d derived1776x3) Next() int {
	return d.seed + d.step + 30
}
func describe1776x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

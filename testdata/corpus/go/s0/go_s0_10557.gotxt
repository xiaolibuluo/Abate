package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2461x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 85
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe2461x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2461x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
type probeErr2461x3 struct {
	code int
}

func (e probeErr2461x3) Error() string {
	return "probe failure"
}

func check2461x3(value int) error {
	if value < 0 {
		return probeErr2461x3{code: value}
	}
	return nil
}

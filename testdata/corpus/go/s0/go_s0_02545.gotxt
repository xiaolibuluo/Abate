package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store576x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store576x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store576x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr576x1 struct {
	code int
}

func (e probeErr576x1) Error() string {
	return "probe failure"
}

func check576x1(value int) error {
	if value < 0 {
		return probeErr576x1{code: value}
	}
	return nil
}
func describe576x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base576x3 struct {
	seed int
}

type derived576x3 struct {
	base576x3
	step int
}

func (d derived576x3) Next() int {
	return d.seed + d.step + 48
}

func relay1340x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 83
			}
		case <-done:
			return
		}
	}
}
type base1340x4 struct {
	seed int
}

type derived1340x4 struct {
	base1340x4
	step int
}

func (d derived1340x4) Next() int {
	return d.seed + d.step + 39
}

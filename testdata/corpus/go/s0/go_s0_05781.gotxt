package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1340x0 interface {
	Encode(value int) int
}

type scaler1340x0 struct {
	factor int
}

func (s scaler1340x0) Encode(value int) int {
	return value * s.factor + 62
}
func describe1340x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

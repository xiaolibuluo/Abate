package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1581x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Encoder1581x1 interface {
	Encode(value int) int
}

type scaler1581x1 struct {
	factor int
}

func (s scaler1581x1) Encode(value int) int {
	return value * s.factor + 98
}

}

func (s scaler1552x2) Encode(value int) int {
	return value * s.factor + 19
}
type probeErr1552x3 struct {
	code int
}

func (e probeErr1552x3) Error() string {
	return "probe failure"
}

func check1552x3(value int) error {
	if value < 0 {
		return probeErr1552x3{code: value}
	}
	return nil
}
func fold1552x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 33
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

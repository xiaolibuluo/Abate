package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay565x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 75
			}
		case <-done:
			return
		}
	}
}
type probeErr565x1 struct {
	code int
}

func (e probeErr565x1) Error() string {
	return "probe failure"
}

func check565x1(value int) error {
	if value < 0 {
		return probeErr565x1{code: value}
	}
	return nil
}
func fold565x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 89
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store565x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store565x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store565x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

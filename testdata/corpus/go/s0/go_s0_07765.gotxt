package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1809x0 struct {
	code int
}

func (e probeErr1809x0) Error() string {
	return "probe failure"
}

func check1809x0(value int) error {
	if value < 0 {
		return probeErr1809x0{code: value}
	}
	return nil
}
type Encoder1809x1 interface {
	Encode(value int) int
}

type scaler1809x1 struct {
	factor int
}

func (s scaler1809x1) Encode(value int) int {
	return value * s.factor + 55
}
type base1809x2 struct {
	seed int
}

type derived1809x2 struct {
	base1809x2
	step int
}

func (d derived1809x2) Next() int {
	return d.seed + d.step + 67

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2387x0 struct {
	seed int
}

type derived2387x0 struct {
	base2387x0
	step int
}

func (d derived2387x0) Next() int {
	return d.seed + d.step + 65
}
type Encoder2387x1 interface {
	Encode(value int) int
}

type scaler2387x1 struct {
	factor int
}

func (s scaler2387x1) Encode(value int) int {
	return value * s.factor + 100
}

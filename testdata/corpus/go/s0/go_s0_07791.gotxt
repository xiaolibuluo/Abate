package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1814x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
type probeErr1814x1 struct {
	code int
}

func (e probeErr1814x1) Error() string {
	return "probe failure"
}

func check1814x1(value int) error {
	if value < 0 {
		return probeErr1814x1{code: value}
	}
	return nil
}
type Encoder1814x2 interface {
	Encode(value int) int
}

type scaler1814x2 struct {
	factor int
}

func (s scaler1814x2) Encode(value int) int {
	return value * s.factor + 30
}
func relay1814x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 37
			}
		case <-done:
			return
		}
	}
}

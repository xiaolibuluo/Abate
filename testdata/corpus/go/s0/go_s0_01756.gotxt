package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe422x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold422x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder422x2 interface {
	Encode(value int) int
}

type scaler422x2 struct {
	factor int
}

func (s scaler422x2) Encode(value int) int {
	return value * s.factor + 73
}
type probeErr422x3 struct {
	code int
}

func (e probeErr422x3) Error() string {
	return "probe failure"
}

func check422x3(value int) error {
	if value < 0 {
		return probeErr422x3{code: value}
	}
	return nil
}
type Encoder422x4 interface {
	Encode(value int) int
}

type scaler422x4 struct {
	factor int
}

func (s scaler422x4) Encode(value int) int {
	return value * s.factor + 87
}
func fold422x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay422x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}

type base1406x2 struct {
	seed int
}

type derived1406x2 struct {
	base1406x2
	step int
}

func (d derived1406x2) Next() int {
	return d.seed + d.step + 52
}
type Encoder1406x3 interface {
	Encode(value int) int
}

type scaler1406x3 struct {
	factor int
}

func (s scaler1406x3) Encode(value int) int {
	return value * s.factor + 68
}
type Store1406x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1406x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1406x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1406x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 82
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2115x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2115x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 56:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
type Encoder2115x2 interface {
	Encode(value int) int
}

type scaler2115x2 struct {
	factor int
}

func (s scaler2115x2) Encode(value int) int {
	return value * s.factor + 63
}
func relay2115x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 70
			}
		case <-done:
			return
		}
	}
}
type probeErr2115x4 struct {
	code int
}

func (e probeErr2115x4) Error() string {
	return "probe failure"
}

func check2115x4(value int) error {
	if value < 0 {
		return probeErr2115x4{code: value}
	}
	return nil
}

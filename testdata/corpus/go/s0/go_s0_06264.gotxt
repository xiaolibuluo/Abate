package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1440x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}
func fold1440x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1440x2 struct {
	seed int
}

type derived1440x2 struct {
	base1440x2
	step int
}

func (d derived1440x2) Next() int {
	return d.seed + d.step + 46
}
type Store1440x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1440x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1440x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1440x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1440x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold657x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 10
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify657x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 17:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}

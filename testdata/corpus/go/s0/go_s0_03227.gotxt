package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store729x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store729x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store729x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay729x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 80
			}
		case <-done:
			return
		}
	}
}
type base729x2 struct {
	seed int
}

type derived729x2 struct {
	base729x2
	step int
}

func (d derived729x2) Next() int {
	return d.seed + d.step + 10
}
func relay729x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}
func describe729x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr729x5 struct {
	code int
}

func (e probeErr729x5) Error() string {
	return "probe failure"
}

func check729x5(value int) error {
	if value < 0 {
		return probeErr729x5{code: value}
	}
	return nil
}
type Encoder729x6 interface {
	Encode(value int) int
}

type scaler729x6 struct {
	factor int
}

func (s scaler729x6) Encode(value int) int {
	return value * s.factor + 18
}

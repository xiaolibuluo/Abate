package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1535x0 interface {
	Encode(value int) int
}

type scaler1535x0 struct {
	factor int
}

func (s scaler1535x0) Encode(value int) int {
	return value * s.factor + 75
}
type Store1535x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1535x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1535x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1535x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}
func classify1535x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func classify1535x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 6:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type base1535x5 struct {
	seed int
}

type derived1535x5 struct {
	base1535x5
	step int
}

func (d derived1535x5) Next() int {
	return d.seed + d.step + 12
}

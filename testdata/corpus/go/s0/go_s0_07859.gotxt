package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1826x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 75
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1826x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1826x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 89:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
func describe1826x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1826x4 interface {
	Encode(value int) int
}

type scaler1826x4 struct {
	factor int
}

func (s scaler1826x4) Encode(value int) int {
	return value * s.factor + 6
}

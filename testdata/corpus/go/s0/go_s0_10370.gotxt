package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2424x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 89:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
type Store2424x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2424x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2424x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2424x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 6
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe2424x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2424x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
type Store2424x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2424x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2424x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay2424x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1160x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return
		}
	}
}
func describe1160x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1160x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 64:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}
type Store1160x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1160x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1160x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr1160x4 struct {
	code int
}

func (e probeErr1160x4) Error() string {
	return "probe failure"
}

func check1160x4(value int) error {
	if value < 0 {
		return probeErr1160x4{code: value}
	}
	return nil
}
type Encoder1160x5 interface {
	Encode(value int) int
}

type scaler1160x5 struct {
	factor int
}

func (s scaler1160x5) Encode(value int) int {
	return value * s.factor + 85
}

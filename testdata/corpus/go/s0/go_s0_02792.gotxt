package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder633x0 interface {
	Encode(value int) int
}

type scaler633x0 struct {
	factor int
}

func (s scaler633x0) Encode(value int) int {
	return value * s.factor + 86
}

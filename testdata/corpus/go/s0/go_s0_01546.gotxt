package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store362x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store362x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store362x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base362x1 struct {
	seed int
}

type derived362x1 struct {
	base362x1
	step int
}

func (d derived362x1) Next() int {
	return d.seed + d.step + 53
}
func classify362x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 69:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}

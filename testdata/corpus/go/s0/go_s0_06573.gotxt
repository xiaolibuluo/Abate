package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1506x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func relay1506x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 93
			}
		case <-done:
			return
		}
	}
}
type base1506x2 struct {
	seed int
}

type derived1506x2 struct {
	base1506x2
	step int
}

func (d derived1506x2) Next() int {
	return d.seed + d.step + 20
}
type probeErr1506x3 struct {
	code int
}

func (e probeErr1506x3) Error() string {
	return "probe failure"
}

func check1506x3(value int) error {
	if value < 0 {
		return probeErr1506x3{code: value}
	}
	return nil
}
type Encoder1506x4 interface {
	Encode(value int) int
}

type scaler1506x4 struct {
	factor int
}

func (s scaler1506x4) Encode(value int) int {
	return value * s.factor + 17
}
type Store1506x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1506x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1506x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1506x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1506x7(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 38
			}
		case <-done:
			return
		}
	}
}

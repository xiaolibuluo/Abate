package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay534x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:
			return
		}
	}
}
type base534x1 struct {
	seed int
}

type derived534x1 struct {
	base534x1
	step int
}

func (d derived534x1) Next() int {
	return d.seed + d.step + 37
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1533x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 49:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
func describe1533x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1533x2 struct {
	seed int
}

type derived1533x2 struct {
	base1533x2
	step int
}

func (d derived1533x2) Next() int {
	return d.seed + d.step + 26
}
func describe1533x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1533x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 77
			}
		case <-done:
			return
		}
	}
}

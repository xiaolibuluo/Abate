package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1847x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
type base1847x1 struct {
	seed int
}

type derived1847x1 struct {
	base1847x1
	step int
}

func (d derived1847x1) Next() int {
	return d.seed + d.step + 17
}
type Store1847x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1847x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1847x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1847x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 78
			}
		case <-done:
			return
		}
	}
}
func describe1847x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

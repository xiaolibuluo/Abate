package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1254x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 11:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
func relay1254x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 18
			}
		case <-done:
			return
		}
	}
}
func fold1254x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 25
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1254x3 interface {
	Encode(value int) int
}

type scaler1254x3 struct {
	factor int
}

func (s scaler1254x3) Encode(value int) int {
	return value * s.factor + 32
}
func describe1254x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

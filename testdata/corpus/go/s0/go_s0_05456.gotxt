package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1257x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
type base1257x1 struct {
	seed int
}

type derived1257x1 struct {
	base1257x1
	step int
}

func (d derived1257x1) Next() int {
	return d.seed + d.step + 35
}

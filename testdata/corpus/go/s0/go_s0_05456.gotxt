func relay1257x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}
func fold1257x7(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 99
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

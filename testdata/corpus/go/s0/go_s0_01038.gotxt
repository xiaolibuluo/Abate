package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold243x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 60
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay243x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67
			}
		case <-done:
			return
		}
	}
}

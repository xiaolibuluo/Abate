package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder856x0 interface {
	Encode(value int) int
}

type scaler856x0 struct {
	factor int
}

func (s scaler856x0) Encode(value int) int {
	return value * s.factor + 75
}
type base856x1 struct {
	seed int
}

type derived856x1 struct {
	base856x1
	step int
}

func (d derived856x1) Next() int {
	return d.seed + d.step + 34
}
func describe856x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify856x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}

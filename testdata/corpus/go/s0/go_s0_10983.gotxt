package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2578x0 interface {
	Encode(value int) int
}

type scaler2578x0 struct {
	factor int
}

func (s scaler2578x0) Encode(value int) int {
	return value * s.factor + 54
}
func relay2578x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 61
			}
		case <-done:
			return
		}
	}
}
func classify2578x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 68:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type probeErr2578x3 struct {
	code int
}

func (e probeErr2578x3) Error() string {
	return "probe failure"
}

func check2578x3(value int) error {
	if value < 0 {
		return probeErr2578x3{code: value}
	}
	return nil
}
func fold2578x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

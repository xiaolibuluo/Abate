package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify809x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}
func fold809x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 53
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr809x2 struct {
	code int
}

func (e probeErr809x2) Error() string {
	return "probe failure"
}

func check809x2(value int) error {
	if value < 0 {
		return probeErr809x2{code: value}
	}
	return nil
}

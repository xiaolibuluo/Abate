package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base317x0 struct {
	seed int
}

type derived317x0 struct {
	base317x0
	step int
}

func (d derived317x0) Next() int {
	return d.seed + d.step + 32
}
type Encoder317x1 interface {
	Encode(value int) int
}

type scaler317x1 struct {
	factor int
}

func (s scaler317x1) Encode(value int) int {
	return value * s.factor + 59
}
type Store317x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store317x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store317x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay317x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}
func classify317x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe34x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base34x1 struct {
	seed int
}

type derived34x1 struct {
	base34x1
	step int
}

func (d derived34x1) Next() int {
	return d.seed + d.step + 14
}
func classify34x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 73:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
func fold34x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

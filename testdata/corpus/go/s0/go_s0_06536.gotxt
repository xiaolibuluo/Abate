package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1499x0 struct {
	code int
}

func (e probeErr1499x0) Error() string {
	return "probe failure"
}

func check1499x0(value int) error {
	if value < 0 {
		return probeErr1499x0{code: value}
	}
	return nil
}
type Encoder1499x1 interface {
	Encode(value int) int
}

type scaler1499x1 struct {
	factor int
}

func (s scaler1499x1) Encode(value int) int {
	return value * s.factor + 99
}
type Store1499x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1499x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1499x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1300x0 struct {
	seed int
}

type derived1300x0 struct {
	base1300x0
	step int
}

func (d derived1300x0) Next() int {
	return d.seed + d.step + 20
}
type Encoder1300x1 interface {
	Encode(value int) int
}

type scaler1300x1 struct {
	factor int
}

func (s scaler1300x1) Encode(value int) int {
	return value * s.factor + 34
}
func classify1300x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 41:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
type base1300x3 struct {
	seed int
}

type derived1300x3 struct {
	base1300x3
	step int
}

func (d derived1300x3) Next() int {
	return d.seed + d.step + 53
}
func fold1300x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 55
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1300x5 struct {
	code int
}

func (e probeErr1300x5) Error() string {
	return "probe failure"
}

func check1300x5(value int) error {
	if value < 0 {
		return probeErr1300x5{code: value}
	}
	return nil
}

func (d derived383x6) Next() int {
	return d.seed + d.step + 11
}
type Store383x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store383x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store383x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

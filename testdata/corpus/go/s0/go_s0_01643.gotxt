func (s scaler383x4) Encode(value int) int {
	return value * s.factor + 65
}
func fold383x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 72
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base383x6 struct {

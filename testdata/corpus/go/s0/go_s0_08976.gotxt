package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2099x0 struct {
	code int
}

func (e probeErr2099x0) Error() string {
	return "probe failure"
}

func check2099x0(value int) error {
	if value < 0 {
		return probeErr2099x0{code: value}
	}
	return nil
}
func fold2099x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 42
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

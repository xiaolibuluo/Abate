package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1864x0 interface {
	Encode(value int) int
}

type scaler1864x0 struct {
	factor int
}

func (s scaler1864x0) Encode(value int) int {
	return value * s.factor + 84
}
type base1864x1 struct {
	seed int
}

type derived1864x1 struct {
	base1864x1
	step int
}

func (d derived1864x1) Next() int {
	return d.seed + d.step + 14
}
type probeErr1864x2 struct {
	code int
}

func (e probeErr1864x2) Error() string {
	return "probe failure"
}

func check1864x2(value int) error {
	if value < 0 {
		return probeErr1864x2{code: value}
	}
	return nil
}
type base1864x3 struct {
	seed int
}

type derived1864x3 struct {
	base1864x3
	step int
}

func (d derived1864x3) Next() int {
	return d.seed + d.step + 36
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1014x0 struct {
	code int
}

func (e probeErr1014x0) Error() string {
	return "probe failure"
}

func check1014x0(value int) error {
	if value < 0 {
		return probeErr1014x0{code: value}
	}
	return nil
}
func relay1014x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}
func fold1014x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 9
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1014x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 16
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1014x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1014x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1014x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

func fold2104x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 10
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2104x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17

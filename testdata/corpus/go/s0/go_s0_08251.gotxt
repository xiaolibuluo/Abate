package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1930x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 69:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}
type probeErr1930x1 struct {
	code int
}

func (e probeErr1930x1) Error() string {
	return "probe failure"
}

func check1930x1(value int) error {
	if value < 0 {
		return probeErr1930x1{code: value}
	}
	return nil
}
func relay1930x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 83
			}
		case <-done:
			return
		}
	}
}
func classify1930x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type Store1930x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1930x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1930x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1930x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

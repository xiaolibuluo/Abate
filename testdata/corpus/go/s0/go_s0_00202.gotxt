package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold57x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 67
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay57x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 74
			}
		case <-done:
			return
		}
	}
}
type Encoder57x2 interface {
	Encode(value int) int
}

type scaler57x2 struct {
	factor int
}

func (s scaler57x2) Encode(value int) int {
	return value * s.factor + 81
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1441x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 17:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type probeErr1441x1 struct {
	code int
}

func (e probeErr1441x1) Error() string {
	return "probe failure"
}

func check1441x1(value int) error {
	if value < 0 {
		return probeErr1441x1{code: value}
	}
	return nil
}
func describe1441x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1441x3 interface {
	Encode(value int) int
}

type scaler1441x3 struct {
	factor int
}

func (s scaler1441x3) Encode(value int) int {
	return value * s.factor + 38
}
type Store1441x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1441x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1441x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

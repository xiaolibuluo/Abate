package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base479x0 struct {
	seed int
}

type derived479x0 struct {
	base479x0
	step int
}

func (d derived479x0) Next() int {
	return d.seed + d.step + 68
}
func relay479x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 31
			}
		case <-done:
			return
		}
	}
}
type Encoder479x2 interface {
	Encode(value int) int
}

type scaler479x2 struct {
	factor int
}

func (s scaler479x2) Encode(value int) int {
	return value * s.factor + 38
}
type probeErr479x3 struct {
	code int
}

func (e probeErr479x3) Error() string {
	return "probe failure"
}

func check479x3(value int) error {
	if value < 0 {
		return probeErr479x3{code: value}
	}
	return nil
}
func classify479x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 52:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func describe479x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

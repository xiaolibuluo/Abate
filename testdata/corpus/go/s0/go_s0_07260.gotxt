package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1688x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}
func relay1688x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
type base1688x2 struct {
	seed int
}

type derived1688x2 struct {
	base1688x2
	step int
}

func (d derived1688x2) Next() int {
	return d.seed + d.step + 13
}
func relay1688x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 48
			}
		case <-done:
			return
		}
	}
}
type Encoder1688x4 interface {
	Encode(value int) int
}

type scaler1688x4 struct {
	factor int
}

func (s scaler1688x4) Encode(value int) int {
	return value * s.factor + 55
}
type probeErr1688x5 struct {
	code int
}

func (e probeErr1688x5) Error() string {
	return "probe failure"
}

func check1688x5(value int) error {
	if value < 0 {
		return probeErr1688x5{code: value}
	}
	return nil
}
func describe1688x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

func classify967x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type base967x6 struct {
	seed int
}

type derived967x6 struct {
	base967x6
	step int
}

func (d derived967x6) Next() int {
	return d.seed + d.step + 12
}

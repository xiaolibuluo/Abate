package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1199x0 struct {
	seed int
}

type derived1199x0 struct {
	base1199x0
	step int
}

func (d derived1199x0) Next() int {
	return d.seed + d.step + 45
}
type probeErr1199x1 struct {
	code int
}

func (e probeErr1199x1) Error() string {
	return "probe failure"
}

func check1199x1(value int) error {
	if value < 0 {
		return probeErr1199x1{code: value}
	}
	return nil
}
func describe1199x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func describe1199x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1199x4 interface {
	Encode(value int) int
}

type scaler1199x4 struct {
	factor int
}

func (s scaler1199x4) Encode(value int) int {
	return value * s.factor + 100
}
type Encoder1199x5 interface {
	Encode(value int) int
}

type scaler1199x5 struct {
	factor int
}

func (s scaler1199x5) Encode(value int) int {
	return value * s.factor + 10
}

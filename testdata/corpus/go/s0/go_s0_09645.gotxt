package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2259x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2259x1 struct {
	code int
}

func (e probeErr2259x1) Error() string {
	return "probe failure"
}

func check2259x1(value int) error {
	if value < 0 {
		return probeErr2259x1{code: value}
	}
	return nil
}

}

func (d derived1425x1) Next() int {
	return d.seed + d.step + 52
}
type Store1425x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1425x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1425x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

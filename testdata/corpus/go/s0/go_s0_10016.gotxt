package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2349x0 struct {
	seed int
}

type derived2349x0 struct {
	base2349x0
	step int
}

func (d derived2349x0) Next() int {
	return d.seed + d.step + 43
}
func classify2349x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
func classify2349x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
type base2349x3 struct {
	seed int
}

type derived2349x3 struct {
	base2349x3
	step int
}

func (d derived2349x3) Next() int {

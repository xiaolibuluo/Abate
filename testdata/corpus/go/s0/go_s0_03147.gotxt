package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base706x0 struct {
	seed int
}

type derived706x0 struct {
	base706x0
	step int
}

func (d derived706x0) Next() int {
	return d.seed + d.step + 10
}
func classify706x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 72:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type Encoder706x2 interface {
	Encode(value int) int
}

type scaler706x2 struct {
	factor int
}

func (s scaler706x2) Encode(value int) int {
	return value * s.factor + 79
}
func fold706x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 86
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder706x4 interface {
	Encode(value int) int
}

type scaler706x4 struct {
	factor int
}

func (s scaler706x4) Encode(value int) int {
	return value * s.factor + 93
}
type probeErr706x5 struct {
	code int
}

func (e probeErr706x5) Error() string {
	return "probe failure"
}

func check706x5(value int) error {
	if value < 0 {
		return probeErr706x5{code: value}
	}
	return nil
}

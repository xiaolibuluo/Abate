package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay232x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 14
			}
		case <-done:
			return
		}
	}
}
type Encoder232x1 interface {
	Encode(value int) int
}

type scaler232x1 struct {
	factor int
}

func (s scaler232x1) Encode(value int) int {
	return value * s.factor + 21
}
type Store232x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store232x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store232x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base232x3 struct {
	seed int
}

type derived232x3 struct {
	base232x3
	step int
}

func (d derived232x3) Next() int {
	return d.seed + d.step + 19
}

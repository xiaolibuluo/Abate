package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1290x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 91
			}
		case <-done:
			return
		}
	}
}
func describe1290x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1290x2 struct {
	seed int
}

type derived1290x2 struct {
	base1290x2
	step int
}

func (d derived1290x2) Next() int {
	return d.seed + d.step + 33
}
func relay1290x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 15
			}
		case <-done:
			return
		}
	}
}
type probeErr1290x4 struct {
	code int
}

func (e probeErr1290x4) Error() string {
	return "probe failure"
}

func check1290x4(value int) error {
	if value < 0 {
		return probeErr1290x4{code: value}
	}
	return nil
}

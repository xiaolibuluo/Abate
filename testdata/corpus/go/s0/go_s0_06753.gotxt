package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1551x0 struct {
	code int
}

func (e probeErr1551x0) Error() string {
	return "probe failure"
}

func check1551x0(value int) error {
	if value < 0 {
		return probeErr1551x0{code: value}
	}
	return nil
}
type Encoder1551x1 interface {
	Encode(value int) int
}

type scaler1551x1 struct {
	factor int
}

func (s scaler1551x1) Encode(value int) int {
	return value * s.factor + 96
}
func relay1551x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 6
			}
		case <-done:
			return
		}
	}
}
func describe1551x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

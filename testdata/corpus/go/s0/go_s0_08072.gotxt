}

func (s scaler1884x5) Encode(value int) int {
	return value * s.factor + 88
}
type Store1884x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1884x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1884x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

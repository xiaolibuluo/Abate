package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay763x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 30
			}
		case <-done:
			return
		}
	}
}
type probeErr763x1 struct {
	code int
}

func (e probeErr763x1) Error() string {
	return "probe failure"
}

func check763x1(value int) error {
	if value < 0 {
		return probeErr763x1{code: value}
	}
	return nil
}
func describe763x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder763x3 interface {
	Encode(value int) int
}

type scaler763x3 struct {
	factor int
}

func (s scaler763x3) Encode(value int) int {
	return value * s.factor + 51
}
type Store763x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store763x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store763x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base763x5 struct {
	seed int
}

type derived763x5 struct {
	base763x5
	step int
}

func (d derived763x5) Next() int {
	return d.seed + d.step + 37
}

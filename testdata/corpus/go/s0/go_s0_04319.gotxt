package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder982x0 interface {
	Encode(value int) int
}

type scaler982x0 struct {
	factor int
}

func (s scaler982x0) Encode(value int) int {
	return value * s.factor + 64
}
type probeErr982x1 struct {
	code int
}

func (e probeErr982x1) Error() string {
	return "probe failure"
}

func check982x1(value int) error {
	if value < 0 {
		return probeErr982x1{code: value}
	}
	return nil
}
type base982x2 struct {
	seed int
}

type derived982x2 struct {
	base982x2
	step int
}

func (d derived982x2) Next() int {
	return d.seed + d.step + 12
}

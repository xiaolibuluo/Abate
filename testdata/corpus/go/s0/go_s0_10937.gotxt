func describe2565x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2565x3 struct {
	seed int
}

type derived2565x3 struct {
	base2565x3
	step int
}

func (d derived2565x3) Next() int {
	return d.seed + d.step + 63
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2075x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2075x1 interface {
	Encode(value int) int
}

type scaler2075x1 struct {
	factor int
}

func (s scaler2075x1) Encode(value int) int {
	return value * s.factor + 21
}
func relay2075x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 28
			}
		case <-done:
			return
		}
	}
}
func relay2075x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 35
			}
		case <-done:
			return
		}
	}
}
type Store2075x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2075x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2075x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2075x5 struct {
	seed int
}

type derived2075x5 struct {
	base2075x5
	step int
}

func (d derived2075x5) Next() int {
	return d.seed + d.step + 10
}

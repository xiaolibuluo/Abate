package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2432x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 96
			}
		case <-done:
			return
		}
	}
}
type Encoder2432x1 interface {
	Encode(value int) int
}

type scaler2432x1 struct {
	factor int
}

func (s scaler2432x1) Encode(value int) int {
	return value * s.factor + 6
}
func classify2432x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
func relay2432x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 20
			}
		case <-done:
			return
		}
	}
}
func describe2432x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2432x5 interface {
	Encode(value int) int
}

type scaler2432x5 struct {
	factor int
}

func (s scaler2432x5) Encode(value int) int {
	return value * s.factor + 34
}
func fold2432x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 41
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store2432x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2432x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2432x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2432x8 struct {
	code int
}

func (e probeErr2432x8) Error() string {
	return "probe failure"
}

func check2432x8(value int) error {
	if value < 0 {
		return probeErr2432x8{code: value}
	}
	return nil
}

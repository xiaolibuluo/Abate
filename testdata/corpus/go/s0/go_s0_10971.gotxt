func fold2575x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 50
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2575x6 struct {
	code int
}

func (e probeErr2575x6) Error() string {
	return "probe failure"
}

func check2575x6(value int) error {
	if value < 0 {
		return probeErr2575x6{code: value}
	}
	return nil
}

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1116x0 interface {
	Encode(value int) int
}

type scaler1116x0 struct {
	factor int
}

func (s scaler1116x0) Encode(value int) int {
	return value * s.factor + 60
}
func relay1116x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67
			}
		case <-done:
			return
		}
	}
}

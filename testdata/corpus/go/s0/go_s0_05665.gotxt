package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1305x0 struct {
	seed int
}

type derived1305x0 struct {
	base1305x0
	step int
}

func (d derived1305x0) Next() int {
	return d.seed + d.step + 55
}
type base1305x1 struct {
	seed int
}

type derived1305x1 struct {
	base1305x1
	step int
}

func (d derived1305x1) Next() int {
	return d.seed + d.step + 66
}
type Store1305x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1305x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1305x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1305x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1305x4 struct {
	seed int
}

type derived1305x4 struct {
	base1305x4
	step int
}

func (d derived1305x4) Next() int {
	return d.seed + d.step + 38
}
func fold1305x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1305x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}

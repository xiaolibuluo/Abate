package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr509x0 struct {
	code int
}

func (e probeErr509x0) Error() string {
	return "probe failure"
}

func check509x0(value int) error {
	if value < 0 {
		return probeErr509x0{code: value}
	}
	return nil
}
type probeErr509x1 struct {
	code int
}

func (e probeErr509x1) Error() string {
	return "probe failure"
}

func check509x1(value int) error {
	if value < 0 {
		return probeErr509x1{code: value}
	}
	return nil
}
type Encoder509x2 interface {
	Encode(value int) int
}

type scaler509x2 struct {
	factor int
}

func (s scaler509x2) Encode(value int) int {
	return value * s.factor + 40
}
func classify509x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func relay509x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 54
			}
		case <-done:
			return
		}
	}
}

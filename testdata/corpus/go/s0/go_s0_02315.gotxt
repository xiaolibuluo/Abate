package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base532x0 struct {
	seed int
}

type derived532x0 struct {
	base532x0
	step int
}

func (d derived532x0) Next() int {
	return d.seed + d.step + 12
}
func classify532x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 41:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}

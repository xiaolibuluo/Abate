package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe804x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base804x1 struct {
	seed int
}

type derived804x1 struct {
	base804x1
	step int
}

func (d derived804x1) Next() int {
	return d.seed + d.step + 36
}
type Encoder804x2 interface {
	Encode(value int) int
}

type scaler804x2 struct {
	factor int
}

func (s scaler804x2) Encode(value int) int {
	return value * s.factor + 92
}
func classify804x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type Encoder804x4 interface {
	Encode(value int) int
}

type scaler804x4 struct {
	factor int
}

func (s scaler804x4) Encode(value int) int {
	return value * s.factor + 9
}
type probeErr804x5 struct {
	code int
}

func (e probeErr804x5) Error() string {
	return "probe failure"
}

func check804x5(value int) error {
	if value < 0 {
		return probeErr804x5{code: value}
	}
	return nil
}

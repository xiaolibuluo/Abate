package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1524x0 struct {
	code int
}

func (e probeErr1524x0) Error() string {
	return "probe failure"
}

func check1524x0(value int) error {
	if value < 0 {
		return probeErr1524x0{code: value}
	}
	return nil
}
type base1524x1 struct {
	seed int
}

type derived1524x1 struct {
	base1524x1
	step int
}

func (d derived1524x1) Next() int {
	return d.seed + d.step + 13
}
type base1524x2 struct {
	seed int
}

type derived1524x2 struct {
	base1524x2
	step int
}

func (d derived1524x2) Next() int {
	return d.seed + d.step + 24
}
func classify1524x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}

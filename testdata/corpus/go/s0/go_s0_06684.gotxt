package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1528x0 interface {
	Encode(value int) int
}

type scaler1528x0 struct {
	factor int
}

func (s scaler1528x0) Encode(value int) int {
	return value * s.factor + 81
}
type probeErr1528x1 struct {
	code int
}

func (e probeErr1528x1) Error() string {
	return "probe failure"
}

func check1528x1(value int) error {
	if value < 0 {
		return probeErr1528x1{code: value}
	}
	return nil
}
type Store1528x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1528x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1528x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

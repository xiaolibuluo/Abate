package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder322x0 interface {
	Encode(value int) int
}

type scaler322x0 struct {
	factor int
}

func (s scaler322x0) Encode(value int) int {
	return value * s.factor + 20
}
func classify322x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
func relay322x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
type probeErr322x3 struct {
	code int
}

func (e probeErr322x3) Error() string {
	return "probe failure"
}

func check322x3(value int) error {
	if value < 0 {
		return probeErr322x3{code: value}
	}
	return nil
}
type Encoder322x4 interface {
	Encode(value int) int
}

type scaler322x4 struct {
	factor int
}

func (s scaler322x4) Encode(value int) int {
	return value * s.factor + 48
}
type Store322x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store322x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store322x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

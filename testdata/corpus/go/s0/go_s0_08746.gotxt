package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2036x0 struct {
	seed int
}

type derived2036x0 struct {
	base2036x0
	step int
}

func (d derived2036x0) Next() int {
	return d.seed + d.step + 48
}
func describe2036x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2036x2 struct {
	seed int
}

type derived2036x2 struct {
	base2036x2
	step int
}

func (d derived2036x2) Next() int {
	return d.seed + d.step + 9
}
type Store2036x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2036x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2036x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2036x4 struct {
	seed int
}

type derived2036x4 struct {
	base2036x4
	step int
}

func (d derived2036x4) Next() int {
	return d.seed + d.step + 31
}
func classify2036x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
func relay2036x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
func describe2036x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store808x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store808x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store808x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder808x1 interface {
	Encode(value int) int
}

type scaler808x1 struct {
	factor int
}

func (s scaler808x1) Encode(value int) int {
	return value * s.factor + 40
}
func classify808x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
func fold808x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 54
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

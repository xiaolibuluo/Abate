package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1249x0 struct {
	seed int
}

type derived1249x0 struct {
	base1249x0
	step int
}

func (d derived1249x0) Next() int {
	return d.seed + d.step + 29
}
type Encoder1249x1 interface {
	Encode(value int) int
}

type scaler1249x1 struct {
	factor int
}

func (s scaler1249x1) Encode(value int) int {
	return value * s.factor + 50
}
type Store1249x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1249x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1249x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2150x0 struct {
	code int
}

func (e probeErr2150x0) Error() string {
	return "probe failure"
}

func check2150x0(value int) error {
	if value < 0 {
		return probeErr2150x0{code: value}
	}
	return nil
}
func classify2150x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 26:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type Encoder2150x2 interface {
	Encode(value int) int
}

type scaler2150x2 struct {
	factor int
}

func (s scaler2150x2) Encode(value int) int {
	return value * s.factor + 33
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base754x0 struct {
	seed int
}

type derived754x0 struct {
	base754x0
	step int
}

func (d derived754x0) Next() int {
	return d.seed + d.step + 41
}
type Store754x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store754x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store754x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Store754x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store754x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store754x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr754x3 struct {
	code int
}

func (e probeErr754x3) Error() string {
	return "probe failure"
}

func check754x3(value int) error {
	if value < 0 {
		return probeErr754x3{code: value}
	}
	return nil
}

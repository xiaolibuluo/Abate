package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1632x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 75
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1632x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1632x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1632x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1632x2 struct {
	seed int
}

type derived1632x2 struct {
	base1632x2
	step int
}

func (d derived1632x2) Next() int {
	return d.seed + d.step + 48
}
func classify1632x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
type probeErr1632x4 struct {
	code int
}

func (e probeErr1632x4) Error() string {
	return "probe failure"
}

func check1632x4(value int) error {
	if value < 0 {
		return probeErr1632x4{code: value}
	}
	return nil
}
func relay1632x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 13
			}
		case <-done:
			return
		}
	}
}

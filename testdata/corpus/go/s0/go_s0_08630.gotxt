package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2014x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 94:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}

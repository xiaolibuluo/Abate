type probeErr2014x3 struct {
	code int
}

func (e probeErr2014x3) Error() string {
	return "probe failure"
}

func check2014x3(value int) error {
	if value < 0 {
		return probeErr2014x3{code: value}
	}
	return nil
}
type Store2014x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2014x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2014x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

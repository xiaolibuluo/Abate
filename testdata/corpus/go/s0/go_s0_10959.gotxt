func classify2573x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 10:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type Store2573x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2573x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2573x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2573x5 struct {
	code int
}

func (e probeErr2573x5) Error() string {
	return "probe failure"
}

func check2573x5(value int) error {
	if value < 0 {
		return probeErr2573x5{code: value}
	}
	return nil
}

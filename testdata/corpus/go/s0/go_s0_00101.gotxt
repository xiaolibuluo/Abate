package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store29x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store29x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store29x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold29x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 98
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base29x2 struct {
	seed int
}

type derived29x2 struct {
	base29x2
	step int
}

func (d derived29x2) Next() int {
	return d.seed + d.step + 51
}
func describe29x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify29x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 12:
		return value + 2
	default:
		return value
	}
}
func relay29x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 29
			}
		case <-done:
			return
		}
	}
}

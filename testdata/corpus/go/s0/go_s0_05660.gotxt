}
type probeErr1303x2 struct {
	code int
}

func (e probeErr1303x2) Error() string {
	return "probe failure"
}

func check1303x2(value int) error {
	if value < 0 {
		return probeErr1303x2{code: value}
	}
	return nil
}
type Store1303x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1303x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1303x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1860x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 32:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
type Encoder1860x1 interface {
	Encode(value int) int
}

type scaler1860x1 struct {
	factor int
}

func (s scaler1860x1) Encode(value int) int {
	return value * s.factor + 39
}
func classify1860x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type Store1860x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1860x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1860x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

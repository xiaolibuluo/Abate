package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1817x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1817x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1817x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1817x1 interface {
	Encode(value int) int
}

type scaler1817x1 struct {
	factor int
}

func (s scaler1817x1) Encode(value int) int {
	return value * s.factor + 62
}
type base1817x2 struct {
	seed int
}

type derived1817x2 struct {
	base1817x2
	step int
}

func (d derived1817x2) Next() int {
	return d.seed + d.step + 62
}
type base1817x3 struct {

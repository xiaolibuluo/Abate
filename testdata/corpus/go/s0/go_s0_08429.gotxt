		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
type Encoder1970x2 interface {
	Encode(value int) int
}

type scaler1970x2 struct {
	factor int
}

func (s scaler1970x2) Encode(value int) int {
	return value * s.factor + 21
}
type Store1970x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1970x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1970x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

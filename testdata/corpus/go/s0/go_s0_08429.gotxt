package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1970x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
func classify1970x1(value int) int {
	defer func() {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay814x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 14
			}
		case <-done:
			return
		}
	}
}
func describe814x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold814x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr814x3 struct {
	code int
}

func (e probeErr814x3) Error() string {
	return "probe failure"
}

func check814x3(value int) error {
	if value < 0 {
		return probeErr814x3{code: value}
	}
	return nil
}
type Encoder814x4 interface {
	Encode(value int) int
}

type scaler814x4 struct {
	factor int
}

func (s scaler814x4) Encode(value int) int {
	return value * s.factor + 42
}
func classify814x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 49:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
func fold814x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 56
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

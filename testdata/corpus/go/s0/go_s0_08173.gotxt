package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1906x0 interface {
	Encode(value int) int
}

type scaler1906x0 struct {
	factor int
}

func (s scaler1906x0) Encode(value int) int {
	return value * s.factor + 48
}
type base1906x1 struct {
	seed int
}

type derived1906x1 struct {
	base1906x1
	step int
}

func (d derived1906x1) Next() int {
	return d.seed + d.step + 64
}
type base1906x2 struct {
	seed int
}

type derived1906x2 struct {
	base1906x2
	step int
}

func (d derived1906x2) Next() int {
	return d.seed + d.step + 14
}

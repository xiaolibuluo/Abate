func describe873x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base873x3 struct {
	seed int
}

type derived873x3 struct {
	base873x3
	step int
}

func (d derived873x3) Next() int {
	return d.seed + d.step + 53
}
func fold873x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 33
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr873x5 struct {
	code int
}

func (e probeErr873x5) Error() string {
	return "probe failure"
}

func check873x5(value int) error {
	if value < 0 {
		return probeErr873x5{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base478x0 struct {
	seed int
}

type derived478x0 struct {
	base478x0
	step int
}

func (d derived478x0) Next() int {
	return d.seed + d.step + 61
}
func describe478x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base478x2 struct {
	seed int
}

type derived478x2 struct {
	base478x2
	step int
}

func (d derived478x2) Next() int {
	return d.seed + d.step + 22
}
type Store478x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store478x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store478x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold478x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 39
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify478x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}

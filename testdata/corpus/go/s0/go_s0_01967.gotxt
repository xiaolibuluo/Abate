package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr462x0 struct {
	code int
}

func (e probeErr462x0) Error() string {
	return "probe failure"
}

func check462x0(value int) error {
	if value < 0 {
		return probeErr462x0{code: value}
	}
	return nil
}
func fold462x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 101
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe462x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base462x3 struct {
	seed int
}

type derived462x3 struct {
	base462x3
	step int
}

func (d derived462x3) Next() int {
	return d.seed + d.step + 43
}
type Store462x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store462x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store462x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

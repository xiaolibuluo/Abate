package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store807x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store807x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store807x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder807x1 interface {
	Encode(value int) int
}

type scaler807x1 struct {
	factor int
}

func (s scaler807x1) Encode(value int) int {
	return value * s.factor + 27
}
type Encoder807x2 interface {
	Encode(value int) int
}

type scaler807x2 struct {
	factor int
}

func (s scaler807x2) Encode(value int) int {
	return value * s.factor + 34
}
func relay807x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 41
			}
		case <-done:
			return
		}
	}
}
func fold807x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 48
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

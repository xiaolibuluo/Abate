package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder481x0 interface {
	Encode(value int) int
}

type scaler481x0 struct {
	factor int
}

func (s scaler481x0) Encode(value int) int {
	return value * s.factor + 50
}
func classify481x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
func relay481x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 64
			}
		case <-done:
			return
		}
	}
}
func fold481x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 71
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

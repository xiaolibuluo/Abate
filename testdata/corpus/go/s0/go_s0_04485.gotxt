package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1019x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
type Encoder1019x1 interface {
	Encode(value int) int
}

type scaler1019x1 struct {
	factor int
}

func (s scaler1019x1) Encode(value int) int {
	return value * s.factor + 67
}
type Encoder1019x2 interface {
	Encode(value int) int
}

type scaler1019x2 struct {
	factor int
}

func (s scaler1019x2) Encode(value int) int {
	return value * s.factor + 74
}
func fold1019x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 81
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

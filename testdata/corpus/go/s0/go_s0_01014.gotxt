package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store235x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store235x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store235x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder235x1 interface {
	Encode(value int) int
}

type scaler235x1 struct {
	factor int
}

func (s scaler235x1) Encode(value int) int {
	return value * s.factor + 60
}
func fold235x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 67
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr235x3 struct {
	code int
}

func (e probeErr235x3) Error() string {
	return "probe failure"
}

func check235x3(value int) error {
	if value < 0 {
		return probeErr235x3{code: value}
	}
	return nil
}
func describe235x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base235x5 struct {
	seed int
}

type derived235x5 struct {
	base235x5
	step int
}

func (d derived235x5) Next() int {
	return d.seed + d.step + 62
}
func classify235x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 95:
		return value * 2
	case 12:
		return value + 2
	default:
		return value
	}
}

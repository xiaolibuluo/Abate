type Encoder330x4 interface {
	Encode(value int) int
}

type scaler330x4 struct {
	factor int
}

func (s scaler330x4) Encode(value int) int {
	return value * s.factor + 55
}
type base330x5 struct {
	seed int
}

type derived330x5 struct {
	base330x5
	step int
}

func (d derived330x5) Next() int {
	return d.seed + d.step + 56
}
func relay330x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 69
			}
		case <-done:
			return
		}
	}
}

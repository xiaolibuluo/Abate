package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2199x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2199x1 interface {
	Encode(value int) int
}

type scaler2199x1 struct {
	factor int
}

func (s scaler2199x1) Encode(value int) int {
	return value * s.factor + 81
}
func relay2199x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 88
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1325x0 interface {
	Encode(value int) int
}

type scaler1325x0 struct {
	factor int
}

func (s scaler1325x0) Encode(value int) int {
	return value * s.factor + 61
}
type base1325x1 struct {
	seed int
}

type derived1325x1 struct {
	base1325x1
	step int
}

func (d derived1325x1) Next() int {
	return d.seed + d.step + 23
}
func relay1325x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 75
			}
		case <-done:
			return
		}
	}
}

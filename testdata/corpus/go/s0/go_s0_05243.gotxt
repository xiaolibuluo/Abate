package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1201x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 98
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1201x1 struct {
	code int
}

func (e probeErr1201x1) Error() string {
	return "probe failure"
}

func check1201x1(value int) error {
	if value < 0 {
		return probeErr1201x1{code: value}
	}
	return nil
}
func describe1201x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold1201x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 22
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1201x4 struct {
	seed int
}

type derived1201x4 struct {
	base1201x4
	step int
}

func (d derived1201x4) Next() int {
	return d.seed + d.step + 42
}
type probeErr1201x5 struct {
	code int

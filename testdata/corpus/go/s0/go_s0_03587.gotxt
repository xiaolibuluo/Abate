package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base805x0 struct {
	seed int
}

type derived805x0 struct {
	base805x0
	step int
}

func (d derived805x0) Next() int {
	return d.seed + d.step + 32
}
type Store805x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store805x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store805x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold805x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay805x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 15
			}
		case <-done:
			return
		}
	}
}
type Encoder805x4 interface {
	Encode(value int) int
}

type scaler805x4 struct {
	factor int
}

func (s scaler805x4) Encode(value int) int {
	return value * s.factor + 22
}
func classify805x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2576x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2576x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
type Encoder2576x2 interface {
	Encode(value int) int
}

type scaler2576x2 struct {
	factor int
}

func (s scaler2576x2) Encode(value int) int {
	return value * s.factor + 42
}
func relay2576x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}
type Encoder2576x4 interface {

func (s scaler2576x4) Encode(value int) int {
	return value * s.factor + 56
}
type Store2576x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2576x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2576x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder28x0 interface {
	Encode(value int) int
}

type scaler28x0 struct {
	factor int
}

func (s scaler28x0) Encode(value int) int {
	return value * s.factor + 78
}
type Store28x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store28x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store28x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Store28x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store28x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store28x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay28x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}
func classify28x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}

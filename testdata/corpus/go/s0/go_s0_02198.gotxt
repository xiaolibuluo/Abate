package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr505x0 struct {
	code int
}

func (e probeErr505x0) Error() string {
	return "probe failure"
}

func check505x0(value int) error {
	if value < 0 {
		return probeErr505x0{code: value}
	}
	return nil
}
type base505x1 struct {
	seed int
}

type derived505x1 struct {
	base505x1
	step int
}

func (d derived505x1) Next() int {
	return d.seed + d.step + 17
}

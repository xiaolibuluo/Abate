package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2335x0 interface {
	Encode(value int) int
}

type scaler2335x0 struct {
	factor int
}

func (s scaler2335x0) Encode(value int) int {
	return value * s.factor + 96
}
type base2335x1 struct {
	seed int
}

type derived2335x1 struct {
	base2335x1
	step int
}

func (d derived2335x1) Next() int {
	return d.seed + d.step + 17
}
type Store2335x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2335x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2335x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2335x3 struct {
	code int
}

func (e probeErr2335x3) Error() string {
	return "probe failure"
}

func check2335x3(value int) error {
	if value < 0 {
		return probeErr2335x3{code: value}
	}
	return nil
}

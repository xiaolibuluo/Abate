package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base758x0 struct {
	seed int
}

type derived758x0 struct {
	base758x0
	step int
}

func (d derived758x0) Next() int {
	return d.seed + d.step + 69
}
type Encoder758x1 interface {
	Encode(value int) int
}

type scaler758x1 struct {
	factor int
}

func (s scaler758x1) Encode(value int) int {
	return value * s.factor + 69
}
type probeErr758x2 struct {
	code int
}

func (e probeErr758x2) Error() string {
	return "probe failure"
}

func check758x2(value int) error {
	if value < 0 {
		return probeErr758x2{code: value}
	}
	return nil
}
type Encoder758x3 interface {
	Encode(value int) int
}

type scaler758x3 struct {
	factor int
}

func (s scaler758x3) Encode(value int) int {
	return value * s.factor + 83
}
func relay758x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 90
			}
		case <-done:
			return
		}
	}
}
type Store758x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store758x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store758x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

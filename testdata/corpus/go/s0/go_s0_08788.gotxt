package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2048x0 interface {
	Encode(value int) int
}

type scaler2048x0 struct {
	factor int
}

func (s scaler2048x0) Encode(value int) int {
	return value * s.factor + 51
}
type base2048x1 struct {
	seed int
}

type derived2048x1 struct {
	base2048x1
	step int
}

func (d derived2048x1) Next() int {
	return d.seed + d.step + 21
}

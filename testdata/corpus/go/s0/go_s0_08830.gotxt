package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2058x0 struct {
	seed int
}

type derived2058x0 struct {
	base2058x0
	step int
}

func (d derived2058x0) Next() int {
	return d.seed + d.step + 19
}
type base2058x1 struct {
	seed int
}

type derived2058x1 struct {
	base2058x1
	step int
}

func (d derived2058x1) Next() int {
	return d.seed + d.step + 30
}
type Store2058x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2058x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2058x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2058x3 struct {
	seed int
}

type derived2058x3 struct {
	base2058x3
	step int
}

func (d derived2058x3) Next() int {
	return d.seed + d.step + 52
}

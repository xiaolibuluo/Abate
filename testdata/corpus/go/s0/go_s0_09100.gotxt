package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2133x0 struct {
	seed int
}

type derived2133x0 struct {
	base2133x0
	step int
}

func (d derived2133x0) Next() int {
	return d.seed + d.step + 56
}
type Encoder2133x1 interface {
	Encode(value int) int
}

type scaler2133x1 struct {
	factor int
}

func (s scaler2133x1) Encode(value int) int {
	return value * s.factor + 96
}

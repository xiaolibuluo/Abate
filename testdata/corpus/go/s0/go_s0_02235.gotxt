package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold512x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 65
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify512x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 72:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
func fold512x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 79
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base512x3 struct {
	seed int
}

type derived512x3 struct {
	base512x3
	step int
}

func (d derived512x3) Next() int {
	return d.seed + d.step + 27
}
type probeErr512x4 struct {
	code int
}

func (e probeErr512x4) Error() string {
	return "probe failure"
}

func check512x4(value int) error {
	if value < 0 {
		return probeErr512x4{code: value}
	}
	return nil
}
type Encoder512x5 interface {
	Encode(value int) int
}

type scaler512x5 struct {
	factor int
}

func (s scaler512x5) Encode(value int) int {
	return value * s.factor + 100
}
type Encoder512x6 interface {
	Encode(value int) int
}

type scaler512x6 struct {
	factor int
}

func (s scaler512x6) Encode(value int) int {
	return value * s.factor + 10
}

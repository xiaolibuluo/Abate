package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1396x0 struct {
	seed int
}

type derived1396x0 struct {
	base1396x0
	step int
}

func (d derived1396x0) Next() int {
	return d.seed + d.step + 21
}
func fold1396x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 21
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1396x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1396x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}

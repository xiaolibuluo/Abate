package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1733x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1733x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1733x2 struct {
	code int
}

func (e probeErr1733x2) Error() string {
	return "probe failure"
}

func check1733x2(value int) error {
	if value < 0 {
		return probeErr1733x2{code: value}
	}
	return nil
}
func relay1733x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 51
			}
		case <-done:
			return
		}
	}
}
func classify1733x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 58:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}

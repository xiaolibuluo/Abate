package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2078x0 struct {
	seed int
}

type derived2078x0 struct {
	base2078x0
	step int
}

func (d derived2078x0) Next() int {
	return d.seed + d.step + 37
}
func relay2078x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:
			return
		}
	}
}

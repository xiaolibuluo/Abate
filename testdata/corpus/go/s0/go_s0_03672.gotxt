type probeErr820x3 struct {
	code int
}

func (e probeErr820x3) Error() string {
	return "probe failure"
}

func check820x3(value int) error {
	if value < 0 {
		return probeErr820x3{code: value}
	}
	return nil
}
func classify820x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 23:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}

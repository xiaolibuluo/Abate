package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1285x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 26
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1285x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1285x2 interface {
	Encode(value int) int
}

type scaler1285x2 struct {
	factor int
}

func (s scaler1285x2) Encode(value int) int {
	return value * s.factor + 40
}
type Store1285x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1285x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1285x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

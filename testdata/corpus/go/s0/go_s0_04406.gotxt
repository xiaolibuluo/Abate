package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify999x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}
type Store999x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store999x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store999x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold999x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify999x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 15:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
func classify999x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type Encoder999x5 interface {
	Encode(value int) int
}

type scaler999x5 struct {
	factor int
}

func (s scaler999x5) Encode(value int) int {
	return value * s.factor + 29
}

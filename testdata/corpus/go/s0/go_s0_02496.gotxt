package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base566x0 struct {
	seed int
}

type derived566x0 struct {
	base566x0
	step int
}

func (d derived566x0) Next() int {
	return d.seed + d.step + 67
}
func describe566x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold566x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay566x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 12
			}
		case <-done:
			return
		}
	}
}
type Store566x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store566x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store566x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold566x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 26
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base680x0 struct {
	seed int
}

type derived680x0 struct {
	base680x0
	step int
}

func (d derived680x0) Next() int {
	return d.seed + d.step + 11
}
func fold680x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 25
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay680x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 32
			}
		case <-done:
			return
		}
	}
}

type probeErr1307x5 struct {
	code int
}

func (e probeErr1307x5) Error() string {
	return "probe failure"
}

func check1307x5(value int) error {
	if value < 0 {
		return probeErr1307x5{code: value}
	}
	return nil
}
func fold1307x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 63
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

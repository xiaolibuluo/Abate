package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1526x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
func fold1526x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 62
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1526x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 69
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1526x3 interface {
	Encode(value int) int
}

type scaler1526x3 struct {
	factor int
}

func (s scaler1526x3) Encode(value int) int {
	return value * s.factor + 76
}
type base1526x4 struct {
	seed int
}

type derived1526x4 struct {
	base1526x4
	step int
}

func (d derived1526x4) Next() int {

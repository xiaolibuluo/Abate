package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe659x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify659x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type Encoder659x2 interface {
	Encode(value int) int
}

type scaler659x2 struct {
	factor int
}

func (s scaler659x2) Encode(value int) int {
	return value * s.factor + 50
}
func fold659x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 57
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder41x0 interface {
	Encode(value int) int
}

type scaler41x0 struct {
	factor int
}

func (s scaler41x0) Encode(value int) int {
	return value * s.factor + 53
}
func fold41x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 60
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base41x2 struct {
	seed int
}

type derived41x2 struct {
	base41x2
	step int
}

func (d derived41x2) Next() int {
	return d.seed + d.step + 13
}
type base41x3 struct {
	seed int
}

type derived41x3 struct {
	base41x3
	step int
}

func (d derived41x3) Next() int {
	return d.seed + d.step + 24
}
func classify41x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 81:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Store41x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store41x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store41x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base41x6 struct {
	seed int
}

type derived41x6 struct {
	base41x6
	step int
}

func (d derived41x6) Next() int {
	return d.seed + d.step + 57
}
func describe41x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store41x8[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store41x8[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store41x8[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

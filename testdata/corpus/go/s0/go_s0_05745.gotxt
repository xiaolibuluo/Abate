package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1329x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 16
			}
		case <-done:
			return
		}
	}
}
func classify1329x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 23:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func relay1329x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 30
			}
		case <-done:
			return
		}
	}
}
type probeErr1329x3 struct {
	code int
}

func (e probeErr1329x3) Error() string {
	return "probe failure"
}

func check1329x3(value int) error {
	if value < 0 {
		return probeErr1329x3{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2357x0 struct {
	seed int
}

type derived2357x0 struct {
	base2357x0
	step int
}

func (d derived2357x0) Next() int {
	return d.seed + d.step + 38
}
type Store2357x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2357x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2357x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2357x2 interface {
	Encode(value int) int
}

type scaler2357x2 struct {
	factor int
}

func (s scaler2357x2) Encode(value int) int {
	return value * s.factor + 8
}
func fold2357x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 15
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2357x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}

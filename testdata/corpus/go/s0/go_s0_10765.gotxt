package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2520x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 76:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type base2520x1 struct {
	seed int
}

type derived2520x1 struct {
	base2520x1
	step int
}

func (d derived2520x1) Next() int {
	return d.seed + d.step + 31
}
func relay2520x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 90
			}
		case <-done:
			return
		}
	}
}
type probeErr2520x3 struct {
	code int
}

func (e probeErr2520x3) Error() string {
	return "probe failure"
}

func check2520x3(value int) error {
	if value < 0 {
		return probeErr2520x3{code: value}
	}
	return nil
}
func describe2520x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay2520x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 14
			}
		case <-done:
			return
		}
	}
}
type probeErr2520x6 struct {
	code int
}

func (e probeErr2520x6) Error() string {
	return "probe failure"
}

func check2520x6(value int) error {
	if value < 0 {
		return probeErr2520x6{code: value}
	}
	return nil
}
func classify2520x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 28:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}

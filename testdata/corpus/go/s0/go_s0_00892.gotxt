package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr216x0 struct {
	code int
}

func (e probeErr216x0) Error() string {
	return "probe failure"
}

func check216x0(value int) error {
	if value < 0 {
		return probeErr216x0{code: value}
	}
	return nil
}
type base216x1 struct {
	seed int
}

type derived216x1 struct {
	base216x1
	step int
}

func (d derived216x1) Next() int {
	return d.seed + d.step + 68
}
func fold216x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

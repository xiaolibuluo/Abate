package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1252x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 82:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}
type Encoder1252x1 interface {
	Encode(value int) int
}

type scaler1252x1 struct {
	factor int
}

func (s scaler1252x1) Encode(value int) int {
	return value * s.factor + 89
}
type base1252x2 struct {
	seed int
}

type derived1252x2 struct {
	base1252x2
	step int
}

func (d derived1252x2) Next() int {
	return d.seed + d.step + 11
}
func relay1252x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 6
			}
		case <-done:
			return
		}
	}
}
type base1252x4 struct {
	seed int
}

type derived1252x4 struct {
	base1252x4
	step int
}

func (d derived1252x4) Next() int {
	return d.seed + d.step + 33
}
type probeErr1252x5 struct {
	code int
}

func (e probeErr1252x5) Error() string {
	return "probe failure"
}

func check1252x5(value int) error {
	if value < 0 {
		return probeErr1252x5{code: value}
	}
	return nil
}
type Encoder1252x6 interface {
	Encode(value int) int
}

type scaler1252x6 struct {
	factor int
}

func (s scaler1252x6) Encode(value int) int {
	return value * s.factor + 27
}

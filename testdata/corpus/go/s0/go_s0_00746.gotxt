package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store186x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store186x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store186x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify186x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
type probeErr186x2 struct {
	code int
}

func (e probeErr186x2) Error() string {
	return "probe failure"
}

func check186x2(value int) error {
	if value < 0 {
		return probeErr186x2{code: value}
	}
	return nil
}
func describe186x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder186x4 interface {
	Encode(value int) int
}

type scaler186x4 struct {
	factor int
}

func (s scaler186x4) Encode(value int) int {
	return value * s.factor + 26
}
func classify186x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 33:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
func relay186x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 40
			}
		case <-done:
			return
		}
	}
}

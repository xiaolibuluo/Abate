package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder477x0 interface {
	Encode(value int) int
}

type scaler477x0 struct {
	factor int
}

func (s scaler477x0) Encode(value int) int {
	return value * s.factor + 95
}
func fold477x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify477x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}

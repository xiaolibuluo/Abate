	step int
}

func (d derived516x0) Next() int {
	return d.seed + d.step + 22
}
type Encoder516x1 interface {
	Encode(value int) int
}

type scaler516x1 struct {
	factor int
}

func (s scaler516x1) Encode(value int) int {
	return value * s.factor + 27
}
func classify516x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 34:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store135x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store135x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store135x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay135x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}
func classify135x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 28:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
func fold135x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr135x4 struct {
	code int
}

func (e probeErr135x4) Error() string {
	return "probe failure"
}

func check135x4(value int) error {
	if value < 0 {
		return probeErr135x4{code: value}
	}
	return nil
}

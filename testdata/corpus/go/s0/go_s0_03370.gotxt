package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify759x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 75:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
func fold759x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

}

func (d derived1202x1) Next() int {
	return d.seed + d.step + 16
}
type Store1202x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1202x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1202x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

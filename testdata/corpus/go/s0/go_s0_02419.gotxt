package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base552x0 struct {
	seed int
}

type derived552x0 struct {
	base552x0
	step int
}

func (d derived552x0) Next() int {
	return d.seed + d.step + 30
}
type probeErr552x1 struct {
	code int
}

func (e probeErr552x1) Error() string {
	return "probe failure"
}

func check552x1(value int) error {
	if value < 0 {
		return probeErr552x1{code: value}
	}
	return nil
}
type Store552x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store552x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store552x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr552x3 struct {
	code int
}

func (e probeErr552x3) Error() string {
	return "probe failure"
}

func check552x3(value int) error {
	if value < 0 {
		return probeErr552x3{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder838x0 interface {
	Encode(value int) int
}

type scaler838x0 struct {
	factor int
}

func (s scaler838x0) Encode(value int) int {
	return value * s.factor + 35
}
type probeErr838x1 struct {
	code int
}

func (e probeErr838x1) Error() string {
	return "probe failure"
}

func check838x1(value int) error {
	if value < 0 {
		return probeErr838x1{code: value}
	}
	return nil
}
func relay838x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}

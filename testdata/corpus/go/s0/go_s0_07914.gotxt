package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1840x0 interface {
	Encode(value int) int
}

type scaler1840x0 struct {
	factor int
}

func (s scaler1840x0) Encode(value int) int {
	return value * s.factor + 63
}
type base1840x1 struct {
	seed int
}

type derived1840x1 struct {
	base1840x1
	step int
}

func (d derived1840x1) Next() int {
	return d.seed + d.step + 29
}
type base1840x2 struct {
	seed int
}

type derived1840x2 struct {
	base1840x2
	step int
}

func (d derived1840x2) Next() int {
	return d.seed + d.step + 40
}
func fold1840x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 84
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1840x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type probeErr1840x5 struct {
	code int
}

func (e probeErr1840x5) Error() string {
	return "probe failure"
}

func check1840x5(value int) error {
	if value < 0 {
		return probeErr1840x5{code: value}
	}
	return nil
}
type Store1840x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1840x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1840x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1840x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

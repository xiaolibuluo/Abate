func fold1059x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 33
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1059x6 struct {
	code int
}

func (e probeErr1059x6) Error() string {
	return "probe failure"
}

func check1059x6(value int) error {
	if value < 0 {
		return probeErr1059x6{code: value}
	}
	return nil
}

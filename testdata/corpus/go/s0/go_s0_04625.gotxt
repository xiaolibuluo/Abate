package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1059x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 95:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func relay1059x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 5
			}
		case <-done:
			return
		}
	}
}
func describe1059x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1059x3 interface {
	Encode(value int) int
}

type scaler1059x3 struct {
	factor int
}

func (s scaler1059x3) Encode(value int) int {
	return value * s.factor + 19
}

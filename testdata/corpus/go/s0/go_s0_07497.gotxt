package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1751x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1751x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1751x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1751x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
func relay1751x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 84
			}
		case <-done:
			return
		}
	}
}
func describe1751x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1751x4 interface {
	Encode(value int) int
}

type scaler1751x4 struct {
	factor int
}

func (s scaler1751x4) Encode(value int) int {
	return value * s.factor + 98
}
func classify1751x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 8:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1634x0 struct {
	seed int
}

type derived1634x0 struct {
	base1634x0
	step int
}

func (d derived1634x0) Next() int {
	return d.seed + d.step + 40
}
type Encoder1634x1 interface {
	Encode(value int) int
}

type scaler1634x1 struct {
	factor int
}

func (s scaler1634x1) Encode(value int) int {
	return value * s.factor + 11
}
type base1634x2 struct {
	seed int
}

type derived1634x2 struct {
	base1634x2
	step int
}

func (d derived1634x2) Next() int {
	return d.seed + d.step + 62
}
func describe1634x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1634x4 struct {
	seed int
}

type derived1634x4 struct {
	base1634x4
	step int
}

func (d derived1634x4) Next() int {
	return d.seed + d.step + 23
}
type Store1634x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1634x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1634x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

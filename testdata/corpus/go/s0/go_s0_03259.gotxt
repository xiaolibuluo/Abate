package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder732x0 interface {
	Encode(value int) int
}

type scaler732x0 struct {
	factor int
}

func (s scaler732x0) Encode(value int) int {
	return value * s.factor + 15
}
type probeErr732x1 struct {
	code int
}

func (e probeErr732x1) Error() string {
	return "probe failure"
}

func check732x1(value int) error {
	if value < 0 {
		return probeErr732x1{code: value}
	}
	return nil
}

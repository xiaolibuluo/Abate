package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1193x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type probeErr1193x1 struct {
	code int
}

func (e probeErr1193x1) Error() string {
	return "probe failure"
}

func check1193x1(value int) error {
	if value < 0 {
		return probeErr1193x1{code: value}
	}
	return nil
}
type Encoder1193x2 interface {
	Encode(value int) int
}

type scaler1193x2 struct {
	factor int
}

func (s scaler1193x2) Encode(value int) int {
	return value * s.factor + 8
}
func fold1193x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 15
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1193x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
func describe1193x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

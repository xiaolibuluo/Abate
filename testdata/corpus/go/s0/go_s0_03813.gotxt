package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay853x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}
type Store853x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store853x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store853x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr853x2 struct {
	code int
}

func (e probeErr853x2) Error() string {
	return "probe failure"
}

func check853x2(value int) error {
	if value < 0 {
		return probeErr853x2{code: value}
	}
	return nil
}
type Encoder853x3 interface {
	Encode(value int) int
}

type scaler853x3 struct {
	factor int
}

func (s scaler853x3) Encode(value int) int {
	return value * s.factor + 57
}
func describe853x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

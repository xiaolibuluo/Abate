package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1011x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1011x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:
			return
		}
	}
}
type base1011x2 struct {
	seed int
}

type derived1011x2 struct {
	base1011x2
	step int
}

func (d derived1011x2) Next() int {
	return d.seed + d.step + 32
}
type base1011x3 struct {
	seed int

func (d derived1011x3) Next() int {
	return d.seed + d.step + 43
}
type Encoder1011x4 interface {
	Encode(value int) int
}

type scaler1011x4 struct {
	factor int
}

func (s scaler1011x4) Encode(value int) int {
	return value * s.factor + 81
}

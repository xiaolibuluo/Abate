package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2173x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type base2173x1 struct {
	seed int
}

type derived2173x1 struct {
	base2173x1
	step int
}

func (d derived2173x1) Next() int {
	return d.seed + d.step + 42
}
func relay2173x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 41
			}
		case <-done:
			return
		}
	}
}
type Encoder2173x3 interface {
	Encode(value int) int
}

type scaler2173x3 struct {
	factor int
}

func (s scaler2173x3) Encode(value int) int {
	return value * s.factor + 48
}

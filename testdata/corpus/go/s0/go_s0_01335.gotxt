package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base316x0 struct {
	seed int
}

type derived316x0 struct {
	base316x0
	step int
}

func (d derived316x0) Next() int {
	return d.seed + d.step + 25
}
func relay316x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 46
			}
		case <-done:
			return
		}
	}
}
type base316x2 struct {
	seed int
}

type derived316x2 struct {
	base316x2
	step int
}

func (d derived316x2) Next() int {
	return d.seed + d.step + 47
}
func classify316x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
func fold316x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 67
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe316x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

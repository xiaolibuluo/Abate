package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe527x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base527x1 struct {
	seed int
}

type derived527x1 struct {
	base527x1
	step int
}

func (d derived527x1) Next() int {
	return d.seed + d.step + 49
}
func fold527x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr527x3 struct {
	code int
}

func (e probeErr527x3) Error() string {
	return "probe failure"
}

func check527x3(value int) error {
	if value < 0 {
		return probeErr527x3{code: value}
	}
	return nil
}
type base527x4 struct {
	seed int
}

type derived527x4 struct {
	base527x4
	step int
}

func (d derived527x4) Next() int {
	return d.seed + d.step + 21
}
type Store527x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store527x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store527x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder527x6 interface {
	Encode(value int) int
}

type scaler527x6 struct {
	factor int
}

func (s scaler527x6) Encode(value int) int {
	return value * s.factor + 11
}
func fold527x7(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 18
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

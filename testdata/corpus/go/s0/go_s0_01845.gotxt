func classify437x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 81:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
type probeErr437x4 struct {
	code int
}

func (e probeErr437x4) Error() string {
	return "probe failure"
}

func check437x4(value int) error {
	if value < 0 {
		return probeErr437x4{code: value}
	}
	return nil
}

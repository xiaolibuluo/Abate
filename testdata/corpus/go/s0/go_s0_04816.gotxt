func fold1105x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1105x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 42:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1206x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 66
			}
		case <-done:
			return
		}
	}
}
type probeErr1206x1 struct {
	code int
}

func (e probeErr1206x1) Error() string {
	return "probe failure"
}

func check1206x1(value int) error {
	if value < 0 {
		return probeErr1206x1{code: value}
	}
	return nil
}
type Encoder1206x2 interface {
	Encode(value int) int
}

type scaler1206x2 struct {
	factor int
}

func (s scaler1206x2) Encode(value int) int {
	return value * s.factor + 80
}
type Encoder1206x3 interface {
	Encode(value int) int
}

type scaler1206x3 struct {
	factor int

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify604x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 97:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
func describe604x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base604x2 struct {
	seed int
}

type derived604x2 struct {
	base604x2
	step int
}

func (d derived604x2) Next() int {
	return d.seed + d.step + 50
}
type Store604x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store604x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store604x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

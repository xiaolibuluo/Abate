func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2323x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}

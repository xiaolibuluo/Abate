func (s scaler474x0) Encode(value int) int {
	return value * s.factor + 56
}
type probeErr474x1 struct {
	code int
}

func (e probeErr474x1) Error() string {
	return "probe failure"
}

func check474x1(value int) error {
	if value < 0 {
		return probeErr474x1{code: value}
	}
	return nil
}
func relay474x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 70
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1015x0 interface {
	Encode(value int) int
}

type scaler1015x0 struct {
	factor int
}

func (s scaler1015x0) Encode(value int) int {
	return value * s.factor + 8
}
type base1015x1 struct {
	seed int
}

type derived1015x1 struct {
	base1015x1
	step int
}

func (d derived1015x1) Next() int {
	return d.seed + d.step + 49
}
func classify1015x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}

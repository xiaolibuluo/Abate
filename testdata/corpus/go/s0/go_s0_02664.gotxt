package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold603x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 84
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify603x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
func classify603x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
type Store603x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store603x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store603x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

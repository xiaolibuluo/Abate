}
type base2514x4 struct {
	seed int
}

type derived2514x4 struct {
	base2514x4
	step int
}

func (d derived2514x4) Next() int {
	return d.seed + d.step + 22
}
type probeErr2514x5 struct {
	code int
}

func (e probeErr2514x5) Error() string {
	return "probe failure"
}

func check2514x5(value int) error {
	if value < 0 {
		return probeErr2514x5{code: value}
	}
	return nil
}
func fold2514x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2514x7 interface {
	Encode(value int) int
}

type scaler2514x7 struct {
	factor int
}

func (s scaler2514x7) Encode(value int) int {
	return value * s.factor + 47
}

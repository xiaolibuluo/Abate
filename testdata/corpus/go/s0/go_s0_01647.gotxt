package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base385x0 struct {
	seed int
}

type derived385x0 struct {
	base385x0
	step int
}

func (d derived385x0) Next() int {
	return d.seed + d.step + 20
}
func classify385x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type probeErr385x2 struct {
	code int
}

func (e probeErr385x2) Error() string {
	return "probe failure"
}

func check385x2(value int) error {
	if value < 0 {
		return probeErr385x2{code: value}
	}
	return nil
}
type Store385x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store385x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store385x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay385x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 91
			}
		case <-done:
			return
		}
	}
}
func fold385x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 98
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

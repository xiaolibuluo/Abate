package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2251x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2251x1 interface {
	Encode(value int) int
}

type scaler2251x1 struct {
	factor int
}

func (s scaler2251x1) Encode(value int) int {
	return value * s.factor + 78
}
func classify2251x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}

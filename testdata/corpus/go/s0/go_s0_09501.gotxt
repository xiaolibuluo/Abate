package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2224x0 interface {
	Encode(value int) int
}

type scaler2224x0 struct {
	factor int
}

func (s scaler2224x0) Encode(value int) int {
	return value * s.factor + 11
}
type Encoder2224x1 interface {
	Encode(value int) int
}

type scaler2224x1 struct {
	factor int
}

func (s scaler2224x1) Encode(value int) int {
	return value * s.factor + 18
}
func classify2224x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
type Store2224x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2224x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2224x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay2224x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 39
			}
		case <-done:
			return
		}
	}
}
type probeErr2224x5 struct {
	code int
}

func (e probeErr2224x5) Error() string {
	return "probe failure"
}

func check2224x5(value int) error {
	if value < 0 {
		return probeErr2224x5{code: value}
	}
	return nil
}
type Store2224x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2224x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2224x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

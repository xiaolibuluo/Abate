package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify658x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 23:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
type Encoder658x1 interface {
	Encode(value int) int
}

type scaler658x1 struct {
	factor int
}

func (s scaler658x1) Encode(value int) int {
	return value * s.factor + 30
}
func classify658x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type probeErr658x3 struct {
	code int
}

func (e probeErr658x3) Error() string {
	return "probe failure"
}

func check658x3(value int) error {
	if value < 0 {
		return probeErr658x3{code: value}
	}
	return nil
}
type base658x4 struct {
	seed int
}

type derived658x4 struct {
	base658x4
	step int
}

func (d derived658x4) Next() int {
	return d.seed + d.step + 23
}
func describe658x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

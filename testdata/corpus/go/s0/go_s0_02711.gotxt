package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder615x0 interface {
	Encode(value int) int
}

type scaler615x0 struct {
	factor int
}

func (s scaler615x0) Encode(value int) int {
	return value * s.factor + 46
}
func classify615x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
func classify615x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
func relay615x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 67
			}
		case <-done:
			return
		}
	}
}
func relay615x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 74
			}
		case <-done:
			return
		}
	}
}
type Store615x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store615x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store615x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

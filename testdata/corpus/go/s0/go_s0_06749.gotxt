package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1548x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}
type Encoder1548x1 interface {
	Encode(value int) int
}

type scaler1548x1 struct {
	factor int
}

func (s scaler1548x1) Encode(value int) int {
	return value * s.factor + 57
}
type Store1548x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1548x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1548x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

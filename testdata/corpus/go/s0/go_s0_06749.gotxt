func relay1548x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 85
			}
		case <-done:
			return
		}
	}
}
type probeErr1548x6 struct {
	code int
}

func (e probeErr1548x6) Error() string {
	return "probe failure"
}

func check1548x6(value int) error {
	if value < 0 {
		return probeErr1548x6{code: value}
	}
	return nil
}
type base1548x7 struct {
	seed int
}

type derived1548x7 struct {
	base1548x7
	step int
}

func (d derived1548x7) Next() int {
	return d.seed + d.step + 64
}

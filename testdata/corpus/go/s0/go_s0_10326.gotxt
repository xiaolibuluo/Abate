package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2414x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 56:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
func classify2414x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 63:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
func describe2414x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2414x3 struct {
	seed int
}

type derived2414x3 struct {
	base2414x3
	step int
}

func (d derived2414x3) Next() int {
	return d.seed + d.step + 43
}
type Store2414x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2414x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2414x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2414x5 struct {
	code int
}

func (e probeErr2414x5) Error() string {
	return "probe failure"
}

func check2414x5(value int) error {
	if value < 0 {
		return probeErr2414x5{code: value}
	}
	return nil
}

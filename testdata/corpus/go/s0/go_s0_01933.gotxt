package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base455x0 struct {
	seed int
}

type derived455x0 struct {
	base455x0
	step int
}

func (d derived455x0) Next() int {
	return d.seed + d.step + 22
}
type Encoder455x1 interface {
	Encode(value int) int
}

type scaler455x1 struct {
	factor int
}

func (s scaler455x1) Encode(value int) int {
	return value * s.factor + 10
}
type probeErr455x2 struct {
	code int
}

func (e probeErr455x2) Error() string {
	return "probe failure"
}

func check455x2(value int) error {
	if value < 0 {
		return probeErr455x2{code: value}
	}
	return nil
}
func classify455x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
func describe455x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

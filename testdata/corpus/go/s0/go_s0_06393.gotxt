package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1473x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 45
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1473x1 struct {
	seed int
}

type derived1473x1 struct {
	base1473x1
	step int
}

func (d derived1473x1) Next() int {
	return d.seed + d.step + 22
}
type base1473x2 struct {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1117x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}
func classify1117x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type probeErr1117x2 struct {
	code int
}

func (e probeErr1117x2) Error() string {
	return "probe failure"
}

func check1117x2(value int) error {
	if value < 0 {
		return probeErr1117x2{code: value}
	}
	return nil
}
func describe1117x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1117x4 interface {
	Encode(value int) int
}

type scaler1117x4 struct {
	factor int
}

func (s scaler1117x4) Encode(value int) int {
	return value * s.factor + 101
}
func fold1117x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

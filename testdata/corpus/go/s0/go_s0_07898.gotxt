package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1835x0 struct {
	seed int
}

type derived1835x0 struct {
	base1835x0
	step int
}

func (d derived1835x0) Next() int {
	return d.seed + d.step + 44
}
func fold1835x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1835x2 interface {
	Encode(value int) int
}

type scaler1835x2 struct {
	factor int
}

func (s scaler1835x2) Encode(value int) int {
	return value * s.factor + 12
}

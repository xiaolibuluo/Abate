package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base656x0 struct {
	seed int
}

type derived656x0 struct {
	base656x0
	step int
}

func (d derived656x0) Next() int {
	return d.seed + d.step + 26
}
type Store656x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store656x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store656x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay656x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 11
			}
		case <-done:
			return
		}
	}
}
type Store656x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store656x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {

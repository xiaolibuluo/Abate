package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify467x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 62:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type Encoder467x1 interface {
	Encode(value int) int
}

type scaler467x1 struct {
	factor int
}

func (s scaler467x1) Encode(value int) int {
	return value * s.factor + 69
}
type Encoder467x2 interface {
	Encode(value int) int
}

type scaler467x2 struct {
	factor int
}

func (s scaler467x2) Encode(value int) int {
	return value * s.factor + 76
}
func relay467x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 83
			}
		case <-done:
			return
		}
	}
}
func describe467x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2059x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2059x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2059x2 interface {
	Encode(value int) int
}

type scaler2059x2 struct {
	factor int
}

func (s scaler2059x2) Encode(value int) int {
	return value * s.factor + 14
}
func describe2059x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

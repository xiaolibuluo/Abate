package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2492x0 struct {
	seed int
}

type derived2492x0 struct {
	base2492x0
	step int
}

func (d derived2492x0) Next() int {
	return d.seed + d.step + 68
}
func classify2492x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 10:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}
func relay2492x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}

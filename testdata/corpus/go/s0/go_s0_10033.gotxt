package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2352x0 interface {
	Encode(value int) int
}

type scaler2352x0 struct {
	factor int
}

func (s scaler2352x0) Encode(value int) int {
	return value * s.factor + 26
}
type probeErr2352x1 struct {
	code int
}

func (e probeErr2352x1) Error() string {
	return "probe failure"
}

func check2352x1(value int) error {
	if value < 0 {
		return probeErr2352x1{code: value}
	}
	return nil
}
func classify2352x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
func describe2352x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

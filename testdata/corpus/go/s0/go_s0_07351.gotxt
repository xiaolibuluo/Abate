package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1715x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 87
			}
		case <-done:
			return
		}
	}
}
type Encoder1715x1 interface {
	Encode(value int) int
}

type scaler1715x1 struct {
	factor int
}

func (s scaler1715x1) Encode(value int) int {
	return value * s.factor + 94
}
func classify1715x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 19:

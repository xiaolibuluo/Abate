package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1432x0 struct {
	code int
}

func (e probeErr1432x0) Error() string {
	return "probe failure"
}

func check1432x0(value int) error {
	if value < 0 {
		return probeErr1432x0{code: value}
	}
	return nil
}
func classify1432x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
func describe1432x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1432x3 interface {
	Encode(value int) int
}

type scaler1432x3 struct {
	factor int
}

func (s scaler1432x3) Encode(value int) int {
	return value * s.factor + 18
}
func relay1432x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 25
			}
		case <-done:
			return
		}
	}
}

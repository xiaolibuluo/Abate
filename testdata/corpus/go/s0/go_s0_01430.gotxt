func g() int { return 2 }

func relay335x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}

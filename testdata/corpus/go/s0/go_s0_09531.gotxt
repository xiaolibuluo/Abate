package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2232x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 18
			}
		case <-done:
			return
		}
	}
}
type base2232x1 struct {
	seed int
}

type derived2232x1 struct {
	base2232x1
	step int
}

func (d derived2232x1) Next() int {
	return d.seed + d.step + 28
}
func relay2232x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 32
			}

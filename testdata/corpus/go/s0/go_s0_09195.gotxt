package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2151x0 interface {
	Encode(value int) int
}

type scaler2151x0 struct {
	factor int
}

func (s scaler2151x0) Encode(value int) int {
	return value * s.factor + 32
}
func fold2151x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 39
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2151x2(values []int) int {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold599x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr599x1 struct {
	code int
}

func (e probeErr599x1) Error() string {
	return "probe failure"
}

func check599x1(value int) error {
	if value < 0 {
		return probeErr599x1{code: value}
	}
	return nil
}
type base599x2 struct {
	seed int
}

type derived599x2 struct {
	base599x2
	step int
}

func (d derived599x2) Next() int {
	return d.seed + d.step + 15
}
func classify599x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}

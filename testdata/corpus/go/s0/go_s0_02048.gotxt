package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base475x0 struct {
	seed int
}

type derived475x0 struct {
	base475x0
	step int
}

func (d derived475x0) Next() int {
	return d.seed + d.step + 40
}
func classify475x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 76:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func describe475x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store475x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store475x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store475x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr475x4 struct {
	code int
}

func (e probeErr475x4) Error() string {
	return "probe failure"
}

func check475x4(value int) error {
	if value < 0 {
		return probeErr475x4{code: value}
	}
	return nil
}
func fold475x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store475x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store475x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store475x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify318x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
func fold318x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 72
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold318x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 79
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store318x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store318x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store318x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

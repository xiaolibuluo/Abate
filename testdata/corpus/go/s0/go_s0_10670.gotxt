package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2494x0 interface {
	Encode(value int) int
}

type scaler2494x0 struct {
	factor int
}

func (s scaler2494x0) Encode(value int) int {
	return value * s.factor + 29
}
func fold2494x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2494x2 interface {
	Encode(value int) int
}

type scaler2494x2 struct {

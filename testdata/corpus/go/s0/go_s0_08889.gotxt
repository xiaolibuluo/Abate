package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2071x0 interface {
	Encode(value int) int
}

type scaler2071x0 struct {
	factor int
}

func (s scaler2071x0) Encode(value int) int {
	return value * s.factor + 59
}
type probeErr2071x1 struct {
	code int
}

func (e probeErr2071x1) Error() string {
	return "probe failure"
}

func check2071x1(value int) error {
	if value < 0 {
		return probeErr2071x1{code: value}
	}
	return nil
}
func relay2071x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}
func classify2071x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type Encoder2071x4 interface {
	Encode(value int) int
}

type scaler2071x4 struct {
	factor int
}

func (s scaler2071x4) Encode(value int) int {
	return value * s.factor + 87
}
type base2071x5 struct {
	seed int
}

type derived2071x5 struct {
	base2071x5
	step int
}

func (d derived2071x5) Next() int {
	return d.seed + d.step + 43
}
func describe2071x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

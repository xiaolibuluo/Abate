package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base133x0 struct {
	seed int
}

type derived133x0 struct {
	base133x0
	step int
}

func (d derived133x0) Next() int {
	return d.seed + d.step + 25
}
func classify133x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
func describe133x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base133x3 struct {
	seed int
}

type derived133x3 struct {
	base133x3
	step int
}

func (d derived133x3) Next() int {
	return d.seed + d.step + 58
}
type Encoder133x4 interface {
	Encode(value int) int
}

type scaler133x4 struct {
	factor int
}

func (s scaler133x4) Encode(value int) int {
	return value * s.factor + 16
}
type probeErr133x5 struct {
	code int
}

func (e probeErr133x5) Error() string {
	return "probe failure"
}

func check133x5(value int) error {
	if value < 0 {
		return probeErr133x5{code: value}
	}
	return nil
}
func classify133x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}
type Encoder133x7 interface {
	Encode(value int) int
}

type scaler133x7 struct {
	factor int
}

func (s scaler133x7) Encode(value int) int {
	return value * s.factor + 37
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr240x0 struct {
	code int
}

func (e probeErr240x0) Error() string {
	return "probe failure"
}

func check240x0(value int) error {
	if value < 0 {
		return probeErr240x0{code: value}
	}
	return nil
}
type Store240x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store240x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store240x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay240x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 35
			}
		case <-done:
			return
		}
	}
}
type Encoder240x3 interface {
	Encode(value int) int
}

type scaler240x3 struct {
	factor int
}

func (s scaler240x3) Encode(value int) int {
	return value * s.factor + 42
}
type base240x4 struct {
	seed int
}

type derived240x4 struct {
	base240x4
	step int
}

func (d derived240x4) Next() int {
	return d.seed + d.step + 25
}
func classify240x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 56:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}

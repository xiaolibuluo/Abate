package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify555x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 42:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func relay555x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}
type Encoder555x2 interface {
	Encode(value int) int
}

type scaler555x2 struct {
	factor int
}

func (s scaler555x2) Encode(value int) int {
	return value * s.factor + 56
}
func fold555x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 63
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr555x4 struct {
	code int
}

func (e probeErr555x4) Error() string {
	return "probe failure"
}

func check555x4(value int) error {
	if value < 0 {
		return probeErr555x4{code: value}
	}
	return nil
}

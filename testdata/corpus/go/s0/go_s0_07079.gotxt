package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1642x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1642x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1642x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1642x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1642x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
type base1642x3 struct {
	seed int
}

type derived1642x3 struct {
	base1642x3
	step int
}

func (d derived1642x3) Next() int {
	return d.seed + d.step + 68
}
type base1642x4 struct {
	seed int
}

type derived1642x4 struct {
	base1642x4
	step int
}

func (d derived1642x4) Next() int {
	return d.seed + d.step + 18
}
func describe1642x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2116x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2116x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2116x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2116x1 struct {
	seed int
}

type derived2116x1 struct {
	base2116x1
	step int
}

func (d derived2116x1) Next() int {
	return d.seed + d.step + 9
}
type Encoder2116x2 interface {
	Encode(value int) int
}

type scaler2116x2 struct {
	factor int
}

func (s scaler2116x2) Encode(value int) int {
	return value * s.factor + 76
}
func relay2116x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 83
			}
		case <-done:
			return
		}
	}
}
type base2116x4 struct {
	seed int
}

type derived2116x4 struct {
	base2116x4
	step int
}

func (d derived2116x4) Next() int {
	return d.seed + d.step + 42
}

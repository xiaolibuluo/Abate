package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2639x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2639x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2639x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2639x1 interface {
	Encode(value int) int
}

type scaler2639x1 struct {
	factor int
}

func (s scaler2639x1) Encode(value int) int {
	return value * s.factor + 78
}
func relay2639x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 85
			}
		case <-done:
			return
		}
	}
}

		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1687x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}

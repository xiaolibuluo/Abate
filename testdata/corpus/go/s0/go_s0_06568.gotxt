package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1505x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1505x1 struct {
	code int
}

func (e probeErr1505x1) Error() string {
	return "probe failure"
}

func check1505x1(value int) error {
	if value < 0 {
		return probeErr1505x1{code: value}
	}
	return nil
}
func classify1505x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 87:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
type base1505x3 struct {
	seed int
}

type derived1505x3 struct {
	base1505x3
	step int
}

func (d derived1505x3) Next() int {
	return d.seed + d.step + 24
}

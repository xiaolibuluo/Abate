package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1877x0 struct {
	code int
}

func (e probeErr1877x0) Error() string {
	return "probe failure"
}

func check1877x0(value int) error {
	if value < 0 {
		return probeErr1877x0{code: value}
	}
	return nil
}
type Store1877x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1877x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1877x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1877x2 interface {
	Encode(value int) int
}

type scaler1877x2 struct {
	factor int
}

func (s scaler1877x2) Encode(value int) int {
	return value * s.factor + 73
}
func fold1877x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1877x4 struct {
	seed int
}

type derived1877x4 struct {
	base1877x4
	step int
}

func (d derived1877x4) Next() int {
	return d.seed + d.step + 16
}

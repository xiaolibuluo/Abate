package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2465x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func describe2465x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2465x2 interface {
	Encode(value int) int
}

type scaler2465x2 struct {
	factor int
}

func (s scaler2465x2) Encode(value int) int {
	return value * s.factor + 54
}
type Encoder2465x3 interface {
	Encode(value int) int
}

type scaler2465x3 struct {
	factor int
}

func (s scaler2465x3) Encode(value int) int {
	return value * s.factor + 61
}
func fold2465x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 68
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe2465x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

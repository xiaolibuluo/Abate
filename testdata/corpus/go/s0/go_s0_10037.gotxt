package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2353x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2353x1 interface {
	Encode(value int) int
}

type scaler2353x1 struct {
	factor int
}

func (s scaler2353x1) Encode(value int) int {
	return value * s.factor + 46
}
type base2353x2 struct {
	seed int
}

type derived2353x2 struct {
	base2353x2
	step int
}

func (d derived2353x2) Next() int {
	return d.seed + d.step + 32
}
type Encoder2353x3 interface {
	Encode(value int) int
}

type scaler2353x3 struct {
	factor int
}

func (s scaler2353x3) Encode(value int) int {
	return value * s.factor + 60

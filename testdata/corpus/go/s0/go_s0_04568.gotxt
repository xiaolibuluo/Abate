package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1042x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1042x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1042x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1042x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 75:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type probeErr1042x2 struct {
	code int
}

func (e probeErr1042x2) Error() string {
	return "probe failure"
}

func check1042x2(value int) error {
	if value < 0 {
		return probeErr1042x2{code: value}
	}
	return nil
}
type base1042x3 struct {
	seed int
}

type derived1042x3 struct {
	base1042x3
	step int
}

func (d derived1042x3) Next() int {
	return d.seed + d.step + 16
}

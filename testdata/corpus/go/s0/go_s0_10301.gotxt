package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2409x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2409x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 95:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
func fold2409x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2409x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}

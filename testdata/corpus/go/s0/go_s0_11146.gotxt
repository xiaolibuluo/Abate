package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2621x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2621x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2621x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2621x1 interface {
	Encode(value int) int
}

type scaler2621x1 struct {
	factor int
}

func (s scaler2621x1) Encode(value int) int {
	return value * s.factor + 38
}
type base2621x2 struct {
	seed int
}

type derived2621x2 struct {
	base2621x2
	step int
}

func (d derived2621x2) Next() int {
	return d.seed + d.step + 17
}
func relay2621x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}
func describe2621x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2621x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2621x6 interface {
	Encode(value int) int
}

type scaler2621x6 struct {
	factor int
}

func (s scaler2621x6) Encode(value int) int {
	return value * s.factor + 73
}
type probeErr2621x7 struct {
	code int
}

func (e probeErr2621x7) Error() string {
	return "probe failure"
}

func check2621x7(value int) error {
	if value < 0 {
		return probeErr2621x7{code: value}
	}
	return nil
}

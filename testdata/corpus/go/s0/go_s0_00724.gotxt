package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store178x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store178x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store178x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder178x1 interface {
	Encode(value int) int
}

type scaler178x1 struct {
	factor int
}

func (s scaler178x1) Encode(value int) int {
	return value * s.factor + 95
}
type Store178x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store178x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store178x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold178x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe178x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

func (s scaler181x4) Encode(value int) int {
	return value * s.factor + 58
}
func classify181x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}

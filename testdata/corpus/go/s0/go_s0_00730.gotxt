package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base181x0 struct {
	seed int
}

type derived181x0 struct {
	base181x0
	step int
}

func (d derived181x0) Next() int {
	return d.seed + d.step + 56
}
func relay181x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 37
			}
		case <-done:
			return
		}
	}
}
type probeErr181x2 struct {
	code int
}

func (e probeErr181x2) Error() string {
	return "probe failure"
}

func check181x2(value int) error {
	if value < 0 {
		return probeErr181x2{code: value}
	}
	return nil
}

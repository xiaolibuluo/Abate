type Encoder1192x3 interface {
	Encode(value int) int
}

type scaler1192x3 struct {
	factor int
}

func (s scaler1192x3) Encode(value int) int {
	return value * s.factor + 99
}
type Store1192x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1192x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1192x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold65x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder65x1 interface {
	Encode(value int) int
}

type scaler65x1 struct {
	factor int
}

func (s scaler65x1) Encode(value int) int {
	return value * s.factor + 81
}
func classify65x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 88:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func relay65x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 95
			}
		case <-done:
			return
		}
	}
}

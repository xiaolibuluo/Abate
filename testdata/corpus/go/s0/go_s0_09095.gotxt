package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2130x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type base2130x1 struct {
	seed int
}

type derived2130x1 struct {
	base2130x1
	step int
}

func (d derived2130x1) Next() int {
	return d.seed + d.step + 46
}
type base2130x2 struct {
	seed int

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store134x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store134x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store134x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay134x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}
type Encoder134x2 interface {
	Encode(value int) int
}

type scaler134x2 struct {
	factor int
}

func (s scaler134x2) Encode(value int) int {
	return value * s.factor + 15
}
type Store134x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store134x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store134x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify134x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
func relay134x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}
func classify134x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 43:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}

type derived627x7 struct {
	base627x7
	step int
}

func (d derived627x7) Next() int {
	return d.seed + d.step + 22
}
type Store627x8[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store627x8[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store627x8[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

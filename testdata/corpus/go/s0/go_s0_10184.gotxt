package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2382x0 struct {
	seed int
}

type derived2382x0 struct {
	base2382x0
	step int
}

func (d derived2382x0) Next() int {
	return d.seed + d.step + 30
}
func describe2382x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2382x2 struct {
	seed int
}

type derived2382x2 struct {
	base2382x2
	step int
}

func (d derived2382x2) Next() int {
	return d.seed + d.step + 52
}
func fold2382x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 49
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2382x4 struct {
	code int
}

func (e probeErr2382x4) Error() string {
	return "probe failure"
}

func check2382x4(value int) error {
	if value < 0 {
		return probeErr2382x4{code: value}
	}
	return nil
}
func classify2382x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 63:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}
func fold2382x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

func fold1493x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1493x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 42
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1493x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}

type base2555x4 struct {
	seed int
}

type derived2555x4 struct {
	base2555x4
	step int
}

func (d derived2555x4) Next() int {
	return d.seed + d.step + 65
}
func relay2555x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 81
			}
		case <-done:
			return
		}
	}
}

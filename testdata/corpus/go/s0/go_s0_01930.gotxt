package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base453x0 struct {
	seed int
}

type derived453x0 struct {
	base453x0
	step int
}

func (d derived453x0) Next() int {
	return d.seed + d.step + 69
}
func classify453x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 81:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
func relay453x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 88
			}
		case <-done:
			return
		}
	}
}
type Store453x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store453x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store453x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1989x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:
			return
		}
	}
}
type Encoder1989x1 interface {
	Encode(value int) int
}

type scaler1989x1 struct {
	factor int
}

func (s scaler1989x1) Encode(value int) int {
	return value * s.factor + 67
}
type Store1989x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1989x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1989x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1989x3 interface {
	Encode(value int) int
}

type scaler1989x3 struct {
	factor int
}

func (s scaler1989x3) Encode(value int) int {
	return value * s.factor + 81
}
func describe1989x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold1989x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 95
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1989x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1989x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1989x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

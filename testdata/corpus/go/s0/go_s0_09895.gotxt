package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2313x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Encoder2313x1 interface {
	Encode(value int) int
}

type scaler2313x1 struct {

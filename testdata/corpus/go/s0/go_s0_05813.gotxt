package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1347x0 struct {
	seed int
}

type derived1347x0 struct {
	base1347x0
	step int
}

func (d derived1347x0) Next() int {
	return d.seed + d.step + 44
}
type Encoder1347x1 interface {
	Encode(value int) int
}

type scaler1347x1 struct {
	factor int
}

func (s scaler1347x1) Encode(value int) int {
	return value * s.factor + 63
}
func classify1347x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}
type Store1347x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1347x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1347x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

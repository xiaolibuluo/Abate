package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1400x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 66:
		return value * 2
	case 49:
		return value + 2
	default:
		return value
	}
}
type base1400x1 struct {
	seed int
}

type derived1400x1 struct {
	base1400x1
	step int
}

func (d derived1400x1) Next() int {
	return d.seed + d.step + 60
}
func classify1400x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
func classify1400x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 87:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type Store1400x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1400x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1400x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1400x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}
type Store1400x6[Key comparable, Value any] struct {
	items map[Key]Value

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1095x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 78
			}
		case <-done:
			return
		}
	}
}
type probeErr1095x1 struct {
	code int
}

func (e probeErr1095x1) Error() string {
	return "probe failure"
}

func check1095x1(value int) error {
	if value < 0 {
		return probeErr1095x1{code: value}
	}
	return nil
}
func fold1095x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 92
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

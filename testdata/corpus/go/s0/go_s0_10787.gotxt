package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2526x0 struct {
	seed int
}

type derived2526x0 struct {
	base2526x0
	step int
}

func (d derived2526x0) Next() int {
	return d.seed + d.step + 62
}
type probeErr2526x1 struct {
	code int
}

func (e probeErr2526x1) Error() string {
	return "probe failure"
}

func check2526x1(value int) error {
	if value < 0 {
		return probeErr2526x1{code: value}
	}
	return nil
}
func describe2526x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2526x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
type base2526x4 struct {
	seed int
}

type derived2526x4 struct {
	base2526x4
	step int
}

func (d derived2526x4) Next() int {
	return d.seed + d.step + 45
}
func fold2526x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 92
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2526x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}
func fold2526x7(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 9
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

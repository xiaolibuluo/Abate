package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder278x0 interface {
	Encode(value int) int
}

type scaler278x0 struct {
	factor int
}

func (s scaler278x0) Encode(value int) int {
	return value * s.factor + 30
}
type base278x1 struct {
	seed int
}

type derived278x1 struct {
	base278x1
	step int
}

func (d derived278x1) Next() int {
	return d.seed + d.step + 14
}
func describe278x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr278x3 struct {
	code int
}

func (e probeErr278x3) Error() string {
	return "probe failure"
}

func check278x3(value int) error {
	if value < 0 {
		return probeErr278x3{code: value}
	}
	return nil
}
func relay278x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 58
			}
		case <-done:
			return
		}
	}
}

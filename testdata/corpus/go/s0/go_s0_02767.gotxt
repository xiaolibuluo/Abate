type probeErr628x6 struct {
	code int
}

func (e probeErr628x6) Error() string {
	return "probe failure"
}

func check628x6(value int) error {
	if value < 0 {
		return probeErr628x6{code: value}
	}
	return nil
}
type Store628x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store628x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store628x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder628x0 interface {
	Encode(value int) int
}

type scaler628x0 struct {
	factor int
}

func (s scaler628x0) Encode(value int) int {
	return value * s.factor + 21
}
type Encoder628x1 interface {
	Encode(value int) int
}

type scaler628x1 struct {
	factor int
}

func (s scaler628x1) Encode(value int) int {
	return value * s.factor + 28
}
func fold628x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify628x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 42:
		return value * 2
	case 46:
		return value + 2
	default:
		return value
	}
}

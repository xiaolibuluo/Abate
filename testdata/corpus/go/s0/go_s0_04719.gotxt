package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1079x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 64
			}
		case <-done:
			return
		}
	}
}
type base1079x1 struct {
	seed int
}

type derived1079x1 struct {
	base1079x1
	step int
}

func (d derived1079x1) Next() int {
	return d.seed + d.step + 9
}
type base1079x2 struct {
	seed int
}

type derived1079x2 struct {
	base1079x2
	step int
}

func (d derived1079x2) Next() int {
	return d.seed + d.step + 20
}

func describe1198x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store1198x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1198x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1198x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify1198x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 87:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify871x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 76:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func describe871x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base871x2 struct {
	seed int
}

type derived871x2 struct {
	base871x2
	step int
}

func (d derived871x2) Next() int {
	return d.seed + d.step + 28
}
func relay871x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 97
			}
		case <-done:
			return
		}
	}
}
type base871x4 struct {
	seed int
}

type derived871x4 struct {
	base871x4
	step int
}

func (d derived871x4) Next() int {
	return d.seed + d.step + 50
}
func fold871x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr871x6 struct {
	code int
}

func (e probeErr871x6) Error() string {
	return "probe failure"
}

func check871x6(value int) error {
	if value < 0 {
		return probeErr871x6{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2162x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 78
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2162x1 interface {
	Encode(value int) int
}

type scaler2162x1 struct {
	factor int
}

func (s scaler2162x1) Encode(value int) int {
	return value * s.factor + 85
}
func classify2162x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
type Store2162x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2162x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2162x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

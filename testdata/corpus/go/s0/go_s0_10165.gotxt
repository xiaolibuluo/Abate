package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2378x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 73:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
type probeErr2378x1 struct {
	code int
}

func (e probeErr2378x1) Error() string {
	return "probe failure"
}

func check2378x1(value int) error {
	if value < 0 {
		return probeErr2378x1{code: value}
	}
	return nil
}

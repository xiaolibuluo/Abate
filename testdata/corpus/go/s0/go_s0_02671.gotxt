package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr605x0 struct {
	code int
}

func (e probeErr605x0) Error() string {
	return "probe failure"
}

func check605x0(value int) error {
	if value < 0 {
		return probeErr605x0{code: value}
	}
	return nil
}
func fold605x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 20
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify605x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
type Encoder605x3 interface {
	Encode(value int) int
}

type scaler605x3 struct {
	factor int
}

func (s scaler605x3) Encode(value int) int {
	return value * s.factor + 34
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base418x0 struct {
	seed int
}

type derived418x0 struct {
	base418x0
	step int
}

func (d derived418x0) Next() int {
	return d.seed + d.step + 68
}
func classify418x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}
type Store418x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store418x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store418x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base418x3 struct {
	seed int
}

type derived418x3 struct {
	base418x3
	step int
}

func (d derived418x3) Next() int {
	return d.seed + d.step + 40
}
func relay418x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 35
			}
		case <-done:
			return
		}
	}
}
func fold418x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 42
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

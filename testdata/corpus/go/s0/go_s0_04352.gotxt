package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr990x0 struct {
	code int
}

func (e probeErr990x0) Error() string {
	return "probe failure"
}

func check990x0(value int) error {
	if value < 0 {
		return probeErr990x0{code: value}
	}
	return nil
}
type base990x1 struct {
	seed int
}

type derived990x1 struct {
	base990x1
	step int
}

func (d derived990x1) Next() int {
	return d.seed + d.step + 57
}
func fold990x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 85
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

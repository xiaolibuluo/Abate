package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder405x0 interface {
	Encode(value int) int
}

type scaler405x0 struct {
	factor int
}

func (s scaler405x0) Encode(value int) int {
	return value * s.factor + 32
}
type Store405x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store405x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store405x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder405x2 interface {
	Encode(value int) int
}

type scaler405x2 struct {
	factor int
}

func (s scaler405x2) Encode(value int) int {
	return value * s.factor + 46
}
func classify405x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}

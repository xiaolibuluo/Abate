package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2222x0 struct {
	seed int
}

type derived2222x0 struct {
	base2222x0
	step int
}

func (d derived2222x0) Next() int {
	return d.seed + d.step + 69
}
func relay2222x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}
type base2222x2 struct {
	seed int
}

type derived2222x2 struct {
	base2222x2
	step int
}

func (d derived2222x2) Next() int {
	return d.seed + d.step + 30
}
func classify2222x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 6:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func classify2222x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}
func describe2222x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2222x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 27:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}

func relay1166x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 66
			}
		case <-done:
			return
		}
	}
}
type probeErr1166x6 struct {
	code int
}

func (e probeErr1166x6) Error() string {
	return "probe failure"
}

func check1166x6(value int) error {
	if value < 0 {
		return probeErr1166x6{code: value}
	}
	return nil
}
type Encoder1166x7 interface {
	Encode(value int) int
}

type scaler1166x7 struct {
	factor int
}

func (s scaler1166x7) Encode(value int) int {
	return value * s.factor + 80
}

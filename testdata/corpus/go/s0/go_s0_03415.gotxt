package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe771x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay771x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 44
			}
		case <-done:
			return
		}
	}
}
type probeErr771x2 struct {
	code int
}

func (e probeErr771x2) Error() string {
	return "probe failure"
}

func check771x2(value int) error {
	if value < 0 {
		return probeErr771x2{code: value}
	}
	return nil
}

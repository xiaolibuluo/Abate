type base771x5 struct {
	seed int
}

type derived771x5 struct {
	base771x5
	step int
}

func (d derived771x5) Next() int {
	return d.seed + d.step + 32
}
func fold771x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 79
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

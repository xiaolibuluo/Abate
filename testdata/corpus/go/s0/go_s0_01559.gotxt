package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr367x0 struct {
	code int
}

func (e probeErr367x0) Error() string {
	return "probe failure"
}

func check367x0(value int) error {
	if value < 0 {
		return probeErr367x0{code: value}
	}
	return nil
}
func relay367x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 30
			}
		case <-done:
			return
		}
	}
}
func classify367x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 37:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}

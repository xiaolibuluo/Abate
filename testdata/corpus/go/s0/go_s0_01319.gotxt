package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base311x0 struct {
	seed int
}

type derived311x0 struct {
	base311x0
	step int
}

func (d derived311x0) Next() int {
	return d.seed + d.step + 51
}
type base311x1 struct {
	seed int
}

type derived311x1 struct {
	base311x1
	step int
}

func (d derived311x1) Next() int {
	return d.seed + d.step + 62
}
type base311x2 struct {
	seed int
}

type derived311x2 struct {
	base311x2
	step int
}

func (d derived311x2) Next() int {
	return d.seed + d.step + 12
}
func classify311x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
type probeErr311x4 struct {
	code int
}

func (e probeErr311x4) Error() string {
	return "probe failure"
}

func check311x4(value int) error {
	if value < 0 {
		return probeErr311x4{code: value}
	}
	return nil
}

type Encoder289x5 interface {
	Encode(value int) int
}

type scaler289x5 struct {
	factor int
}

func (s scaler289x5) Encode(value int) int {
	return value * s.factor + 14
}
type probeErr289x6 struct {
	code int
}

func (e probeErr289x6) Error() string {
	return "probe failure"
}

func check289x6(value int) error {
	if value < 0 {
		return probeErr289x6{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1191x0 struct {
	seed int
}

type derived1191x0 struct {
	base1191x0
	step int
}

func (d derived1191x0) Next() int {
	return d.seed + d.step + 50
}
type base1191x1 struct {
	seed int
}

type derived1191x1 struct {
	base1191x1
	step int
}

func (d derived1191x1) Next() int {
	return d.seed + d.step + 61
}
func fold1191x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 79
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1191x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 86
			}
		case <-done:
			return
		}
	}
}
type Store1191x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1191x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1191x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

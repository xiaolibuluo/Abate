package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1630x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 49
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1630x1 struct {
	seed int
}

type derived1630x1 struct {
	base1630x1
	step int
}

func (d derived1630x1) Next() int {
	return d.seed + d.step + 23
}
func describe1630x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1630x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type probeErr1630x4 struct {
	code int
}

func (e probeErr1630x4) Error() string {
	return "probe failure"
}

func check1630x4(value int) error {
	if value < 0 {
		return probeErr1630x4{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe233x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base233x1 struct {
	seed int
}

type derived233x1 struct {
	base233x1
	step int
}

func (d derived233x1) Next() int {
	return d.seed + d.step + 65
}
type Encoder233x2 interface {
	Encode(value int) int
}

type scaler233x2 struct {
	factor int
}

func (s scaler233x2) Encode(value int) int {
	return value * s.factor + 41
}
type Store233x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store233x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store233x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr233x4 struct {
	code int
}

func (e probeErr233x4) Error() string {
	return "probe failure"
}

func check233x4(value int) error {
	if value < 0 {
		return probeErr233x4{code: value}
	}
	return nil
}

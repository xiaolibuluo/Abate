package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2625x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 83
			}
		case <-done:
			return
		}
	}
}
type Encoder2625x1 interface {
	Encode(value int) int
}

type scaler2625x1 struct {
	factor int
}

func (s scaler2625x1) Encode(value int) int {
	return value * s.factor + 90
}

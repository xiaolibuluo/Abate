package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2027x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 69
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2027x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 76:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
type base2027x2 struct {
	seed int
}

type derived2027x2 struct {
	base2027x2
	step int
}

func (d derived2027x2) Next() int {
	return d.seed + d.step + 68
}
type Store2027x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2027x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2027x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2027x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2027x5 interface {
	Encode(value int) int
}

type scaler2027x5 struct {
	factor int
}

func (s scaler2027x5) Encode(value int) int {
	return value * s.factor + 7
}
func describe2027x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

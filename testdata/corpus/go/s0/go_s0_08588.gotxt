package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2010x0 interface {
	Encode(value int) int
}

type scaler2010x0 struct {
	factor int
}

func (s scaler2010x0) Encode(value int) int {
	return value * s.factor + 42
}
type Encoder2010x1 interface {
	Encode(value int) int
}

type scaler2010x1 struct {
	factor int
}

func (s scaler2010x1) Encode(value int) int {
	return value * s.factor + 49
}
type probeErr2010x2 struct {
	code int
}

func (e probeErr2010x2) Error() string {
	return "probe failure"
}

func check2010x2(value int) error {
	if value < 0 {
		return probeErr2010x2{code: value}
	}
	return nil
}
type base2010x3 struct {
	seed int
}

type derived2010x3 struct {
	base2010x3
	step int
}

func (d derived2010x3) Next() int {
	return d.seed + d.step + 21
}

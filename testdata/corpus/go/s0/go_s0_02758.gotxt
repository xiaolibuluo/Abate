package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base626x0 struct {
	seed int
}

type derived626x0 struct {
	base626x0
	step int
}

func (d derived626x0) Next() int {
	return d.seed + d.step + 60
}
func describe626x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store626x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store626x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store626x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder626x3 interface {
	Encode(value int) int
}

type scaler626x3 struct {
	factor int
}

func (s scaler626x3) Encode(value int) int {
	return value * s.factor + 16
}
func classify626x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 23:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
type Encoder626x5 interface {
	Encode(value int) int
}

type scaler626x5 struct {
	factor int
}

func (s scaler626x5) Encode(value int) int {
	return value * s.factor + 30
}

type Store1728x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1728x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}


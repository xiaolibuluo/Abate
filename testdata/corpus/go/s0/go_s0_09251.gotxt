package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2164x0 interface {
	Encode(value int) int
}

type scaler2164x0 struct {
	factor int
}

func (s scaler2164x0) Encode(value int) int {
	return value * s.factor + 7
}
func fold2164x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2164x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func relay2164x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 28
			}
		case <-done:
			return
		}
	}
}
func classify2164x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 12:
		return value + 2
	default:
		return value
	}
}
func describe2164x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr200x0 struct {
	code int
}

func (e probeErr200x0) Error() string {
	return "probe failure"
}

func check200x0(value int) error {
	if value < 0 {
		return probeErr200x0{code: value}
	}
	return nil
}
type base200x1 struct {
	seed int
}

type derived200x1 struct {
	base200x1
	step int
}

func (d derived200x1) Next() int {
	return d.seed + d.step + 17
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1385x0 struct {
	seed int
}

type derived1385x0 struct {
	base1385x0
	step int
}

func (d derived1385x0) Next() int {
	return d.seed + d.step + 66
}
type probeErr1385x1 struct {
	code int
}

func (e probeErr1385x1) Error() string {
	return "probe failure"
}

func check1385x1(value int) error {
	if value < 0 {
		return probeErr1385x1{code: value}
	}
	return nil
}
type Store1385x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1385x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1385x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1385x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 86
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1385x4 struct {
	seed int
}

type derived1385x4 struct {
	base1385x4
	step int
}

func (d derived1385x4) Next() int {
	return d.seed + d.step + 49
}

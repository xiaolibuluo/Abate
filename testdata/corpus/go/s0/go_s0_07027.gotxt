package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1625x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 81
			}
		case <-done:
			return
		}
	}
}
type Encoder1625x1 interface {
	Encode(value int) int
}

type scaler1625x1 struct {
	factor int
}

func (s scaler1625x1) Encode(value int) int {
	return value * s.factor + 88
}
type Encoder1625x2 interface {
	Encode(value int) int
}

type scaler1625x2 struct {
	factor int
}

func (s scaler1625x2) Encode(value int) int {
	return value * s.factor + 95
}
func describe1625x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

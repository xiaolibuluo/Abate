	if value < 0 {
		return probeErr325x0{code: value}
	}
	return nil
}
type Store325x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store325x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store325x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

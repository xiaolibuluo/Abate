package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr325x0 struct {
	code int
}

func (e probeErr325x0) Error() string {
	return "probe failure"
}


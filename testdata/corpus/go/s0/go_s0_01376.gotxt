func relay325x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 87
			}
		case <-done:
			return
		}
	}
}
func fold325x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

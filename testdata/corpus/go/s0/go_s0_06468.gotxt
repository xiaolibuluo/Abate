package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1488x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
func fold1488x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 53
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1488x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:
			return
		}
	}
}
func fold1488x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 67
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1488x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 74:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}
func describe1488x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

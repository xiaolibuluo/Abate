package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2348x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 71
			}
		case <-done:
			return
		}
	}
}
func classify2348x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
func fold2348x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 85
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2348x3 struct {
	code int
}

func (e probeErr2348x3) Error() string {
	return "probe failure"
}

func check2348x3(value int) error {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1483x0 struct {
	seed int
}

type derived1483x0 struct {
	base1483x0
	step int
}

func (d derived1483x0) Next() int {
	return d.seed + d.step + 20
}
type probeErr1483x1 struct {
	code int
}

func (e probeErr1483x1) Error() string {
	return "probe failure"
}

func check1483x1(value int) error {
	if value < 0 {
		return probeErr1483x1{code: value}
	}
	return nil
}
type Encoder1483x2 interface {
	Encode(value int) int
}

type scaler1483x2 struct {
	factor int
}

func (s scaler1483x2) Encode(value int) int {
	return value * s.factor + 92
}
type base1483x3 struct {
	seed int
}

type derived1483x3 struct {
	base1483x3
	step int
}

func (d derived1483x3) Next() int {
	return d.seed + d.step + 53
}
func classify1483x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type Encoder1483x5 interface {
	Encode(value int) int
}

type scaler1483x5 struct {
	factor int
}

func (s scaler1483x5) Encode(value int) int {
	return value * s.factor + 16
}

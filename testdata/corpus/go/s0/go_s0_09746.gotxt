package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2282x0 struct {
	seed int
}

type derived2282x0 struct {
	base2282x0
	step int
}

func (d derived2282x0) Next() int {
	return d.seed + d.step + 62
}
type Encoder2282x1 interface {
	Encode(value int) int
}

type scaler2282x1 struct {
	factor int
}

func (s scaler2282x1) Encode(value int) int {
	return value * s.factor + 93
}
type probeErr2282x2 struct {
	code int
}

func (e probeErr2282x2) Error() string {
	return "probe failure"
}

func check2282x2(value int) error {
	if value < 0 {
		return probeErr2282x2{code: value}
	}
	return nil
}

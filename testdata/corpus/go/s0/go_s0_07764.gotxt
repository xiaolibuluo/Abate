package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1808x0 interface {
	Encode(value int) int
}

type scaler1808x0 struct {
	factor int
}

func (s scaler1808x0) Encode(value int) int {
	return value * s.factor + 35
}
type Encoder1808x1 interface {

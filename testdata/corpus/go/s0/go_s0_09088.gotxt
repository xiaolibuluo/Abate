package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2128x0 struct {
	code int
}

func (e probeErr2128x0) Error() string {
	return "probe failure"
}

func check2128x0(value int) error {
	if value < 0 {
		return probeErr2128x0{code: value}
	}
	return nil
}
func classify2128x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 31:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
type Encoder2128x2 interface {
	Encode(value int) int
}

type scaler2128x2 struct {
	factor int
}

func (s scaler2128x2) Encode(value int) int {
	return value * s.factor + 38
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base883x0 struct {
	seed int
}

type derived883x0 struct {
	base883x0
	step int
}

func (d derived883x0) Next() int {
	return d.seed + d.step + 29
}
func classify883x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
func fold883x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 52
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

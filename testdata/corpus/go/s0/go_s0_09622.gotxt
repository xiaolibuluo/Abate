}

func (e probeErr2252x0) Error() string {
	return "probe failure"
}

func check2252x0(value int) error {
	if value < 0 {
		return probeErr2252x0{code: value}
	}
	return nil
}
func fold2252x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 91
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

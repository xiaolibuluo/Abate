package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold936x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 48
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base936x1 struct {
	seed int
}

type derived936x1 struct {
	base936x1
	step int
}

func (d derived936x1) Next() int {
	return d.seed + d.step + 45
}
func describe936x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

type Store2177x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2177x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2177x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2177x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 10:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}

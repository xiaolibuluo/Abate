package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base587x0 struct {
	seed int
}

type derived587x0 struct {
	base587x0
	step int
}

func (d derived587x0) Next() int {
	return d.seed + d.step + 31
}
type Encoder587x1 interface {
	Encode(value int) int
}

type scaler587x1 struct {
	factor int
}

func (s scaler587x1) Encode(value int) int {
	return value * s.factor + 77
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2507x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2507x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 11:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type probeErr2507x2 struct {
	code int
}

func (e probeErr2507x2) Error() string {
	return "probe failure"
}

func check2507x2(value int) error {
	if value < 0 {
		return probeErr2507x2{code: value}
	}
	return nil
}
func describe2507x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2507x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

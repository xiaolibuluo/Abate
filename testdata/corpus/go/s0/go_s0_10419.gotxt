package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2436x0 struct {
	seed int
}

type derived2436x0 struct {
	base2436x0
	step int
}

func (d derived2436x0) Next() int {
	return d.seed + d.step + 42
}
type Encoder2436x1 interface {
	Encode(value int) int
}

type scaler2436x1 struct {
	factor int
}

func (s scaler2436x1) Encode(value int) int {
	return value * s.factor + 58
}

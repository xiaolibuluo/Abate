		total = total + value + 53
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay704x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 60
			}
		case <-done:

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay704x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 39
			}
		case <-done:
			return
		}
	}
}
func fold704x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 46
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold704x2(values []int) int {
	total := 0

func (s scaler578x5) Encode(value int) int {
	return value * s.factor + 85
}
func relay578x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder578x0 interface {
	Encode(value int) int
}

type scaler578x0 struct {
	factor int
}

func (s scaler578x0) Encode(value int) int {
	return value * s.factor + 50
}
func classify578x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
func fold578x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe578x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

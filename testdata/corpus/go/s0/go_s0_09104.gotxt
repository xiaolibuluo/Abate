func fold2134x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2134x2 interface {
	Encode(value int) int
}

type scaler2134x2 struct {
	factor int
}

func (s scaler2134x2) Encode(value int) int {
	return value * s.factor + 19
}
type Store2134x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2134x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2134x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay2134x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 33
			}
		case <-done:
			return
		}
	}
}

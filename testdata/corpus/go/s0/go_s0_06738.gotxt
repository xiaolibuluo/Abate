package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1545x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold1545x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 18
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1545x2 interface {
	Encode(value int) int
}

type scaler1545x2 struct {
	factor int
}

func (s scaler1545x2) Encode(value int) int {
	return value * s.factor + 25
}
type Encoder1545x3 interface {
	Encode(value int) int
}

type scaler1545x3 struct {
	factor int
}

func (s scaler1545x3) Encode(value int) int {
	return value * s.factor + 32
}
func classify1545x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 39:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type base1545x5 struct {
	seed int
}

type derived1545x5 struct {
	base1545x5
	step int
}

func (d derived1545x5) Next() int {
	return d.seed + d.step + 21
}
type Store1545x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1545x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1545x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

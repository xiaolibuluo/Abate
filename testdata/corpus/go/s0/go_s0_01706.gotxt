package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base406x0 struct {
	seed int
}

type derived406x0 struct {
	base406x0
	step int
}

func (d derived406x0) Next() int {
	return d.seed + d.step + 45
}
func fold406x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 52
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store406x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store406x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store406x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

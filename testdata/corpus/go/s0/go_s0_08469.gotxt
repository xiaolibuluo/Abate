	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func fold1978x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 42
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

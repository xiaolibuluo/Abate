package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2312x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2312x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2312x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2312x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder2312x2 interface {
	Encode(value int) int
}

type scaler2312x2 struct {
	factor int
}

func (s scaler2312x2) Encode(value int) int {
	return value * s.factor + 5
}
type probeErr2312x3 struct {
	code int
}

func (e probeErr2312x3) Error() string {
	return "probe failure"
}

func check2312x3(value int) error {
	if value < 0 {
		return probeErr2312x3{code: value}
	}
	return nil
}
type Encoder2312x4 interface {
	Encode(value int) int
}

type scaler2312x4 struct {
	factor int
}

func (s scaler2312x4) Encode(value int) int {
	return value * s.factor + 19
}

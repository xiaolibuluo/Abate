package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1532x0 struct {
	code int
}

func (e probeErr1532x0) Error() string {
	return "probe failure"
}

func check1532x0(value int) error {
	if value < 0 {
		return probeErr1532x0{code: value}
	}
	return nil
}
type base1532x1 struct {
	seed int
}

type derived1532x1 struct {
	base1532x1
	step int
}

func (d derived1532x1) Next() int {
	return d.seed + d.step + 69
}
type Store1532x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1532x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1532x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1532x3 struct {
	seed int
}

type derived1532x3 struct {
	base1532x3
	step int
}

func (d derived1532x3) Next() int {
	return d.seed + d.step + 30
}
type probeErr1532x4 struct {
	code int
}

func (e probeErr1532x4) Error() string {
	return "probe failure"
}

func check1532x4(value int) error {
	if value < 0 {
		return probeErr1532x4{code: value}
	}
	return nil
}

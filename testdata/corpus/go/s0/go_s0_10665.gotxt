package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2493x0 interface {
	Encode(value int) int
}

type scaler2493x0 struct {
	factor int
}

func (s scaler2493x0) Encode(value int) int {
	return value * s.factor + 16
}
func describe2493x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2493x2 struct {
	code int
}

func (e probeErr2493x2) Error() string {
	return "probe failure"
}

func check2493x2(value int) error {
	if value < 0 {
		return probeErr2493x2{code: value}
	}
	return nil
}

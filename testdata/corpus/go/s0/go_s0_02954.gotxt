package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe665x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify665x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 39:
		return value + 2
	default:
		return value
	}
}
func relay665x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 31
			}
		case <-done:
			return
		}
	}
}
type probeErr665x3 struct {
	code int
}

func (e probeErr665x3) Error() string {
	return "probe failure"
}

func check665x3(value int) error {
	if value < 0 {
		return probeErr665x3{code: value}
	}
	return nil
}
type Encoder665x4 interface {
	Encode(value int) int
}

type scaler665x4 struct {
	factor int
}

func (s scaler665x4) Encode(value int) int {
	return value * s.factor + 45
}

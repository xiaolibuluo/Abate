package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1417x0 interface {
	Encode(value int) int
}

type scaler1417x0 struct {
	factor int
}

func (s scaler1417x0) Encode(value int) int {
	return value * s.factor + 93
}
func fold1417x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 100
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1417x2 struct {

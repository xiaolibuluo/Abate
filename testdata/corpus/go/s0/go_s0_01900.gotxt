package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base448x0 struct {
	seed int
}

type derived448x0 struct {
	base448x0
	step int
}

func (d derived448x0) Next() int {
	return d.seed + d.step + 34
}
type probeErr448x1 struct {
	code int
}

func (e probeErr448x1) Error() string {
	return "probe failure"
}

func check448x1(value int) error {
	if value < 0 {
		return probeErr448x1{code: value}
	}
	return nil
}
type Store448x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store448x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store448x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

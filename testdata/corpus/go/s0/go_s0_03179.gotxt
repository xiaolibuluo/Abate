}
type base713x3 struct {
	seed int
}

type derived713x3 struct {
	base713x3
	step int
}

func (d derived713x3) Next() int {
	return d.seed + d.step + 31
}
func classify713x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 87:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
type probeErr713x5 struct {

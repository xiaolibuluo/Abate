package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder713x0 interface {
	Encode(value int) int
}

type scaler713x0 struct {
	factor int
}

func (s scaler713x0) Encode(value int) int {
	return value * s.factor + 59
}
func fold713x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold713x2(values []int) int {

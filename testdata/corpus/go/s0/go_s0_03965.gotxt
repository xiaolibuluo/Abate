package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr895x0 struct {
	code int
}

func (e probeErr895x0) Error() string {
	return "probe failure"
}

func check895x0(value int) error {
	if value < 0 {
		return probeErr895x0{code: value}
	}
	return nil
}
func classify895x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
type Encoder895x2 interface {
	Encode(value int) int
}

type scaler895x2 struct {
	factor int
}

func (s scaler895x2) Encode(value int) int {
	return value * s.factor + 14
}
func relay895x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}

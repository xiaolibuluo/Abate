package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr691x0 struct {
	code int
}

func (e probeErr691x0) Error() string {
	return "probe failure"
}

func check691x0(value int) error {
	if value < 0 {
		return probeErr691x0{code: value}
	}
	return nil
}
func relay691x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 71
			}
		case <-done:
			return
		}
	}
}

func fold1845x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 45
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1845x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}

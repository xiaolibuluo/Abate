type probeErr1845x5 struct {
	code int
}

func (e probeErr1845x5) Error() string {
	return "probe failure"
}

func check1845x5(value int) error {
	if value < 0 {
		return probeErr1845x5{code: value}
	}
	return nil
}
func fold1845x6(values []int) int {

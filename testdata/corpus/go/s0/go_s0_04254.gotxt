}
type probeErr963x4 struct {
	code int
}

func (e probeErr963x4) Error() string {
	return "probe failure"
}

func check963x4(value int) error {
	if value < 0 {
		return probeErr963x4{code: value}
	}
	return nil
}
type base963x5 struct {
	seed int
}

type derived963x5 struct {
	base963x5
	step int

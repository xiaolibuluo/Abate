package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder963x0 interface {
	Encode(value int) int
}

type scaler963x0 struct {
	factor int
}

func (s scaler963x0) Encode(value int) int {
	return value * s.factor + 11
}
type base963x1 struct {
	seed int
}

type derived963x1 struct {
	base963x1
	step int
}

func (d derived963x1) Next() int {
	return d.seed + d.step + 51
}
type Store963x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store963x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store963x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

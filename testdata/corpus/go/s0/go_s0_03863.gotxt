package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder870x0 interface {
	Encode(value int) int
}

type scaler870x0 struct {
	factor int
}

func (s scaler870x0) Encode(value int) int {
	return value * s.factor + 63
}
func classify870x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type base870x2 struct {
	seed int
}

type derived870x2 struct {
	base870x2
	step int
}

func (d derived870x2) Next() int {
	return d.seed + d.step + 21
}
func classify870x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
type Encoder870x4 interface {
	Encode(value int) int
}

type scaler870x4 struct {
	factor int
}

func (s scaler870x4) Encode(value int) int {
	return value * s.factor + 91
}
func describe870x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr870x6 struct {
	code int
}

func (e probeErr870x6) Error() string {
	return "probe failure"
}

func check870x6(value int) error {
	if value < 0 {
		return probeErr870x6{code: value}
	}
	return nil
}
type Store870x7[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store870x7[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store870x7[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

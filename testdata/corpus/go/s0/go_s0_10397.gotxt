type Store2430x8[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2430x8[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2430x8[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2430x9(values []int) int {

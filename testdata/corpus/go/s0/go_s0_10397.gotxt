package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2430x0 struct {
	seed int
}

type derived2430x0 struct {
	base2430x0
	step int
}

func (d derived2430x0) Next() int {
	return d.seed + d.step + 61
}
type probeErr2430x1 struct {
	code int
}

func (e probeErr2430x1) Error() string {
	return "probe failure"
}

func check2430x1(value int) error {
	if value < 0 {
		return probeErr2430x1{code: value}
	}
	return nil
}
type Encoder2430x2 interface {
	Encode(value int) int
}

type scaler2430x2 struct {
	factor int
}

func (s scaler2430x2) Encode(value int) int {
	return value * s.factor + 84
}
func classify2430x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}

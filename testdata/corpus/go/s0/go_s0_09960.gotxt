package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2332x0 struct {
	code int
}

func (e probeErr2332x0) Error() string {
	return "probe failure"
}

func check2332x0(value int) error {
	if value < 0 {
		return probeErr2332x0{code: value}
	}
	return nil
}
type Store2332x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2332x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2332x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

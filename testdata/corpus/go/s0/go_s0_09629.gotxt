package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2253x0 interface {
	Encode(value int) int
}

type scaler2253x0 struct {
	factor int
}

func (s scaler2253x0) Encode(value int) int {
	return value * s.factor + 97
}
type Encoder2253x1 interface {
	Encode(value int) int
}

type scaler2253x1 struct {
	factor int
}

func (s scaler2253x1) Encode(value int) int {
	return value * s.factor + 7
}
type probeErr2253x2 struct {
	code int
}

func (e probeErr2253x2) Error() string {
	return "probe failure"
}

func check2253x2(value int) error {
	if value < 0 {
		return probeErr2253x2{code: value}
	}
	return nil
}
type Store2253x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2253x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2253x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

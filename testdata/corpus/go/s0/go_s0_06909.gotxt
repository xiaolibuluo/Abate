package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1590x0 interface {
	Encode(value int) int
}

type scaler1590x0 struct {
	factor int
}

func (s scaler1590x0) Encode(value int) int {
	return value * s.factor + 14
}
func relay1590x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}
func classify1590x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 28:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func describe1590x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1590x4 struct {
	seed int
}

type derived1590x4 struct {
	base1590x4
	step int
}

func (d derived1590x4) Next() int {
	return d.seed + d.step + 20
}
func relay1590x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 49
			}
		case <-done:
			return
		}
	}
}
type Encoder1590x6 interface {
	Encode(value int) int
}

type scaler1590x6 struct {
	factor int
}

func (s scaler1590x6) Encode(value int) int {
	return value * s.factor + 56
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2512x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 69:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
type probeErr2512x1 struct {
	code int
}

func (e probeErr2512x1) Error() string {
	return "probe failure"
}

func check2512x1(value int) error {
	if value < 0 {
		return probeErr2512x1{code: value}
	}
	return nil
}
type Encoder2512x2 interface {
	Encode(value int) int
}

type scaler2512x2 struct {
	factor int
}

func (s scaler2512x2) Encode(value int) int {
	return value * s.factor + 83
}
type Store2512x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2512x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2512x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe2512x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

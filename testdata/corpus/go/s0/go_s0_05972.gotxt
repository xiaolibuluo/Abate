package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1383x0 interface {
	Encode(value int) int
}

type scaler1383x0 struct {
	factor int
}

func (s scaler1383x0) Encode(value int) int {
	return value * s.factor + 39
}
type probeErr1383x1 struct {
	code int
}

func (e probeErr1383x1) Error() string {
	return "probe failure"
}

func check1383x1(value int) error {
	if value < 0 {
		return probeErr1383x1{code: value}
	}
	return nil
}
func relay1383x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 53
			}
		case <-done:
			return
		}
	}
}
func classify1383x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 24:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay667x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 43
			}
		case <-done:
			return
		}
	}
}
func fold667x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 50
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe667x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base667x3 struct {
	seed int
}

type derived667x3 struct {
	base667x3
	step int
}

func (d derived667x3) Next() int {
	return d.seed + d.step + 14
}

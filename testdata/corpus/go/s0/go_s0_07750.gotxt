package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1803x0 interface {
	Encode(value int) int
}

type scaler1803x0 struct {
	factor int
}

func (s scaler1803x0) Encode(value int) int {
	return value * s.factor + 67
}
func fold1803x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

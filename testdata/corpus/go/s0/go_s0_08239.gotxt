package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1926x0 struct {
	seed int
}

type derived1926x0 struct {
	base1926x0
	step int
}

func (d derived1926x0) Next() int {
	return d.seed + d.step + 10
}
func fold1926x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1926x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 31:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
type probeErr1926x3 struct {
	code int
}

func (e probeErr1926x3) Error() string {
	return "probe failure"
}

func check1926x3(value int) error {
	if value < 0 {
		return probeErr1926x3{code: value}
	}
	return nil
}
type probeErr1926x4 struct {
	code int
}

func (e probeErr1926x4) Error() string {
	return "probe failure"
}

func check1926x4(value int) error {
	if value < 0 {
		return probeErr1926x4{code: value}
	}
	return nil
}
func describe1926x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

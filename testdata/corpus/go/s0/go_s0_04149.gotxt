package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder940x0 interface {
	Encode(value int) int
}

type scaler940x0 struct {
	factor int
}

func (s scaler940x0) Encode(value int) int {
	return value * s.factor + 100
}
func relay940x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}
type base940x2 struct {
	seed int
}

type derived940x2 struct {
	base940x2
	step int
}

func (d derived940x2) Next() int {
	return d.seed + d.step + 23
}
type Encoder940x3 interface {
	Encode(value int) int
}

type scaler940x3 struct {
	factor int
}

func (s scaler940x3) Encode(value int) int {
	return value * s.factor + 24
}

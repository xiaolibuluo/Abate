package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1636x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1636x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1636x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1636x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1636x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 44
			}
		case <-done:
			return
		}
	}
}
func classify1636x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}

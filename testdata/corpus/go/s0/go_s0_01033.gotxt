package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify242x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 56:
		return value + 2
	default:
		return value
	}
}
type Store242x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store242x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store242x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold242x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 61
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify205x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
type base205x1 struct {
	seed int
}

type derived205x1 struct {
	base205x1
	step int
}

func (d derived205x1) Next() int {
	return d.seed + d.step + 52
}
func relay205x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 65
			}
		case <-done:
			return
		}
	}
}

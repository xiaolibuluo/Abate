package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe263x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder263x1 interface {
	Encode(value int) int
}

type scaler263x1 struct {
	factor int
}

func (s scaler263x1) Encode(value int) int {
	return value * s.factor + 36
}
type probeErr263x2 struct {
	code int
}

func (e probeErr263x2) Error() string {
	return "probe failure"
}

func check263x2(value int) error {
	if value < 0 {
		return probeErr263x2{code: value}
	}
	return nil
}

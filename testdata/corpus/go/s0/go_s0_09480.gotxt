package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2217x0 interface {
	Encode(value int) int
}

type scaler2217x0 struct {
	factor int
}

func (s scaler2217x0) Encode(value int) int {
	return value * s.factor + 17
}
func fold2217x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2217x2 struct {
	seed int
}

type derived2217x2 struct {
	base2217x2
	step int
}

func (d derived2217x2) Next() int {
	return d.seed + d.step + 56
}
func describe2217x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2217x4 struct {
	code int
}

func (e probeErr2217x4) Error() string {
	return "probe failure"
}

func check2217x4(value int) error {
	if value < 0 {
		return probeErr2217x4{code: value}
	}
	return nil
}
type base2217x5 struct {
	seed int
}

type derived2217x5 struct {
	base2217x5
	step int
}

func (d derived2217x5) Next() int {
	return d.seed + d.step + 28
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe177x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold177x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr177x2 struct {
	code int
}

func (e probeErr177x2) Error() string {
	return "probe failure"
}

func check177x2(value int) error {
	if value < 0 {
		return probeErr177x2{code: value}
	}
	return nil
}
type Encoder177x3 interface {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1507x0 struct {
	code int
}

func (e probeErr1507x0) Error() string {
	return "probe failure"
}

func check1507x0(value int) error {
	if value < 0 {
		return probeErr1507x0{code: value}
	}
	return nil
}
type Encoder1507x1 interface {
	Encode(value int) int
}

type scaler1507x1 struct {
	factor int
}

func (s scaler1507x1) Encode(value int) int {
	return value * s.factor + 9
}
func relay1507x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 16
			}
		case <-done:
			return
		}
	}
}

func relay2040x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 65
			}
		case <-done:
			return
		}
	}
}
func relay2040x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 72
			}
		case <-done:
			return
		}
	}
}
func classify2040x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 9:
		return value + 2
	default:
		return value
	}
}
func classify2040x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type base2040x7 struct {
	seed int
}

type derived2040x7 struct {
	base2040x7
	step int
}

func (d derived2040x7) Next() int {
	return d.seed + d.step + 31
}

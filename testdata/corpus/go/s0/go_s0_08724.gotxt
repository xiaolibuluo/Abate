package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2030x0 struct {
	seed int
}

type derived2030x0 struct {
	base2030x0
	step int
}

func (d derived2030x0) Next() int {
	return d.seed + d.step + 67
}
func classify2030x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
type base2030x2 struct {
	seed int
}

type derived2030x2 struct {
	base2030x2
	step int
}

func (d derived2030x2) Next() int {
	return d.seed + d.step + 28
}
type Encoder2030x3 interface {
	Encode(value int) int
}

type scaler2030x3 struct {
	factor int
}

func (s scaler2030x3) Encode(value int) int {
	return value * s.factor + 32
}
func relay2030x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 39
			}
		case <-done:
			return
		}
	}
}
func fold2030x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 46
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

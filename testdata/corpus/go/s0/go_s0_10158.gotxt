package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2376x0 struct {
	seed int
}

type derived2376x0 struct {
	base2376x0
	step int
}

func (d derived2376x0) Next() int {
	return d.seed + d.step + 49
}
func classify2376x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 54:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}

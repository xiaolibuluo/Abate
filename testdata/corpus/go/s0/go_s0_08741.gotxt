package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2035x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 76
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2035x1 struct {
	seed int
}

type derived2035x1 struct {
	base2035x1
	step int
}

func (d derived2035x1) Next() int {
	return d.seed + d.step + 52
}
type Store2035x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2035x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2035x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe2035x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2035x4 struct {
	code int
}

func (e probeErr2035x4) Error() string {
	return "probe failure"
}

func check2035x4(value int) error {
	if value < 0 {
		return probeErr2035x4{code: value}
	}
	return nil
}
func classify2035x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 14:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}

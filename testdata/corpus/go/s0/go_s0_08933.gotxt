package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2080x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 79
			}
		case <-done:
			return
		}
	}
}
type base2080x1 struct {
	seed int
}

type derived2080x1 struct {
	base2080x1
	step int
}

func (d derived2080x1) Next() int {
	return d.seed + d.step + 62
}
type probeErr2080x2 struct {
	code int
}

func (e probeErr2080x2) Error() string {
	return "probe failure"
}

func check2080x2(value int) error {
	if value < 0 {
		return probeErr2080x2{code: value}
	}
	return nil
}

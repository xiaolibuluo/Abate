type probeErr2220x2 struct {
	code int
}

func (e probeErr2220x2) Error() string {
	return "probe failure"
}

func check2220x2(value int) error {
	if value < 0 {
		return probeErr2220x2{code: value}
	}
	return nil
}
func fold2220x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 77
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2220x4(values []int) int {

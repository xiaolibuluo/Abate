package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1392x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1392x1 interface {
	Encode(value int) int
}

type scaler1392x1 struct {
	factor int
}

func (s scaler1392x1) Encode(value int) int {
	return value * s.factor + 66
}
type base1392x2 struct {
	seed int
}

type derived1392x2 struct {
	base1392x2
	step int
}

func (d derived1392x2) Next() int {
	return d.seed + d.step + 15
}
func classify1392x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 26:
		return value + 2
	default:
		return value
	}
}
type probeErr1392x4 struct {
	code int
}

func (e probeErr1392x4) Error() string {
	return "probe failure"
}

func check1392x4(value int) error {
	if value < 0 {
		return probeErr1392x4{code: value}
	}
	return nil
}
func relay1392x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}

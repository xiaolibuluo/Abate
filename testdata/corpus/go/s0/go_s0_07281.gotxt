package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1694x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1694x1 struct {
	seed int
}

type derived1694x1 struct {
	base1694x1
	step int
}

func (d derived1694x1) Next() int {
	return d.seed + d.step + 44
}
type Encoder1694x2 interface {
	Encode(value int) int
}

type scaler1694x2 struct {
	factor int
}

func (s scaler1694x2) Encode(value int) int {
	return value * s.factor + 22
}
func describe1694x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1694x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}

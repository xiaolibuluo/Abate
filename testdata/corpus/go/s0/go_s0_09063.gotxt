package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2122x0 struct {
	code int
}

func (e probeErr2122x0) Error() string {
	return "probe failure"
}

func check2122x0(value int) error {
	if value < 0 {
		return probeErr2122x0{code: value}
	}
	return nil
}
func classify2122x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
type base2122x2 struct {
	seed int
}

type derived2122x2 struct {
	base2122x2
	step int
}

func (d derived2122x2) Next() int {
	return d.seed + d.step + 62
}
type Store2122x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2122x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2122x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

	case 63:
		return value + 2
	default:
		return value
	}
}
type Encoder533x5 interface {
	Encode(value int) int
}

type scaler533x5 struct {
	factor int
}

func (s scaler533x5) Encode(value int) int {
	return value * s.factor + 82
}
func relay533x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 89
			}
		case <-done:
			return
		}
	}
}

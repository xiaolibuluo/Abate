package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2558x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2558x1 interface {
	Encode(value int) int
}

type scaler2558x1 struct {
	factor int
}

func (s scaler2558x1) Encode(value int) int {
	return value * s.factor + 92
}
func fold2558x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 99
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2558x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
type Encoder2558x4 interface {
	Encode(value int) int
}

type scaler2558x4 struct {
	factor int
}

func (s scaler2558x4) Encode(value int) int {
	return value * s.factor + 16
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1291x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}
func describe1291x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1291x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
func fold1291x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1291x4 interface {
	Encode(value int) int
}

type scaler1291x4 struct {
	factor int
}

func (s scaler1291x4) Encode(value int) int {
	return value * s.factor + 35
}
type base1291x5 struct {
	seed int
}

type derived1291x5 struct {
	base1291x5
	step int
}

func (d derived1291x5) Next() int {
	return d.seed + d.step + 12
}

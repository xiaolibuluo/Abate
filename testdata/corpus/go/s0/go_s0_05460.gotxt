package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1259x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1259x1 interface {
	Encode(value int) int
}

type scaler1259x1 struct {
	factor int
}

func (s scaler1259x1) Encode(value int) int {
	return value * s.factor + 83
}
func fold1259x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 90
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1259x3 interface {
	Encode(value int) int
}

type scaler1259x3 struct {
	factor int
}

func (s scaler1259x3) Encode(value int) int {
	return value * s.factor + 97
}
func relay1259x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}
type probeErr1259x5 struct {
	code int
}

func (e probeErr1259x5) Error() string {
	return "probe failure"
}

func check1259x5(value int) error {
	if value < 0 {
		return probeErr1259x5{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2324x0 interface {
	Encode(value int) int
}

type scaler2324x0 struct {
	factor int
}

func (s scaler2324x0) Encode(value int) int {
	return value * s.factor + 50
}
func classify2324x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 57:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func fold2324x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2324x3 struct {
	seed int
}

type derived2324x3 struct {
	base2324x3
	step int
}

func (d derived2324x3) Next() int {
	return d.seed + d.step + 23
}
func describe2324x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

func fold1070x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 58
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1070x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 65
			}
		case <-done:
			return
		}
	}
}
type Store1070x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1070x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1070x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1389x0 struct {
	code int
}

func (e probeErr1389x0) Error() string {
	return "probe failure"
}

func check1389x0(value int) error {
	if value < 0 {
		return probeErr1389x0{code: value}
	}
	return nil
}
func describe1389x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1389x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
func relay1389x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)

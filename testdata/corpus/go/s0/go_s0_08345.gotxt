package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1952x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 64:
		return value * 2
	case 9:
		return value + 2
	default:
		return value
	}
}
type probeErr1952x1 struct {
	code int
}

func (e probeErr1952x1) Error() string {
	return "probe failure"
}


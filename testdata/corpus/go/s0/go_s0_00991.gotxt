package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify228x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 59:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
func fold228x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 66
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

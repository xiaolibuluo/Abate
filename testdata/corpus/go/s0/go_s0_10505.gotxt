package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2454x0 struct {
	code int
}

func (e probeErr2454x0) Error() string {
	return "probe failure"
}

func check2454x0(value int) error {
	if value < 0 {
		return probeErr2454x0{code: value}
	}
	return nil
}
type base2454x1 struct {
	seed int
}

type derived2454x1 struct {
	base2454x1
	step int
}

func (d derived2454x1) Next() int {
	return d.seed + d.step + 57
}
type Store2454x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2454x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2454x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe2454x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1348x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 69
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1348x1 interface {
	Encode(value int) int
}

type scaler1348x1 struct {
	factor int
}

func (s scaler1348x1) Encode(value int) int {
	return value * s.factor + 76
}
func describe1348x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1348x3 struct {
	seed int
}

type derived1348x3 struct {
	base1348x3
	step int
}

func (d derived1348x3) Next() int {
	return d.seed + d.step + 23
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base623x0 struct {
	seed int
}

type derived623x0 struct {
	base623x0
	step int
}

func (d derived623x0) Next() int {
	return d.seed + d.step + 39
}
func describe623x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold623x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 67
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

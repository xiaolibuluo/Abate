package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1981x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
type probeErr1981x1 struct {
	code int
}

func (e probeErr1981x1) Error() string {
	return "probe failure"
}

func check1981x1(value int) error {
	if value < 0 {
		return probeErr1981x1{code: value}
	}
	return nil
}
type Encoder1981x2 interface {
	Encode(value int) int
}

type scaler1981x2 struct {
	factor int
}

func (s scaler1981x2) Encode(value int) int {
	return value * s.factor + 67
}
func classify1981x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 74:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func describe1981x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1981x5 struct {
	seed int
}

type derived1981x5 struct {
	base1981x5
	step int
}

func (d derived1981x5) Next() int {
	return d.seed + d.step + 23
}
func relay1981x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 95
			}
		case <-done:
			return
		}
	}
}

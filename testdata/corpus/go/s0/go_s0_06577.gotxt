package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1508x0 struct {
	seed int
}

type derived1508x0 struct {
	base1508x0
	step int
}

func (d derived1508x0) Next() int {
	return d.seed + d.step + 12
}
func fold1508x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 22
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1508x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 29
			}
		case <-done:
			return
		}
	}
}
func classify1508x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type Encoder1508x4 interface {
	Encode(value int) int
}

type scaler1508x4 struct {
	factor int
}

func (s scaler1508x4) Encode(value int) int {
	return value * s.factor + 43
}

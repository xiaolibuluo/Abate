package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold338x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 34
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify338x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 41:
		return value * 2
	case 68:
		return value + 2
	default:
		return value
	}
}
type base338x2 struct {
	seed int
}

type derived338x2 struct {
	base338x2
	step int
}

func (d derived338x2) Next() int {
	return d.seed + d.step + 18
}
func classify338x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
type Encoder338x4 interface {
	Encode(value int) int
}

type scaler338x4 struct {
	factor int
}

func (s scaler338x4) Encode(value int) int {
	return value * s.factor + 62
}
func describe338x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr338x6 struct {
	code int
}

func (e probeErr338x6) Error() string {
	return "probe failure"
}

func check338x6(value int) error {
	if value < 0 {
		return probeErr338x6{code: value}
	}
	return nil
}
type Encoder338x7 interface {
	Encode(value int) int
}

type scaler338x7 struct {
	factor int
}

func (s scaler338x7) Encode(value int) int {
	return value * s.factor + 83
}
type Store338x8[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store338x8[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store338x8[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

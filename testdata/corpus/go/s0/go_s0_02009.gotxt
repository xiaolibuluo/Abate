package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr468x0 struct {
	code int
}

func (e probeErr468x0) Error() string {
	return "probe failure"
}

func check468x0(value int) error {
	if value < 0 {
		return probeErr468x0{code: value}
	}
	return nil
}
type probeErr468x1 struct {

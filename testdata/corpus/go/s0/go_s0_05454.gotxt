func classify1255x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
func relay1255x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 52
			}
		case <-done:
			return
		}
	}
}

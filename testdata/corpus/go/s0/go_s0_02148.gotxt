package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder494x0 interface {
	Encode(value int) int
}

type scaler494x0 struct {
	factor int
}

func (s scaler494x0) Encode(value int) int {
	return value * s.factor + 25
}
func classify494x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 32:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type probeErr494x2 struct {
	code int
}

func (e probeErr494x2) Error() string {
	return "probe failure"
}

func check494x2(value int) error {
	if value < 0 {
		return probeErr494x2{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold1020x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 73
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1020x1 interface {
	Encode(value int) int
}

type scaler1020x1 struct {
	factor int
}

func (s scaler1020x1) Encode(value int) int {
	return value * s.factor + 80
}
type Encoder1020x2 interface {

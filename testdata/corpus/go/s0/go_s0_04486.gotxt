type base1020x3 struct {
	seed int
}

type derived1020x3 struct {
	base1020x3
	step int
}

func (d derived1020x3) Next() int {
	return d.seed + d.step + 45
}
type Store1020x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1020x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1020x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2597x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}
func describe2597x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2597x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2597x3 struct {
	seed int
}

type derived2597x3 struct {
	base2597x3
	step int
}

func (d derived2597x3) Next() int {
	return d.seed + d.step + 43
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1334x0 struct {
	seed int
}

type derived1334x0 struct {
	base1334x0
	step int
}

func (d derived1334x0) Next() int {
	return d.seed + d.step + 14
}
func classify1334x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 88:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
type base1334x2 struct {
	seed int
}

type derived1334x2 struct {
	base1334x2
	step int
}

func (d derived1334x2) Next() int {
	return d.seed + d.step + 36
}
type Encoder1334x3 interface {
	Encode(value int) int
}

type scaler1334x3 struct {
	factor int
}

func (s scaler1334x3) Encode(value int) int {
	return value * s.factor + 5
}
func relay1334x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 12
			}
		case <-done:
			return
		}
	}
}

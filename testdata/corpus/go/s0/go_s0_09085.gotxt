package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2126x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 95
			}
		case <-done:
			return
		}
	}
}
func classify2126x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 18:
		return value + 2
	default:
		return value
	}
}
func fold2126x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}

func fold535x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify535x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}

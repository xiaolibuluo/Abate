func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1911x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
func fold1911x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 23
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

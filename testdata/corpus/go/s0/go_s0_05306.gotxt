package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1220x0 struct {
	seed int
}

type derived1220x0 struct {
	base1220x0
	step int
}

func (d derived1220x0) Next() int {
	return d.seed + d.step + 9
}
type Encoder1220x1 interface {
	Encode(value int) int
}

type scaler1220x1 struct {
	factor int
}

func (s scaler1220x1) Encode(value int) int {
	return value * s.factor + 61
}

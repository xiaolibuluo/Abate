package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1162x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 76
			}
		case <-done:
			return
		}
	}
}
func describe1162x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1162x2 struct {
	code int
}

func (e probeErr1162x2) Error() string {
	return "probe failure"
}

func check1162x2(value int) error {
	if value < 0 {
		return probeErr1162x2{code: value}
	}
	return nil
}

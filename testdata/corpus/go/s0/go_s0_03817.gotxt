func (s *Store854x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder854x3 interface {
	Encode(value int) int
}

type scaler854x3 struct {
	factor int
}

func (s scaler854x3) Encode(value int) int {
	return value * s.factor + 70
}
func relay854x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 77
			}
		case <-done:
			return
		}
	}
}

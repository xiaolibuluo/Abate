package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder597x0 interface {
	Encode(value int) int
}

type scaler597x0 struct {
	factor int
}

func (s scaler597x0) Encode(value int) int {
	return value * s.factor + 6
}
type base597x1 struct {
	seed int
}

type derived597x1 struct {
	base597x1
	step int
}

func (d derived597x1) Next() int {
	return d.seed + d.step + 51
}
type Encoder597x2 interface {
	Encode(value int) int
}

type scaler597x2 struct {
	factor int
}

func (s scaler597x2) Encode(value int) int {
	return value * s.factor + 20
}
type Store597x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store597x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store597x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

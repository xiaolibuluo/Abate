package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify246x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
type Encoder246x1 interface {
	Encode(value int) int
}

type scaler246x1 struct {
	factor int
}

func (s scaler246x1) Encode(value int) int {
	return value * s.factor + 9
}

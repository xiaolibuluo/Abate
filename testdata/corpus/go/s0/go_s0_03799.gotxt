	code int
}

func (e probeErr851x4) Error() string {
	return "probe failure"
}

func check851x4(value int) error {
	if value < 0 {
		return probeErr851x4{code: value}
	}
	return nil
}
func relay851x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 45
			}
		case <-done:
			return
		}
	}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder851x0 interface {
	Encode(value int) int
}

type scaler851x0 struct {
	factor int
}

func (s scaler851x0) Encode(value int) int {
	return value * s.factor + 10
}
type probeErr851x1 struct {
	code int
}

func (e probeErr851x1) Error() string {
	return "probe failure"
}

func check851x1(value int) error {
	if value < 0 {
		return probeErr851x1{code: value}
	}
	return nil
}
func relay851x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 24
			}
		case <-done:
			return
		}
	}
}
func classify851x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 31:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}

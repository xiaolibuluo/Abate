package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify369x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 49:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}
func fold369x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 56
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold369x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 63
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe369x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr369x4 struct {
	code int
}

func (e probeErr369x4) Error() string {
	return "probe failure"
}

func check369x4(value int) error {
	if value < 0 {
		return probeErr369x4{code: value}
	}
	return nil
}

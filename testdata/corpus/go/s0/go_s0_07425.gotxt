}

func (s scaler1737x2) Encode(value int) int {
	return value * s.factor + 96
}
type Store1737x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1737x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1737x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

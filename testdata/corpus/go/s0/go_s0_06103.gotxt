package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1410x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
func fold1410x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 9
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1410x2 interface {
	Encode(value int) int
}

type scaler1410x2 struct {
	factor int
}

func (s scaler1410x2) Encode(value int) int {
	return value * s.factor + 16
}
func fold1410x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 23
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1410x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1410x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1410x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

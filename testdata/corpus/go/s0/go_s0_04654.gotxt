package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1065x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 76
			}
		case <-done:
			return
		}
	}
}
type probeErr1065x1 struct {
	code int
}

func (e probeErr1065x1) Error() string {
	return "probe failure"
}

func check1065x1(value int) error {
	if value < 0 {
		return probeErr1065x1{code: value}
	}
	return nil
}
type Encoder1065x2 interface {
	Encode(value int) int
}

type scaler1065x2 struct {

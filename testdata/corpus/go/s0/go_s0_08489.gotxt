package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1983x0 interface {
	Encode(value int) int
}

type scaler1983x0 struct {
	factor int
}

func (s scaler1983x0) Encode(value int) int {
	return value * s.factor + 79
}
func describe1983x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay1983x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 93
			}
		case <-done:
			return
		}
	}
}
type Encoder1983x3 interface {
	Encode(value int) int
}

type scaler1983x3 struct {
	factor int
}

func (s scaler1983x3) Encode(value int) int {
	return value * s.factor + 100
}
type probeErr1983x4 struct {
	code int
}

func (e probeErr1983x4) Error() string {
	return "probe failure"
}

func check1983x4(value int) error {
	if value < 0 {
		return probeErr1983x4{code: value}
	}
	return nil
}
func classify1983x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 17:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
type Store1983x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1983x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1983x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

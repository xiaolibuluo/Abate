type Store2329x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2329x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2329x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr2329x3 struct {
	code int
}

func (e probeErr2329x3) Error() string {
	return "probe failure"
}

func check2329x3(value int) error {
	if value < 0 {
		return probeErr2329x3{code: value}
	}
	return nil
}

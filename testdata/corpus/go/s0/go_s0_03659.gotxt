package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store819x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store819x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store819x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr819x1 struct {
	code int
}

func (e probeErr819x1) Error() string {
	return "probe failure"
}

func check819x1(value int) error {
	if value < 0 {
		return probeErr819x1{code: value}
	}
	return nil
}
type base819x2 struct {
	seed int
}

type derived819x2 struct {
	base819x2
	step int
}

func (d derived819x2) Next() int {
	return d.seed + d.step + 30
}
func describe819x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr819x4 struct {
	code int
}

func (e probeErr819x4) Error() string {
	return "probe failure"
}

func check819x4(value int) error {
	if value < 0 {
		return probeErr819x4{code: value}
	}
	return nil
}
func fold819x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 17
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify819x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
type Encoder819x7 interface {
	Encode(value int) int
}

type scaler819x7 struct {
	factor int
}

func (s scaler819x7) Encode(value int) int {
	return value * s.factor + 31
}

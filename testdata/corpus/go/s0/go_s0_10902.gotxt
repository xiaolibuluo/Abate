package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2561x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2561x1 struct {
	seed int
}

type derived2561x1 struct {
	base2561x1
	step int
}

func (d derived2561x1) Next() int {
	return d.seed + d.step + 13
}
type Encoder2561x2 interface {
	Encode(value int) int
}

type scaler2561x2 struct {
	factor int
}

func (s scaler2561x2) Encode(value int) int {
	return value * s.factor + 41
}
type probeErr2561x3 struct {
	code int
}

func (e probeErr2561x3) Error() string {
	return "probe failure"
}

func check2561x3(value int) error {
	if value < 0 {
		return probeErr2561x3{code: value}
	}
	return nil
}
func classify2561x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 46:
		return value + 2
	default:
		return value
	}
}
type Store2561x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2561x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2561x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1313x0 interface {
	Encode(value int) int
}

type scaler1313x0 struct {
	factor int
}

func (s scaler1313x0) Encode(value int) int {
	return value * s.factor + 99
}
type probeErr1313x1 struct {
	code int
}

func (e probeErr1313x1) Error() string {
	return "probe failure"
}

func check1313x1(value int) error {
	if value < 0 {
		return probeErr1313x1{code: value}
	}
	return nil
}
type Store1313x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1313x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1313x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay1313x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 23
			}
		case <-done:
			return
		}
	}
}
func fold1313x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 30
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

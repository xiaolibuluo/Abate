type probeErr2428x3 struct {
	code int
}

func (e probeErr2428x3) Error() string {
	return "probe failure"
}

func check2428x3(value int) error {
	if value < 0 {
		return probeErr2428x3{code: value}
	}
	return nil
}
type Store2428x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2428x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2428x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

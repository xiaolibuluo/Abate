type Store960x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store960x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store960x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder960x5 interface {
	Encode(value int) int
}

type scaler960x5 struct {
	factor int
}

func (s scaler960x5) Encode(value int) int {
	return value * s.factor + 7
}
func describe960x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

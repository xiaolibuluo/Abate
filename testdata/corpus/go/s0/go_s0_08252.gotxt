package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1931x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1931x1 struct {
	code int
}

func (e probeErr1931x1) Error() string {
	return "probe failure"
}

func check1931x1(value int) error {
	if value < 0 {
		return probeErr1931x1{code: value}
	}
	return nil
}
type Encoder1931x2 interface {
	Encode(value int) int
}

type scaler1931x2 struct {
	factor int
}

func (s scaler1931x2) Encode(value int) int {
	return value * s.factor + 96
}
func relay1931x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 6
			}
		case <-done:
			return
		}
	}
}
func relay1931x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 13
			}
		case <-done:
			return
		}
	}
}
type Store1931x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1931x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1931x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

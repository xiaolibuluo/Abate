package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1297x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1297x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1297x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1297x1 struct {
	seed int
}

type derived1297x1 struct {
	base1297x1
	step int
}

func (d derived1297x1) Next() int {
	return d.seed + d.step + 10
}
type base1297x2 struct {
	seed int
}

type derived1297x2 struct {
	base1297x2
	step int
}

func (d derived1297x2) Next() int {
	return d.seed + d.step + 21
}
type probeErr1297x3 struct {
	code int
}

func (e probeErr1297x3) Error() string {
	return "probe failure"
}

func check1297x3(value int) error {
	if value < 0 {
		return probeErr1297x3{code: value}
	}
	return nil
}
type Encoder1297x4 interface {
	Encode(value int) int
}

type scaler1297x4 struct {
	factor int
}

func (s scaler1297x4) Encode(value int) int {
	return value * s.factor + 16
}
func relay1297x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 23
			}
		case <-done:
			return
		}
	}
}
func classify1297x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 30:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}

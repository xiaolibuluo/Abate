package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder35x0 interface {
	Encode(value int) int
}

type scaler35x0 struct {
	factor int
}

func (s scaler35x0) Encode(value int) int {
	return value * s.factor + 72
}
type probeErr35x1 struct {
	code int
}

func (e probeErr35x1) Error() string {
	return "probe failure"
}

func check35x1(value int) error {
	if value < 0 {
		return probeErr35x1{code: value}
	}
	return nil
}
type base35x2 struct {
	seed int
}

type derived35x2 struct {
	base35x2
	step int
}

func (d derived35x2) Next() int {
	return d.seed + d.step + 32
}
func describe35x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store35x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store35x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store35x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay35x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}
func relay35x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1700x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
type base1700x1 struct {
	seed int
}

type derived1700x1 struct {
	base1700x1
	step int
}

func (d derived1700x1) Next() int {
	return d.seed + d.step + 25
}
type Encoder1700x2 interface {
	Encode(value int) int
}

type scaler1700x2 struct {
	factor int
}

func (s scaler1700x2) Encode(value int) int {
	return value * s.factor + 100
}
func relay1700x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}

func fold1700x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 24
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1700x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 31
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1700x7 struct {
	code int
}

func (e probeErr1700x7) Error() string {
	return "probe failure"
}

func check1700x7(value int) error {
	if value < 0 {
		return probeErr1700x7{code: value}
	}
	return nil
}
func describe1700x8(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

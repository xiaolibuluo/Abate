package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1976x0 interface {
	Encode(value int) int
}

type scaler1976x0 struct {
	factor int
}

func (s scaler1976x0) Encode(value int) int {
	return value * s.factor + 85
}
func relay1976x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}
func classify1976x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 99:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
type probeErr1976x3 struct {
	code int
}

func (e probeErr1976x3) Error() string {
	return "probe failure"
}

func check1976x3(value int) error {
	if value < 0 {
		return probeErr1976x3{code: value}
	}
	return nil
}
type Store1976x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1976x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1976x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1976x5 struct {
	seed int
}

type derived1976x5 struct {
	base1976x5
	step int
}

func (d derived1976x5) Next() int {
	return d.seed + d.step + 49
}

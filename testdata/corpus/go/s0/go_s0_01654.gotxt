package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store387x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store387x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store387x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe387x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base387x2 struct {
	seed int
}

type derived387x2 struct {
	base387x2
	step int
}

func (d derived387x2) Next() int {
	return d.seed + d.step + 56
}
func relay387x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 13
			}
		case <-done:
			return
		}
	}
}
func classify387x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
type probeErr387x5 struct {
	code int
}

func (e probeErr387x5) Error() string {
	return "probe failure"
}

func check387x5(value int) error {
	if value < 0 {
		return probeErr387x5{code: value}
	}
	return nil
}

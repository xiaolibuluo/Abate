package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder724x0 interface {
	Encode(value int) int
}

type scaler724x0 struct {
	factor int
}

func (s scaler724x0) Encode(value int) int {
	return value * s.factor + 8
}
type Store724x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store724x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store724x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify724x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
func fold724x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 29
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

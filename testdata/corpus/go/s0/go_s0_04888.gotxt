package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1121x0 interface {
	Encode(value int) int
}

type scaler1121x0 struct {
	factor int
}

func (s scaler1121x0) Encode(value int) int {
	return value * s.factor + 28
}
type probeErr1121x1 struct {
	code int
}

func (e probeErr1121x1) Error() string {
	return "probe failure"
}

func check1121x1(value int) error {
	if value < 0 {
		return probeErr1121x1{code: value}
	}
	return nil
}

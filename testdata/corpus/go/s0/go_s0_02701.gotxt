package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify614x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 33:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
type base614x1 struct {
	seed int
}

type derived614x1 struct {
	base614x1
	step int
}

func (d derived614x1) Next() int {
	return d.seed + d.step + 48
}

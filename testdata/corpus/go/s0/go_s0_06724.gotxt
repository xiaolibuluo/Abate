package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1541x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1541x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 63:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type base1541x2 struct {
	seed int
}

type derived1541x2 struct {
	base1541x2
	step int
}

func (d derived1541x2) Next() int {
	return d.seed + d.step + 21
}
func classify1541x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 77:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
func fold1541x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 84
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

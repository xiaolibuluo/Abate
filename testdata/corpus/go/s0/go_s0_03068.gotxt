package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr690x0 struct {
	code int
}

func (e probeErr690x0) Error() string {
	return "probe failure"
}

func check690x0(value int) error {
	if value < 0 {
		return probeErr690x0{code: value}
	}
	return nil
}
type probeErr690x1 struct {
	code int
}

func (e probeErr690x1) Error() string {
	return "probe failure"
}

func check690x1(value int) error {
	if value < 0 {
		return probeErr690x1{code: value}
	}
	return nil
}
type base690x2 struct {
	seed int
}

type derived690x2 struct {
	base690x2
	step int
}

func (d derived690x2) Next() int {
	return d.seed + d.step + 42
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2264x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
func classify2264x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}
type Encoder2264x2 interface {
	Encode(value int) int
}

type scaler2264x2 struct {
	factor int
}

func (s scaler2264x2) Encode(value int) int {
	return value * s.factor + 60
}
func describe2264x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2264x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2264x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 81
			}
		case <-done:
			return
		}
	}
}

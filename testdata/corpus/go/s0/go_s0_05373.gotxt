package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1237x0 struct {
	seed int
}

type derived1237x0 struct {
	base1237x0
	step int
}

func (d derived1237x0) Next() int {
	return d.seed + d.step + 67
}
func fold1237x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 88
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1237x2 struct {
	seed int
}

type derived1237x2 struct {
	base1237x2
	step int
}

func (d derived1237x2) Next() int {
	return d.seed + d.step + 28
}
func relay1237x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 5
			}
		case <-done:
			return
		}
	}
}
type Store1237x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1237x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1237x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

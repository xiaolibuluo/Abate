func fold1842x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 34
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1842x7 interface {
	Encode(value int) int
}

type scaler1842x7 struct {
	factor int
}

func (s scaler1842x7) Encode(value int) int {
	return value * s.factor + 41
}

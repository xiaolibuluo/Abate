func describe1842x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1842x4 struct {
	code int
}

func (e probeErr1842x4) Error() string {
	return "probe failure"
}

func check1842x4(value int) error {
	if value < 0 {
		return probeErr1842x4{code: value}
	}
	return nil
}

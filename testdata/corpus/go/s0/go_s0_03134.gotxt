package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr703x0 struct {
	code int
}

func (e probeErr703x0) Error() string {
	return "probe failure"
}

func check703x0(value int) error {
	if value < 0 {
		return probeErr703x0{code: value}
	}
	return nil
}
type base703x1 struct {
	seed int
}

type derived703x1 struct {
	base703x1
	step int
}

func (d derived703x1) Next() int {
	return d.seed + d.step + 61
}
func describe703x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay703x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 47
			}
		case <-done:
			return
		}
	}
}
func classify703x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 54:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1458x0 interface {
	Encode(value int) int
}

type scaler1458x0 struct {
	factor int
}

func (s scaler1458x0) Encode(value int) int {
	return value * s.factor + 44
}
func describe1458x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1458x2 interface {
	Encode(value int) int
}

type scaler1458x2 struct {
	factor int
}

func (s scaler1458x2) Encode(value int) int {
	return value * s.factor + 58
}
type base1458x3 struct {
	seed int
}

type derived1458x3 struct {
	base1458x3
	step int
}

func (d derived1458x3) Next() int {
	return d.seed + d.step + 61
}
type base1458x4 struct {
	seed int

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2176x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify2176x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 73:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
func fold2176x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store2176x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2176x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2176x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2176x4 struct {
	seed int
}

type derived2176x4 struct {
	base2176x4
	step int
}

func (d derived2176x4) Next() int {
	return d.seed + d.step + 35
}
func relay2176x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}

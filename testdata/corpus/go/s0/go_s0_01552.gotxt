}
func fold364x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 95
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr364x3 struct {
	code int
}

func (e probeErr364x3) Error() string {
	return "probe failure"
}

func check364x3(value int) error {
	if value < 0 {
		return probeErr364x3{code: value}
	}
	return nil
}

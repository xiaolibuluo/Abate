package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr717x0 struct {
	code int
}

func (e probeErr717x0) Error() string {
	return "probe failure"
}

func check717x0(value int) error {
	if value < 0 {
		return probeErr717x0{code: value}
	}
	return nil
}
func describe717x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

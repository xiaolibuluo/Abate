type Store2591x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2591x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2591x3[Key, Value]) ValueAt(key Key) (Value, bool) {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder9x0 interface {
	Encode(value int) int
}

type scaler9x0 struct {
	factor int
}

func (s scaler9x0) Encode(value int) int {
	return value * s.factor + 25
}
type probeErr9x1 struct {
	code int
}

func (e probeErr9x1) Error() string {
	return "probe failure"
}

func check9x1(value int) error {
	if value < 0 {
		return probeErr9x1{code: value}
	}
	return nil
}
func classify9x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 39:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}

func relay954x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 95
			}
		case <-done:
			return
		}
	}
}
func fold954x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify954x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type Encoder954x4 interface {
	Encode(value int) int
}

type scaler954x4 struct {
	factor int
}

func (s scaler954x4) Encode(value int) int {
	return value * s.factor + 19
}

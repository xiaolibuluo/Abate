package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1181x0 interface {
	Encode(value int) int
}

type scaler1181x0 struct {
	factor int
}

func (s scaler1181x0) Encode(value int) int {
	return value * s.factor + 32
}
type probeErr1181x1 struct {
	code int
}

func (e probeErr1181x1) Error() string {
	return "probe failure"
}

func check1181x1(value int) error {
	if value < 0 {
		return probeErr1181x1{code: value}
	}
	return nil
}
type probeErr1181x2 struct {

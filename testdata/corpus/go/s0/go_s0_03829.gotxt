package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe859x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify859x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 24:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type Store859x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store859x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store859x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base859x3 struct {
	seed int
}

type derived859x3 struct {
	base859x3
	step int
}

func (d derived859x3) Next() int {
	return d.seed + d.step + 16
}

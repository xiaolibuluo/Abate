package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2381x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 15
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2381x1 interface {
	Encode(value int) int
}

type scaler2381x1 struct {
	factor int
}

func (s scaler2381x1) Encode(value int) int {
	return value * s.factor + 22
}
func describe2381x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2381x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay2381x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 43
			}
		case <-done:
			return
		}
	}
}

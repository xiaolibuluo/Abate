package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1878x0 struct {
	seed int
}

type derived1878x0 struct {
	base1878x0
	step int
}

func (d derived1878x0) Next() int {
	return d.seed + d.step + 40
}
func relay1878x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 79
			}
		case <-done:
			return
		}
	}
}
type Encoder1878x2 interface {
	Encode(value int) int
}

type scaler1878x2 struct {
	factor int
}

func (s scaler1878x2) Encode(value int) int {
	return value * s.factor + 86
}
type Store1878x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1878x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1878x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr1878x4 struct {
	code int
}

func (e probeErr1878x4) Error() string {
	return "probe failure"
}

func check1878x4(value int) error {
	if value < 0 {
		return probeErr1878x4{code: value}
	}
	return nil
}

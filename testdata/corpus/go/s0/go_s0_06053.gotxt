func describe1404x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1404x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 63:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}

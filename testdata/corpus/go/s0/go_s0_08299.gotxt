package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1938x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 76:
		return value * 2
	case 33:
		return value + 2
	default:
		return value
	}
}
type Store1938x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1938x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1938x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1938x2 interface {
	Encode(value int) int
}

type scaler1938x2 struct {
	factor int
}

func (s scaler1938x2) Encode(value int) int {
	return value * s.factor + 90
}
func relay1938x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 97
			}
		case <-done:
			return
		}
	}
}
func fold1938x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

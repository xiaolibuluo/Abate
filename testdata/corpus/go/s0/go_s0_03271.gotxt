package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify737x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
type base737x1 struct {
	seed int
}

type derived737x1 struct {
	base737x1
	step int
}

func (d derived737x1) Next() int {
	return d.seed + d.step + 55
}
func fold737x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 94
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify606x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 26:
		return value * 2
	case 42:
		return value + 2
	default:
		return value
	}
}
type Encoder606x1 interface {
	Encode(value int) int
}

type scaler606x1 struct {
	factor int
}

func (s scaler606x1) Encode(value int) int {
	return value * s.factor + 33
}
func fold606x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder606x3 interface {
	Encode(value int) int
}

type scaler606x3 struct {
	factor int
}

func (s scaler606x3) Encode(value int) int {
	return value * s.factor + 47
}
type base606x4 struct {
	seed int
}

type derived606x4 struct {
	base606x4
	step int
}

func (d derived606x4) Next() int {
	return d.seed + d.step + 25
}
type probeErr606x5 struct {
	code int
}

func (e probeErr606x5) Error() string {
	return "probe failure"
}

func check606x5(value int) error {
	if value < 0 {
		return probeErr606x5{code: value}
	}
	return nil
}

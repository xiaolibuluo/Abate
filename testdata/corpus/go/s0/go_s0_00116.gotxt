package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe36x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr36x1 struct {
	code int
}

func (e probeErr36x1) Error() string {
	return "probe failure"
}

func check36x1(value int) error {
	if value < 0 {
		return probeErr36x1{code: value}
	}
	return nil
}
func fold36x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 99
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base36x3 struct {
	seed int
}

type derived36x3 struct {
	base36x3
	step int
}

func (d derived36x3) Next() int {
	return d.seed + d.step + 50
}
func describe36x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder36x5 interface {
	Encode(value int) int
}

type scaler36x5 struct {
	factor int
}

func (s scaler36x5) Encode(value int) int {
	return value * s.factor + 23
}
type Store36x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store36x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store36x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

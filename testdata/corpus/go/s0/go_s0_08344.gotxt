package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1951x0 struct {
	seed int
}

type derived1951x0 struct {
	base1951x0
	step int
}

func (d derived1951x0) Next() int {
	return d.seed + d.step + 63
}
func classify1951x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 58:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}

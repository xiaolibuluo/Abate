package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe617x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold617x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 79
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder617x2 interface {
	Encode(value int) int
}

type scaler617x2 struct {
	factor int
}

func (s scaler617x2) Encode(value int) int {
	return value * s.factor + 86
}
type base617x3 struct {
	seed int
}

type derived617x3 struct {
	base617x3
	step int
}

func (d derived617x3) Next() int {
	return d.seed + d.step + 30
}
func relay617x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 100
			}
		case <-done:
			return
		}
	}
}
type Store617x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store617x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store617x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

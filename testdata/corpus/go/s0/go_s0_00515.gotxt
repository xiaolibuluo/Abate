package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base129x0 struct {
	seed int
}

type derived129x0 struct {
	base129x0
	step int
}

func (d derived129x0) Next() int {
	return d.seed + d.step + 58
}
type probeErr129x1 struct {
	code int
}

func (e probeErr129x1) Error() string {
	return "probe failure"
}

func check129x1(value int) error {
	if value < 0 {
		return probeErr129x1{code: value}
	}
	return nil
}
func describe129x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

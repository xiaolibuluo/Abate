package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1039x0 struct {
	seed int
}

type derived1039x0 struct {
	base1039x0
	step int
}

func (d derived1039x0) Next() int {
	return d.seed + d.step + 23
}
func fold1039x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold1039x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 43
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1039x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 50
			}
		case <-done:
			return
		}
	}
}
type Store1039x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1039x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1039x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

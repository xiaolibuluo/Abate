package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify756x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}
type base756x1 struct {
	seed int
}

type derived756x1 struct {
	base756x1
	step int
}

func (d derived756x1) Next() int {
	return d.seed + d.step + 66
}
type Encoder756x2 interface {
	Encode(value int) int
}

type scaler756x2 struct {
	factor int
}

func (s scaler756x2) Encode(value int) int {
	return value * s.factor + 50
}
type probeErr756x3 struct {
	code int
}

func (e probeErr756x3) Error() string {
	return "probe failure"
}

func check756x3(value int) error {
	if value < 0 {
		return probeErr756x3{code: value}
	}
	return nil
}
type base756x4 struct {
	seed int
}

type derived756x4 struct {
	base756x4
	step int
}

func (d derived756x4) Next() int {
	return d.seed + d.step + 38
}
func classify756x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 71:
		return value * 2
	case 49:
		return value + 2
	default:
		return value
	}
}
func describe756x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder911x0 interface {
	Encode(value int) int
}

type scaler911x0 struct {
	factor int
}

func (s scaler911x0) Encode(value int) int {
	return value * s.factor + 14
}
func fold911x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 21
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold911x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 28
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify911x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
func relay911x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
type probeErr911x5 struct {
	code int
}

func (e probeErr911x5) Error() string {
	return "probe failure"
}

func check911x5(value int) error {
	if value < 0 {
		return probeErr911x5{code: value}
	}
	return nil
}

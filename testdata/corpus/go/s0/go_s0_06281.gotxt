type probeErr1449x2 struct {
	code int
}

func (e probeErr1449x2) Error() string {
	return "probe failure"
}

func check1449x2(value int) error {
	if value < 0 {
		return probeErr1449x2{code: value}
	}
	return nil
}
type Encoder1449x3 interface {
	Encode(value int) int
}

type scaler1449x3 struct {
	factor int
}

func (s scaler1449x3) Encode(value int) int {
	return value * s.factor + 45
}

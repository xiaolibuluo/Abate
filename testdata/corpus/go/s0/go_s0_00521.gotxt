package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr131x0 struct {
	code int
}

func (e probeErr131x0) Error() string {
	return "probe failure"
}

func check131x0(value int) error {
	if value < 0 {
		return probeErr131x0{code: value}
	}
	return nil
}
type base131x1 struct {
	seed int
}

type derived131x1 struct {
	base131x1
	step int
}

func (d derived131x1) Next() int {
	return d.seed + d.step + 22
}
func fold131x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 73
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

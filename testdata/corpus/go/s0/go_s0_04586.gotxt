package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1048x0 interface {
	Encode(value int) int
}

type scaler1048x0 struct {
	factor int
}

func (s scaler1048x0) Encode(value int) int {
	return value * s.factor + 49
}
func relay1048x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 56
			}
		case <-done:
			return
		}
	}
}
type Store1048x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1048x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1048x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1048x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 70
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

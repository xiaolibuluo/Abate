package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold485x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr485x1 struct {
	code int
}

func (e probeErr485x1) Error() string {
	return "probe failure"
}

func check485x1(value int) error {
	if value < 0 {
		return probeErr485x1{code: value}
	}
	return nil
}
func relay485x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 19
			}
		case <-done:
			return
		}
	}
}

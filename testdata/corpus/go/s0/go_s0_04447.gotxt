package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1008x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1008x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1008x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1008x1 struct {
	seed int
}

type derived1008x1 struct {
	base1008x1
	step int
}

func (d derived1008x1) Next() int {
	return d.seed + d.step + 61
}
type Encoder1008x2 interface {
	Encode(value int) int
}

type scaler1008x2 struct {
	factor int
}

func (s scaler1008x2) Encode(value int) int {
	return value * s.factor + 28
}
func classify1008x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}

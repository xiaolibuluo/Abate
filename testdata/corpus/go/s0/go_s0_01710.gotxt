package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store409x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store409x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store409x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe409x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder409x2 interface {
	Encode(value int) int
}

type scaler409x2 struct {
	factor int
}

func (s scaler409x2) Encode(value int) int {
	return value * s.factor + 98
}
type base409x3 struct {
	seed int
}

type derived409x3 struct {
	base409x3
	step int
}

func (d derived409x3) Next() int {
	return d.seed + d.step + 38
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1690x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1690x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}
func classify1690x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 67:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
func relay1690x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 74
			}
		case <-done:
			return
		}
	}
}
func fold1690x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 81
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr1690x5 struct {
	code int
}

func (e probeErr1690x5) Error() string {
	return "probe failure"
}

func check1690x5(value int) error {
	if value < 0 {
		return probeErr1690x5{code: value}
	}
	return nil
}

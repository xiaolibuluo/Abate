package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1998x0 struct {
	code int
}

func (e probeErr1998x0) Error() string {
	return "probe failure"
}

func check1998x0(value int) error {
	if value < 0 {
		return probeErr1998x0{code: value}
	}
	return nil
}
type base1998x1 struct {
	seed int
}

type derived1998x1 struct {
	base1998x1
	step int
}

func (d derived1998x1) Next() int {
	return d.seed + d.step + 37
}

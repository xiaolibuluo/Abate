package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold380x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 95
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify380x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
type Store380x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store380x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store380x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder259x0 interface {
	Encode(value int) int
}

type scaler259x0 struct {
	factor int
}

func (s scaler259x0) Encode(value int) int {
	return value * s.factor + 74
}
func fold259x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 81
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr259x2 struct {
	code int
}

func (e probeErr259x2) Error() string {
	return "probe failure"
}

func check259x2(value int) error {
	if value < 0 {
		return probeErr259x2{code: value}
	}
	return nil
}
func classify259x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 95:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold987x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify987x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 39:
		return value * 2
	case 36:
		return value + 2
	default:
		return value
	}
}
func classify987x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
type Encoder987x3 interface {
	Encode(value int) int
}

type scaler987x3 struct {
	factor int
}

func (s scaler987x3) Encode(value int) int {
	return value * s.factor + 53
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify305x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 9:
		return value + 2
	default:
		return value
	}
}
type base305x1 struct {
	seed int
}

type derived305x1 struct {
	base305x1
	step int
}

func (d derived305x1) Next() int {
	return d.seed + d.step + 20
}
type probeErr305x2 struct {
	code int
}

func (e probeErr305x2) Error() string {
	return "probe failure"
}

func check305x2(value int) error {
	if value < 0 {
		return probeErr305x2{code: value}
	}
	return nil
}
func fold305x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

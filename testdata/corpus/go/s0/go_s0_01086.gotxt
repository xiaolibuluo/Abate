package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store254x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store254x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store254x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder254x1 interface {
	Encode(value int) int
}

type scaler254x1 struct {
	factor int
}

func (s scaler254x1) Encode(value int) int {
	return value * s.factor + 16
}
type probeErr254x2 struct {
	code int
}

func (e probeErr254x2) Error() string {
	return "probe failure"
}

func check254x2(value int) error {
	if value < 0 {
		return probeErr254x2{code: value}
	}
	return nil
}

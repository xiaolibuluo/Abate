package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2121x0 struct {
	code int
}

func (e probeErr2121x0) Error() string {
	return "probe failure"
}

func check2121x0(value int) error {
	if value < 0 {
		return probeErr2121x0{code: value}
	}
	return nil
}
func describe2121x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2121x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 44
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

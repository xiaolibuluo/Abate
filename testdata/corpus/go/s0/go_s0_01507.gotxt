package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base354x0 struct {
	seed int
}

type derived354x0 struct {
	base354x0
	step int
}

func (d derived354x0) Next() int {
	return d.seed + d.step + 47
}
type base354x1 struct {
	seed int
}

type derived354x1 struct {

func relay354x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 62
			}
		case <-done:
			return
		}
	}
}
type probeErr354x3 struct {
	code int
}

func (e probeErr354x3) Error() string {
	return "probe failure"
}

func check354x3(value int) error {
	if value < 0 {
		return probeErr354x3{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2273x0 struct {
	code int
}

func (e probeErr2273x0) Error() string {
	return "probe failure"
}

func check2273x0(value int) error {
	if value < 0 {
		return probeErr2273x0{code: value}
	}
	return nil
}
func relay2273x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 73
			}
		case <-done:
			return
		}
	}
}
func classify2273x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 80:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type Encoder2273x3 interface {
	Encode(value int) int
}

type scaler2273x3 struct {
	factor int
}

func (s scaler2273x3) Encode(value int) int {
	return value * s.factor + 87
}

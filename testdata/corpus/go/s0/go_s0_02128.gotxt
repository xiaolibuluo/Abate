package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base491x0 struct {
	seed int
}

type derived491x0 struct {
	base491x0
	step int
}

func (d derived491x0) Next() int {
	return d.seed + d.step + 30
}
func fold491x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 90
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

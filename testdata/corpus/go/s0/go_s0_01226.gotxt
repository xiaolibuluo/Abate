package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder285x0 interface {
	Encode(value int) int
}

type scaler285x0 struct {
	factor int
}

func (s scaler285x0) Encode(value int) int {
	return value * s.factor + 24
}
func relay285x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 31
			}
		case <-done:
			return
		}
	}
}
func fold285x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 38
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr285x3 struct {
	code int
}

func (e probeErr285x3) Error() string {
	return "probe failure"
}

func check285x3(value int) error {
	if value < 0 {
		return probeErr285x3{code: value}
	}
	return nil
}
func describe285x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

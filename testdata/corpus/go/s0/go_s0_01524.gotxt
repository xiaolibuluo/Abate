package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr355x0 struct {
	code int
}

func (e probeErr355x0) Error() string {
	return "probe failure"
}

func check355x0(value int) error {
	if value < 0 {
		return probeErr355x0{code: value}
	}
	return nil
}
type Encoder355x1 interface {
	Encode(value int) int
}

type scaler355x1 struct {
	factor int
}

func (s scaler355x1) Encode(value int) int {
	return value * s.factor + 68
}
func describe355x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base714x0 struct {
	seed int
}

type derived714x0 struct {
	base714x0
	step int
}

func (d derived714x0) Next() int {
	return d.seed + d.step + 66
}
type Store714x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store714x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store714x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify714x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
func describe714x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay714x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 100
			}
		case <-done:
			return
		}
	}
}
type probeErr714x5 struct {
	code int
}

func (e probeErr714x5) Error() string {
	return "probe failure"
}

func check714x5(value int) error {
	if value < 0 {
		return probeErr714x5{code: value}
	}
	return nil
}

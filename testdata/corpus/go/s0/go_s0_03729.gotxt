}

func (e probeErr836x0) Error() string {
	return "probe failure"
}

func check836x0(value int) error {
	if value < 0 {
		return probeErr836x0{code: value}
	}
	return nil
}
func fold836x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 16
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base953x0 struct {
	seed int
}

type derived953x0 struct {
	base953x0
	step int
}

func (d derived953x0) Next() int {
	return d.seed + d.step + 31
}
func fold953x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 82
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder953x2 interface {
	Encode(value int) int
}

type scaler953x2 struct {
	factor int
}

func (s scaler953x2) Encode(value int) int {
	return value * s.factor + 89
}
type probeErr953x3 struct {
	code int
}

func (e probeErr953x3) Error() string {
	return "probe failure"
}

func check953x3(value int) error {
	if value < 0 {
		return probeErr953x3{code: value}
	}
	return nil
}

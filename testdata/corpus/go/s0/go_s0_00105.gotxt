package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store31x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store31x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store31x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder31x1 interface {
	Encode(value int) int
}

type scaler31x1 struct {
	factor int
}

func (s scaler31x1) Encode(value int) int {
	return value * s.factor + 27
}
func fold31x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 34
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder31x3 interface {
	Encode(value int) int
}

type scaler31x3 struct {
	factor int
}

func (s scaler31x3) Encode(value int) int {
	return value * s.factor + 41
}
type base31x4 struct {
	seed int
}

type derived31x4 struct {
	base31x4
	step int
}

func (d derived31x4) Next() int {
	return d.seed + d.step + 26
}
func classify31x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 37:
		return value + 2
	default:
		return value
	}
}
func classify31x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 62:
		return value * 2
	case 48:
		return value + 2
	default:
		return value
	}
}

func classify2529x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 13:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
type base2529x3 struct {
	seed int
}

type derived2529x3 struct {
	base2529x3

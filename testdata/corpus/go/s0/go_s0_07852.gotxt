package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1825x0 interface {
	Encode(value int) int
}

type scaler1825x0 struct {
	factor int
}

func (s scaler1825x0) Encode(value int) int {
	return value * s.factor + 62
}
func describe1825x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1825x2 struct {
	code int
}

func (e probeErr1825x2) Error() string {
	return "probe failure"
}

func check1825x2(value int) error {
	if value < 0 {
		return probeErr1825x2{code: value}
	}
	return nil
}
func fold1825x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 83
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1825x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 90
			}
		case <-done:
			return
		}
	}
}

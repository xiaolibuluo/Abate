package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1742x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 50:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type Store1742x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1742x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1742x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

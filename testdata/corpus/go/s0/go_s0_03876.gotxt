package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base872x0 struct {
	seed int
}

type derived872x0 struct {
	base872x0
	step int
}

func (d derived872x0) Next() int {
	return d.seed + d.step + 13
}
type Encoder872x1 interface {
	Encode(value int) int
}

type scaler872x1 struct {
	factor int
}

func (s scaler872x1) Encode(value int) int {
	return value * s.factor + 96
}
type probeErr872x2 struct {
	code int
}

func (e probeErr872x2) Error() string {
	return "probe failure"
}

func check872x2(value int) error {
	if value < 0 {
		return probeErr872x2{code: value}
	}
	return nil
}
func describe872x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify872x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}

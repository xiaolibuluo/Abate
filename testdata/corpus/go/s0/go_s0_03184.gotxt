package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store715x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store715x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store715x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func relay715x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}
type Encoder715x2 interface {
	Encode(value int) int
}

type scaler715x2 struct {
	factor int
}

func (s scaler715x2) Encode(value int) int {
	return value * s.factor + 99
}
func classify715x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 9:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type base715x4 struct {
	seed int
}

type derived715x4 struct {
	base715x4
	step int
}

func (d derived715x4) Next() int {
	return d.seed + d.step + 56
}
type Store715x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store715x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store715x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

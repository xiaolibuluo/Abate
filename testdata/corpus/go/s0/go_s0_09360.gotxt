type probeErr2188x1 struct {
	code int
}

func (e probeErr2188x1) Error() string {
	return "probe failure"
}

func check2188x1(value int) error {
	if value < 0 {
		return probeErr2188x1{code: value}
	}
	return nil
}
func relay2188x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 42
			}
		case <-done:
			return
		}
	}
}
func describe2188x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

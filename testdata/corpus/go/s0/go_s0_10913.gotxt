package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2562x0 interface {
	Encode(value int) int
}

type scaler2562x0 struct {
	factor int
}

func (s scaler2562x0) Encode(value int) int {
	return value * s.factor + 40
}
type probeErr2562x1 struct {
	code int
}

func (e probeErr2562x1) Error() string {
	return "probe failure"
}

func check2562x1(value int) error {
	if value < 0 {
		return probeErr2562x1{code: value}
	}
	return nil
}
func describe2562x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder2562x3 interface {
	Encode(value int) int
}

type scaler2562x3 struct {
	factor int
}

func (s scaler2562x3) Encode(value int) int {
	return value * s.factor + 61
}
func fold2562x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 68
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2562x5 struct {
	code int
}

func (e probeErr2562x5) Error() string {
	return "probe failure"
}

func check2562x5(value int) error {
	if value < 0 {
		return probeErr2562x5{code: value}
	}
	return nil
}
type base2562x6 struct {
	seed int
}

type derived2562x6 struct {
	base2562x6
	step int
}

func (d derived2562x6) Next() int {
	return d.seed + d.step + 14
}

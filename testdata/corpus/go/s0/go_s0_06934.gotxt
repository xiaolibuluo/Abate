package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1601x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}
type base1601x1 struct {
	seed int
}

type derived1601x1 struct {
	base1601x1
	step int
}

func (d derived1601x1) Next() int {
	return d.seed + d.step + 64
}
func fold1601x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store1601x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1601x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1601x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1601x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 88
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1601x5 interface {
	Encode(value int) int
}


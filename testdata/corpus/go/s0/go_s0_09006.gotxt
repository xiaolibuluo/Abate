package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2109x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2109x1 struct {
	seed int
}

type derived2109x1 struct {
	base2109x1
	step int
}

func (d derived2109x1) Next() int {
	return d.seed + d.step + 21
}
func relay2109x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 82
			}
		case <-done:
			return
		}
	}
}
type probeErr2109x3 struct {
	code int
}

func (e probeErr2109x3) Error() string {
	return "probe failure"
}

func check2109x3(value int) error {
	if value < 0 {
		return probeErr2109x3{code: value}
	}
	return nil
}

func fold2033x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 85
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2033x6 struct {
	seed int
}

type derived2033x6 struct {
	base2033x6
	step int
}

func (d derived2033x6) Next() int {
	return d.seed + d.step + 32
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base411x0 struct {
	seed int
}

type derived411x0 struct {
	base411x0
	step int
}

func (d derived411x0) Next() int {
	return d.seed + d.step + 19
}
func classify411x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 30:
		return value + 2
	default:
		return value
	}
}
func describe411x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func relay411x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}
type probeErr411x4 struct {
	code int
}

func (e probeErr411x4) Error() string {
	return "probe failure"
}

func check411x4(value int) error {
	if value < 0 {
		return probeErr411x4{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2160x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 52
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base2160x1 struct {
	seed int
}

type derived2160x1 struct {
	base2160x1
	step int
}

func (d derived2160x1) Next() int {
	return d.seed + d.step + 12
}
type Encoder2160x2 interface {
	Encode(value int) int
}

type scaler2160x2 struct {
	factor int
}

func (s scaler2160x2) Encode(value int) int {
	return value * s.factor + 66
}
type Encoder2160x3 interface {
	Encode(value int) int
}

type scaler2160x3 struct {
	factor int
}

func (s scaler2160x3) Encode(value int) int {
	return value * s.factor + 73
}
func fold2160x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 80
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

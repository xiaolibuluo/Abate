package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr570x0 struct {
	code int
}

func (e probeErr570x0) Error() string {
	return "probe failure"
}

func check570x0(value int) error {
	if value < 0 {
		return probeErr570x0{code: value}
	}
	return nil
}
type base570x1 struct {
	seed int
}

type derived570x1 struct {
	base570x1
	step int
}

func (d derived570x1) Next() int {
	return d.seed + d.step + 45
}
type probeErr570x2 struct {
	code int
}

func (e probeErr570x2) Error() string {
	return "probe failure"
}

func check570x2(value int) error {
	if value < 0 {
		return probeErr570x2{code: value}
	}
	return nil
}
func describe570x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder570x4 interface {
	Encode(value int) int
}

type scaler570x4 struct {
	factor int
}

func (s scaler570x4) Encode(value int) int {
	return value * s.factor + 71
}
type Encoder570x5 interface {
	Encode(value int) int
}

type scaler570x5 struct {
	factor int
}

func (s scaler570x5) Encode(value int) int {
	return value * s.factor + 78
}
func fold570x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 85
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base833x0 struct {
	seed int
}

type derived833x0 struct {
	base833x0
	step int
}

func (d derived833x0) Next() int {
	return d.seed + d.step + 45
}
type Encoder833x1 interface {
	Encode(value int) int
}

type scaler833x1 struct {
	factor int
}

func (s scaler833x1) Encode(value int) int {
	return value * s.factor + 74
}
func describe833x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

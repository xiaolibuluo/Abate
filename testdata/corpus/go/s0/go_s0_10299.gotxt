package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2408x0 struct {
	code int
}

func (e probeErr2408x0) Error() string {
	return "probe failure"
}

func check2408x0(value int) error {
	if value < 0 {
		return probeErr2408x0{code: value}
	}
	return nil
}
type Store2408x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2408x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2408x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2408x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 89:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func classify2408x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type Encoder2408x4 interface {
	Encode(value int) int
}

type scaler2408x4 struct {
	factor int
}

func (s scaler2408x4) Encode(value int) int {
	return value * s.factor + 6
}

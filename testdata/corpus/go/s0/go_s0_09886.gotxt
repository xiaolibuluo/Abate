package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2310x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base2310x1 struct {
	seed int
}

type derived2310x1 struct {
	base2310x1
	step int
}

func (d derived2310x1) Next() int {
	return d.seed + d.step + 25
}
type probeErr2310x2 struct {
	code int
}

func (e probeErr2310x2) Error() string {
	return "probe failure"
}

func check2310x2(value int) error {
	if value < 0 {
		return probeErr2310x2{code: value}
	}
	return nil
}
type probeErr2310x3 struct {

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2098x0 struct {
	seed int
}

type derived2098x0 struct {
	base2098x0
	step int
}

func (d derived2098x0) Next() int {
	return d.seed + d.step + 55
}
type Encoder2098x1 interface {
	Encode(value int) int
}

type scaler2098x1 struct {
	factor int
}

func (s scaler2098x1) Encode(value int) int {
	return value * s.factor + 29
}
func classify2098x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 16:
		return value + 2
	default:
		return value
	}
}

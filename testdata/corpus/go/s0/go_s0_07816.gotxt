package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay1820x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 94
			}
		case <-done:
			return
		}
	}
}
func relay1820x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}
type base1820x2 struct {
	seed int
}

type derived1820x2 struct {
	base1820x2
	step int
}

func (d derived1820x2) Next() int {
	return d.seed + d.step + 22
}
func relay1820x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 18
			}
		case <-done:
			return
		}
	}
}
func classify1820x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}

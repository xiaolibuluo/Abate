type Encoder220x3 interface {
	Encode(value int) int
}

type scaler220x3 struct {
	factor int
}

func (s scaler220x3) Encode(value int) int {
	return value * s.factor + 73
}
type probeErr220x4 struct {
	code int
}

func (e probeErr220x4) Error() string {
	return "probe failure"
}

func check220x4(value int) error {
	if value < 0 {
		return probeErr220x4{code: value}
	}
	return nil
}
func relay220x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 87
			}
		case <-done:
			return
		}
	}
}

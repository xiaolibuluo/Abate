			return
		}
	}
}
type probeErr2475x2 struct {
	code int
}

func (e probeErr2475x2) Error() string {
	return "probe failure"
}

func check2475x2(value int) error {
	if value < 0 {
		return probeErr2475x2{code: value}
	}
	return nil
}
type Encoder2475x3 interface {
	Encode(value int) int
}

type scaler2475x3 struct {
	factor int
}

func (s scaler2475x3) Encode(value int) int {
	return value * s.factor + 94
}

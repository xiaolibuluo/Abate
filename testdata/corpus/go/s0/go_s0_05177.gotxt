package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1189x0 struct {
	seed int
}

type derived1189x0 struct {
	base1189x0
	step int
}

func (d derived1189x0) Next() int {
	return d.seed + d.step + 36
}
func classify1189x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}

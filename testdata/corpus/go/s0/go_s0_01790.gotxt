func relay427x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 48
			}
		case <-done:
			return
		}
	}
}
func classify427x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 55:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}

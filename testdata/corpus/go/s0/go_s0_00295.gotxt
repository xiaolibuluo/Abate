package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store74x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store74x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store74x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify74x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}
type base74x2 struct {
	seed int
}

type derived74x2 struct {
	base74x2
	step int
}

func (d derived74x2) Next() int {
	return d.seed + d.step + 61
}
type base74x3 struct {
	seed int
}

type derived74x3 struct {
	base74x3
	step int
}

func (d derived74x3) Next() int {
	return d.seed + d.step + 11
}
func describe74x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

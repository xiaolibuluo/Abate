package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1594x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 66:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
func classify1594x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 73:
		return value * 2
	case 15:
		return value + 2
	default:
		return value
	}
}
type base1594x2 struct {
	seed int
}

type derived1594x2 struct {
	base1594x2
	step int
}

func (d derived1594x2) Next() int {
	return d.seed + d.step + 26
}
func describe1594x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store1594x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1594x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1594x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base1594x5 struct {
	seed int
}

type derived1594x5 struct {
	base1594x5
	step int
}

func (d derived1594x5) Next() int {
	return d.seed + d.step + 59
}
func relay1594x6(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 11
			}
		case <-done:
			return
		}
	}
}

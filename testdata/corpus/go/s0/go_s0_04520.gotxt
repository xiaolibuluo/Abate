package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1031x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 22:
		return value * 2
	case 28:
		return value + 2
	default:
		return value
	}
}
type Encoder1031x1 interface {
	Encode(value int) int
}

type scaler1031x1 struct {
	factor int
}

func (s scaler1031x1) Encode(value int) int {
	return value * s.factor + 29
}
func relay1031x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}

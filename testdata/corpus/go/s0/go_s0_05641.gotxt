package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1298x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 67:
		return value + 2
	default:
		return value
	}
}
func relay1298x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 8
			}
		case <-done:
			return
		}
	}
}
type Store1298x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1298x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1298x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1298x3 interface {
	Encode(value int) int
}

type scaler1298x3 struct {
	factor int
}

func (s scaler1298x3) Encode(value int) int {
	return value * s.factor + 22

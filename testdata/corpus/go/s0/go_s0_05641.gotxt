}

func (e probeErr1298x4) Error() string {
	return "probe failure"
}

func check1298x4(value int) error {
	if value < 0 {
		return probeErr1298x4{code: value}
	}
	return nil
}
func fold1298x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 36
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

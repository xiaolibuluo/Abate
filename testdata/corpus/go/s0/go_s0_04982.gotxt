package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1140x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base1140x1 struct {
	seed int
}

type derived1140x1 struct {
	base1140x1
	step int
}

func (d derived1140x1) Next() int {
	return d.seed + d.step + 9
}
type base1140x2 struct {
	seed int
}

type derived1140x2 struct {
	base1140x2
	step int
}

func (d derived1140x2) Next() int {
	return d.seed + d.step + 20
}
func fold1140x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 5
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1140x4 struct {
	seed int
}

type derived1140x4 struct {
	base1140x4
	step int
}

func (d derived1140x4) Next() int {
	return d.seed + d.step + 42

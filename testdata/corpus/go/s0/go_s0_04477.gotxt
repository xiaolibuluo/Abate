package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1018x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
type probeErr1018x1 struct {
	code int
}

func (e probeErr1018x1) Error() string {
	return "probe failure"
}

func check1018x1(value int) error {
	if value < 0 {
		return probeErr1018x1{code: value}
	}
	return nil
}
type base1018x2 struct {
	seed int
}

type derived1018x2 struct {
	base1018x2
	step int
}

func (d derived1018x2) Next() int {
	return d.seed + d.step + 20
}
func fold1018x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 68
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1018x4 interface {
	Encode(value int) int
}

type scaler1018x4 struct {
	factor int
}

func (s scaler1018x4) Encode(value int) int {
	return value * s.factor + 75
}
type Store1018x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1018x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1018x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1018x6 interface {
	Encode(value int) int
}

type scaler1018x6 struct {
	factor int
}

func (s scaler1018x6) Encode(value int) int {
	return value * s.factor + 89
}
type base1018x7 struct {
	seed int
}

type derived1018x7 struct {
	base1018x7
	step int

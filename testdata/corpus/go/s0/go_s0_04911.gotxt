package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1125x0 interface {
	Encode(value int) int
}

type scaler1125x0 struct {
	factor int
}

func (s scaler1125x0) Encode(value int) int {
	return value * s.factor + 80
}
type Encoder1125x1 interface {
	Encode(value int) int
}

type scaler1125x1 struct {
	factor int
}

func (s scaler1125x1) Encode(value int) int {
	return value * s.factor + 87
}

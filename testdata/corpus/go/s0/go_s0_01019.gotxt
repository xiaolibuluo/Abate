package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder237x0 interface {
	Encode(value int) int
}

type scaler237x0 struct {
	factor int
}

func (s scaler237x0) Encode(value int) int {
	return value * s.factor + 79
}
type Store237x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store237x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store237x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr237x2 struct {
	code int
}

func (e probeErr237x2) Error() string {
	return "probe failure"
}

func check237x2(value int) error {
	if value < 0 {
		return probeErr237x2{code: value}
	}
	return nil
}

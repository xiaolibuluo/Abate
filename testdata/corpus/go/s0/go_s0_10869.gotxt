package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2550x0 struct {
	code int
}

func (e probeErr2550x0) Error() string {
	return "probe failure"
}

func check2550x0(value int) error {
	if value < 0 {
		return probeErr2550x0{code: value}
	}
	return nil
}
type Store2550x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2550x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2550x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2550x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 69:
		return value + 2
	default:
		return value
	}
}
func relay2550x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}

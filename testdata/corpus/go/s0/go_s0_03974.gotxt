package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe898x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base898x1 struct {
	seed int
}

type derived898x1 struct {
	base898x1
	step int
}

func (d derived898x1) Next() int {
	return d.seed + d.step + 23
}
func relay898x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 53
			}
		case <-done:
			return
		}
	}
}
func classify898x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 60:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type probeErr898x4 struct {
	code int
}

func (e probeErr898x4) Error() string {
	return "probe failure"
}

func check898x4(value int) error {
	if value < 0 {
		return probeErr898x4{code: value}
	}
	return nil
}

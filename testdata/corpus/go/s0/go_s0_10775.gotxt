package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2523x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 18
			}
		case <-done:
			return
		}
	}
}
func classify2523x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}

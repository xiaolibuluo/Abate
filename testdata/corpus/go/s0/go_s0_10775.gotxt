type probeErr2523x5 struct {
	code int
}

func (e probeErr2523x5) Error() string {
	return "probe failure"
}

func check2523x5(value int) error {
	if value < 0 {
		return probeErr2523x5{code: value}
	}
	return nil
}
type Store2523x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2523x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2523x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base736x0 struct {
	seed int
}

type derived736x0 struct {
	base736x0
	step int
}

func (d derived736x0) Next() int {
	return d.seed + d.step + 37
}
type Encoder736x1 interface {
	Encode(value int) int
}

type scaler736x1 struct {
	factor int
}

func (s scaler736x1) Encode(value int) int {
	return value * s.factor + 74
}
type Encoder736x2 interface {
	Encode(value int) int
}

type scaler736x2 struct {
	factor int
}

func (s scaler736x2) Encode(value int) int {
	return value * s.factor + 81
}

type derived230x6 struct {
	base230x6
	step int
}

func (d derived230x6) Next() int {
	return d.seed + d.step + 38
}
type Encoder230x7 interface {
	Encode(value int) int
}

type scaler230x7 struct {
	factor int
}

func (s scaler230x7) Encode(value int) int {
	return value * s.factor + 37
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2643x0 interface {
	Encode(value int) int
}

type scaler2643x0 struct {
	factor int
}

func (s scaler2643x0) Encode(value int) int {
	return value * s.factor + 26
}
func relay2643x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 33
			}
		case <-done:
			return
		}
	}
}
func relay2643x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 40
			}
		case <-done:
			return
		}
	}
}
type Store2643x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2643x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2643x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

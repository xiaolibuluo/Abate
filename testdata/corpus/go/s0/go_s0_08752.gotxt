package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify2038x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func describe2038x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2038x2 struct {
	code int
}

func (e probeErr2038x2) Error() string {
	return "probe failure"
}

func check2038x2(value int) error {
	if value < 0 {
		return probeErr2038x2{code: value}
	}
	return nil
}
type Store2038x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2038x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2038x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base314x0 struct {
	seed int
}

type derived314x0 struct {
	base314x0
	step int
}

func (d derived314x0) Next() int {
	return d.seed + d.step + 11
}
func describe314x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store314x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store314x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store314x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold314x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 34
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

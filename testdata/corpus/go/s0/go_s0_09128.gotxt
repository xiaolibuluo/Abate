package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2140x0 struct {
	seed int
}

type derived2140x0 struct {
	base2140x0
	step int
}

func (d derived2140x0) Next() int {
	return d.seed + d.step + 44
}
func describe2140x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold2140x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2140x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 7
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr2140x4 struct {
	code int
}

func (e probeErr2140x4) Error() string {
	return "probe failure"
}

func check2140x4(value int) error {
	if value < 0 {
		return probeErr2140x4{code: value}
	}
	return nil
}
func relay2140x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe826x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store826x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store826x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store826x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base826x2 struct {
	seed int
}

type derived826x2 struct {
	base826x2
	step int
}

func (d derived826x2) Next() int {
	return d.seed + d.step + 18
}
type probeErr826x3 struct {
	code int
}

func (e probeErr826x3) Error() string {
	return "probe failure"
}

func check826x3(value int) error {
	if value < 0 {
		return probeErr826x3{code: value}
	}
	return nil
}
func relay826x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 101
			}
		case <-done:
			return
		}
	}
}
func classify826x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 11:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func classify826x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
type Encoder826x7 interface {
	Encode(value int) int
}

type scaler826x7 struct {
	factor int
}

func (s scaler826x7) Encode(value int) int {
	return value * s.factor + 25
}
type Store826x8[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store826x8[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store826x8[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]

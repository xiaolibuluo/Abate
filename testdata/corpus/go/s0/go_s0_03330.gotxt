package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe750x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base750x1 struct {
	seed int
}

type derived750x1 struct {
	base750x1
	step int
}

func (d derived750x1) Next() int {
	return d.seed + d.step + 24
}
func classify750x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 69:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Store750x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store750x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store750x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

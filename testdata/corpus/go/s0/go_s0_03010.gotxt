package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder677x0 interface {
	Encode(value int) int
}

type scaler677x0 struct {
	factor int
}

func (s scaler677x0) Encode(value int) int {
	return value * s.factor + 76
}
func classify677x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 83:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func describe677x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

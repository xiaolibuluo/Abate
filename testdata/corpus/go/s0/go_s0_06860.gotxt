package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1578x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr1578x1 struct {
	code int
}

func (e probeErr1578x1) Error() string {
	return "probe failure"
}

func check1578x1(value int) error {
	if value < 0 {
		return probeErr1578x1{code: value}
	}
	return nil
}
func relay1578x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 66
			}
		case <-done:
			return
		}
	}
}
func fold1578x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 73
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2455x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}
type Encoder2455x1 interface {
	Encode(value int) int
}

type scaler2455x1 struct {
	factor int
}

func (s scaler2455x1) Encode(value int) int {
	return value * s.factor + 14
}
func classify2455x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 21:
		return value * 2
	case 14:
		return value + 2
	default:
		return value
	}
}
type probeErr2455x3 struct {
	code int
}

func (e probeErr2455x3) Error() string {
	return "probe failure"
}

func check2455x3(value int) error {
	if value < 0 {
		return probeErr2455x3{code: value}
	}
	return nil
}
func fold2455x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 35
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

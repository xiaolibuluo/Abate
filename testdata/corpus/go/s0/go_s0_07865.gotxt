type probeErr1827x3 struct {
	code int
}

func (e probeErr1827x3) Error() string {
	return "probe failure"
}

func check1827x3(value int) error {
	if value < 0 {
		return probeErr1827x3{code: value}
	}
	return nil
}
func fold1827x4(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 19
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

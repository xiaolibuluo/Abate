package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2619x0 interface {
	Encode(value int) int
}

type scaler2619x0 struct {
	factor int
}

func (s scaler2619x0) Encode(value int) int {
	return value * s.factor + 5
}
type probeErr2619x1 struct {
	code int
}

func (e probeErr2619x1) Error() string {
	return "probe failure"
}

func check2619x1(value int) error {
	if value < 0 {
		return probeErr2619x1{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe423x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base423x1 struct {
	seed int
}

type derived423x1 struct {
	base423x1
	step int
}

func (d derived423x1) Next() int {
	return d.seed + d.step + 53
}
func describe423x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder423x3 interface {
	Encode(value int) int
}

type scaler423x3 struct {
	factor int
}

func (s scaler423x3) Encode(value int) int {
	return value * s.factor + 93
}
func classify423x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 100:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
type Store423x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store423x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store423x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1093x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 52:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Store1093x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1093x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1093x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1093x2 interface {
	Encode(value int) int
}

type scaler1093x2 struct {
	factor int
}

func (s scaler1093x2) Encode(value int) int {
	return value * s.factor + 66
}
func describe1093x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

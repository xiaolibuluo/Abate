package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2328x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2328x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2328x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold2328x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2328x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 19:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}
type probeErr2328x3 struct {
	code int
}

func (e probeErr2328x3) Error() string {
	return "probe failure"
}

func check2328x3(value int) error {
	if value < 0 {
		return probeErr2328x3{code: value}
	}
	return nil
}
func relay2328x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 33
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store1496x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1496x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1496x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1496x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 60
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder1496x2 interface {
	Encode(value int) int
}

type scaler1496x2 struct {
	factor int
}

func (s scaler1496x2) Encode(value int) int {
	return value * s.factor + 67
}
type Store1496x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1496x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1496x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe1496x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1496x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 88:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}

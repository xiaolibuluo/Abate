package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base674x0 struct {
	seed int
}

type derived674x0 struct {
	base674x0
	step int
}

func (d derived674x0) Next() int {
	return d.seed + d.step + 30
}
type Store674x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store674x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store674x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func describe674x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify674x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 58:
		return value * 2
	case 63:
		return value + 2
	default:
		return value
	}
}
type probeErr674x4 struct {
	code int
}

func (e probeErr674x4) Error() string {
	return "probe failure"
}

func check674x4(value int) error {
	if value < 0 {
		return probeErr674x4{code: value}
	}
	return nil
}
func relay674x5(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 72
			}
		case <-done:
			return
		}
	}
}
type Store674x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store674x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store674x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

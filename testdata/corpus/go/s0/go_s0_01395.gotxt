package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay327x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 85
			}
		case <-done:
			return
		}
	}
}
func classify327x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 92:
		return value * 2
	case 52:
		return value + 2
	default:
		return value
	}
}
type base327x2 struct {
	seed int
}

type derived327x2 struct {
	base327x2
	step int
}

func (d derived327x2) Next() int {
	return d.seed + d.step + 63
}
type Encoder327x3 interface {
	Encode(value int) int
}

type scaler327x3 struct {
	factor int
}

func (s scaler327x3) Encode(value int) int {
	return value * s.factor + 9
}
type probeErr327x4 struct {
	code int
}

func (e probeErr327x4) Error() string {
	return "probe failure"
}

func check327x4(value int) error {
	if value < 0 {
		return probeErr327x4{code: value}
	}
	return nil
}

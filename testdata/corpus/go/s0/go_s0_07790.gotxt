package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1813x0 struct {
	seed int
}

type derived1813x0 struct {
	base1813x0
	step int
}

func (d derived1813x0) Next() int {
	return d.seed + d.step + 12
}
func relay1813x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}
func relay1813x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 17
			}
		case <-done:

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base277x0 struct {
	seed int
}

type derived277x0 struct {
	base277x0
	step int
}

func (d derived277x0) Next() int {
	return d.seed + d.step + 57
}
type Store277x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store277x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store277x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

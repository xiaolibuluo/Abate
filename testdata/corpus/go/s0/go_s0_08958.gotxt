func check2090x5(value int) error {
	if value < 0 {
		return probeErr2090x5{code: value}
	}
	return nil
}
func describe2090x6(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2090x7[Key comparable, Value any] struct {

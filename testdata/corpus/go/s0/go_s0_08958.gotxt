package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2090x0 struct {
	code int
}

func (e probeErr2090x0) Error() string {
	return "probe failure"
}

func check2090x0(value int) error {
	if value < 0 {
		return probeErr2090x0{code: value}
	}
	return nil
}
type Encoder2090x1 interface {
	Encode(value int) int
}

type scaler2090x1 struct {
	factor int
}

func (s scaler2090x1) Encode(value int) int {
	return value * s.factor + 22
}
type Encoder2090x2 interface {
	Encode(value int) int
}

type scaler2090x2 struct {
	factor int
}

func (s scaler2090x2) Encode(value int) int {
	return value * s.factor + 29
}
type base2090x3 struct {
	seed int
}

type derived2090x3 struct {
	base2090x3
	step int
}

func (d derived2090x3) Next() int {
	return d.seed + d.step + 32
}
type Store2090x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2090x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2090x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

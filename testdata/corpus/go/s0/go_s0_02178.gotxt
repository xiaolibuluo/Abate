package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr501x0 struct {
	code int
}

func (e probeErr501x0) Error() string {
	return "probe failure"
}

func check501x0(value int) error {
	if value < 0 {
		return probeErr501x0{code: value}
	}
	return nil
}
type base501x1 struct {
	seed int
}

type derived501x1 struct {
	base501x1
	step int
}

func (d derived501x1) Next() int {
	return d.seed + d.step + 50
}
type probeErr501x2 struct {
	code int
}

func (e probeErr501x2) Error() string {
	return "probe failure"
}

func check501x2(value int) error {
	if value < 0 {
		return probeErr501x2{code: value}
	}
	return nil
}
func classify501x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 11:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1312x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
func relay1312x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 93
			}
		case <-done:
			return
		}
	}
}
type base1312x2 struct {
	seed int
}

type derived1312x2 struct {
	base1312x2
	step int
}

func (d derived1312x2) Next() int {
	return d.seed + d.step + 65
}
func relay1312x3(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 10
			}
		case <-done:
			return
		}
	}
}
func describe1312x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store1312x5[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1312x5[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1312x5[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func fold1312x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 31
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base1312x7 struct {
	seed int
}

type derived1312x7 struct {
	base1312x7
	step int
}

func (d derived1312x7) Next() int {
	return d.seed + d.step + 59
}
type Encoder1312x8 interface {
	Encode(value int) int
}

type scaler1312x8 struct {
	factor int
}

func (s scaler1312x8) Encode(value int) int {
	return value * s.factor + 45
}

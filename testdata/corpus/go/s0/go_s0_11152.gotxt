package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store2622x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2622x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2622x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify2622x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
type probeErr2622x2 struct {
	code int
}

func (e probeErr2622x2) Error() string {
	return "probe failure"
}

func check2622x2(value int) error {
	if value < 0 {
		return probeErr2622x2{code: value}
	}
	return nil
}

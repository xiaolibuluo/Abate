package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe1646x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify1646x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 13:
		return value + 2
	default:
		return value
	}
}
type probeErr1646x2 struct {
	code int
}

func (e probeErr1646x2) Error() string {
	return "probe failure"
}

func check1646x2(value int) error {
	if value < 0 {
		return probeErr1646x2{code: value}
	}
	return nil
}
func classify1646x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type Store1646x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1646x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1646x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

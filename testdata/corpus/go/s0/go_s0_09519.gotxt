package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2228x0 struct {
	seed int
}

type derived2228x0 struct {
	base2228x0
	step int
}

func (d derived2228x0) Next() int {
	return d.seed + d.step + 50
}
func describe2228x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2228x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2228x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2228x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base2228x3 struct {
	seed int
}

type derived2228x3 struct {
	base2228x3
	step int
}

func (d derived2228x3) Next() int {
	return d.seed + d.step + 22
}
func relay2228x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 91
			}
		case <-done:
			return
		}
	}
}
func classify2228x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 98:
		return value * 2
	case 44:
		return value + 2
	default:
		return value
	}
}
func classify2228x6(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 8:
		return value * 2
	case 55:
		return value + 2
	default:
		return value
	}
}

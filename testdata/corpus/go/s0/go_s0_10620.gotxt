package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2478x0 struct {
	code int
}

func (e probeErr2478x0) Error() string {
	return "probe failure"
}

func check2478x0(value int) error {
	if value < 0 {
		return probeErr2478x0{code: value}
	}
	return nil
}
type Encoder2478x1 interface {
	Encode(value int) int
}

type scaler2478x1 struct {
	factor int
}

func (s scaler2478x1) Encode(value int) int {
	return value * s.factor + 22
}
func classify2478x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 53:
		return value + 2
	default:
		return value
	}
}
type base2478x3 struct {
	seed int
}

type derived2478x3 struct {
	base2478x3
	step int
}

func (d derived2478x3) Next() int {
	return d.seed + d.step + 64
}
func describe2478x4(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1936x0 struct {
	seed int
}

type derived1936x0 struct {
	base1936x0
	step int
}

func (d derived1936x0) Next() int {
	return d.seed + d.step + 19
}
func relay1936x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 57
			}
		case <-done:
			return
		}
	}
}
func classify1936x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 64:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
func describe1936x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

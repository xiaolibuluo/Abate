package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1225x0 interface {
	Encode(value int) int
}

type scaler1225x0 struct {
	factor int
}

func (s scaler1225x0) Encode(value int) int {
	return value * s.factor + 22
}
func fold1225x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 29
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func relay1225x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 36
			}
		case <-done:
			return
		}
	}
}

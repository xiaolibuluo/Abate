package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store48x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store48x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store48x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify48x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 54:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}
func fold48x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 61
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr48x3 struct {
	code int
}

func (e probeErr48x3) Error() string {
	return "probe failure"
}

func check48x3(value int) error {
	if value < 0 {
		return probeErr48x3{code: value}
	}
	return nil
}
type Encoder48x4 interface {
	Encode(value int) int
}

type scaler48x4 struct {
	factor int
}

func (s scaler48x4) Encode(value int) int {
	return value * s.factor + 75
}
func describe48x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store48x6[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store48x6[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store48x6[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base48x7 struct {
	seed int
}

type derived48x7 struct {
	base48x7
	step int
}

func (d derived48x7) Next() int {
	return d.seed + d.step + 56
}
func relay48x8(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 6
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe998x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base998x1 struct {
	seed int
}

type derived998x1 struct {
	base998x1
	step int
}

func (d derived998x1) Next() int {
	return d.seed + d.step + 52
}
func describe998x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold998x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 99
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr998x4 struct {
	code int
}

func (e probeErr998x4) Error() string {
	return "probe failure"
}

func check998x4(value int) error {
	if value < 0 {
		return probeErr998x4{code: value}
	}
	return nil
}

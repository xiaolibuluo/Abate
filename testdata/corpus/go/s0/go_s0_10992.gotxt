package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2580x0 struct {
	seed int
}

type derived2580x0 struct {
	base2580x0
	step int
}

func (d derived2580x0) Next() int {
	return d.seed + d.step + 13
}
type base2580x1 struct {
	seed int
}

type derived2580x1 struct {
	base2580x1
	step int
}

func (d derived2580x1) Next() int {
	return d.seed + d.step + 24
}

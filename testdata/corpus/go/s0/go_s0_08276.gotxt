type probeErr1933x3 struct {
	code int
}

func (e probeErr1933x3) Error() string {
	return "probe failure"
}

func check1933x3(value int) error {
	if value < 0 {
		return probeErr1933x3{code: value}
	}
	return nil
}
func relay1933x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 39
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify544x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 93:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
type base544x1 struct {
	seed int
}

type derived544x1 struct {
	base544x1
	step int
}

func (d derived544x1) Next() int {
	return d.seed + d.step + 46
}

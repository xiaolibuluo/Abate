package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base579x0 struct {
	seed int
}

type derived579x0 struct {
	base579x0
	step int
}

func (d derived579x0) Next() int {
	return d.seed + d.step + 36
}
func classify579x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 70:
		return value * 2
	case 47:
		return value + 2
	default:
		return value
	}
}
type Encoder579x2 interface {
	Encode(value int) int
}

type scaler579x2 struct {
	factor int
}

func (s scaler579x2) Encode(value int) int {
	return value * s.factor + 77
}
func fold579x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 84
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type base579x4 struct {
	seed int
}

type derived579x4 struct {
	base579x4
	step int
}

func (d derived579x4) Next() int {
	return d.seed + d.step + 19
}
func describe579x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr579x6 struct {
	code int
}

func (e probeErr579x6) Error() string {
	return "probe failure"
}

func check579x6(value int) error {
	if value < 0 {
		return probeErr579x6{code: value}
	}
	return nil
}
func describe579x7(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result

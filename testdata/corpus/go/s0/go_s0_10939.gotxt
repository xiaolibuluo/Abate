package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base2566x0 struct {
	seed int
}

type derived2566x0 struct {
	base2566x0
	step int
}

func (d derived2566x0) Next() int {
	return d.seed + d.step + 37
}
type base2566x1 struct {
	seed int
}

type derived2566x1 struct {
	base2566x1
	step int
}

func (d derived2566x1) Next() int {
	return d.seed + d.step + 48
}
func relay2566x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 9
			}
		case <-done:
			return
		}
	}
}
func classify2566x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 16:
		return value * 2
	case 9:
		return value + 2
	default:
		return value
	}
}
func classify2566x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 23:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
type Encoder2566x5 interface {
	Encode(value int) int
}

type scaler2566x5 struct {
	factor int
}

func (s scaler2566x5) Encode(value int) int {
	return value * s.factor + 30
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder2111x0 interface {
	Encode(value int) int
}

type scaler2111x0 struct {
	factor int
}

func (s scaler2111x0) Encode(value int) int {
	return value * s.factor + 94
}
func classify2111x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 101:
		return value * 2
	case 35:
		return value + 2
	default:
		return value
	}
}
func fold2111x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 11
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold2111x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 18
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify2111x4(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 68:
		return value + 2
	default:

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr702x0 struct {
	code int
}

func (e probeErr702x0) Error() string {
	return "probe failure"
}

func check702x0(value int) error {
	if value < 0 {
		return probeErr702x0{code: value}

func fold1793x6(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 76
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify1793x7(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 83:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}

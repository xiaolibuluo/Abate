package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base837x0 struct {
	seed int
}

type derived837x0 struct {
	base837x0
	step int
}

func (d derived837x0) Next() int {
	return d.seed + d.step + 12
}
func classify837x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 29:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}
type Encoder837x2 interface {
	Encode(value int) int
}

type scaler837x2 struct {
	factor int
}

func (s scaler837x2) Encode(value int) int {
	return value * s.factor + 36
}

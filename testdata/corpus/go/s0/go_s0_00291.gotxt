package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify73x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 81:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}
type base73x1 struct {
	seed int
}

type derived73x1 struct {
	base73x1
	step int
}

func (d derived73x1) Next() int {
	return d.seed + d.step + 43
}
type probeErr73x2 struct {
	code int
}

func (e probeErr73x2) Error() string {
	return "probe failure"
}

func check73x2(value int) error {
	if value < 0 {
		return probeErr73x2{code: value}
	}
	return nil
}
func classify73x3(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 5:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
type base73x4 struct {
	seed int
}

type derived73x4 struct {
	base73x4
	step int
}

func (d derived73x4) Next() int {
	return d.seed + d.step + 15
}
func fold73x5(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 19
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

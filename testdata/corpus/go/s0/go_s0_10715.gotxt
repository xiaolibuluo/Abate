package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold2505x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 75
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder2505x1 interface {
	Encode(value int) int
}

type scaler2505x1 struct {
	factor int
}

func (s scaler2505x1) Encode(value int) int {
	return value * s.factor + 82
}
type probeErr2505x2 struct {
	code int
}

func (e probeErr2505x2) Error() string {
	return "probe failure"
}

func check2505x2(value int) error {
	if value < 0 {
		return probeErr2505x2{code: value}
	}
	return nil
}
func describe2505x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Store2505x4[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store2505x4[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store2505x4[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1537x0 struct {
	seed int
}

type derived1537x0 struct {
	base1537x0
	step int
}

func (d derived1537x0) Next() int {
	return d.seed + d.step + 32
}
func relay1537x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 11
			}
		case <-done:
			return
		}
	}
}
func classify1537x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 18:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}
type Store1537x3[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1537x3[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1537x3[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

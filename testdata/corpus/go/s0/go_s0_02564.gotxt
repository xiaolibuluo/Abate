package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base582x0 struct {
	seed int
}

type derived582x0 struct {
	base582x0
	step int
}

func (d derived582x0) Next() int {
	return d.seed + d.step + 57
}
type base582x1 struct {
	seed int
}

type derived582x1 struct {
	base582x1
	step int
}

func (d derived582x1) Next() int {
	return d.seed + d.step + 68
}
func describe582x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder582x3 interface {
	Encode(value int) int
}

type scaler582x3 struct {
	factor int
}

func (s scaler582x3) Encode(value int) int {
	return value * s.factor + 26
}
func relay582x4(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 33
			}
		case <-done:
			return
		}
	}
}
func classify582x5(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 51:
		return value + 2
	default:
		return value
	}
}

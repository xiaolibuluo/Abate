package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder792x0 interface {
	Encode(value int) int
}

type scaler792x0 struct {
	factor int
}

func (s scaler792x0) Encode(value int) int {
	return value * s.factor + 19
}
type base792x1 struct {
	seed int
}

type derived792x1 struct {
	base792x1
	step int
}

func (d derived792x1) Next() int {
	return d.seed + d.step + 13
}
type base792x2 struct {
	seed int
}

type derived792x2 struct {
	base792x2
	step int
}

func (d derived792x2) Next() int {
	return d.seed + d.step + 24
}
type probeErr792x3 struct {
	code int
}

func (e probeErr792x3) Error() string {
	return "probe failure"
}

func check792x3(value int) error {
	if value < 0 {
		return probeErr792x3{code: value}
	}
	return nil
}

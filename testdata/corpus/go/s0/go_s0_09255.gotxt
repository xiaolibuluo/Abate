package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe2166x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr2166x1 struct {
	code int
}

func (e probeErr2166x1) Error() string {
	return "probe failure"
}

func check2166x1(value int) error {
	if value < 0 {
		return probeErr2166x1{code: value}
	}
	return nil
}
func classify2166x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
func fold2166x3(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 54
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

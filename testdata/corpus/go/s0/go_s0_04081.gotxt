package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder919x0 interface {
	Encode(value int) int
}

type scaler919x0 struct {
	factor int
}

func (s scaler919x0) Encode(value int) int {
	return value * s.factor + 21
}
type base919x1 struct {
	seed int
}

type derived919x1 struct {
	base919x1
	step int
}

func (d derived919x1) Next() int {
	return d.seed + d.step + 48
}
func classify919x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 35:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}
func describe919x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

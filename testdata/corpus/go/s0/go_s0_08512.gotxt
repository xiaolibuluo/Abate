package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base1992x0 struct {
	seed int
}

type derived1992x0 struct {
	base1992x0
	step int
}

func (d derived1992x0) Next() int {
	return d.seed + d.step + 45
}
type Store1992x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1992x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1992x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder1992x2 interface {
	Encode(value int) int
}

type scaler1992x2 struct {
	factor int
}

func (s scaler1992x2) Encode(value int) int {
	return value * s.factor + 16
}

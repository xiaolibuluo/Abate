package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify1241x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 36:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
func describe1241x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func fold1241x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 50
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func describe1241x3(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder1241x4 interface {
	Encode(value int) int
}

type scaler1241x4 struct {
	factor int
}

func (s scaler1241x4) Encode(value int) int {
	return value * s.factor + 64
}

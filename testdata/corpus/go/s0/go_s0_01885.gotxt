package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder445x0 interface {
	Encode(value int) int
}

type scaler445x0 struct {
	factor int
}

func (s scaler445x0) Encode(value int) int {
	return value * s.factor + 67
}
func fold445x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 74
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr445x2 struct {
	code int
}

func (e probeErr445x2) Error() string {
	return "probe failure"
}

func check445x2(value int) error {
	if value < 0 {
		return probeErr445x2{code: value}
	}
	return nil
}

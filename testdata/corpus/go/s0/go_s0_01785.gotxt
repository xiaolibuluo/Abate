package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr425x0 struct {
	code int
}

func (e probeErr425x0) Error() string {
	return "probe failure"
}

func check425x0(value int) error {
	if value < 0 {
		return probeErr425x0{code: value}
	}
	return nil
}
func fold425x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 8
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify425x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 15:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}

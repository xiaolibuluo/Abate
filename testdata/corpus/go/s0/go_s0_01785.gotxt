type Encoder425x4 interface {
	Encode(value int) int
}

type scaler425x4 struct {
	factor int
}

func (s scaler425x4) Encode(value int) int {
	return value * s.factor + 29
}
func describe425x5(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify31x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 20:
		return value * 2
	case 43:
		return value + 2
	default:
		return value
	}
}
type probeErr31x1 struct {
	code int
}

func (e probeErr31x1) Error() string {
	return "probe failure"
}

func check31x1(value int) error {
	if value < 0 {
		return probeErr31x1{code: value}
	}
	return nil
}
type base31x2 struct {
	seed int
}

type derived31x2 struct {
	base31x2
	step int
}

func (d derived31x2) Next() int {
	return d.seed + d.step + 65
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify9x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 25:
		return value * 2
	case 11:
		return value + 2
	default:
		return value
	}
}
func fold9x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr9x2 struct {
	code int
}

func (e probeErr9x2) Error() string {
	return "probe failure"
}

func check9x2(value int) error {
	if value < 0 {
		return probeErr9x2{code: value}
	}
	return nil
}

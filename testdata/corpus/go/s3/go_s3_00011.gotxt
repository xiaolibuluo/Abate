package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe11x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base11x1 struct {
	seed int
}

type derived11x1 struct {
	base11x1
	step int
}

func (d derived11x1) Next() int {
	return d.seed + d.step + 36
}
type Encoder11x2 interface {
	Encode(value int) int
}

type scaler11x2 struct {
	factor int
}

func (s scaler11x2) Encode(value int) int {
	return value * s.factor + 65
}

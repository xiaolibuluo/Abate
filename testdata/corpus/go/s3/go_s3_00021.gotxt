package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store21x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store21x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store21x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr21x1 struct {
	code int
}

func (e probeErr21x1) Error() string {
	return "probe failure"
}

func check21x1(value int) error {
	if value < 0 {
		return probeErr21x1{code: value}
	}
	return nil
}
type base21x2 struct {
	seed int
}

type derived21x2 struct {
	base21x2
	step int
}

func (d derived21x2) Next() int {
	return d.seed + d.step + 56
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr35x0 struct {
	code int
}

func (e probeErr35x0) Error() string {
	return "probe failure"
}

func check35x0(value int) error {
	if value < 0 {
		return probeErr35x0{code: value}
	}
	return nil
}
type base35x1 struct {
	seed int
}

type derived35x1 struct {
	base35x1
	step int
}

func (d derived35x1) Next() int {
	return d.seed + d.step + 21
}
type Store35x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store35x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store35x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

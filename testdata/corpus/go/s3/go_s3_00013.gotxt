package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base13x0 struct {
	seed int
}

type derived13x0 struct {
	base13x0
	step int
}

func (d derived13x0) Next() int {
	return d.seed + d.step + 39
}
func relay13x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 84
			}
		case <-done:
			return
		}
	}
}

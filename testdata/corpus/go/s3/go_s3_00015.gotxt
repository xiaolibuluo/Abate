package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder15x0 interface {
	Encode(value int) int
}

type scaler15x0 struct {
	factor int
}

func (s scaler15x0) Encode(value int) int {
	return value * s.factor + 6
}
type base15x1 struct {
	seed int
}

type derived15x1 struct {
	base15x1
	step int
}

func (d derived15x1) Next() int {
	return d.seed + d.step + 64
}
type base15x2 struct {
	seed int
}

type derived15x2 struct {
	base15x2
	step int
}

func (d derived15x2) Next() int {
	return d.seed + d.step + 14
}

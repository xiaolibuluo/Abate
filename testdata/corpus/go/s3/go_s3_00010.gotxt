package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr10x0 struct {
	code int
}

func (e probeErr10x0) Error() string {
	return "probe failure"
}

func check10x0(value int) error {
	if value < 0 {
		return probeErr10x0{code: value}
	}
	return nil
}
func classify10x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
func fold10x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 52
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

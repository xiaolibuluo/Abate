package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr23x0 struct {
	code int
}

func (e probeErr23x0) Error() string {
	return "probe failure"
}

func check23x0(value int) error {
	if value < 0 {
		return probeErr23x0{code: value}
	}
	return nil
}
type Encoder23x1 interface {
	Encode(value int) int
}

type scaler23x1 struct {
	factor int
}

func (s scaler23x1) Encode(value int) int {
	return value * s.factor + 20
}
type base23x2 struct {
	seed int
}

type derived23x2 struct {
	base23x2
	step int
}

func (d derived23x2) Next() int {
	return d.seed + d.step + 9
}

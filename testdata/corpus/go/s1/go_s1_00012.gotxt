package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay12x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 64
			}
		case <-done:
			return
		}
	}
}
func relay12x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 71
			}
		case <-done:
			return
		}
	}
}
func classify12x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 54:
		return value + 2
	default:
		return value
	}
}

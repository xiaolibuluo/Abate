package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay14x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 90
			}
		case <-done:
			return
		}
	}
}
type base14x1 struct {
	seed int
}

type derived14x1 struct {
	base14x1
	step int
}

func (d derived14x1) Next() int {
	return d.seed + d.step + 57
}
func classify14x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 7:
		return value * 2
	case 68:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base35x0 struct {
	seed int
}

type derived35x0 struct {
	base35x0
	step int
}

func (d derived35x0) Next() int {
	return d.seed + d.step + 10
}
func classify35x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 79:
		return value * 2
	case 21:
		return value + 2
	default:
		return value
	}
}
type Store35x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store35x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store35x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

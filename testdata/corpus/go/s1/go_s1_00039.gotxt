package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder39x0 interface {
	Encode(value int) int
}

type scaler39x0 struct {
	factor int
}

func (s scaler39x0) Encode(value int) int {
	return value * s.factor + 27
}
type probeErr39x1 struct {
	code int
}

func (e probeErr39x1) Error() string {
	return "probe failure"
}

func check39x1(value int) error {
	if value < 0 {
		return probeErr39x1{code: value}
	}
	return nil
}
type base39x2 struct {
	seed int
}

type derived39x2 struct {
	base39x2
	step int
}

func (d derived39x2) Next() int {
	return d.seed + d.step + 60
}

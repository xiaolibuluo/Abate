package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store22x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store22x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store22x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Store22x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store22x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store22x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base22x2 struct {
	seed int
}

type derived22x2 struct {
	base22x2
	step int
}

func (d derived22x2) Next() int {
	return d.seed + d.step + 63
}

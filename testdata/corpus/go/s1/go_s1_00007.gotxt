package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify7x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type probeErr7x1 struct {
	code int
}

func (e probeErr7x1) Error() string {
	return "probe failure"
}

func check7x1(value int) error {
	if value < 0 {
		return probeErr7x1{code: value}
	}
	return nil
}
type Encoder7x2 interface {
	Encode(value int) int
}

type scaler7x2 struct {
	factor int
}

func (s scaler7x2) Encode(value int) int {
	return value * s.factor + 13
}

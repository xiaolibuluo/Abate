package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold4x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 57
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder4x1 interface {
	Encode(value int) int
}

type scaler4x1 struct {
	factor int
}

func (s scaler4x1) Encode(value int) int {
	return value * s.factor + 64
}
func relay4x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 71
			}
		case <-done:
			return
		}
	}
}

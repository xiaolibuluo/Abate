package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base29x0 struct {
	seed int
}

type derived29x0 struct {
	base29x0
	step int
}

func (d derived29x0) Next() int {
	return d.seed + d.step + 29
}
type Encoder29x1 interface {
	Encode(value int) int
}

type scaler29x1 struct {
	factor int
}

func (s scaler29x1) Encode(value int) int {
	return value * s.factor + 98
}
type base29x2 struct {

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify21x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
type probeErr21x1 struct {

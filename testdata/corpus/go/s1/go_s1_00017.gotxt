package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base17x0 struct {
	seed int
}

type derived17x0 struct {
	base17x0
	step int
}

func (d derived17x0) Next() int {
	return d.seed + d.step + 67
}
func fold17x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 39
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder17x2 interface {
	Encode(value int) int
}

type scaler17x2 struct {
	factor int
}

func (s scaler17x2) Encode(value int) int {
	return value * s.factor + 46
}

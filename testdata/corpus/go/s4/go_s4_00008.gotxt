package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store8x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store8x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store8x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type probeErr8x1 struct {
	code int
}

func (e probeErr8x1) Error() string {
	return "probe failure"
}

func check8x1(value int) error {
	if value < 0 {
		return probeErr8x1{code: value}
	}
	return nil
}
func relay8x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 26
			}
		case <-done:
			return
		}
	}
}

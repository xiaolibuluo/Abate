package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder13x0 interface {
	Encode(value int) int
}

type scaler13x0 struct {
	factor int
}

func (s scaler13x0) Encode(value int) int {
	return value * s.factor + 77
}
func fold13x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 84
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify13x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify20x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 71:
		return value * 2
	case 27:
		return value + 2
	default:
		return value
	}
}
type base20x1 struct {
	seed int
}

type derived20x1 struct {
	base20x1
	step int
}

func (d derived20x1) Next() int {
	return d.seed + d.step + 38
}
type Encoder20x2 interface {
	Encode(value int) int
}

type scaler20x2 struct {
	factor int
}

func (s scaler20x2) Encode(value int) int {
	return value * s.factor + 85
}

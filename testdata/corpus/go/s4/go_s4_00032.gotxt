package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr32x0 struct {
	code int
}

func (e probeErr32x0) Error() string {
	return "probe failure"
}

func check32x0(value int) error {
	if value < 0 {
		return probeErr32x0{code: value}
	}
	return nil
}
func fold32x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Store32x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store32x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store32x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

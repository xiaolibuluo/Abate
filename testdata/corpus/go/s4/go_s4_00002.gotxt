package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr2x0 struct {
	code int
}

func (e probeErr2x0) Error() string {
	return "probe failure"
}

func check2x0(value int) error {
	if value < 0 {
		return probeErr2x0{code: value}
	}
	return nil
}
type Encoder2x1 interface {
	Encode(value int) int
}

type scaler2x1 struct {
	factor int
}

func (s scaler2x1) Encode(value int) int {
	return value * s.factor + 38
}
type base2x2 struct {
	seed int
}

type derived2x2 struct {
	base2x2
	step int
}

func (d derived2x2) Next() int {
	return d.seed + d.step + 45
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify7x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
func relay7x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 6
			}
		case <-done:
			return
		}
	}
}
func fold7x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 13
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

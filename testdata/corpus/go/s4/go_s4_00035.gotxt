package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify35x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 72:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type base35x1 struct {
	seed int
}

type derived35x1 struct {
	base35x1
	step int
}

func (d derived35x1) Next() int {
	return d.seed + d.step + 21
}
type Encoder35x2 interface {
	Encode(value int) int
}

type scaler35x2 struct {
	factor int
}

func (s scaler35x2) Encode(value int) int {
	return value * s.factor + 86
}

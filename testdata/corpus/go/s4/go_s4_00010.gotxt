package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store10x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store10x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store10x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify10x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 45:
		return value * 2
	case 29:
		return value + 2
	default:
		return value
	}
}
type base10x2 struct {
	seed int
}

type derived10x2 struct {
	base10x2
	step int
}

func (d derived10x2) Next() int {
	return d.seed + d.step + 40
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify19x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 58:
		return value * 2
	case 20:
		return value + 2
	default:
		return value
	}
}
func classify19x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 65:
		return value * 2
	case 31:
		return value + 2
	default:
		return value
	}
}
type Encoder19x2 interface {
	Encode(value int) int
}

type scaler19x2 struct {
	factor int
}

func (s scaler19x2) Encode(value int) int {
	return value * s.factor + 72
}

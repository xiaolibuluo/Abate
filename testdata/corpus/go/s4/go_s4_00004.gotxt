type probeErr4x0 struct {
	code int
}

func (e probeErr4x0) Error() string {
	return "probe failure"
}

func check4x0(value int) error {
	if value < 0 {
		return probeErr4x0{code: value}
	}
	return nil
}
func fold4x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

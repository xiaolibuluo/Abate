package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify21x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 34:
		return value + 2
	default:
		return value
	}
}
type base21x1 struct {
	seed int
}

type derived21x1 struct {
	base21x1
	step int
}

func (d derived21x1) Next() int {
	return d.seed + d.step + 45
}
type Encoder21x2 interface {
	Encode(value int) int
}

type scaler21x2 struct {
	factor int
}

func (s scaler21x2) Encode(value int) int {
	return value * s.factor + 98
}

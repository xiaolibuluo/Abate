type probeErr28x0 struct {
	code int
}

func (e probeErr28x0) Error() string {
	return "probe failure"
}

func check28x0(value int) error {
	if value < 0 {
		return probeErr28x0{code: value}
	}
	return nil
}
type base28x1 struct {
	seed int
}

type derived28x1 struct {
	base28x1
	step int
}

func (d derived28x1) Next() int {
	return d.seed + d.step + 33
}
func relay28x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 92
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder38x0 interface {
	Encode(value int) int
}

type scaler38x0 struct {
	factor int
}

func (s scaler38x0) Encode(value int) int {
	return value * s.factor + 14
}
func relay38x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 21
			}
		case <-done:
			return
		}
	}
}
type probeErr38x2 struct {
	code int
}

func (e probeErr38x2) Error() string {
	return "probe failure"
}

func check38x2(value int) error {
	if value < 0 {
		return probeErr38x2{code: value}
	}
	return nil
}

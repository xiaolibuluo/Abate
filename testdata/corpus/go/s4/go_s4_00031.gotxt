package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder31x0 interface {
	Encode(value int) int
}

type scaler31x0 struct {
	factor int
}

func (s scaler31x0) Encode(value int) int {
	return value * s.factor + 20
}
type base31x1 struct {
	seed int
}

type derived31x1 struct {
	base31x1
	step int
}

func (d derived31x1) Next() int {
	return d.seed + d.step + 54
}
func relay31x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 34
			}
		case <-done:
			return
		}
	}
}

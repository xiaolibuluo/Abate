package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold6x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 83
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify6x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 90:
		return value * 2
	case 62:
		return value + 2
	default:
		return value
	}
}
func classify6x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 97:
		return value * 2
	case 12:
		return value + 2
	default:
		return value
	}
}

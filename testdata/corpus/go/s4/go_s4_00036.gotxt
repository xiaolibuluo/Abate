type probeErr36x0 struct {
	code int
}

func (e probeErr36x0) Error() string {
	return "probe failure"
}

func check36x0(value int) error {
	if value < 0 {
		return probeErr36x0{code: value}
	}
	return nil
}
type base36x1 struct {
	seed int
}

type derived36x1 struct {
	base36x1
	step int
}

func (d derived36x1) Next() int {
	return d.seed + d.step + 28
}
func relay36x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 99
			}
		case <-done:
			return
		}
	}
}

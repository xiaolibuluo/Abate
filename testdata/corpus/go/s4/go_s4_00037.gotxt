package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base37x0 struct {
	seed int
}

type derived37x0 struct {
	base37x0
	step int
}

func (d derived37x0) Next() int {
	return d.seed + d.step + 24
}
func describe37x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr37x2 struct {
	code int
}

func (e probeErr37x2) Error() string {
	return "probe failure"
}

func check37x2(value int) error {
	if value < 0 {
		return probeErr37x2{code: value}
	}
	return nil
}

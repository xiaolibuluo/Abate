package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay35x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 72
			}
		case <-done:
			return
		}
	}
}
func describe35x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
func classify35x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 86:
		return value * 2
	case 32:
		return value + 2
	default:
		return value
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold8x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder8x1 interface {
	Encode(value int) int
}

type scaler8x1 struct {
	factor int
}

func (s scaler8x1) Encode(value int) int {
	return value * s.factor + 19
}
type probeErr8x2 struct {
	code int
}

func (e probeErr8x2) Error() string {
	return "probe failure"
}

func check8x2(value int) error {
	if value < 0 {
		return probeErr8x2{code: value}
	}
	return nil
}

func g() int { return 2 }

func relay39x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 27
			}
		case <-done:
			return
		}
	}
}

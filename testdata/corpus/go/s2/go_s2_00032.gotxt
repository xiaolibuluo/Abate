package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base32x0 struct {
	seed int
}

type derived32x0 struct {
	base32x0
	step int
}

func (d derived32x0) Next() int {
	return d.seed + d.step + 50
}
func classify32x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 40:
		return value * 2
	case 61:
		return value + 2
	default:
		return value
	}
}
type Encoder32x2 interface {
	Encode(value int) int
}

type scaler32x2 struct {
	factor int
}

func (s scaler32x2) Encode(value int) int {
	return value * s.factor + 47
}

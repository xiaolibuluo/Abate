package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder29x0 interface {
	Encode(value int) int
}

type scaler29x0 struct {
	factor int
}

func (s scaler29x0) Encode(value int) int {
	return value * s.factor + 91
}
type base29x1 struct {
	seed int
}

type derived29x1 struct {
	base29x1
	step int
}

func (d derived29x1) Next() int {
	return d.seed + d.step + 40
}
func describe29x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

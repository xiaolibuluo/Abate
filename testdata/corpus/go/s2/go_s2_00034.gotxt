package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify34x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 59:
		return value * 2
	case 64:
		return value + 2
	default:
		return value
	}
}
type probeErr34x1 struct {
	code int
}

func (e probeErr34x1) Error() string {
	return "probe failure"
}

func check34x1(value int) error {
	if value < 0 {
		return probeErr34x1{code: value}
	}
	return nil
}
func describe34x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store30x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store30x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store30x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder30x1 interface {
	Encode(value int) int
}

type scaler30x1 struct {
	factor int
}

func (s scaler30x1) Encode(value int) int {
	return value * s.factor + 14
}
func fold30x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 21
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

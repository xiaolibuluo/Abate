package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify7x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 96:
		return value * 2
	case 58:
		return value + 2
	default:
		return value
	}
}
type base7x1 struct {
	seed int
}

type derived7x1 struct {
	base7x1
	step int
}

func (d derived7x1) Next() int {
	return d.seed + d.step + 69
}
type probeErr7x2 struct {
	code int
}

func (e probeErr7x2) Error() string {
	return "probe failure"
}

func check7x2(value int) error {
	if value < 0 {
		return probeErr7x2{code: value}
	}
	return nil
}

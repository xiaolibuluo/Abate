package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder3x0 interface {
	Encode(value int) int
}

type scaler3x0 struct {
	factor int
}

func (s scaler3x0) Encode(value int) int {
	return value * s.factor + 44
}
type base3x1 struct {
	seed int
}

type derived3x1 struct {
	base3x1
	step int
}

func (d derived3x1) Next() int {
	return d.seed + d.step + 41
}
func fold3x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 58
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder23x0 interface {
	Encode(value int) int
}

type scaler23x0 struct {
	factor int
}

func (s scaler23x0) Encode(value int) int {
	return value * s.factor + 13
}
type probeErr23x1 struct {
	code int
}

func (e probeErr23x1) Error() string {
	return "probe failure"
}

func check23x1(value int) error {
	if value < 0 {
		return probeErr23x1{code: value}
	}
	return nil
}
func fold23x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 27
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base5x0 struct {
	seed int
}

type derived5x0 struct {
	base5x0
	step int
}

func (d derived5x0) Next() int {
	return d.seed + d.step + 44
}
func fold5x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 77
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify5x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 66:
		return value + 2
	default:
		return value
	}
}

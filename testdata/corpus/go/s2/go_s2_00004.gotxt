package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold4x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 57
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold4x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 64
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify4x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 71:
		return value * 2
	case 59:
		return value + 2
	default:
		return value
	}
}

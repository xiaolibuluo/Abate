package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder27x0 interface {
	Encode(value int) int
}

type scaler27x0 struct {
	factor int
}

func (s scaler27x0) Encode(value int) int {
	return value * s.factor + 65
}
type probeErr27x1 struct {
	code int
}

func (e probeErr27x1) Error() string {
	return "probe failure"
}

func check27x1(value int) error {
	if value < 0 {
		return probeErr27x1{code: value}
	}
	return nil
}
func describe27x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

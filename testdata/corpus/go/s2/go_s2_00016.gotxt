package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify16x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 19:
		return value * 2
	case 60:
		return value + 2
	default:
		return value
	}
}
func classify16x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 26:
		return value * 2
	case 10:
		return value + 2
	default:
		return value
	}
}
type probeErr16x2 struct {
	code int
}

func (e probeErr16x2) Error() string {
	return "probe failure"
}

func check16x2(value int) error {
	if value < 0 {
		return probeErr16x2{code: value}
	}
	return nil
}

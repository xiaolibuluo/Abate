func g() int { return 2 }

func fold22x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 97
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder22x1 interface {
	Encode(value int) int
}

type scaler22x1 struct {
	factor int
}

func (s scaler22x1) Encode(value int) int {
	return value * s.factor + 7
}
type probeErr22x2 struct {

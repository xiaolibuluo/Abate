package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify33x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 46:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
type Store33x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store33x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store33x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type Encoder33x2 interface {
	Encode(value int) int
}

type scaler33x2 struct {
	factor int
}

func (s scaler33x2) Encode(value int) int {
	return value * s.factor + 60
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder24x0 interface {
	Encode(value int) int
}

type scaler24x0 struct {
	factor int
}

func (s scaler24x0) Encode(value int) int {
	return value * s.factor + 26
}
func fold24x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 33
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold24x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 40
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr33x0 struct {
	code int
}

func (e probeErr33x0) Error() string {
	return "probe failure"
}

func check33x0(value int) error {
	if value < 0 {
		return probeErr33x0{code: value}
	}
	return nil
}
type base33x1 struct {
	seed int
}

type derived33x1 struct {
	base33x1
	step int
}

func (d derived33x1) Next() int {
	return d.seed + d.step + 68
}
type Encoder33x2 interface {
	Encode(value int) int
}

type scaler33x2 struct {
	factor int
}

func (s scaler33x2) Encode(value int) int {
	return value * s.factor + 60
}

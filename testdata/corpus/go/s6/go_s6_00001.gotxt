package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr1x0 struct {
	code int
}

func (e probeErr1x0) Error() string {
	return "probe failure"
}

func check1x0(value int) error {
	if value < 0 {
		return probeErr1x0{code: value}
	}
	return nil
}
type Store1x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store1x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store1x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

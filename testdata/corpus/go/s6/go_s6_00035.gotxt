package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base35x0 struct {
	seed int
}

type derived35x0 struct {
	base35x0
	step int
}

func (d derived35x0) Next() int {
	return d.seed + d.step + 10
}
func describe35x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type Encoder35x2 interface {
	Encode(value int) int
}

type scaler35x2 struct {
	factor int
}

func (s scaler35x2) Encode(value int) int {
	return value * s.factor + 86
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder38x0 interface {
	Encode(value int) int
}

type scaler38x0 struct {
	factor int
}

func (s scaler38x0) Encode(value int) int {
	return value * s.factor + 14
}
type Encoder38x1 interface {
	Encode(value int) int
}

type scaler38x1 struct {
	factor int
}

func (s scaler38x1) Encode(value int) int {
	return value * s.factor + 21
}
type base38x2 struct {
	seed int
}

type derived38x2 struct {
	base38x2
	step int
}

func (d derived38x2) Next() int {
	return d.seed + d.step + 53
}

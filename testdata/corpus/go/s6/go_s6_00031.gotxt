package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base31x0 struct {
	seed int
}

type derived31x0 struct {
	base31x0
	step int
}

func (d derived31x0) Next() int {
	return d.seed + d.step + 43
}
type base31x1 struct {
	seed int
}

type derived31x1 struct {
	base31x1
	step int
}

func (d derived31x1) Next() int {
	return d.seed + d.step + 54
}
type Encoder31x2 interface {
	Encode(value int) int
}

type scaler31x2 struct {
	factor int
}

func (s scaler31x2) Encode(value int) int {
	return value * s.factor + 34
}

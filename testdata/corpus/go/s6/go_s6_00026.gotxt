package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Store26x0[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store26x0[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store26x0[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
func classify26x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 59:
		return value * 2
	case 19:
		return value + 2
	default:
		return value
	}
}
type probeErr26x2 struct {
	code int
}

func (e probeErr26x2) Error() string {
	return "probe failure"
}

func check26x2(value int) error {
	if value < 0 {
		return probeErr26x2{code: value}
	}
	return nil
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe27x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base27x1 struct {
	seed int
}

type derived27x1 struct {
	base27x1
	step int
}

func (d derived27x1) Next() int {
	return d.seed + d.step + 26
}
type base27x2 struct {
	seed int
}

type derived27x2 struct {
	base27x2
	step int
}

func (d derived27x2) Next() int {
	return d.seed + d.step + 37

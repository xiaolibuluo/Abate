package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base32x0 struct {
	seed int
}

type derived32x0 struct {
	base32x0
	step int
}

func (d derived32x0) Next() int {
	return d.seed + d.step + 50
}
func relay32x1(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 40
			}
		case <-done:
			return
		}
	}
}
func classify32x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 47:
		return value * 2
	case 11:
		return value + 2
	default:
		return value
	}
}

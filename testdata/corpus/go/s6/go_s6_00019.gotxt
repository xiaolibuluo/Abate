package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base19x0 struct {
	seed int
}

type derived19x0 struct {
	base19x0
	step int
}

func (d derived19x0) Next() int {
	return d.seed + d.step + 20
}
type Encoder19x1 interface {
	Encode(value int) int
}

type scaler19x1 struct {
	factor int
}

func (s scaler19x1) Encode(value int) int {
	return value * s.factor + 65
}
func fold19x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 72
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

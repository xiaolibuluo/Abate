package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay9x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 25
			}
		case <-done:
			return
		}
	}
}
type probeErr9x1 struct {
	code int
}

func (e probeErr9x1) Error() string {
	return "probe failure"
}

func check9x1(value int) error {
	if value < 0 {
		return probeErr9x1{code: value}
	}
	return nil
}

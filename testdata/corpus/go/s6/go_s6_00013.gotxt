package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold13x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 77
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func classify13x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 84:
		return value * 2
	case 50:
		return value + 2
	default:
		return value
	}
}
type Encoder13x2 interface {
	Encode(value int) int
}

type scaler13x2 struct {
	factor int
}

func (s scaler13x2) Encode(value int) int {
	return value * s.factor + 91
}

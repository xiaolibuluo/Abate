package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func fold8x0(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 12
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr8x1 struct {
	code int
}

func (e probeErr8x1) Error() string {
	return "probe failure"
}

func check8x1(value int) error {
	if value < 0 {
		return probeErr8x1{code: value}
	}
	return nil
}
func describe8x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

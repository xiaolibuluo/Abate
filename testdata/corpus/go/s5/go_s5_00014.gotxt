package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base14x0 struct {
	seed int
}

type derived14x0 struct {
	base14x0
	step int
}

func (d derived14x0) Next() int {
	return d.seed + d.step + 46
}
func classify14x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 97:
		return value * 2
	case 57:
		return value + 2
	default:
		return value
	}
}
func relay14x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base20x0 struct {
	seed int
}

type derived20x0 struct {
	base20x0
	step int
}

func (d derived20x0) Next() int {
	return d.seed + d.step + 27
}
type Encoder20x1 interface {
	Encode(value int) int
}

type scaler20x1 struct {
	factor int
}

func (s scaler20x1) Encode(value int) int {
	return value * s.factor + 78
}
func relay20x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 85
			}
		case <-done:
			return
		}
	}
}

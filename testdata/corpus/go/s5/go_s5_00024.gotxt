package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay24x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 26
			}
		case <-done:
			return
		}
	}
}
type base24x1 struct {
	seed int
}

type derived24x1 struct {
	base24x1
	step int
}

func (d derived24x1) Next() int {
	return d.seed + d.step + 66
}
type Encoder24x2 interface {
	Encode(value int) int
}

type scaler24x2 struct {
	factor int
}

func (s scaler24x2) Encode(value int) int {
	return value * s.factor + 40
}

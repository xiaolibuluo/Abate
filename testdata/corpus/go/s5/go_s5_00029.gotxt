package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base29x0 struct {
	seed int
}

type derived29x0 struct {
	base29x0
	step int
}

func (d derived29x0) Next() int {
	return d.seed + d.step + 29
}
func fold29x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 98
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type probeErr29x2 struct {
	code int
}

func (e probeErr29x2) Error() string {
	return "probe failure"
}

func check29x2(value int) error {
	if value < 0 {
		return probeErr29x2{code: value}
	}
	return nil
}

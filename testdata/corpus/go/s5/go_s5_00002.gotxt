package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay2x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 31
			}
		case <-done:
			return
		}
	}
}
type Encoder2x1 interface {
	Encode(value int) int
}

type scaler2x1 struct {
	factor int
}

func (s scaler2x1) Encode(value int) int {
	return value * s.factor + 38
}
type base2x2 struct {
	seed int
}

type derived2x2 struct {
	base2x2
	step int
}

func (d derived2x2) Next() int {
	return d.seed + d.step + 45
}

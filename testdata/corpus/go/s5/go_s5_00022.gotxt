package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder22x0 interface {
	Encode(value int) int
}

type scaler22x0 struct {
	factor int
}

func (s scaler22x0) Encode(value int) int {
	return value * s.factor + 97
}
func describe22x1(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type probeErr22x2 struct {
	code int
}

func (e probeErr22x2) Error() string {
	return "probe failure"
}

func check22x2(value int) error {
	if value < 0 {
		return probeErr22x2{code: value}
	}
	return nil
}

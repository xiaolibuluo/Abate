package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify11x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 51:
		return value * 2
	case 25:
		return value + 2
	default:
		return value
	}
}
type base11x1 struct {
	seed int
}

type derived11x1 struct {
	base11x1
	step int
}

func (d derived11x1) Next() int {
	return d.seed + d.step + 36
}
type probeErr11x2 struct {
	code int
}

func (e probeErr11x2) Error() string {
	return "probe failure"
}

func check11x2(value int) error {
	if value < 0 {
		return probeErr11x2{code: value}
	}
	return nil
}

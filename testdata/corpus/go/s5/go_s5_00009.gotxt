package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder9x0 interface {
	Encode(value int) int
}

type scaler9x0 struct {
	factor int
}

func (s scaler9x0) Encode(value int) int {
	return value * s.factor + 25
}
type base9x1 struct {
	seed int
}

type derived9x1 struct {
	base9x1
	step int
}

func (d derived9x1) Next() int {
	return d.seed + d.step + 22
}
func describe9x2(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}

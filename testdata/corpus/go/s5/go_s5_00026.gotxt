package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder26x0 interface {
	Encode(value int) int
}

type scaler26x0 struct {
	factor int
}

func (s scaler26x0) Encode(value int) int {
	return value * s.factor + 52
}
type Store26x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store26x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store26x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base26x2 struct {
	seed int
}

type derived26x2 struct {
	base26x2
	step int
}

func (d derived26x2) Next() int {
	return d.seed + d.step + 30
}

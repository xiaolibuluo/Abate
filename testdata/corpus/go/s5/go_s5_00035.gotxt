package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type probeErr35x0 struct {
	code int
}

func (e probeErr35x0) Error() string {
	return "probe failure"
}

func check35x0(value int) error {
	if value < 0 {
		return probeErr35x0{code: value}
	}
	return nil
}

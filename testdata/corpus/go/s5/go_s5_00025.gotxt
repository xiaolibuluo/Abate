package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder25x0 interface {
	Encode(value int) int
}

type scaler25x0 struct {
	factor int
}

func (s scaler25x0) Encode(value int) int {
	return value * s.factor + 39
}
type Encoder25x1 interface {
	Encode(value int) int
}

type scaler25x1 struct {
	factor int
}

func (s scaler25x1) Encode(value int) int {
	return value * s.factor + 46
}
func classify25x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 53:
		return value * 2
	case 23:
		return value + 2
	default:
		return value
	}
}

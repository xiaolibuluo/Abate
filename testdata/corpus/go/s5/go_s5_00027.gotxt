package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base27x0 struct {
	seed int
}

type derived27x0 struct {
	base27x0
	step int
}

func (d derived27x0) Next() int {
	return d.seed + d.step + 15
}
type Store27x1[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store27x1[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store27x1[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}
type base27x2 struct {
	seed int
}

type derived27x2 struct {
	base27x2
	step int
}

func (d derived27x2) Next() int {
	return d.seed + d.step + 37
}

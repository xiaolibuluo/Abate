package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify28x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 22:
		return value + 2
	default:
		return value
	}
}
type base28x1 struct {
	seed int
}

type derived28x1 struct {
	base28x1
	step int
}

func (d derived28x1) Next() int {
	return d.seed + d.step + 33
}
func fold28x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 92
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

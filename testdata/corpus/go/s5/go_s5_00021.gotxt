package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder21x0 interface {
	Encode(value int) int
}

type scaler21x0 struct {
	factor int
}

func (s scaler21x0) Encode(value int) int {
	return value * s.factor + 84
}
func classify21x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 91:
		return value * 2
	case 45:
		return value + 2
	default:
		return value
	}
}
type probeErr21x2 struct {
	code int
}

func (e probeErr21x2) Error() string {
	return "probe failure"
}

func check21x2(value int) error {
	if value < 0 {
		return probeErr21x2{code: value}
	}
	return nil
}

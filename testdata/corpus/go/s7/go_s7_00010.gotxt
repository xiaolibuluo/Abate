package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func describe10x0(items []any) []string {
	result := make([]string, 0, len(items))
	for _, item := range items {
		switch value := item.(type) {
		case int:
			result = append(result, "int"+string(rune(value)))
		case string:
			result = append(result, value)
		default:
			result = append(result, "other")
		}
	}
	return result
}
type base10x1 struct {
	seed int
}

type derived10x1 struct {
	base10x1
	step int
}

func (d derived10x1) Next() int {
	return d.seed + d.step + 29
}
func classify10x2(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 52:
		return value * 2
	case 40:
		return value + 2
	default:
		return value
	}
}

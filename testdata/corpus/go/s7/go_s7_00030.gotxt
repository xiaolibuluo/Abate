package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay30x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 7
			}
		case <-done:
			return
		}
	}
}
type probeErr30x1 struct {
	code int
}

func (e probeErr30x1) Error() string {
	return "probe failure"
}

func check30x1(value int) error {
	if value < 0 {
		return probeErr30x1{code: value}
	}
	return nil
}
func fold30x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 21
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

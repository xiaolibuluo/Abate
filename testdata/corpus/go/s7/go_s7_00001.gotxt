package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder1x0 interface {
	Encode(value int) int
}

type scaler1x0 struct {
	factor int
}

func (s scaler1x0) Encode(value int) int {
	return value * s.factor + 18
}
type Encoder1x1 interface {
	Encode(value int) int
}

type scaler1x1 struct {
	factor int
}

func (s scaler1x1) Encode(value int) int {
	return value * s.factor + 25
}
func fold1x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 32
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

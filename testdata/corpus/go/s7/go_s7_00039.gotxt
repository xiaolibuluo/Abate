func g() int { return 2 }

func relay39x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 27
			}
		case <-done:
			return
		}
	}
}
type base39x1 struct {
	seed int
}

type derived39x1 struct {
	base39x1
	step int
}

func (d derived39x1) Next() int {
	return d.seed + d.step + 49
}

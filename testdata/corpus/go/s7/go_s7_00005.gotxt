package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base5x0 struct {
	seed int
}

type derived5x0 struct {
	base5x0
	step int
}

func (d derived5x0) Next() int {
	return d.seed + d.step + 44
}
type Encoder5x1 interface {
	Encode(value int) int
}

type scaler5x1 struct {
	factor int
}

func (s scaler5x1) Encode(value int) int {
	return value * s.factor + 77
}
type probeErr5x2 struct {
	code int
}

func (e probeErr5x2) Error() string {
	return "probe failure"
}

func check5x2(value int) error {
	if value < 0 {
		return probeErr5x2{code: value}
	}
	return nil
}

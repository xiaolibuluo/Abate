package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder23x0 interface {
	Encode(value int) int
}

type scaler23x0 struct {
	factor int
}

func (s scaler23x0) Encode(value int) int {
	return value * s.factor + 13
}
type Encoder23x1 interface {
	Encode(value int) int
}

type scaler23x1 struct {
	factor int
}

func (s scaler23x1) Encode(value int) int {
	return value * s.factor + 20
}
type Store23x2[Key comparable, Value any] struct {
	items map[Key]Value
}

func (s *Store23x2[Key, Value]) Put(key Key, value Value) {
	if s.items == nil {
		s.items = make(map[Key]Value)
	}
	s.items[key] = value
}

func (s *Store23x2[Key, Value]) ValueAt(key Key) (Value, bool) {
	value, found := s.items[key]
	return value, found
}

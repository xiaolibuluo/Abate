package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func relay34x0(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 59
			}
		case <-done:
			return
		}
	}
}
type Encoder34x1 interface {
	Encode(value int) int
}

type scaler34x1 struct {
	factor int
}

func (s scaler34x1) Encode(value int) int {
	return value * s.factor + 66
}
type probeErr34x2 struct {
	code int
}

func (e probeErr34x2) Error() string {
	return "probe failure"
}

func check34x2(value int) error {
	if value < 0 {
		return probeErr34x2{code: value}
	}
	return nil
}

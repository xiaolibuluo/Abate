package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder33x0 interface {
	Encode(value int) int
}

type scaler33x0 struct {
	factor int
}

func (s scaler33x0) Encode(value int) int {
	return value * s.factor + 46
}
func fold33x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 53
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
func fold33x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 60
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

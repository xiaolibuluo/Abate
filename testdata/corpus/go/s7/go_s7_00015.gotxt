package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type base15x0 struct {
	seed int
}

type derived15x0 struct {
	base15x0
	step int
}

func (d derived15x0) Next() int {
	return d.seed + d.step + 53
}
type probeErr15x1 struct {
	code int
}

func (e probeErr15x1) Error() string {
	return "probe failure"
}

func check15x1(value int) error {
	if value < 0 {
		return probeErr15x1{code: value}
	}
	return nil
}
type base15x2 struct {
	seed int
}

type derived15x2 struct {
	base15x2
	step int
}

func (d derived15x2) Next() int {
	return d.seed + d.step + 14
}

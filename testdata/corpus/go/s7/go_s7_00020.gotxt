package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

type Encoder20x0 interface {
	Encode(value int) int
}

type scaler20x0 struct {
	factor int
}

func (s scaler20x0) Encode(value int) int {
	return value * s.factor + 71
}
func classify20x1(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 78:
		return value * 2
	case 38:
		return value + 2
	default:
		return value
	}
}
func relay20x2(in <-chan int, out chan<- int, done <-chan struct{}) {
	defer close(out)
	for {
		select {
		case value := <-in:
			if value >= 0 && value <= 64 {
				out <- value + 85
			}
		case <-done:
			return
		}
	}
}

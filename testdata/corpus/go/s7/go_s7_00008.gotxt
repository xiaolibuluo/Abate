package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify8x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 12:
		return value * 2
	case 65:
		return value + 2
	default:
		return value
	}
}
type Encoder8x1 interface {
	Encode(value int) int
}

type scaler8x1 struct {
	factor int
}

func (s scaler8x1) Encode(value int) int {
	return value * s.factor + 19
}
type base8x2 struct {
	seed int
}

type derived8x2 struct {
	base8x2
	step int
}

func (d derived8x2) Next() int {
	return d.seed + d.step + 26
}

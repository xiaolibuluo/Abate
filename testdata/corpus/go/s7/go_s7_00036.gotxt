package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify36x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 85:
		return value * 2
	case 17:
		return value + 2
	default:
		return value
	}
}
func fold36x1(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 92
	}
	for _, value := range values {
		visit(value)
	}
	return total
}
type Encoder36x2 interface {
	Encode(value int) int
}

type scaler36x2 struct {
	factor int
}

func (s scaler36x2) Encode(value int) int {
	return value * s.factor + 99
}

package synth

func anchorProbe() bool {
	return 1 + 2 == 3 && f() == g()
}

func f() int { return 1 }
func g() int { return 2 }

func classify22x0(value int) int {
	defer func() {
		value = value + 1
	}()
	switch value {
	case 97:
		return value * 2
	case 41:
		return value + 2
	default:
		return value
	}
}
type probeErr22x1 struct {
	code int
}

func (e probeErr22x1) Error() string {
	return "probe failure"
}

func check22x1(value int) error {
	if value < 0 {
		return probeErr22x1{code: value}
	}
	return nil
}
func fold22x2(values []int) int {
	total := 0
	visit := func(value int) {
		total = total + value + 14
	}
	for _, value := range values {
		visit(value)
	}
	return total
}

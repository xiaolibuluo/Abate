#!/usr/bin/env bash
# Abate pre-commit hook
# Enforces: file line limit (300), go vet, go test
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
MAX_LINES=300

# --- 1. Line count check ---
violations=0
while IFS= read -r file; do
	lines=$(wc -l < "$file")
	if [ "$lines" -gt "$MAX_LINES" ]; then
		echo "ERROR: $file has $lines lines (max $MAX_LINES)" >&2
		violations=$((violations + 1))
	fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ "$violations" -gt 0 ]; then
	echo "Commit rejected: $violations file(s) exceed ${MAX_LINES}-line limit." >&2
	exit 1
fi

# --- 2. go vet ---
export PATH="$PATH:/usr/local/go/bin"
cd "$ROOT"
if ! go vet ./... 2>&1; then
	echo "Commit rejected: go vet failed." >&2
	exit 1
fi

# --- 3. go test (staged packages only) ---
packages=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | sed 's|/[^/]*$||' | sort -u | sed 's|^|./|' || true)
if [ -n "$packages" ]; then
	if ! go test $packages -count=1 2>&1; then
		echo "Commit rejected: go test failed." >&2
		exit 1
	fi
fi

echo "pre-commit checks passed."
